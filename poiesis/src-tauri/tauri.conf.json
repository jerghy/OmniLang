{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui/main/nicegui/static/tauri/config2.schema.json",
  "productName": "Poiesis",
  "version": "0.1.0",
  "identifier": "com.omnilang.poiesis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Poiesis",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; img-src 'self' data: https:; font-src 'self'"
    }
  },
  "plugins": {
    "fs": {
      "scope": ["$RESOURCE/**", "$APPDATA/**"]
    },
    "shell": {
      "scope": []
    }
  }
}
