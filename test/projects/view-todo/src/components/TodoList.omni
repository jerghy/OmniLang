import omniview;

component TodoList {
    signal items: Vec<string> = [];
    signal input: string = "";

    fn add_item() {
        if input != "" {
            items.push(input);
            input = "";
        }
    }

    view {
        <div class: todo-list>
            <h2>Todo List</h2>
            <div class: input-group>
                <input bind:value={input} placeholder="Add a task..." />
                <button @on:click={add_item()}>Add</button>
            </div>
            <ul>
                @for item in items {
                    <li>{item}</li>
                }
                @empty {
                    <li class: empty>No items yet</li>
                }
            </ul>
        </div>
    }
}
