import omniview;

component TodoList {
    signal items: Array<String> = [];
    signal input: String = "";

    fn add_item() {
        if input != "" {
            items = [input];
            input = "";
        }
    }

    view {
        <div>
            <h2>Todo List</h2>
            <div>
                <input placeholder="Add a task..." />
                <button @onPress={add_item}>Add</button>
            </div>
            <ul>
                @for item in items {
                    <li>{item}</li>
                }
                @empty {
                    <li>No items yet</li>
                }
            </ul>
        </div>
    }
}

component App {
    view {
        <div>
            <TodoList />
        </div>
    }
}
