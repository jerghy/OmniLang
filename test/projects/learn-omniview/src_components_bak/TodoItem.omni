// @pid:c5
component TodoItem {
  prop text: String = "";

  view {
    <div class: todo-item>
      <span class: todo-text>{text}</span>
    </div>
  }
  style {
    .todo-item { display: flex; align-items: center; padding: 12px 16px; border-bottom: 1px solid #f3f4f6; }
    .todo-text { font-size: 15px; color: #1f2937; }
    // 该组件样式完全为独有模式——无通用 reusable 部分
  }
}