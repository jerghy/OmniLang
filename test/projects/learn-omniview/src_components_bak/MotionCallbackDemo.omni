// ╔══════════════════════════════════════════════════════════════════╗
// ║  MotionCallbackDemo.omni — @motion 回调模式实战                   ║
// ║                                                                  ║
// ║  编译器支持的 @motion 主体模式：                                  ║
// ║    1. Keyframe 模式: from { } to { } over N ease E               ║
// ║    2. Timeline 模式: item then item with item                    ║
// ║    3. Callback 模式: onStart { } onUpdate { } onComplete { }     ║
// ║                       onRepeat { } onInterrupt { }                ║
// ║                                                                  ║
// ║  当前 learn-omniview 的 MotionPlaybackDemo.omni 声明了            ║
// ║  callbackOnly 运动但从未在视图中接入触发（鬼影代码）。              ║
// ║  本组件将演示回调模式的实际用法。                                   ║
// ╚══════════════════════════════════════════════════════════════════╝

import omniview;

// ── 带回调的运动：入场动画追踪 ────────────────────────────
@motion trackedEnter {
    from { opacity: 0 y: -20 scale: 0.8 }
    to   { opacity: 1 y: 0 scale: 1 }
    over 600 ease power2Out

    // callback 模式：在运动生命周期关键点触发逻辑
    onStart {
        // 运动开始时触发
    }
    onComplete {
        // 运动完成时触发
    }
}

// ── 脉冲循环（带 onRepeat 回调） ──────────────────────────
@motion pulseWithCallback {
    from { scale: 1 opacity: 0.7 }
    to   { scale: 1.1 opacity: 1 }
    over 400 ease easeInOut
    direction alternate
    loop
    repeatDelay 200

    onStart { }
    onUpdate { }
    onRepeat { }
}

// ── 带中断回调的运动 ──────────────────────────────────────
@motion interruptWithCallback {
    from { x: 0 rotate: 0 }
    to   { x: 40 rotate: 15 }
    over 300 ease power1Out
    interrupt replace

    onStart { }
    onInterrupt { }
    onComplete { }
}

component MotionCallbackDemo {
    // 跟踪运动状态
    signal enterCount: i32 = 0;
    signal completeCount: i32 = 0;
    signal repeatCount: i32 = 0;
    signal lastEvent: String = "—";
    signal isPlaying: bool = false;
    signal isPulsing: bool = false;
    signal pulseRepeatCount: i32 = 0;

    // 入场动画回调处理
    fn handleEnterStart() {
        enterCount = enterCount + 1;
        lastEvent = "onStart @ " + enterCount.to_string();
        isPlaying = true;
    }
    fn handleEnterComplete() {
        completeCount = completeCount + 1;
        lastEvent = "onComplete #" + completeCount.to_string();
        isPlaying = false;
    }

    // 脉冲回调处理
    fn handlePulseStart() {
        isPulsing = true;
    }
    fn handlePulseRepeat() {
        pulseRepeatCount = pulseRepeatCount + 1;
        lastEvent = "onRepeat x" + pulseRepeatCount.to_string();
    }

    // 中断回调
    fn handleInterrupt() {
        lastEvent = "onInterrupt — motion was interrupted";
        isPlaying = false;
    }

    view {
        <div class: wrapper>
            <h3 class: section-title>@motion Callback Mode</h3>
            <p class: subtitle>
                演示 <code>onStart</code>、<code>onComplete</code>、<code>onRepeat</code>、
                <code>onInterrupt</code> 回调与信号的联动
            </p>

            <!-- 状态仪表板 -->
            <div class: status-bar>
                <div class: stat-item>
                    <span class: stat-value>{enterCount}</span>
                    <span class: stat-label>onStart 触发</span>
                </div>
                <div class: stat-item>
                    <span class: stat-value>{completeCount}</span>
                    <span class: stat-label>onComplete 触发</span>
                </div>
                <div class: stat-item>
                    <span class: stat-value>{pulseRepeatCount}</span>
                    <span class: stat-label>onRepeat 触发</span>
                </div>
                <div class: stat-item>
                    <span class: stat-value-last>{lastEvent}</span>
                    <span class: stat-label>最近事件</span>
                </div>
            </div>

            <!-- Demo 1: 入场动画 + 回调 -->
            <div class: demo-card>
                <h4 class: demo-label>① trackedEnter: onStart + onComplete</h4>
                <p class: demo-desc>
                    每次点击按钮重新触发运动，<code>onStart</code> 和 <code>onComplete</code>
                    回调分别更新信号值。
                </p>
                <div class: demo-content>
                    <div class: callback-box-area>
                        <!-- @click 触发运动（点击重新触发） -->
                        <div
                            class: anim-box
                            @click={trackedEnter}
                            @onClick={handleEnterStart}
                        >
                            <span class: anim-icon>▶</span>
                            <span class: anim-text>
                                {if isPlaying { "Animating..." } else { "Click me" }}
                            </span>
                        </div>
                    </div>
                    <div class: event-log>
                        <p class: log-entry>
                            <code>onStart</code> → enterCount: <strong>{enterCount}</strong>
                        </p>
                        <p class: log-entry>
                            <code>onComplete</code> → completeCount: <strong>{completeCount}</strong>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Demo 2: 脉冲循环 + onRepeat -->
            <div class: demo-card>
                <h4 class: demo-label>② pulseWithCallback: onRepeat</h4>
                <p class: demo-desc>
                    循环运动每次重复触发 <code>onRepeat</code> 回调，
                    可用于追踪循环动画的执行次数。
                </p>
                <div class: demo-content>
                    <div class: callback-box-area>
                        <div
                            class: anim-box pulse
                            @enter={pulseWithCallback}
                        >
                            <span class: anim-icon>{if isPulsing { "●" } else { "○" }}</span>
                            <span class: anim-text>
                                Pulse (循环中: {pulseRepeatCount})
                            </span>
                        </div>
                    </div>
                    <div class: event-log>
                        <p class: log-entry>
                            <code>onRepeat</code> → pulseRepeatCount: <strong>{pulseRepeatCount}</strong>
                        </p>
                        <p class: log-entry>
                            <code>onUpdate</code> → 每帧触发（不追踪计数）
                        </p>
                    </div>
                </div>
            </div>

            <!-- Demo 3: 中断回调 -->
            <div class: demo-card>
                <h4 class: demo-label>③ interruptWithCallback: onInterrupt</h4>
                <p class: demo-desc>
                    快速连续点击触发 <code>interrupt replace</code>，
                    每次中断调用 <code>onInterrupt</code> 回调。
                </p>
                <div class: demo-content>
                    <div class: callback-box-area>
                        <div
                            class: anim-box interrupt
                            @click={interruptWithCallback}
                            @onClick={handleInterrupt}
                        >
                            <span class: anim-icon>↺</span>
                            <span class: anim-text>快速点击我</span>
                        </div>
                    </div>
                    <div class: event-log>
                        <p class: log-entry>
                            <code>onInterrupt</code> → lastEvent: <strong>{lastEvent}</strong>
                        </p>
                        <p class: log-entry>
                            <code>onComplete</code> → 未被中断时触发
                        </p>
                    </div>
                </div>
            </div>

            <!-- 技术说明 -->
            <div class: tech-note>
                <h4 class: note-title>💡 回调模式 vs 函数式监听</h4>
                <ul class: note-list>
                    <li>回调模式定义在 <code>@motion</code> 块内部，与运动声明共处一处</li>
                    <li>每个回调接收一个 block 体，可执行任意 OmniLang 语句</li>
                    <li>5 种回调：<code>onStart</code> <code>onUpdate</code> <code>onComplete</code>
                        <code>onRepeat</code> <code>onInterrupt</code></li>
                    <li>注意：MotionPlaybackDemo.omni 中声明的 <code>callbackOnly</code> 运动在视图中从未被引用 ——
                        那是**鬼影代码**（dead code），本组件是回调模式的**正确使用示范**</li>
                </ul>
            </div>
        </div>
    }

    style {
        .wrapper { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px; margin: 16px 0; }
        .section-title { font-size: 18px; color: #1e293b; margin: 0 0 4px 0; }
        .subtitle { font-size: 13px; color: #64748b; margin: 0 0 16px 0; }
        code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 12px; }

        .status-bar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; padding: 12px; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0; }
        .stat-item { flex: 1; min-width: 100px; text-align: center; }
        .stat-value { display: block; font-size: 20px; font-weight: bold; color: #6366f1; }
        .stat-value-last { display: block; font-size: 13px; font-weight: 600; color: #0f172a; font-family: monospace; }
        .stat-label { display: block; font-size: 11px; color: #64748b; margin-top: 2px; }

        .demo-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; margin-bottom: 12px; }
        .demo-label { font-size: 14px; font-weight: 600; color: #1e293b; margin: 0 0 4px 0; }
        .demo-desc { font-size: 12px; color: #64748b; margin: 0 0 10px 0; line-height: 1.5; }
        .demo-content { display: flex; gap: 12px; align-items: flex-start; flex-wrap: wrap; }

        .callback-box-area { flex-shrink: 0; }
        .anim-box { width: 160px; height: 80px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #6366f1; color: white; border-radius: 10px; cursor: pointer; font-size: 14px; font-weight: 600; }
        .anim-box.pulse { background: #ec4899; }
        .anim-box.interrupt { background: #f59e0b; }
        .anim-icon { font-size: 20px; margin-bottom: 4px; }
        .anim-text { font-size: 11px; opacity: 0.9; text-align: center; }

        .event-log { flex: 1; min-width: 180px; background: white; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px; }
        .log-entry { font-size: 12px; color: #334155; margin: 0 0 4px 0; }
        .log-entry strong { color: #6366f1; }

        .tech-note { background: #0f172a; border-radius: 8px; padding: 14px 18px; margin-top: 12px; }
        .note-title { font-size: 14px; color: #e2e8f0; margin: 0 0 8px 0; }
        .note-list { margin: 0; padding-left: 18px; }
        .note-list li { font-size: 12px; color: #94a3b8; margin-bottom: 4px; line-height: 1.5; }
    }
}
