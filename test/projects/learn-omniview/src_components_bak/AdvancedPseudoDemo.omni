import omniview;

// ╔══════════════════════════════════════════════════════════════╗
// ║  🧪 Playwright Test                                         ║
// ║                                                            ║
// ║  **Steps:**                                                ║
// ║  1. Navigate to AdvancedPseudoDemo component.               ║
// ║  2. Verify all cards and buttons render.                    ║
// ║                                                            ║
// ║  **Expected:**                                             ║
// ║  - Compound selectors compile: .activeCard.cardActive        ║
// ║  - Compound + pseudo-class: .darkBtn:hover                  ║
// ║  - Complex selectors generate correct CSS output.           ║
// ╚══════════════════════════════════════════════════════════════╝

component AdvancedPseudoDemo {
    signal isActive: bool = false;
    signal variant: String = "default";

    fn toggle() { isActive = !isActive; }
    fn setDefault() { variant = "default"; }
    fn setDark() { variant = "dark"; }

    view {
        <div class: container>
            <h3 class: title>Advanced CSS Selectors Demo</h3>
            <p class: subtitle>演示 .class1.class2 组合选择器和 .class1.class2:hover 伪类链接</p>

            <div class: card>
                <h4 class: label>组合选择器 .activeCard.cardActive</h4>
                <!-- ★ .activeCard.cardActive —— 两个 class 同时匹配时才生效 -->
                <div class: { activeCard: true, cardActive: isActive }>
                    <p>Toggle me to see .activeCard.cardActive style</p>
                </div>
                <button class: btn-outline @onPress={toggle}>Toggle Active ({isActive ? "ON" : "OFF"})</button>
            </div>

            <div class: card>
                <h4 class: label>组合选择器 + 伪类: .darkBtn:hover, .darkBtn:focus, .darkBtn:active</h4>
                <div class: btn-row>
                    <button class: btn-dark @onPress={setDark}>
                        Dark Variant
                    </button>
                    <button class: btn-outline @onPress={setDefault}>
                        Reset
                    </button>
                </div>
                <p class: note>.darkBtn:hover .darkBtn:focus .darkBtn:active —— 三态组合伪类</p>
            </div>

            <div class: card>
                <h4 class: label>多组合 + 多伪类: .panel-highlight:hover, .panel-highlight:focus</h4>
                <div class: panel-highlight>
                    <p>Hover or Focus this panel</p>
                    <input class: panel-input placeholder="Tab to focus me" />
                </div>
            </div>
        </div>
    }
    style {
        .container { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 4px 0; }
        .subtitle { font-size: 13px; color: #9ca3af; margin: 0 0 16px 0; }
        .card { margin-bottom: 14px; padding: 12px; background: #f9fafb; border-radius: 8px; }
        .label { font-size: 14px; font-weight: 600; color: #374151; margin: 0 0 8px 0; }
        .btn-row { display: flex; gap: 8px; margin-bottom: 8px; }
        .btn-outline { padding: 8px 16px; background: white; color: #6366f1; border: 1px solid #6366f1; border-radius: 8px; font-size: 14px; cursor: pointer; }
        .btn-dark { padding: 10px 20px; background: "#1e293b"; color: white; border: none; border-radius: 8px; font-size: 14px; cursor: pointer; }

        // ★ 组合选择器：两个 class 必须同时匹配
        .activeCard { padding: 16px; border-radius: 8px; background: "#f1f5f9"; color: #64748b; font-size: 14px; text-align: center; }
        .activeCard.cardActive { background: "#dcfce7"; color: #166534; border: 2px solid "#86efac"; }

        // ★ 简单伪类
        .btn-dark:hover { background: "#334155"; transform: "scale(1.03)"; }
        .btn-dark:focus { outline: "2px solid #fbbf24"; outline-offset: 2; }
        .btn-dark:active { background: "#0f172a"; transform: "scale(0.97)"; }

        // ★ 多组合 + 多伪类
        .panel-highlight { padding: 16px; background: "#fefce8"; border-radius: 8px; font-size: 14px; color: #713f12; }
        .panel-highlight:hover { background: "#fef08a"; border: 1px solid #eab308; }
        .panel-input { margin-top: 8px; padding: 8px 12px; border: 1px solid #d4d4d8; border-radius: 6px; font-size: 13px; outline: none; width: 100%; }
        .panel-input:focus { border-color: "#6366f1"; box-shadow: "0 0 0 2px rgba(99,102,241,0.3)"; }

        .note { font-size: 12px; color: #9ca3af; margin: 4px 0 0 0; }
    }
}
