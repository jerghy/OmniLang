// ╔══════════════════════════════════════════════════════════════╗
// ║  StatsPanel.omni —— prop 接收数据 + if 表达式                   ║
// ║  演示：prop（父→子传值）、if 表达式用于文本插值                  ║
// ║  导入 lib.omni 的 format_count 工具函数                         ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
import { format_count } from "../lib";

component StatsPanel {
    // prop 从父组件接收数据，可选 prop 有默认值
    prop total: i32 = 0;

    view {
        <div class: LearnDesign.Card>
            <h3 class: LearnDesign.CardTitle>统计面板</h3>
            <div class: Grid>
                <div class: StatCard>
                    <span class: value>{total}</span>
                    <span class: Label>总事项</span>
                </div>
                <div class: StatCard>
                    <span class: value>{if total > 0 { "有" } else { "无" }}</span>
                    <span class: Label>状态</span>
                </div>
            </div>
            <span class: Msg>{
                if total == 0 {
                    "开始添加第一个待办事项"
                } else {
                    "已添加 " + format_count(total) + " 个事项"
                }
            }</span>
        </div>
    }
    style {
        // 统计面板特有的内部布局和数据展示
        .value { font-size: 28px; font-weight: bold; color: #6366f1; }
        // 外部容器 .panel / .title 已由 LearnDesign.Card / CardTitle 提供
    }
}
