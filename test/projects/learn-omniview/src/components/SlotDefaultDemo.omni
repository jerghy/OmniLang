// ╔══════════════════════════════════════════════════════════════════╗
// ║  SlotDefaultDemo.omni — @slot 默认回退内容（ADR-053 D5 语法）      ║
// ║                                                                  ║
// ║  插槽在组件体内声明（body-level），view 中用 {name} / {children}   ║
// ║  插值标记投影位置：                                                ║
// ║    @slot name { 默认内容 }   — 命名插槽 + 回退                     ║
// ║    @slot { 默认内容 }        — 匿名插槽 + 回退                     ║
// ║    @slot name                — 无默认值的插槽                      ║
// ║                                                                  ║
// ║  消费者用命名属性投影命名插槽（name={<.../>}），匿名插槽由           ║
// ║  子元素隐式投影：                                                  ║
// ║    <SlotPanel header={<div>...</div>}>...</SlotPanel>             ║
// ║                                                                  ║
// ║  本组件演示插槽的 4 种形态：                                       ║
// ║    1. 无默认值的空插槽 @slot name                                 ║
// ║    2. 带默认回退内容的插槽 @slot name { 回退内容 }                  ║
// ║    3. 匿名插槽带默认回退 @slot { 回退内容 }                        ║
// ║    4. 类型化插槽 @slot name: Type（见下方 TypedSlotPanel）         ║
// ║       · React 生成 TS 类型（header?: string）                      ║
// ║       · Flutter 警告并退化为 Widget?（data_param 尚未定型）        ║
// ║       · OmniView 不消费类型——约束目前是声明侧文档，                ║
// ║         三目标运行时行为与无类型插槽一致                            ║
// ╚══════════════════════════════════════════════════════════════════╝

import omniview;

// ── SlotPanel: 接收插槽的组件 ──────────────────────────
component SlotPanel {
    // Body-level slot declarations (ADR-053 D5) with fallback content;
    // the view references them via {header} / {children} / {footer}.
    @slot header {
        <span class: default-text>Default Header (来自 header 插槽声明的回退)</span>
    }
    @slot {
        <p class: default-text>Default Body — 这是匿名插槽的默认回退内容</p>
    }
    @slot footer

    view {
        <div class: slot-panel>
            <div class: slot-section>
                <span class: section-label>header slot:</span>
                {header}
            </div>

            <div class: slot-section main>
                <span class: section-label>main slot:</span>
                {children}
            </div>

            <div class: slot-section>
                <span class: section-label>footer slot:</span>
                {footer}
            </div>
        </div>
    }
    style {
        .slot-panel { background: white; border: 1px solid #d4d4d8; border-radius: 10px; padding: 14px; }
        .slot-section { margin-bottom: 10px; padding: 10px; background: #f8fafc; border-radius: 6px; border: 1px dashed #cbd5e1; }
        .slot-section.main { background: #f0f9ff; border-color: #bae6fd; }
        .section-label { display: block; font-size: 11px; color: #64748b; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
        .default-text { font-size: 13px; color: #64748b; font-style: italic; margin: 0; }
    }
}

// ── TypedSlotPanel: 类型化插槽（@slot name: Type） ──────────
// 类型约束随插槽声明进入 AST/IR（SlotIR.type_constraint），
// 消费端投影语法与无类型插槽完全一致。
component TypedSlotPanel {
    @slot header: String {
        <span class: default-text>Default Typed Header（@slot header: String 的回退）</span>
    }
    @slot badge: Int {
        <span class: default-text>0</span>
    }

    view {
        <div class: slot-panel typed>
            <div class: slot-section>
                <span class: section-label>header slot (String):</span>
                {header}
            </div>
            <div class: slot-section main>
                <span class: section-label>badge slot (Int):</span>
                {badge}
            </div>
        </div>
    }
    style {
        .slot-panel.typed { background: #fffbeb; border-color: #fde68a; }
        .slot-section { margin-bottom: 10px; padding: 10px; background: #f8fafc; border-radius: 6px; border: 1px dashed #cbd5e1; }
        .slot-section.main { background: #f0f9ff; border-color: #bae6fd; }
        .section-label { display: block; font-size: 11px; color: #64748b; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
        .default-text { font-size: 13px; color: #64748b; font-style: italic; margin: 0; }
    }
}

// ── 主演示组件 ──────────────────────────────────────
component SlotDefaultDemo {
    signal useCustomContent: bool = false;

    fn toggleContent() { useCustomContent = !useCustomContent; }

    view {
        <div class: wrapper>
            <h3 class: section-title>Slot Default Content (回退内容)</h3>
            <p class: subtitle>
                演示插槽默认回退内容语法 + 对比有/无自定义内容
            </p>

            <!-- 演示区 1: 使用默认回退（无自定义插槽内容） -->
            <div class: demo-card>
                <h4 class: demo-label>① Using Default Slot Content</h4>
                <p class: demo-desc>
                    消费者<strong>没有</strong>提供插槽内容 →
                    组件显示 <code>header</code> 插槽声明中定义的默认回退。
                </p>
                <div class: demo-box>
                    <!-- 没有传入插槽内容，使用默认回退 -->
                    <SlotPanel />
                </div>
            </div>

            <!-- 演示区 2: 提供自定义插槽内容（覆盖默认回退） -->
            <div class: demo-card>
                <h4 class: demo-label>② Overriding Default with Custom Content</h4>
                <p class: demo-desc>
                    消费者<strong>提供</strong>插槽内容 → 默认回退被覆盖。
                    <code>footer</code> 插槽没有默认值，若未提供则保持空白。
                </p>
                <div class: demo-box>
                    <!-- 命名属性投影命名插槽；子元素隐式进入匿名插槽 -->
                    <SlotPanel
                        header={<div class: custom-header><span class: custom-icon>★</span><span>Custom Header — 覆盖了默认回退</span></div>}
                    >
                        <div class: custom-body>
                            <p>Custom Body Content</p>
                            <p class: custom-note>默认回退已被消费者替代</p>
                        </div>
                        <!-- 不提供 footer → footer 为空（无默认值） -->
                    </SlotPanel>
                </div>
            </div>

            <!-- 演示区 3: 条件切换 -->
            <div class: demo-card>
                <h4 class: demo-label>③ Toggle: With / Without Custom Content</h4>
                <p class: demo-desc>
                    点击按钮在有/无自定义插槽内容之间切换，
                    观察默认回退的出现和消失。
                </p>
                <button class: toggle-btn @onPress={toggleContent}>
                    {if useCustomContent { "Reset to Defaults" } else { "Provide Custom Content" }}
                </button>
                <div class: demo-box toggle-area>
                    @if useCustomContent {
                        <SlotPanel
                            header={<div class: custom-header alt><span class: custom-icon>✦</span><span>Custom Header (alt)</span></div>}
                            footer={<div class: custom-footer><span>提供了 footer 插槽</span></div>}
                        >
                            <p class: custom-body alt>Custom body — 回退已被覆盖</p>
                        </SlotPanel>
                    } @else {
                        <SlotPanel />
                    }
                </div>
            </div>

            <!-- 演示区 4: 类型化插槽 @slot name: Type -->
            <div class: demo-card>
                <h4 class: demo-label>④ Typed Slots — {"@slot name: Type"}</h4>
                <p class: demo-desc>
                    类型化插槽声明 <code>{"@slot header: String"}</code> / <code>{"@slot badge: Int"}</code>。
                    消费端投影语法不变。类型约束目前是<strong>声明侧文档</strong>：
                    React 生成 TS 类型（<code>header?: string</code>），Flutter 警告并退化为
                    <code>Widget?</code>，OmniView 不消费类型——运行时行为与无类型插槽一致。
                </p>
                <div class: demo-box>
                    <TypedSlotPanel
                        header={<span class: custom-header>Custom Typed Header — 覆盖回退</span>}
                    >
                        <span class: custom-body>42 — 覆盖 badge 回退</span>
                    </TypedSlotPanel>
                </div>
            </div>

            <!-- 技术说明 -->
            <div class: tech-note>
                <h4 class: note-title>💡 插槽默认内容语义</h4>
                <ul class: note-list>
                    <li>如果消费者<strong>没有</strong>为命名的 <code>插槽</code> 提供内容，显示其默认回退</li>
                    <li>如果消费者<strong>有</strong>提供内容，默认回退被完全替换</li>
                    <li>不带默认值的 <code>插槽声明</code>（无回退体）在无内容时渲染空白</li>
                    <li>匿名插槽（不写名字的声明）同样支持默认回退</li>
                    <li>回退内容可以是任意 OmniLang view 模板（元素、文本、插值、条件等）</li>
                    <li>类型化插槽 <code>{"@slot name: Type"}</code>：三目标均可编译；React 生成 TS 类型，Flutter 警告并退化为 <code>Widget?</code>，OmniView 不消费类型（声明侧文档，不强制）</li>
                </ul>
            </div>
        </div>
    }

    style {
        .wrapper { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px; margin: 16px 0; }
        .section-title { font-size: 18px; color: #1e293b; margin: 0 0 4px 0; }
        .subtitle { font-size: 13px; color: #64748b; margin: 0 0 16px 0; }
        code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 12px; }

        .demo-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; margin-bottom: 12px; }
        .demo-label { font-size: 14px; font-weight: 600; color: #1e293b; margin: 0 0 4px 0; }
        .demo-desc { font-size: 12px; color: #64748b; margin: 0 0 10px 0; line-height: 1.5; }
        .demo-box { margin-top: 10px; }

        .toggle-btn { padding: 10px 20px; background: #6366f1; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; }
        .toggle-btn:hover { background: #4f46e5; }
        .toggle-area { margin-top: 12px; }

        // Custom content styles
        .custom-header { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: #e0e7ff; border-radius: 6px; font-size: 13px; color: #3730a3; font-weight: 600; }
        .custom-header.alt { background: #fce7f3; color: #9d174d; }
        .custom-icon { font-size: 16px; }
        .custom-body { padding: 10px; background: #dbeafe; border-radius: 6px; font-size: 13px; color: #1e40af; margin: 0; }
        .custom-body.alt { background: #d1fae5; color: #065f46; }
        .custom-note { font-size: 11px; color: #3b82f6; margin: 4px 0 0 0; }
        .custom-footer { padding: 8px 12px; background: #f3e8ff; border-radius: 6px; font-size: 12px; color: #6b21a8; }

        .tech-note { background: #0f172a; border-radius: 8px; padding: 14px 18px; margin-top: 12px; }
        .note-title { font-size: 14px; color: #e2e8f0; margin: 0 0 8px 0; }
        .note-list { margin: 0; padding-left: 18px; }
        .note-list li { font-size: 12px; color: #94a3b8; margin-bottom: 4px; line-height: 1.5; }
    }
}
