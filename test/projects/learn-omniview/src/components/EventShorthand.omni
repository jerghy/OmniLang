// ╔══════════════════════════════════════════════════════════════╗
// ║  EventShorthand.omni —— 事件绑定简写                              ║
// ║  演示：{fnName(args)} 自动包装、{store.action} 引用、              ║
// ║        @eventName 简写形式                                       ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { NotificationStore } from "../stores/NotificationStore";

component EventShorthand {
    @store NotificationStore;

    signal msg: String = "Click a button";
    signal count: i32 = 0;

    fn greet(name: String) {
        msg = "Hello " + name + "!";
        count = count + 1;
    }

    fn farewell(name: String) {
        msg = "Goodbye " + name + "!";
        count = count + 1;
    }

    fn reset() {
        msg = "Click a button";
        count = 0;
    }

    view {
        <div class: event-shorthand>
            <h3 class: title>Event Shorthand Demo</h3>

            <!-- 简写1: {fnName(args)} — 解析器自动生成 () => { fnName(args); } -->
            <div class: section>
                <p class: section-title>Form 1: {"{fnName(args)}"} — auto-wraps inline</p>
                <button class: btn @onClick={greet("World")}>greet("World")</button>
                <button class: btn-alt @onClick={farewell("World")}>farewell("World")</button>
            </div>

            <!-- 简写2: {store.action} — 直接引用 store action -->
            <div class: section>
                <p class: section-title>Form 2: {"{store.action}"} — StoreAction ref</p>
                <button class: btn-store @onPress={() => { NotificationStore.add("Hello from shorthand"); }}>
                    NotificationStore.add(...)
                </button>
                <button class: btn-store @onPress={NotificationStore.clear}>
                    NotificationStore.clear
                </button>
            </div>

            <!-- @eventName 简写形式（对比 onEventName） -->
            <div class: section>
                <p class: section-title>@eventName syntax (same as onEventName):</p>
                <div class: demo-row>
                    <button class: btn-on @onPress={() => { msg = "onPress"; }}>
                        onPress
                    </button>
                    <button class: btn-at @onPress={() => { msg = "@onPress"; }}>
                        @onPress
                    </button>
                </div>
            </div>

            <!-- 结果展示 -->
            <div class: result-area>
                <p class: result-text>{msg}</p>
                <p class: result-count>Clicks: {count}</p>
                <p class: store-info>Notifications: {NotificationStore.unreadCount}</p>
            </div>

            <button class: btn-reset @onPress={reset}>Reset</button>
        </div>
    }
    style {
        .event-shorthand { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 16px 0; }
        .section { margin-bottom: 12px; padding: 10px 12px; background: #f9fafb; border-radius: 8px; border: 1px solid #e5e7eb; }
        .section-title { font-size: 13px; font-weight: 600; color: #6b7280; margin: 0 0 8px 0; }
        .demo-row { display: flex; gap: 8px; }
        .btn { padding: 8px 16px; background: #6366f1; color: white; border: none; border-radius: 8px; font-size: 14px; cursor: pointer; }
        .btn-alt { padding: 8px 16px; background: #10b981; color: white; border: none; border-radius: 8px; font-size: 14px; cursor: pointer; }
        .btn-store { padding: 8px 16px; background: #f59e0b; color: white; border: none; border-radius: 8px; font-size: 13px; cursor: pointer; margin-right: 6px; }
        .btn-on { padding: 8px 16px; background: #6366f1; color: white; border: none; border-radius: 8px; font-size: 14px; cursor: pointer; }
        .btn-at { padding: 8px 16px; background: #8b5cf6; color: white; border: none; border-radius: 8px; font-size: 14px; cursor: pointer; }
        .result-area { margin-top: 12px; padding: 12px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; }
        .result-text { font-size: 16px; color: #166534; margin: 0 0 4px 0; font-weight: 600; }
        .result-count { font-size: 13px; color: #6b7280; margin: 0; }
        .store-info { font-size: 12px; color: #f59e0b; margin: 4px 0 0 0; }
        .btn-reset { padding: 8px 16px; background: #f3f4f6; border: 1px solid #d4d4d8; border-radius: 8px; font-size: 14px; cursor: pointer; color: #374151; margin-top: 12px; }
    }
}
