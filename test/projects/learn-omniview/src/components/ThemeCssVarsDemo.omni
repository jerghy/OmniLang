// ╔══════════════════════════════════════════════════════════════════╗
// ║  ThemeCssVarsDemo.omni — CSS 变量主题化实战                       ║
// ║                                                                  ║
// ║  演示：                                                          ║
// ║    - CSS 变量级联：父元素设 --*，子元素用 var() 继承              ║
// ║    - 与设计块主题系统联动：theme 切换自动更新 CSS 变量            ║
// ║    - 运行时交互：scale / border-width 本地信号驱动                 ║
// ║                                                                  ║
// ║  CSS 变量来源：                                                  ║
// ║    --surface, --textPrimary 等由 design.omni 的 @themes 声明      ║
// ║    自动生成 :root { --surface } / [data-theme="dark"] { --surface } ║
// ║    主题切换经 data-theme 属性自动生效                              ║
// ╚══════════════════════════════════════════════════════════════════╝

import omniview;
import { ThemeStore } from "../stores/ThemeStore";

component ThemeCssVarsDemo {
    @store ThemeStore;

    signal boxScale: f64 = 1.0;
    signal borderWidth: i32 = 2;

    fn toggleScale() {
        if boxScale == 1.0 {
            boxScale = 1.05;
        } else {
            boxScale = 1.0;
        }
    }
    fn toggleBorder() {
        if borderWidth == 2 {
            borderWidth = 4;
        } else {
            borderWidth = 2;
        }
    }

    view {
        <div class: Wrapper>
            <h3 class: SectionHeader>Theme with CSS Variables</h3>
            <p class: subtitle>
                设计块主题系统自动生成 <code>--surface</code>、<code>--textPrimary</code>
                等 CSS 变量，子元素用 <code>var()</code> 继承。<code>[data-theme]</code>
                切换时自动更新，无需手动 <code>setProperty()</code>。
            </p>

            <!--
                核心：CSS 变量来自 design.omni 中 @themes 声明的主题令牌，
                由编译器生成到 :root 和 [data-theme="dark"] 选择器内。
                --theme-scale 和 --theme-border-w 是本地交互信号。
            -->
            <div class: ThemeRoot
                style: {
                    --theme-scale: boxScale,
                    --theme-border-w: borderWidth
                }
            >
                <!-- 卡片 1: 基本主题变量继承 -->
                <div class: themed-card>
                    <h4 class: CardTitle>CSS Variable Cascading</h4>
                    <p class: CardDesc>
                        background、color、border-color 均通过 <code>var(--*)</code>
                        从设计系统继承。主题切换时所有卡片同步变化。
                    </p>
                    <div class: StatRow>
                        <span class: StatBadge>BG: var(--surface)</span>
                        <span class: StatBadge>TX: var(--textPrimary)</span>
                        <span class: StatBadge>PR: var(--primary)</span>
                    </div>
                </div>

                <!-- 卡片 2: var() 与 calc() 组合 -->
                <div class: themed-card accent>
                    <h4 class: CardTitle>Composition with calc()</h4>
                    <p class: CardDesc>
                        <code>calc(var(--theme-border-w) * 2px)</code> 动态计算边框宽度。
                        点击按钮切换 <code>--theme-border-w</code> 值。
                    </p>
                    <button class: VarActionBtn @onPress={toggleBorder}>
                        Toggle Border Width ({borderWidth}px → {if borderWidth == 2 { 4 } else { 2 }}px)
                    </button>
                </div>

                <!-- 卡片 3: var() 与 transform 组合 -->
                <div class: themed-card interactive>
                    <h4 class: CardTitle>Transform via CSS Variable</h4>
                    <p class: CardDesc>
                        <code>transform: scale(var(--theme-scale))</code>。
                        信号 <code>boxScale</code> 以 style: 绑定驱动该 CSS 变量。
                    </p>
                    <button class: VarActionBtn @onPress={toggleScale}>
                        Toggle Scale ({boxScale})
                    </button>
                </div>

                <!-- 卡片 4: 主题色预览色板 -->
                <div class: PaletteSection>
                    <h4 class: CardTitle>Theme Palette via var()</h4>
                    <div class: PaletteGrid>
                        <div class: PaletteChip style: { background: "var(--surface)", border: "2px solid var(--border)" }>
                            <span class: ChipLabel style: { color: "var(--textPrimary)" }>--surface</span>
                        </div>
                        <div class: PaletteChip style: { background: "var(--primary)" }>
                            <span class: ChipLabel style: { color: "white" }>--primary</span>
                        </div>
                        <div class: PaletteChip style: { background: "var(--textPrimary)" }>
                            <span class: ChipLabel style: { color: "var(--surface)" }>--textPrimary</span>
                        </div>
                        <div class: PaletteChip style: { background: "var(--surfaceMuted)", border: "1px solid var(--border)" }>
                            <span class: ChipLabel style: { color: "var(--textPrimary)" }>--surfaceMuted</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 切换按钮（在 CSS 变量作用域之外） -->
            <div class: ActionRow>
                <button class: ToggleBtn @onPress={() => { ThemeStore.toggle(); }}>
                    Toggle Theme (light → dark → sepia → highContrast)
                </button>
                <p class: hint>
                    Current: {ThemeStore.modeLabel} ·
                    Toggles: {ThemeStore.toggleCount} ·
                    <code>@themes { light, dark, sepia, highContrast }</code>
                </p>
            </div>

            <!-- 技术说明 -->
            <div class: TechNote>
                <h4 class: NoteTitle>Key Design Patterns</h4>
                <p>Design block theme system: @themes + per-token theme values. CSS generated automatically.</p>
            </div>
        </div>
    }

    style {
        code {
            background: var(--surfaceMuted);
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 12px;
        }
        // Design token CSS variables (from design.omni @themes)
        .themed-card {
            background: var(--surface);
            color: var(--textPrimary);
            border: calc(var(--theme-border-w, 2) * 1px) solid var(--border);
            border-radius: var(--cardRadius);
            padding: 16px;
            transition: transform 200ms ease;
            transform: scale(var(--theme-scale, 1));
        }
        .themed-card.accent {
            border-color: var(--primary);
        }
        .themed-card.interactive {
            border-style: dashed;
        }
        // Palette
        // Actions
        // Tech note
        .NoteList li {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 4px;
            line-height: 1.5;
        }
    
        .subtitle {
            font-size: 13px;
            color: var(--textSecondary);
            margin: 0 0 16px 0;
        }
        .hint {
            font-size: 12px;
            color: var(--textSecondary);
            margin: 0;
        }
    }
}
