// ╔══════════════════════════════════════════════════════════════════╗
// ║  ThemeCssVarsDemo.omni — CSS 变量主题化实战                       ║
// ║                                                                  ║
// ║  演示：                                                          ║
// ║    - CSS 变量级联：父元素设 --*，子元素用 var() 继承              ║
// ║    - 与 ThemeStore 联动：动态信号驱动 CSS 变量                    ║
// ║    - 运行时主题切换：setProperty() 响应式更新                     ║
// ║                                                                  ║
// ║  编译器代码路径：                                                 ║
// ║    style: { --bg: ThemeStore.currentBg }                          ║
// ║    → __omni_effect(() => el.style.setProperty("--bg", ...))       ║
// ╚══════════════════════════════════════════════════════════════════╝

import omniview;
import { ThemeStore } from "../stores/ThemeStore";

component ThemeCssVarsDemo {
    @store ThemeStore;

    signal boxScale: f64 = 1.0;
    signal borderWidth: i32 = 2;

    fn toggleScale() {
        if boxScale == 1.0 {
            boxScale = 1.05;
        } else {
            boxScale = 1.0;
        }
    }
    fn toggleBorder() {
        if borderWidth == 2 {
            borderWidth = 4;
        } else {
            borderWidth = 2;
        }
    }

    view {
        <div class: wrapper>
            <h3 class: section-title>Theme with CSS Variables</h3>
            <p class: subtitle>
                父元素注入 <code>--theme-*</code> CSS 变量（来自 ThemeStore 信号），
                子元素用 <code>var()</code> 继承。切换主题时触发 <code>setProperty()</code> 响应式更新。
            </p>

            <!--
                核心：外层 div 通过内联动态样式注入 CSS 变量。
                所有内层元素用 var() 引用这些变量，无需逐层传递。
                编译器为每个 --* 信号引用生成独立的 setProperty() 效果。
            -->
            <div class: theme-root
                style: {
                    --theme-bg: ThemeStore.currentBg,
                    --theme-text: ThemeStore.currentText,
                    --theme-primary: ThemeStore.currentPrimary,
                    --theme-border: ThemeStore.currentBorder,
                    --theme-muted: ThemeStore.currentMuted,
                    --theme-scale: boxScale,
                    --theme-border-w: borderWidth
                }
            >
                <!-- 卡片 1: 基本主题变量继承 -->
                <div class: themed-card>
                    <h4 class: card-title>CSS Variable Cascading</h4>
                    <p class: card-desc>
                        background、color、border-color 均通过 <code>var(--theme-*)</code>
                        从父级继承。主题切换时所有卡片同步变化。
                    </p>
                    <div class: stat-row>
                        <span class: stat-badge>BG: var(--theme-bg)</span>
                        <span class: stat-badge>TX: var(--theme-text)</span>
                        <span class: stat-badge>PR: var(--theme-primary)</span>
                    </div>
                </div>

                <!-- 卡片 2: var() 与 calc() 组合 -->
                <div class: themed-card accent>
                    <h4 class: card-title>Composition with calc()</h4>
                    <p class: card-desc>
                        <code>calc(var(--theme-border-w) * 2px)</code> 动态计算边框宽度。
                        点击按钮切换 <code>--theme-border-w</code> 值。
                    </p>
                    <button class: var-action-btn @onPress={toggleBorder}>
                        Toggle Border Width ({borderWidth}px → {if borderWidth == 2 { 4 } else { 2 }}px)
                    </button>
                </div>

                <!-- 卡片 3: var() 与 transform 组合 -->
                <div class: themed-card interactive>
                    <h4 class: card-title>Transform via CSS Variable</h4>
                    <p class: card-desc>
                        <code>transform: scale(var(--theme-scale))</code>。
                        信号值通过 <code>setProperty("--theme-scale", boxScale.value)</code> 驱动。
                    </p>
                    <button class: var-action-btn @onPress={toggleScale}>
                        Toggle Scale ({boxScale})
                    </button>
                </div>

                <!-- 卡片 4: 主题色预览色板 -->
                <div class: palette-section>
                    <h4 class: card-title>Theme Palette via var()</h4>
                    <div class: palette-grid>
                        <div class: palette-chip style: { background: "var(--theme-bg)", border: "2px solid var(--theme-border)" }>
                            <span class: chip-label style: { color: "var(--theme-text)" }>--theme-bg</span>
                        </div>
                        <div class: palette-chip style: { background: "var(--theme-primary)" }>
                            <span class: chip-label style: { color: "white" }>--theme-primary</span>
                        </div>
                        <div class: palette-chip style: { background: "var(--theme-text)" }>
                            <span class: chip-label style: { color: "var(--theme-bg)" }>--theme-text</span>
                        </div>
                        <div class: palette-chip style: { background: "var(--theme-muted)", border: "1px solid var(--theme-border)" }>
                            <span class: chip-label style: { color: "var(--theme-text)" }>--theme-muted</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 切换按钮（在 CSS 变量作用域之外） -->
            <div class: action-row>
                <button class: toggle-btn @onPress={() => { ThemeStore.toggle(); }}>
                    Switch to {ThemeStore.nextLabel} Mode
                </button>
                <p class: hint>
                    当前主题: <strong>{ThemeStore.modeLabel}</strong> ·
                    切换次数: {ThemeStore.toggleCount} ·
                    代码路径: <code>setProperty()</code>
                </p>
            </div>

            <!-- 技术说明 -->
            <div class: tech-note>
                <h4 class: note-title>💡 关键设计模式</h4>
                <ul class: note-list>
                    <li>CSS 变量级联：在组件根元素一次性注入 <code>--theme-*</code>，所有子元素用 <code>var()</code> 自动继承</li>
                    <li>信号 → setProperty：编译器为 <code>style: &#123; --var: signal &#125;</code> 生成 <code>__omni_effect(() => el.style.setProperty("--var", signal.value))</code></li>
                    <li>主题切换只需更新 <code>ThemeStore</code> 的 getter，CSS 变量自动响应</li>
                    <li>对比 ThemeSwitcher：后者每个元素单独绑定 <code>style: &#123; color: ThemeStore.currentText &#125;</code>，CSS 变量版只需在根元素设一次</li>
                </ul>
            </div>
        </div>
    }

    style {
        .wrapper {
            --card-radius: 12px;
            --action-h: 48px;
        }

        .wrapper {
            background: white;
            border: 1px solid #d4d4d8;
            border-radius: var(--card-radius);
            padding: 20px;
            margin: 16px 0;
        }

        .section-title {
            font-size: 18px;
            color: #1e293b;
            margin: 0 0 4px 0;
        }
        .subtitle {
            font-size: 13px;
            color: #64748b;
            margin: 0 0 16px 0;
        }
        code {
            background: #f1f5f9;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 12px;
        }

        // ═══ CSS 变量主题根：所有 --theme-* 由父元素注入 ═══
        .theme-root {
            // 这里不设 --theme-* 值，由内联 style: 动态注入
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        // ═══ 子元素用 var() 引用父级定义的 --theme-* ═══
        .themed-card {
            background: var(--theme-bg);
            color: var(--theme-text);
            border: calc(var(--theme-border-w, 2) * 1px) solid var(--theme-border);
            border-radius: var(--card-radius);
            padding: 16px;
            transition: transform 200ms ease;
            transform: scale(var(--theme-scale, 1));
        }
        .themed-card.accent {
            border-color: var(--theme-primary);
        }
        .themed-card.interactive {
            border-style: dashed;
        }

        .card-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--theme-primary);
            margin: 0 0 6px 0;
        }
        .card-desc {
            font-size: 12px;
            color: var(--theme-text);
            margin: 0 0 10px 0;
            opacity: 0.8;
            line-height: 1.5;
        }

        .stat-row {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }
        .stat-badge {
            font-size: 11px;
            padding: 3px 8px;
            background: var(--theme-muted);
            color: var(--theme-text);
            border-radius: 4px;
            font-family: monospace;
        }

        .var-action-btn {
            padding: 8px 16px;
            background: var(--theme-primary);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            cursor: pointer;
        }
        .var-action-btn:hover {
            filter: brightness(1.1);
        }

        // Palette
        .palette-section {
            background: var(--theme-bg);
            border: 1px solid var(--theme-border);
            border-radius: var(--card-radius);
            padding: 14px;
        }
        .palette-grid {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .palette-chip {
            padding: 12px 16px;
            border-radius: 8px;
            flex: 1;
            min-width: 100px;
            text-align: center;
        }
        .chip-label {
            font-size: 11px;
            font-weight: 600;
            font-family: monospace;
        }

        // Actions
        .action-row {
            margin-top: 14px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .toggle-btn {
            height: var(--action-h);
            padding: 0 20px;
            background: #6366f1;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
        }
        .toggle-btn:hover {
            background: #4f46e5;
        }
        .hint {
            font-size: 12px;
            color: #64748b;
            margin: 0;
        }

        // Tech note
        .tech-note {
            background: #0f172a;
            border-radius: 8px;
            padding: 14px 18px;
            margin-top: 16px;
        }
        .note-title {
            font-size: 14px;
            color: #e2e8f0;
            margin: 0 0 8px 0;
        }
        .note-list {
            margin: 0;
            padding-left: 18px;
        }
        .note-list li {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 4px;
            line-height: 1.5;
        }
    }
}
