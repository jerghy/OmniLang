// ╔══════════════════════════════════════════════════════════════════╗
// ║  CssVarsDemo.omni — CSS 自定义属性（CSS 变量）全覆盖              ║
// ║                                                                  ║
// ║  演示编译器新增的 4 种 CSS 变量用法：                              ║
// ║    1. Style 块中声明 --* 属性                                     ║
// ║    2. Style 块中使用 var() 引用                                   ║
// ║    3. 内联样式静态 CSS 变量                                       ║
// ║    4. 内联样式动态 CSS 变量（信号 → setProperty 代码路径）         ║
// ║                                                                  ║
// ║  编译器支持：                                                     ║
// ║    - parse_css_property_name() @ view.rs:1134                    ║
// ║    - emit_style_assignment() @ omniview.rs:692                   ║
// ║    - 测试文件: css_custom_property_test.rs                       ║
// ╚══════════════════════════════════════════════════════════════════╝

import omniview;

// ── @motion: 用于演示动态 CSS 变量变化的过渡效果 ────────────
@motion pulseAccent {
    from { --accent-h: 221 }
    to   { --accent-h: 350 }
    over: 600ms
    easing: ease-in-out
    direction alternate
    loop
}

component CssVarsDemo {
    // 动态 CSS 变量用的信号
    signal accentColor: String = "#6366f1";
    signal accentHue: i32 = 221;
    signal themeMode: String = "light";

    fn cycleAccent() {
        if accentColor == "#6366f1" {
            accentColor = "#ec4899";
        } else if accentColor == "#ec4899" {
            accentColor = "#14b8a6";
        } else {
            accentColor = "#6366f1";
        }
    }

    fn toggleMode() {
        if themeMode == "light" {
            themeMode = "dark";
        } else {
            themeMode = "light";
        }
    }

    view {
        <div class: wrapper>
            <h3 class: section-title>CSS Custom Properties (CSS Variables)</h3>
            <p class: subtitle>
                演示编译器对 <code>--*</code> 声明、<code>var()</code> 引用、内联静态/动态 CSS 变量的完整支持
            </p>

            <!-- ═══ Demo 1: Style 块声明 + var() 引用 ═══ -->
            <div class: demo-card>
                <h4 class: demo-label>① Style 块声明 --* + var() 引用</h4>
                <p class: demo-desc>
                    Style 块内部声明 <code>--primary</code>、<code>--bg</code> 等自定义属性，
                    然后用 <code>var()</code> 引用。这是编译器中 <code>parse_css_property_name()</code>
                    解析 <code>--</code> 前缀的常规路径。
                </p>
                <div class: var-demo-area>
                    <div class: var-card>var(--primary)</div>
                    <div class: var-card alt>var(--primary-alt)</div>
                    <div class: var-card surface>background: var(--surface)</div>
                    <div class: var-card border>border: var(--border-color)</div>
                </div>
            </div>

            <!-- ═══ Demo 2: 内联样式静态 CSS 变量 ═══ -->
            <div class: demo-card>
                <h4 class: demo-label>② 内联样式静态 CSS 变量</h4>
                <p class: demo-desc>
                    在 <code>style: &#123; --name: "value" &#125;</code> 中直接写 <code>--</code> 属性。
                    编译器代码生成将 <code>--</code> 属性用 <code>el.style.setProperty("--name", value)</code>
                    输出，而非普通的 <code>el.style.prop = value</code>。
                </p>
                <div class: inline-static-row>
                    <div class: inline-static-box
                        style: {
                            --box-bg: "#e0e7ff",
                            --box-text: "#3730a3",
                            --box-radius: "8px"
                        }
                    >
                        <code>--box-bg: "#e0e7ff"</code>
                    </div>
                    <div class: inline-static-box
                        style: {
                            --box-bg: "#fce7f3",
                            --box-text: "#9d174d",
                            --box-radius: "16px"
                        }
                    >
                        <code>--box-radius: "16px"</code>
                    </div>
                    <div class: inline-static-box
                        style: {
                            --box-bg: "#d1fae5",
                            --box-text: "#065f46",
                            --box-radius: "50%"
                        }
                    >
                        <code>--box-radius: "50%"</code>
                    </div>
                </div>
            </div>

            <!-- ═══ Demo 3: 内联样式动态 CSS 变量（信号引用） ═══ -->
            <div class: demo-card>
                <h4 class: demo-label>③ 内联样式动态 CSS 变量（信号 → setProperty）</h4>
                <p class: demo-desc>
                    传递<strong>信号引用</strong>给 <code>--*</code> 属性。编译器自动生成
                    <code>__omni_effect(() => el.style.setProperty("--name", signal.value))</code>。
                    这是新增的 <code>$signal</code> JSON 标记代码路径。
                </p>

                <div class: dynamic-area
                    style: {
                        --accent: accentColor,
                        padding: "16px",
                        border: "2px solid " + accentColor
                    }
                >
                    <p class: dynamic-text>
                        当前 accent: <strong>{accentColor}</strong>
                    </p>
                    <div class: dynamic-swatches>
                        <div class: swatch-preview style: { background: accentColor }></div>
                        <div class: swatch-label>{accentColor}</div>
                    </div>
                    <button class: cycle-btn @onPress={cycleAccent}>
                        Cycle Accent Color
                    </button>
                    <p class: code-hint>
                        生成的 JS: <code>setProperty("--accent", accentColor.value)</code>
                    </p>
                </div>
            </div>

            <!-- ═══ Demo 4: CSS 变量 + 动态 hue 实现主题色循环 ═══ -->
            <div class: demo-card>
                <h4 class: demo-label>④ CSS 变量级联 + Motion 驱动</h4>
                <p class: demo-desc>
                    外层设 <code>--accent-h</code>，内层用 <code>var(--accent-h)</code> 计算衍生色。
                    配合 <code>@motion</code> 交替动画驱动 hue 值变化。
                </p>
                <div class: cascade-area
                    style: {
                        --accent-h: accentHue,
                        padding: "16px"
                    }
                >
                    <div class: cascade-box>
                        <p class: cascade-title>
                            hue = <strong>{accentHue}°</strong>
                        </p>
                        <p class: cascade-desc>
                            内层用 <code>var(--accent-h)</code> 通过 CSS <code>hsl()</code> 计算色值
                        </p>
                        <div class: hue-bar>
                            <span class: hue-step style: { background: "hsl(221, 80%, 60%)" }>221°</span>
                            <span class: hue-step style: { background: "hsl(260, 80%, 60%)" }>260°</span>
                            <span class: hue-step style: { background: "hsl(300, 80%, 60%)" }>300°</span>
                            <span class: hue-step style: { background: "hsl(340, 80%, 60%)" }>340°</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 技术说明 -->
            <div class: tech-note>
                <h4 class: note-title>编译器技术要点</h4>
                <ul class: note-list>
                    <li><code>parse_css_property_name()</code> 在 <code>view.rs:1134</code> 检测 <code>--</code> 双短横前缀</li>
                    <li><code>emit_style_assignment()</code> 在 <code>omniview.rs:692</code> 对 <code>--</code> 属性用 <code>setProperty()</code> 而非直接赋值</li>
                    <li>Style 块中 <code>--name: value</code> 以 <code>StyleValue::Ident</code> / <code>HexColor</code> / <code>Dimension</code> 存储在 AST</li>
                    <li>内联 <code>style: &#123; --name: signal &#125;</code> 通过 <code>$signal</code> JSON 标记生成响应式代码</li>
                    <li>测试覆盖：<code>css_custom_property_test.rs</code>（解析 + 静态内联 + 动态内联）</li>
                </ul>
            </div>
        </div>
    }

    style {
        // ═══ CSS 自定义属性声明 + var() 引用 ═══
        .wrapper {
            --primary: #6366f1;
            --primary-alt: #ec4899;
            --surface: #f8fafc;
            --surface-alt: #f1f5f9;
            --border-color: #cbd5e1;
            --text-primary: #1e293b;
            --text-muted: #64748b;
            --radius-sm: 6px;
            --radius-md: 12px;
        }

        .wrapper {
            background: white;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 20px;
            margin: 16px 0;
        }

        .section-title {
            font-size: 18px;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        .subtitle {
            font-size: 13px;
            color: var(--text-muted);
            margin: 0 0 20px 0;
        }
        code {
            background: var(--surface-alt);
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 12px;
        }

        // Demo cards
        .demo-card {
            background: var(--surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 16px;
            margin-bottom: 16px;
        }
        .demo-label {
            font-size: 15px;
            color: var(--text-primary);
            margin: 0 0 6px 0;
        }
        .demo-desc {
            font-size: 13px;
            color: var(--text-muted);
            margin: 0 0 12px 0;
            line-height: 1.5;
        }

        // Demo 1: var-demo-area
        .var-demo-area {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .var-card {
            padding: 12px 18px;
            background: white;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 13px;
            color: var(--text-primary);
        }
        .var-card.alt {
            // 使用 var(--primary-alt) 覆盖边框颜色
            border-color: var(--primary-alt);
            color: var(--primary-alt);
        }
        .var-card.surface {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }
        .var-card.border {
            // 使用 var(--border-color)
            border: 2px solid var(--primary-alt);
            background: white;
        }

        // Demo 2: inline static
        .inline-static-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }
        .inline-static-box {
            padding: 14px 20px;
            // 以下 --box-bg / --box-text / --box-radius 由内联 style: 提供
            background: var(--box-bg, #e0e7ff);
            color: var(--box-text, #3730a3);
            border-radius: var(--box-radius, 8px);
            font-size: 12px;
            font-weight: 600;
            border: 1px solid var(--border-color);
        }

        // Demo 3: dynamic area
        .dynamic-area {
            background: white;
            border-radius: var(--radius-sm);
        }
        .dynamic-text {
            font-size: 14px;
            color: var(--text-primary);
            margin: 0 0 10px 0;
        }
        .dynamic-swatches {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }
        .swatch-preview {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
        }
        .swatch-label {
            font-size: 13px;
            color: var(--text-muted);
            font-family: monospace;
        }
        .cycle-btn {
            padding: 8px 16px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: var(--radius-sm);
            font-size: 13px;
            cursor: pointer;
            margin-bottom: 8px;
        }
        .cycle-btn:hover {
            filter: brightness(1.1);
        }
        .code-hint {
            font-size: 11px;
            color: var(--text-muted);
            margin: 0;
        }
        .code-hint code {
            background: #f1f5f9;
        }

        // Demo 4: cascade
        .cascade-area {
            background: white;
            border-radius: var(--radius-sm);
        }
        .cascade-box {
            // 用 var(--accent-h) 计算衍生色
            background: hsl(var(--accent-h, 221), 70%, 95%);
            border: 2px solid hsl(var(--accent-h, 221), 70%, 75%);
            border-radius: var(--radius-sm);
            padding: 16px;
            text-align: center;
        }
        .cascade-title {
            font-size: 16px;
            color: hsl(var(--accent-h, 221), 50%, 30%);
            margin: 0 0 6px 0;
        }
        .cascade-desc {
            font-size: 12px;
            color: hsl(var(--accent-h, 221), 40%, 45%);
            margin: 0 0 12px 0;
        }
        .hue-bar {
            display: flex;
            gap: 6px;
            justify-content: center;
        }
        .hue-step {
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 11px;
            color: white;
            font-weight: 600;
        }

        // Tech note
        .tech-note {
            background: #0f172a;
            border-radius: var(--radius-sm);
            padding: 14px 18px;
        }
        .note-title {
            font-size: 14px;
            color: #e2e8f0;
            margin: 0 0 8px 0;
        }
        .note-list {
            margin: 0;
            padding-left: 18px;
        }
        .note-list li {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 4px;
            line-height: 1.5;
        }
    }
}
