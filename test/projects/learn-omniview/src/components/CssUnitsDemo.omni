// ╔══════════════════════════════════════════════════════════════╗
// ║  CssUnitsDemo.omni —— CSS 单位全覆盖演示                      ║
// ║  演示：vh, vw, fr, pt, cm, mm, ms, s, deg, rad, grad, turn, ║
// ║        vmin, vmax, svh, svw, lvh, lvw, dvh, dvw,            ║
// ║        cqw, cqh, cqi, cqb, cqmin, cqmax,                    ║
// ║        ch, ex, ic, lh, rlh                                  ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;

component CssUnitsDemo {
    view {
        <div class: container>
            <h3 class: title>CSS 单位全覆盖</h3>
            <p class: subtitle>30 个 CSS 单位（视口/容器/时间/角度/长度维度）</p>

            <div class: grid>
                <div class: box-vh>10vh</div>
                <div class: box-fr>1fr</div>
                <div class: box-pt>12pt</div>
                <div class: box-cm>1cm</div>
                <div class: box-mm>10mm</div>

                <div class: box-ms>150ms</div>
                <div class: box-deg>15deg</div>
                <div class: box-rad>0.5rad</div>
                <div class: box-grad>50grad</div>
                <div class: box-turn>0.25turn</div>

                <div class: box-vmin>5vmin</div>
                <div class: box-svh>5svh</div>
                <div class: box-lvh>5lvh</div>
                <div class: box-dvh>5dvh</div>
                <div class: box-ch>20ch</div>

                <div class: box-ex>10ex</div>
                <div class: box-ic>15ic</div>
                <div class: box-lh>2lh</div>
                <div class: box-cq>10cqw</div>
                <div class: box-cqi>5cqi</div>

                <!-- 视口与容器单位 -->
                <div class: box-s>1s</div>
                <div class: box-vmax>5vmax</div>
                <div class: box-svw>5svw</div>
                <div class: box-lvw>5lvw</div>
                <div class: box-dvw>5dvw</div>
                <div class: box-cqh>5cqh</div>
                <div class: box-cqb>5cqb</div>
                <div class: box-cqmin>5cqmin</div>
                <div class: box-cqmax>5cqmax</div>
                <div class: box-rlh>2rlh</div>
            </div>
        </div>
    }
    style {
        .container { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; container-type: inline-size; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 4px 0; }
        .subtitle { font-size: 13px; color: #9ca3af; margin: 0 0 16px 0; }

        .grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr 1fr; gap: 8px; }

        .box-vh { height: 10vh; background: #fecaca; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-fr { background: #bbf7d0; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-pt { font-size: 12pt; background: #bfdbfe; padding: 8px; border-radius: 6px; text-align: center; }
        .box-cm { width: 1cm; background: #fef08a; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-mm { width: 10mm; background: #ddd6fe; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }

        .box-ms { transition-duration: 150ms; background: #fed7aa; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-deg { transform: rotate(15deg); background: #fbcfe8; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-rad { transform: rotate(0.5rad); background: #a5f3fc; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-grad { transform: rotate(50grad); background: #d9f99d; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-turn { transform: rotate(0.25turn); background: #e9d5ff; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }

        .box-vmin { width: 5vmin; height: 5vmin; background: #fde68a; padding: 4px; font-size: 10px; border-radius: 6px; text-align: center; }
        .box-svh { height: 5svh; background: #cffafe; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-lvh { height: 5lvh; background: #fce7f3; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-dvh { height: 5dvh; background: #d1fae5; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-ch { width: 20ch; background: #e0e7ff; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }

        .box-ex { width: 10ex; background: #fee2e2; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-ic { width: 15ic; background: #dbeafe; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-lh { line-height: 2lh; background: #f3e8ff; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-cq { width: 10cqw; background: #ede9fe; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-cqi { width: 5cqi; height: 5cqb; background: #ffedd5; padding: 4px; font-size: 10px; border-radius: 6px; text-align: center; }

        /* ─── 视口与容器单位 ─── */
        .box-s { animation-duration: 1s; background: #fecdd3; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-vmax { width: 5vmax; height: 5vmax; background: #a7f3d0; padding: 4px; font-size: 10px; border-radius: 6px; text-align: center; }
        .box-svw { width: 5svw; background: #c7d2fe; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-lvw { width: 5lvw; background: #fde68a; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-dvw { width: 5dvw; background: #ddd6fe; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-cqh { height: 5cqh; background: #fbcfe8; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-cqb { height: 5cqb; background: #a5f3fc; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
        .box-cqmin { width: 5cqmin; height: 5cqmin; background: #fed7aa; padding: 4px; font-size: 10px; border-radius: 6px; text-align: center; }
        .box-cqmax { width: 5cqmax; height: 5cqmax; background: #d9f99d; padding: 4px; font-size: 10px; border-radius: 6px; text-align: center; }
        .box-rlh { line-height: 2rlh; background: #f3e8ff; padding: 8px; font-size: 12px; border-radius: 6px; text-align: center; }
    }
}
