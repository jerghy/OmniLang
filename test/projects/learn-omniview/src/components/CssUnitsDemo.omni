// ╔══════════════════════════════════════════════════════════════╗
// ║  CssUnitsDemo.omni —— CSS 单位全覆盖演示                      ║
// ║  演示：vh, vw, fr, pt, cm, mm, ms, s, deg, rad, grad, turn, ║
// ║        vmin, vmax, svh, svw, lvh, lvw, dvh, dvw,            ║
// ║        cqw, cqh, cqi, cqb, cqmin, cqmax,                    ║
// ║        ch, ex, ic, lh, rlh                                  ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;

component CssUnitsDemo {
    view {
        <div class: Container>
            <h3 class: Title>CSS 单位全覆盖</h3>
            <p class: Subtitle>30 个 CSS 单位（视口/容器/时间/角度/长度维度）</p>

            <div class: Grid>
                <div class: BoxVh>10vh</div>
                <div class: BoxFr>1fr</div>
                <div class: BoxPt>12pt</div>
                <div class: BoxCm>1cm</div>
                <div class: BoxMm>10mm</div>

                <div class: BoxMs>150ms</div>
                <div class: BoxDeg>15deg</div>
                <div class: BoxRad>0.5rad</div>
                <div class: BoxGrad>50grad</div>
                <div class: BoxTurn>0.25turn</div>

                <div class: BoxVmin>5vmin</div>
                <div class: BoxSvh>5svh</div>
                <div class: BoxLvh>5lvh</div>
                <div class: BoxDvh>5dvh</div>
                <div class: BoxCh>20ch</div>

                <div class: BoxEx>10ex</div>
                <div class: BoxIc>15ic</div>
                <div class: BoxLh>2lh</div>
                <div class: BoxCq>10cqw</div>
                <div class: BoxCqi>5cqi</div>

                <!-- 视口与容器单位 -->
                <div class: BoxS>1s</div>
                <div class: BoxVmax>5vmax</div>
                <div class: BoxSvw>5svw</div>
                <div class: BoxLvw>5lvw</div>
                <div class: BoxDvw>5dvw</div>
                <div class: BoxCqh>5cqh</div>
                <div class: BoxCqb>5cqb</div>
                <div class: BoxCqmin>5cqmin</div>
                <div class: BoxCqmax>5cqmax</div>
                <div class: BoxRlh>2rlh</div>
            </div>
        </div>
    }
    style {
        /* ─── 视口与容器单位 ─── */
    }
}
