// TabPanel.omni - custom tags (Card, Button, Flex, Text), class: map, inline style:

import omniview;
import { LearnDesign } from "../design";

component TabPanel {
    signal activeTab: String = "home";

    // computed signal: automatically tracks activeTab dependency
    // Returns a color string based on the currently active tab
    computed activeStyle: String = if activeTab == "home" {
        "#6366f1"
    } else if activeTab == "about" {
        "#10b981"
    } else {
        "#f59e0b"
    };

    fn switchTo(tab: String) {
        activeTab = tab;
    }

    fn isActive(tab: String) -> bool {
        return activeTab == tab;
    }

    view {
        <div class: LearnDesign.Card>
            <div class: tab-bar>
                <button
                    variant: LearnDesign.Button(color=primary, size=sm)
                    class: { active: isActive("home") }
                    @onPress={() => { switchTo("home"); }}
                >Home</button>
                <button
                    variant: LearnDesign.Button(color=primary, size=sm)
                    class: { active: isActive("about") }
                    @onPress={() => { switchTo("about"); }}
                >About</button>
                <button
                    variant: LearnDesign.Button(color=primary, size=sm)
                    class: { active: isActive("settings") }
                    @onPress={() => { switchTo("settings"); }}
                >Settings</button>
            </div>

            @if activeTab == "home" {
                <div class: LearnDesign.Card style: { borderLeft: "5px solid " + activeStyle }>
                    <h3 class: card-title>Home Tab</h3>
                    <div class: row>
                        <span>Custom tags: Card, Button, Flex, Text</span>
                    </div>
                    <p class: text>class: map syntax demo on buttons above</p>
                </div>
            }
            @else if activeTab == "about" {
                <div class: LearnDesign.Card style: { borderLeft: "5px solid " + activeStyle }>
                    <h3 class: card-title>About Tab</h3>
                    <p class: text>Custom tag mapping: Card to div, Button to button</p>
                    <p class: text>Inline style: syntax on Button elements</p>
                </div>
            }
            @else if activeTab == "settings" {
                <div class: LearnDesign.Card style: { borderLeft: "5px solid " + activeStyle }>
                    <h3 class: card-title>Settings Tab</h3>
                    <p class: text>Active tab: {activeTab}</p>
                </div>
            }
            @else {
                <div class: LearnDesign.Card style: { borderLeft: "5px solid " + activeStyle }>
                    <p class: text>Unknown tab</p>
                </div>
            }
        </div>
    }
    style {
        // 标签面板特有的内部布局
        .tab-bar { display: flex; gap: 8px; margin-bottom: 16px; }
        .active { background: #6366f1; color: white; }
        .card-title { font-size: 18px; color: #222; margin-bottom: 8px; }
        .row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
        .text { font-size: 14px; color: #666; margin: 4px 0; }
        // .tab-panel / .card 已由 LearnDesign.Card 提供
    }
}
