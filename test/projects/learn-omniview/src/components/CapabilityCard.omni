// CapabilityCard.omni -- reusable capability domain card

import omniview;

component CapabilityCard {
    prop icon: String = "\u{1F527}";
    prop title: String = "";
    prop description: String = "";
    prop tabName: String = "";
    event onNavigate: String;

    view {
        <div class: CapabilityCard @onPress={() => { onNavigate(tabName); }}>
            <span class: CardIcon>{icon}</span>
            <h3 class: CardTitle>{title}</h3>
            <p class: CardDesc>{description}</p>
            <span class: CardLink>Explore →</span>
        </div>
    }

    style {
    }
}
