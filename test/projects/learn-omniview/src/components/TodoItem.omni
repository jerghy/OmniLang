import omniview;

component TodoItem {
  prop id: i32 = 0;
  prop text: String = "";
  // 自定义事件——携带待办 id，由父组件中继到 Store
  event onDelete: i32;

  view {
    <div class: TodoItem>
      <span class: TodoText>{text}</span>
      <button class: DeleteBtn @onPress={() => { onDelete(id); }}>✕</button>
    </div>
  }
  style {
  }
}