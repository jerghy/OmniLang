import omniview;
import { LearnDesign } from "../design";

struct Point { x: i32, y: i32, }
struct StatisticsData { name: String, count: i32, percentage: f64, active: bool, }

component FeatureCard {
    signal status: String = "idle";
    signal focusCount: i32 = 0;

    fn getOriginX() -> i32 {
        let p = Point { x: 0, y: 0 };
        return p.x;
    }

    fn getStats() -> StatisticsData {
        return StatisticsData { name: "demo", count: focusCount, percentage: 75.5, active: true, };
    }

    fn handleFocus() {
        focusCount = focusCount + 1;
        status = "focused";
    }

    fn handleBlur() {
        status = "blurred";
    }

    fn reset() {
        focusCount = 0;
        status = "idle";
    }

    view {
        <div class: LearnDesign.Card>
            <h3 class: LearnDesign.CardTitle>FeatureCard Demo</h3>
            <input class: input placeholder="Click" @onFocus={handleFocus} @onBlur={handleBlur}></input>
            @if status == "focused" {
                <span class: badge-focused>Focused</span>
            }
            @else if status == "blurred" {
                <span class: badge-blurred>Blurred</span>
            }
            @else if status == "idle" {
                <span class: badge-idle>Idle</span>
            }
            @else {
                <span class: badge-unknown>Unknown</span>
            }
            <p class: text>X: {getOriginX()} | Focus: {focusCount}</p>
            <button variant: LearnDesign.Button(color=ghost, size=md) @onPress={reset}>Reset</button>
        </div>
    }
    style {
        // 状态徽章颜色（组件特有的语义色——保留在组件级）
        .badge-focused { font-size: 14px; padding: 4px 12px; border-radius: 12px; background: #dbf0ff; color: #1d40d0; }
        .badge-blurred { font-size: 14px; padding: 4px 12px; border-radius: 12px; background: #f3f4f6; color: #6b7280; }
        .badge-idle { font-size: 14px; padding: 4px 12px; border-radius: 12px; background: #fdf0c0; color: #924000; }
        .badge-unknown { font-size: 14px; padding: 4px 12px; border-radius: 12px; background: #fddddd; color: #dc2626; }
        .text { font-size: 14px; color: #6b7280; margin: 4px 0; }
        .input { padding: 12px; border: 2px solid #d4d4d8; border-radius: 8px; font-size: 16px; margin-bottom: 12px; width: 100%; box-sizing: border-box; }
        // .card / .title / .btn-reset 已由 LearnDesign.Card / CardTitle / Button 变体提供
    }
}
