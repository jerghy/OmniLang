// ╔══════════════════════════════════════════════════════════════╗
// ║  AddTodo.omni —— 输入绑定 + 生命周期 + 自定义事件               ║
// ║  演示：signal, computed, bind:value, @onPress,                ║
// ║        @mount, @effect, event                                ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
import { console_log, console_warn, console_error } from "std/console";

component AddTodo {
    // 自定义事件——子→父通信，携带输入文本
    event onAdd: String;

    // 局部响应式状态
    signal input: String = "";

    // 计算属性——纯函数，依赖自动追踪
    computed hint: String = if input == "" {
        "输入待办事项"
    } else {
        "已输入 " + input.len().to_string() + " 字符"
    };

    // @mount —— 组件挂载后执行一次
    @mount {
        console_log("AddTodo mounted");
    }

    // @effect —— 依赖变化时执行（在 DOM 更新后）
    @effect(input) {
        if input.len() > 20 {
            println("输入较长：" + input.len().to_string() + " 字符");
        }
    }

    fn handleAdd() {
        if input != "" {
            // emit event → 父组件接收
            onAdd(input);
            input = "";
        } else {
            console_warn("Input is empty");
        }
    }

    view {
        <div class: container>
            <div class: row>
                <input bind:value={input} placeholder={hint} class: input />
                <button variant: LearnDesign.Button(color=primary, size=md) @onPress={handleAdd}>添加</button>
                <button variant: LearnDesign.Button(color=danger, size=md) @onPress={() => { input = ""; }}>清空</button>
            </div>
            <p class: LearnDesign.Hint>已输入 {input.len()} 字符</p>
        </div>
    }
    style {
        // 组件特有的输入框布局（非通用模式，保留在组件级）
        .container { padding: 0 16px 16px 16px; }
        .row { display: flex; gap: 8px; }
        .input { flex: 1; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 16px; outline: none; }
        .input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px #a5b4fc; }
        // .btn-add / .btn-clear / .counter 已由 LearnDesign.Button 变体 / Hint 类提供
    }
}
