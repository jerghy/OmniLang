// ╔══════════════════════════════════════════════════════════════╗
// ║  Counter.omni —— signal + computed + 内联回调                   ║
// ║  演示：signal 修改、computed 派生计算、                           ║
// ║        @onPress 内联回调 () => { }、局部 fn                     ║
// ║  按钮使用 LearnDesign.Button 变体（Design 为第一公民）            ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";

component Counter {
    signal count: i32 = 0;
    signal step: i32 = 1;

    // computed 纯计算属性——命名用名词或形容词
    computed doubled: i32 = count * 2;
    computed label: String = if count % 2 == 0 { "偶数" } else { "奇数" };

    fn inc() { count = count + step; }
    fn dec() { count = count - step; }
    fn reset() { count = 0; }

    view {
        <div class: box>
            <h3 class: title>计数器演示</h3>
            <p class: big-number>{count}</p>
            <p class: info>翻倍：{doubled} | {label}</p>
            <div class: row>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={dec}>-</button>
                <span class: step-text>步长 {step}</span>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={inc}>+</button>
            </div>
            <div class: row>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={() => { step = 1; }}>步长1</button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={() => { step = 5; }}>步长5</button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={() => { step = 10; }}>步长10</button>
                <button variant: LearnDesign.Button(color=danger, size=sm) @onPress={reset}>重置</button>
            </div>
        </div>
    }
    style {
        // 组件特有的布局样式（非通用，保留在组件级）
        .box { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px 16px; margin: 16px 0; text-align: center; min-height: 30vh; }
        .title { font-size: 18px; margin: 0 0 12px 0; color: #1f2937; }
        .big-number { font-size: 48px; font-weight: bold; color: #6366f1; margin: 8px 0; }
        .info { font-size: 14px; color: #6b7280; }
        .row { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 12px; }
        .step-text { font-size: 14px; color: #6b7280; }
        // 按钮样式已全部由 LearnDesign.Button 变体提供
    }
}
