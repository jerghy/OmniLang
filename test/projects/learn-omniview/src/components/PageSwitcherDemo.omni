// PageSwitcherDemo.omni — Task 3.9: 顶层互斥 @if（组件级页面切换形态）→ IndexedStack
// 组件根部的 @if/@else 分支全部是组件实例（页面切换形态）时，Flutter 目标发射
// IndexedStack——切标签页时所有页面保持挂载，表单输入/滚动位置不丢失
//（旧的 `cond ? child : SizedBox()` 三元互斥每次切换都会卸载前页）。

import omniview;

component HomePage {
    event onSwitch: String;
    signal draft: String = "";

    view {
        <div class: DemoPage>
            <h3>Home Page</h3>
            <input
                class: Field
                placeholder="Home draft"
                bind:value={draft}
                a11y: { label: "Home draft input" }
            ></input>
            <button @onPress={() => { onSwitch("about"); }}>Go to About</button>
        </div>
    }
    style {
    }
}

component AboutPage {
    event onSwitch: String;
    signal draft: String = "";

    view {
        <div class: DemoPage>
            <h3>About Page</h3>
            <input
                class: Field
                placeholder="About draft"
                bind:value={draft}
                a11y: { label: "About draft input" }
            ></input>
            <button @onPress={() => { onSwitch("home"); }}>Back to Home</button>
        </div>
    }
    style {
    }
}

component PageSwitcherDemo {
    signal page: String = "home";

    fn switchTo(p: String) { page = p; }

    view {
        @if page == "home" {
            <HomePage @onSwitch={switchTo} />
        }
        @else {
            <AboutPage @onSwitch={switchTo} />
        }
    }
}
