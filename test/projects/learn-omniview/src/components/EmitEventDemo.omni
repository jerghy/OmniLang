// ╔══════════════════════════════════════════════════════════════════════╗
// ║  EmitEventDemo — 父子组件事件流演示                                ║
// ║                                                                    ║
// ║  · event 声明（含返回值类型）                                       ║
// ║  · event? 可选事件（nullable event）                               ║
// ║  · 父组件 @onEvent 绑定 + 参数流转                                  ║
// ║  · emit 语句与函数调用两种触发语法（见 EmitKeywordDemo）           ║
// ╚══════════════════════════════════════════════════════════════════════╝
import omniview;
import { LearnDesign } from "../design";

// ── EmitEventChild：事件来源子组件 ─────────────────────────
component EmitEventChild {
    prop label: String = "Child";
    event onAction: String;
    event onOptionalAck: String?;
    event onCount: i32;

    signal clickCount: i32 = 0;

    fn doAction() {
        clickCount = clickCount + 1;
        // 直接调用事件处理函数（等价于 emit onAction(...)）
        onAction(label + " #" + clickCount.to_string());
        // 可选事件：如果绑定则触发
        if onOptionalAck != null {
            onOptionalAck("ack for " + clickCount.to_string());
        }
    }

    fn incrementParent() {
        onCount(clickCount);
    }

    view {
        <div class: ChildBox>
            <strong>{label}</strong>
            <p>Clicks: {clickCount}</p>
            <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={doAction}>Send Action</button>
            <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={incrementParent}>Send Count</button>
        </div>
    }

    style {
        // 子组件特有的浅紫背景和布局
        .ChildBox strong { font-size: 13px; color: #4338ca; display: block; margin-bottom: 4px; }
        .ChildBox p { font-size: 12px; color: #6b7280; margin: 0 0 8px 0; }
    }
}

// ── 父组件：事件消费者 ─────────────────────────────────────
component EmitEventDemo {
    signal messages: Array<String> = [];
    signal totalCount: i32 = 0;

    fn onChildAction(msg: String) {
        totalCount = totalCount + 1;
        messages.push(totalCount.to_string() + ": " + msg);
    }

    fn onOptionalAck(msg: String) {
        messages.push("[ACK] " + msg);
    }

    fn onChildCount(n: i32) {
        totalCount = totalCount + n;
        messages.push("[COUNT] += " + n.to_string() + ", total=" + totalCount.to_string());
    }

    fn clearLog() { messages = []; totalCount = 0; }

    view {
        <div class: LearnDesign.Card>
            <h3 class: LearnDesign.CardTitle>事件流演示</h3>
            <p class: LearnDesign.Hint>event 声明 · @onAction 绑定 · 可选事件 event? · 父→子→父回调链</p>

            <div class: EventGrid>
                <EmitEventChild
                    label="Sender A"
                    @onAction={onChildAction}
                    @onOptionalAck={onOptionalAck}
                    @onCount={onChildCount}
                />
                <EmitEventChild
                    label="Sender B"
                    @onAction={onChildAction}
                    @onCount={onChildCount}
                />
            </div>

            <div class: LogSection>
                <div class: LogHeader>
                    <strong>Event Log（{messages.len().to_string()} entries）</strong>
                    <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={clearLog}>Clear</button>
                </div>
                <div class: LogList>
                    @for msg in messages {
                        <p class: LogEntry>{msg}</p>
                    }
                    @empty {
                        <p class: LearnDesign.Hint>No events yet — click buttons above</p>
                    }
                </div>
            </div>
        </div>
    }

    style {
        // 事件日志特有的结构和布局
        .LogHeader strong { font-size: 13px; color: #374151; }
        // .container / .title / .subtitle / .clear-btn / .empty-hint
        // 已由 LearnDesign.Card / CardTitle / Hint / Button 变体提供
    }
}
