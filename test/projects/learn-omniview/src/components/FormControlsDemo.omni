// ╔══════════════════════════════════════════════════════════════╗
// ║  FormControlsDemo.omni —— HTML 表单控件                          ║
// ║  容器使用 LearnDesign.Card，section 使用组件特有样式                ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";

component FormControlsDemo {
    signal selected: String = "option2";
    signal agreed: bool = false;
    signal age: i32 = 25;
    signal rangeVal: i32 = 50;
    signal linkClicked: i32 = 0;
    signal statusText: String = "";

    fn handleSelect() {
        statusText = "Selected: " + selected;
    }

    fn handleAgree() {
        agreed = !agreed;
        statusText = if agreed { "Agreed ✓" } else { "Not agreed" };
    }

    fn handleAgeChange() {
        statusText = "Age set to: " + age.to_string();
    }

    fn handleRangeChange() {
        statusText = "Range: " + rangeVal.to_string();
    }

    fn handleLinkClick() {
        linkClicked = linkClicked + 1;
        statusText = "Link clicked " + linkClicked.to_string() + " times";
    }

    view {
        <div class: LearnDesign.Card>
            <h3 class: Title>Form Controls Demo</h3>
            <p class: LearnDesign.Hint>a-tag · select · checkbox · range · number</p>

            <!-- <a> 标签 + href + title + target 属性 -->
            <div class: SectionBox>
                <p class: SectionHeader>a-tag link with href / title / target:</p>
                <a href="#" title="Demo link — click to count" class: DemoLink @onPress={handleLinkClick}>
                    Click me ({linkClicked})
                </a>
            </div>

            <!-- <select> + <option> + bind:value -->
            <div class: SectionBox>
                <p class: SectionHeader>select with option:</p>
                <select class: DemoSelect bind:value={selected} @onChange={handleSelect}>
                    <option value="option1">Option 1 — First</option>
                    <option value="option2">Option 2 — Second</option>
                    <option value="option3">Option 3 — Third</option>
                </select>
                <p class: SelectValue>Value: {selected}</p>
            </div>

            <!-- checkbox + checked 属性 -->
            <div class: SectionBox>
                <p class: SectionHeader>Checkbox with checked attribute:</p>
                <label class: CheckLabel>
                    <input type="checkbox" class: DemoCheckbox checked={agreed} @onChange={handleAgree} />
                    <span class: CheckText>I agree to the terms</span>
                </label>
                <p class: CheckStatus>Status: {if agreed { "Checked" } else { "Unchecked" }}</p>
            </div>

            <!-- number input + min/max/step -->
            <div class: SectionBox>
                <p class: SectionHeader>Number input with min/max/step:</p>
                <input
                    type="number"
                    class: DemoInput
                    bind:value={age}
                    min="0"
                    max="120"
                    step="1"
                    title="Enter your age (0-120)"
                    @onChange={handleAgeChange}
                ></input>
                <p class: SelectValue>Age: {age}</p>
            </div>

            <!-- range input + min/max/step -->
            <div class: SectionBox>
                <p class: SectionHeader>Range slider with min/max/step:</p>
                <input
                    type="range"
                    class: DemoRange
                    bind:value={rangeVal}
                    min="0"
                    max="100"
                    step="5"
                    title="Select a value (0-100, step 5)"
                    @onChange={handleRangeChange}
                ></input>
                <p class: SelectValue>Range: {rangeVal} / 100</p>
            </div>

            <!-- 状态显示 -->
            <div class: StatusArea>
                <p class: status-text>{statusText}</p>
            </div>
        </div>
    }
    style {
        // 表单控件特有的 section 分组和控件样式
        .status-text { font-size: 14px; color: #166534; margin: 0; }
    }
}
