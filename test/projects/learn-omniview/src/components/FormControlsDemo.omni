// ╔══════════════════════════════════════════════════════════════╗
// ║  FormControlsDemo.omni —— HTML 表单控件                          ║
// ║  演示：<a> + href、<select> + <option>、checkbox checked、        ║
// ║        number min/max/step、HTML 注释、title 属性                  ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { console_log } from "std/console";

component FormControlsDemo {
    signal selected: String = "option2";
    signal agreed: bool = false;
    signal age: i32 = 25;
    signal rangeVal: i32 = 50;
    signal linkClicked: i32 = 0;
    signal statusText: String = "";

    fn handleSelect() {
        statusText = "Selected: " + selected;
    }

    fn handleAgree() {
        agreed = !agreed;
        statusText = if agreed { "Agreed ✓" } else { "Not agreed" };
    }

    fn handleAgeChange() {
        statusText = "Age set to: " + age.to_string();
    }

    fn handleRangeChange() {
        statusText = "Range: " + rangeVal.to_string();
    }

    fn handleLinkClick() {
        linkClicked = linkClicked + 1;
        statusText = "Link clicked " + linkClicked.to_string() + " times";
    }

    view {
        <div class: form-controls>
            <h3 class: title>Form Controls Demo</h3>
            <p class: subtitle>a-tag · select · checkbox · range · number</p>

            <!-- <a> 标签 + href + title + target 属性 -->
            <div class: section>
                <p class: section-title>a-tag link with href / title / target:</p>
                <!-- 使用 @onPress 来处理点击行为，避免页面跳转 -->
                <a href="#" title="Demo link — click to count" class: demo-link @onPress={handleLinkClick}>
                    Click me ({linkClicked})
                </a>
            </div>

            <!-- <select> + <option> + bind:value -->
            <div class: section>
                <p class: section-title>select with option:</p>
                <!-- HTML 注释: 下拉选择框演示 -->
                <select class: demo-select bind:value={selected} @onChange={handleSelect}>
                    <option value="option1">Option 1 — First</option>
                    <option value="option2">Option 2 — Second</option>
                    <option value="option3">Option 3 — Third</option>
                </select>
                <p class: select-value>Value: {selected}</p>
            </div>

            <!-- checkbox + checked 属性 -->
            <div class: section>
                <p class: section-title>Checkbox with checked attribute:</p>
                <label class: check-label>
                    <input type="checkbox" class: demo-checkbox checked={agreed} @onChange={handleAgree} />
                    <span class: check-text>I agree to the terms</span>
                </label>
                <p class: check-status>Status: {if agreed { "Checked" } else { "Unchecked" }}</p>
            </div>

            <!-- number input + min/max/step -->
            <div class: section>
                <p class: section-title>Number input with min/max/step:</p>
                <input
                    type="number"
                    class: demo-input
                    value={age.to_string()}
                    min="0"
                    max="120"
                    step="1"
                    title="Enter your age (0-120)"
                    @onChange={handleAgeChange}
                ></input>
                <p class: select-value>Age: {age}</p>
            </div>

            <!-- range input + min/max/step -->
            <div class: section>
                <p class: section-title>Range slider with min/max/step:</p>
                <input
                    type="range"
                    class: demo-range
                    value={rangeVal.to_string()}
                    min="0"
                    max="100"
                    step="5"
                    title="Select a value (0-100, step 5)"
                    @onChange={handleRangeChange}
                ></input>
                <p class: select-value>Range: {rangeVal} / 100</p>
            </div>

            <!-- 状态显示 -->
            <div class: status-area>
                <p class: status-text>{statusText}</p>
            </div>
        </div>
    }
    style {
        .form-controls { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 4px 0; }
        .subtitle { font-size: 13px; color: #9ca3af; margin: 0 0 16px 0; }
        .section { margin-bottom: 14px; padding: 10px 12px; background: #f9fafb; border-radius: 8px; border: 1px solid #e5e7eb; }
        .section-title { font-size: 13px; font-weight: 600; color: #6b7280; margin: 0 0 8px 0; }
        .demo-link { font-size: 14px; color: #6366f1; text-decoration: underline; cursor: pointer; }
        .demo-select { padding: 8px 12px; border: 2px solid #d4d4d8; border-radius: 8px; font-size: 14px; width: 100%; }
        .select-value { font-size: 13px; color: #374151; margin: 4px 0 0 0; }
        .check-label { display: flex; align-items: center; gap: 8px; cursor: pointer; }
        .demo-checkbox { width: 18px; height: 18px; cursor: pointer; accent-color: #6366f1; }
        .check-text { font-size: 14px; color: #374151; }
        .check-status { font-size: 13px; color: #6b7280; margin: 4px 0 0 0; }
        .demo-input { padding: 8px 12px; border: 2px solid #d4d4d8; border-radius: 8px; font-size: 14px; width: 100%; }
        .demo-range { width: 100%; margin: 8px 0; }
        .status-area { margin-top: 12px; padding: 10px 12px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; }
        .status-text { font-size: 14px; color: #166534; margin: 0; }
    }
}
