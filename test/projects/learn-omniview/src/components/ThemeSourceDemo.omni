// ╔══════════════════════════════════════════════════════════════════╗
// ║  ThemeSourceDemo.omni —— @themes 语法展示                        ║
// ║                                                                  ║
// ║  演示 design.omni 中 @themes 声明的源代码结构：                   ║
// ║  - @themes 指令（N 主题声明）                                     ║
// ║  - token 多主题值语法                                             ║
// ║  - @default-theme 回退主题                                        ║
// ║                                                                  ║
// ║  同时展示生成的 CSS 三层结构：                                    ║
// ║  :root → [data-theme="X"] → @media prefers-color-scheme          ║
// ╚══════════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";

component ThemeSourceDemo {
    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>How It Works: <code>@themes</code> Syntax</h3>
            <p class: LearnDesign.Subtitle>
                Design blocks declare themes via <code>@themes</code> directive.
                Per-token per-theme values compile to layer CSS.
            </p>

            <div class: CodeLayout>
                <div class: SourcePanel>
                    <h4 class: PanelTitle>Source</h4>
                    <pre class: CodeBlock>
                        @themes { light, dark, sepia, highContrast }
                        @default-theme light;
                        token primary: color = "#6366f1"
                            dark "#a5b4fc"
                            sepia "#8B4513"
                            highContrast "#ffff00";
                        token surface: color = "#ffffff"
                            dark "#111827"
                            sepia "#F5E6C8"
                            highContrast "#000000";
                        token textPrimary: color = "#111827"
                            dark "#f9fafb"
                            sepia "#3E2723"
                            highContrast "#ffffff";
                    </pre>
                </div>
                <div class: GeneratedPanel>
                    <h4 class: PanelTitle>CSS</h4>
                    <pre class: CodeBlock >
                        :root {"{"}
                          --primary: #6366f1;
                          --surface: #ffffff;
                          --textPrimary: #111827;
                        {"}"}
                        [data-theme="dark"] {"{"}
                          --primary: #a5b4fc;
                          --surface: #111827;
                        {"}"}
                        [data-theme="sepia"] {"{"}
                          --primary: #8B4513;
                          --surface: #F5E6C8;
                        {"}"}
                        [data-theme="highContrast"] {"{"}
                          --primary: #ffff00;
                          --surface: #000000;
                        {"}"}
                        @media (prefers-color-scheme: dark) {"{"}
                          :root:not([data-theme]) {"{"}
                            --primary: #a5b4fc;
                          {"}"}
                        {"}"}
                    </pre>
                </div>
            </div>

            <div class: KeyPoints>
                <span class: KeyPoint>CSS Cascade — one data-theme toggle updates ALL tokens at once</span>
                <span class: KeyPoint>Zero runtime — per-theme CSS is generated at compile time</span>
                <span class: KeyPoint>N themes — add "forest", "ocean", or any named theme</span>
            </div>
        </div>
    }

    style {
        .KeyPoint code { font-size: var(--fontSizeXs); background: var(--surfaceSubtle); padding: "1px 4px"; border-radius: "3px"; }
    }
}
