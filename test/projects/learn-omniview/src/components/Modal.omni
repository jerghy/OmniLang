// Modal.omni - @modal 三槽投影 + @enter 打开动画 + @onEnter/@onLeave hover 追踪
// 演示编译器内建的模态语义（spec §2.1）：焦点陷阱 / Esc 关闭 / 遮罩点击关闭 /
// aria 无障碍四要素全由编译器生成——源码只声明受控信号 isOpen 与三个命名槽。
// @slot header/body/footer 按文档序投影进 dialog 内容；槽内按钮回写同一受控
// 信号；@enter={fadeIn} 在信号置真时自动重播打开动画。

import omniview;
import { LearnDesign } from "../design";

@motion fadeIn {
  from { opacity: 0, translateY: 20 }
  to   { opacity: 1, translateY: 0 }
  over: 400ms
  easing: ease-out
}

component Modal {
    signal isOpen: bool = false;
    signal isHovering: bool = false;
    signal lastAction: String = "";

    fn open() { isOpen = true; lastAction = "opened"; }
    fn close() { isOpen = false; lastAction = "closed"; }
    fn handleMouseEnter() { isHovering = true; }
    fn handleMouseLeave() { isHovering = false; }

    view {
        <div>
            <button variant: LearnDesign.Button(color=primary, size=lg) @onPress={open}>Open Modal</button>
            <p class: StatusText>Status: {lastAction} | Hover: {isHovering}</p>

            <dialog @modal={isOpen} @enter={fadeIn}>
                @slot header {
                    <div class: ModalHeader>
                        <h3 class: ModalTitle>Modal Title</h3>
                        <button class: CloseBtn @onPress={close}>X</button>
                    </div>
                }
                @slot body {
                    <div class: ModalBody @onEnter={handleMouseEnter} @onLeave={handleMouseLeave}>
                        <p class: ModalText>Modal content goes here.</p>
                        <p class: HintText>Press Escape or click overlay to close</p>
                    </div>
                }
                @slot footer {
                    <div class: ModalFooter>
                        <button variant: LearnDesign.Button(color=ghost, size=md) @onPress={close}>Cancel</button>
                        <button variant: LearnDesign.Button(color=primary, size=md) @onPress={close}>Confirm</button>
                    </div>
                }
            </dialog>
        </div>
    }
    style {
        // 模态框视觉：容器布局见 design.omni（ModalHeader/Body/Footer/Title/Text/CloseBtn）
    }
}
