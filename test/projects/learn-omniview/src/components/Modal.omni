// Modal.omni - @slot (header/body/footer), @onKeyDown (Escape), @onMouseEnter/@onMouseLeave
// Demonstrates slot projection, keyboard events, and mouse hover tracking

import omniview;

component Modal {
    signal isOpen: bool = false;
    signal isHovering: bool = false;
    signal lastAction: String = "";

    fn open() { isOpen = true; lastAction = "opened"; }
    fn close() { isOpen = false; lastAction = "closed"; }
    fn handleKeyDown() { close(); }
    fn handleMouseEnter() { isHovering = true; }
    fn handleMouseLeave() { isHovering = false; }
    fn handleOverlayClick() { close(); }

    fn getOverlayClass() -> String {
        if isOpen { return "overlay visible"; }
        return "overlay hidden";
    }

    fn getModalClass() -> String {
        if isHovering { return "modal-content hover"; }
        return "modal-content";
    }

    view {
        <div class: container>
            <button class: trigger-btn @onPress={open}>Open Modal</button>
            <p class: status-text>Status: {lastAction} | Hover: {isHovering}</p>

            @if isOpen {
                <!-- Overlay with keyboard and mouse event handling -->
                <div
                    class: { overlay: true, visible: isOpen, hidden: false }
                    @onPress={handleOverlayClick}
                >
                    <div
                        class: { modalcontent: true, hover: isHovering }
                        @onKeyDown={handleKeyDown}
                        @onMouseEnter={handleMouseEnter}
                        @onMouseLeave={handleMouseLeave}
                    >
                        <!-- Named slot: header with close button -->
                        <div class: modal-header>
                            @slot header
                            <h3 class: modal-title>Modal Title</h3>
                            <button class: close-btn @onPress={close}>X</button>
                        </div>

                        <!-- Named slot: body -->
                        <div class: modal-body>
                            @slot body
                            <p class: modal-text>Modal content goes here.</p>
                            <p class: hint-text>Press Escape or click overlay to close</p>
                        </div>

                        <!-- Named slot: footer -->
                        <div class: modal-footer>
                            @slot footer
                            <button class: cancel-btn @onPress={close}>Cancel</button>
                            <button class: confirm-btn @onPress={close}>Confirm</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    style {
        .container { padding: 16px 0; }
        .trigger-btn { padding: 12px 24px; background: #6366f1; color: white; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; }
        .status-text { font-size: 13px; color: #9ca3af; margin-top: 8px; }
        .overlay { background: #808080; display: flex; align-items: center; justify-content: center; padding: 40px; }
        .visible { }
        .hidden { display: none; }
        .modalcontent { background: white; border-radius: 12px; padding: 24px; width: 400px; }
        .hover { background: #f9fafb; }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
        .modal-title { font-size: 20px; color: #1f2937; margin: 0; }
        .close-btn { padding: 6px 12px; background: #f3f4f6; border: 1px solid #d4d4d8; border-radius: 6px; font-size: 16px; cursor: pointer; color: #6b7280; }
        .modal-body { margin-bottom: 20px; }
        .modal-text { font-size: 15px; color: #374151; margin: 0 0 8px 0; }
        .hint-text { font-size: 12px; color: #9ca3af; margin: 0; }
        .modal-footer { display: flex; justify-content: flex-end; gap: 8px; }
        .cancel-btn { padding: 10px 20px; background: #f3f4f6; border: 1px solid #d4d4d8; border-radius: 8px; font-size: 14px; cursor: pointer; color: #374151; }
        .confirm-btn { padding: 10px 20px; background: #6366f1; color: white; border: none; border-radius: 8px; font-size: 14px; cursor: pointer; }
    }
}
