// ╔══════════════════════════════════════════════════════════════════╗
// ║  DesignTokenPanel.omni —— 设计令牌实时可视化                      ║
// ║                                                                  ║
// ║  展示 4 类设计令牌在当前主题下的值：                               ║
// ║  Color（11）、Size（6）、Radius（4）、Shadow（3）                  ║
// ║  令牌值通过 var(--name) CSS 变量引用，主题切换时自动更新。        ║
// ╚══════════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";

component DesignTokenPanel {

    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>Design Tokens Visualizer</h3>
            <p class: LearnDesign.Subtitle>
                Color · Size · Radius · Shadow — 主题切换时经 <code>var(--name)</code> 即时更新
            </p>

            <h4 class: LearnDesign.SectionTitle>Color Tokens (11)</h4>
            <div class: ColorGrid>
                <div class: ColorItem>
                    <div class: ColorSwatch style: { background: "var(--primary)" }></div>
                    <span class: ColorName>--primary</span>
                </div>
                <div class: ColorItem>
                    <div class: ColorSwatch style: { background: "var(--primaryLight)" }></div>
                    <span class: ColorName>--primaryLight</span>
                </div>
                <div class: ColorItem>
                    <div class: ColorSwatch style: { background: "var(--success)" }></div>
                    <span class: ColorName>--success</span>
                </div>
                <div class: ColorItem>
                    <div class: ColorSwatch style: { background: "var(--warning)" }></div>
                    <span class: ColorName>--warning</span>
                </div>
                <div class: ColorItem>
                    <div class: ColorSwatch style: { background: "var(--danger)" }></div>
                    <span class: ColorName>--danger</span>
                </div>
                <div class: ColorItem>
                    <div class: ColorSwatch style: { background: "var(--accent)" }></div>
                    <span class: ColorName>--accent</span>
                </div>
                <div class: ColorItem>
                    <div class: ColorSwatch style: { background: "var(--surface)", border: "1px solid var(--border)" }></div>
                    <span class: ColorName>--surface</span>
                </div>
                <div class: ColorItem>
                    <div class: ColorSwatch style: { background: "var(--surfaceMuted)" }></div>
                    <span class: ColorName>--surfaceMuted</span>
                </div>
                <div class: ColorItem>
                    <div class: ColorSwatch style: { background: "var(--textPrimary)" }></div>
                    <span class: ColorName>--textPrimary</span>
                </div>
                <div class: ColorItem>
                    <div class: ColorSwatch style: { background: "var(--textSecondary)" }></div>
                    <span class: ColorName>--textSecondary</span>
                </div>
                <div class: ColorItem>
                    <div class: ColorSwatch style: { background: "var(--border)" }></div>
                    <span class: ColorName>--border</span>
                </div>
            </div>

            <h4 class: LearnDesign.SectionTitle>Size Tokens</h4>
            <div class: SizeDemo>
                <div class: SizeBar style: { width: "var(--spaceXs)" }>xs</div>
                <div class: SizeBar style: { width: "var(--spaceSm)" }>sm</div>
                <div class: SizeBar style: { width: "var(--spaceMd)" }>md</div>
                <div class: SizeBar style: { width: "var(--spaceLg)" }>lg</div>
                <div class: SizeBar style: { width: "var(--spaceXl)" }>xl</div>
                <div class: SizeBar style: { width: "var(--spaceXxl)" }>xxl</div>
            </div>

            <h4 class: LearnDesign.SectionTitle>Radius Tokens</h4>
            <div class: RadiusDemo>
                <div class: RadiusBox style: { border-radius: "var(--radiusSm)" }>sm</div>
                <div class: RadiusBox style: { border-radius: "var(--radiusMd)" }>md</div>
                <div class: RadiusBox style: { border-radius: "var(--radiusLg)" }>lg</div>
                <div class: RadiusBox style: { border-radius: "var(--radiusFull)" }>full</div>
            </div>

            <h4 class: LearnDesign.SectionTitle>Shadow Tokens</h4>
            <div class: ShadowDemo>
                <div class: ShadowBox style: { box-shadow: "var(--shadowSm)" }>sm</div>
                <div class: ShadowBox style: { box-shadow: "var(--shadowMd)" }>md</div>
                <div class: ShadowBox style: { box-shadow: "var(--shadowLg)" }>lg</div>
            </div>

            <div class: HintBar>
                <span class: HintText>Switch themes above — all tokens update automatically via CSS cascade</span>
            </div>
        </div>
    }

    style {
    }
}
