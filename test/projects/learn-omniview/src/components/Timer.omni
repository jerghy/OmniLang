// Timer.omni — 手动步进计时器：signal + 可选事件 + @unmount 清理
//
// 说明：std 库暂无 timer/sleep 原语（见 docs/omniview/12-standard-library.md），
// 因此本演示不做自动计时，改为手动步进：Start 归零并启用计数，Tick 手动 +1，
// 达到 10 次自动完成并停止；Stop / Reset 用于停止或清零。
// 可选事件 onTick / onComplete 由组件发出，父级可用 @onTick / @onComplete 消费，
// 也可以完全不处理（本展示页即未消费；已消费示例见 EmitEventDemo）。

import omniview;
import { LearnDesign } from "../design";
import { console_log, console_warn, console_error } from "std/console";

component Timer {
    signal count: i32 = 0;
    signal running: bool = false;

    // 可选事件（类型带 ?）：父级可能不处理，发出方无需担心没有监听者
    event onTick: i32?;
    event onComplete: String?;

    fn start() {
        running = true;
        count = 0;
        console_log("Timer started");
    }

    fn stop() {
        running = false;
        console_log("Timer stopped");
    }

    fn reset() {
        count = 0;
        running = false;
    }

    fn tick() {
        if running {
            count = count + 1;
            // 发出可选 tick 事件（无监听者时为无害 no-op）
            onTick(count);
            if count >= 10 {
                running = false;
                onComplete("Timer finished after 10 ticks");
            }
        }
    }

    // @unmount cleanup
    @unmount {
        running = false;
        console_log("Timer unmounted, final count: " + count.to_string());
    }

    view {
        <div class: LearnDesign.Card>
            <h3 class: title>Timer Demo</h3>
            <p class: count-text>Count: {count} / 10</p>
            <p class: info>Status: {if running { "Running" } else { "Stopped" }}</p>
            <p class: info>手动步进：std 库暂无定时器原语，点击 Tick 手动 +1</p>

            <div class: btn-row>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={start}>Start</button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={stop}>Stop</button>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={tick}>Tick</button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={reset}>Reset</button>
            </div>
        </div>
    }
    style {
        // 计时器特有的数字显示和布局
        .title { font-size: 18px; margin-bottom: 12px; color: #222; }
        .count-text { font-size: 36px; font-weight: bold; color: #6366f1; margin-bottom: 8px; }
        .info { font-size: 14px; color: #666; margin-bottom: 12px; }
        .btn-row { display: flex; gap: 8px; margin-bottom: 8px; }
        // .timer / .btn-start / .btn-stop / .btn-tick / .btn-reset / .btn-sm
        // 已由 LearnDesign.Card / Button 变体提供
    }
}
