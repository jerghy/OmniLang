// ╔══════════════════════════════════════════════════════════════╗
// ║  lib/async_demo.omni —— std/async 模块演示                   ║
// ║  演示：async_sleep, async_spawn, async_all, async_race,      ║
// ║        async_timeout                                         ║
// ║  纯逻辑文件，不写 import omniview;                              ║
// ║  注：任务辅助函数必须 pub —— omniview codegen 只发射 pub 函数 ║
// ║  （ir::all_functions 过滤 Visibility::Public，见 deferrals #32）║
// ╚══════════════════════════════════════════════════════════════╝

import { async_sleep, async_spawn, async_all, async_race, async_timeout } from "std/async";

pub async fn task_a() -> String {
    await async_sleep(20);
    return "task_a done";
}

pub async fn task_b() -> String {
    await async_sleep(10);
    return "task_b done";
}

pub async fn slow_task() -> String {
    await async_sleep(200);
    return "slow task done";
}

pub async fn fast_task() -> String {
    await async_sleep(5);
    return "fast task done";
}

pub async fn demo_sleep_and_return() -> String {
    await async_sleep(10);
    return "slept 10ms";
}

pub async fn demo_parallel() -> Array<String> {
    let a = async_spawn(task_a());
    let b = async_spawn(task_b());
    return await async_all([a, b]);
}

pub async fn demo_race() -> String {
    let a = async_spawn(slow_task());
    let b = async_spawn(fast_task());
    return await async_race([a, b]);
}

pub async fn demo_timeout() -> String {
    let task = async_spawn(slow_task());
    return await async_timeout(task, 50);
}
