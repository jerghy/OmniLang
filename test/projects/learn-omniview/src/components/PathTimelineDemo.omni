import omniview;

// ╔══════════════════════════════════════════════════════════════╗
// ║  🧪 Playwright Test                                         ║
// ║                                                            ║
// ║  **Steps:**                                                ║
// ║  1. Navigate to PathTimelineDemo component.                 ║
// ║  2. Verify the boxes with @timeline={flyPath} render.      ║
// ║                                                            ║
// ║  **Expected:**                                             ║
// ║  - Each @timeline direction item has path + pathRotate attrs ║
// ║  - Path SVG string parses as motion path.                  ║
// ║  - pathRotate: true compiles to rotate-along-path behavior  ║
// ╚══════════════════════════════════════════════════════════════╝

// ★ @timeline 中 direction item 级别的 path 和 pathRotate
@timeline flyPath {
    set { opacity: 1 }
    label start
    ball1 { from { x: 0, y: 0, opacity: 0 } to { x: 200, y: 0, opacity: 1 } over: 1200, ease: easeOut, path: "M0,0 C50,-60 150,-60 200,0", pathRotate: true }
    then
    ball2 { from { x: 0, y: 0, opacity: 0 } to { x: 200, y: 0, opacity: 1 } over: 1200, ease: easeInOut, path: "M0,0 Q100,-80 200,0", pathRotate: true }
    then
    label end
}

// ★ 另一个示例：回弹路径
@timeline bouncePath {
    ball { from { opacity: 0, y: -40 } to { opacity: 1, y: 0 } over: 800, ease: easeOut, path: "M0,0 Q25,-20 50,0 Q75,-10 100,0", pathRotate: false }
    then
    ball { from { opacity: 1, y: 0 } to { opacity: 0, y: -40 } over: 600, ease: easeIn, path: "M100,0 Q75,-10 50,0 Q25,-20 0,0", pathRotate: true }
}

component PathTimelineDemo {
    view {
        <div class: container>
            <h3 class: title>Path Timeline Demo</h3>
            <p class: subtitle>演示 @timeline direction item 中的 path + pathRotate</p>

            <div class: card>
                <h4 class: label>flyPath: 两个球沿贝塞尔路径运动</h4>
                <div class: track>
                    <div class: ball ball-blue @timeline={flyPath}>
                        <p>球 1</p>
                    </div>
                    <div class: ball ball-green @timeline={flyPath}>
                        <p>球 2</p>
                    </div>
                </div>
            </div>

            <div class: card>
                <h4 class: label>bouncePath: 回弹路径 (pathRotate: true)</h4>
                <div class: track>
                    <div class: ball ball-pink @timeline={bouncePath}>
                        <p>球</p>
                    </div>
                </div>
            </div>

            <p class: note>path 定义 SVG 运动路径；pathRotate: true 使元素沿路径方向旋转</p>
        </div>
    }
    style {
        .container { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 4px 0; }
        .subtitle { font-size: 13px; color: #9ca3af; margin: 0 0 16px 0; }
        .card { margin-bottom: 14px; padding: 12px; background: #f9fafb; border-radius: 8px; }
        .label { font-size: 14px; font-weight: 600; color: #374151; margin: 0 0 8px 0; }
        .track { position: relative; height: 80px; background: "#f0f9ff"; border-radius: 8px; overflow: hidden; padding: 16px; }
        .ball { width: 48px; height: 48px; border-radius: 24px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: white; position: absolute; }
        .ball-blue { background: "#3b82f6"; left: 16px; top: 16px; }
        .ball-green { background: "#10b981"; left: 16px; top: 16px; }
        .ball-pink { background: "#ec4899"; left: 16px; top: 16px; }
        .note { font-size: 12px; color: #9ca3af; margin: 4px 0 0 0; }
    }
}
