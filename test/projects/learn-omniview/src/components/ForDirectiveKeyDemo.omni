import omniview;

// ╔══════════════════════════════════════════════════════════════╗
// ║  🧪 Playwright Test                                         ║
// ║                                                            ║
// ║  **Steps:**                                                ║
// ║  1. Navigate to ForDirectiveKeyDemo component.              ║
// ║  2. Verify list items render with item names.               ║
// ║                                                             ║
// ║  **Expected:**                                             ║
// ║  - Each list item has data-key attribute mapping.           ║
// ║  - key={expr} syntax compiles without errors.               ║
// ╚══════════════════════════════════════════════════════════════╝

component ForDirectiveKeyDemo {
    signal items: Array<String> = ["Apple", "Banana", "Cherry", "Date", "Elderberry"];

    view {
        <div class: container>
            <h3 class: title>@for key={expr} Demo</h3>
            <p class: subtitle>演示 @for item in iterable key={expr} 用法</p>

            <div class: card>
                <h4 class: label>使用 key={item} 标识的列表</h4>
                <!-- ★ @for key={expr} —— 每个列表项由 key 表达式标识 -->
                <ul class: list>
                    @for item in items key={item} {
                        <li class: list-item>{item}</li>
                    }
                </ul>
            </div>

            <div class: card>
                <h4 class: label>对比：无 key 的 @for</h4>
                <ul class: list>
                    @for item in items {
                        <li class: list-item-alt>{item}</li>
                    }
                </ul>
            </div>

            <p class: note>key={item} 帮助运行时追踪元素身份，提高列表更新效率</p>
        </div>
    }
    style {
        .container { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 4px 0; }
        .subtitle { font-size: 13px; color: #9ca3af; margin: 0 0 16px 0; }
        .card { margin-bottom: 14px; padding: 12px; background: #f9fafb; border-radius: 8px; }
        .label { font-size: 14px; font-weight: 600; color: #374151; margin: 0 0 8px 0; }
        .list { padding: 0 16px; margin: 0; }
        .list-item { padding: 6px 12px; margin: 4px 0; background: "#e0e7ff"; border-radius: 6px; font-size: 14px; color: #3730a3; }
        .list-item-alt { padding: 6px 12px; margin: 4px 0; background: "#fef3c7"; border-radius: 6px; font-size: 14px; color: #92400e; }
        .note { font-size: 12px; color: #9ca3af; margin: 4px 0 0 0; }
    }
}
