import omniview;

// ╔══════════════════════════════════════════════════════════════╗
// ║  ForDirectiveKeyDemo.omni — @for key= 身份追踪                 ║
// ║                                                              ║
// ║  对象项列表建议提供 key=：以稳定标识（如 item.id）跟踪列表项，   ║
// ║  增删/重排时保留项状态（React key / Flutter ValueKey /         ║
// ║  OmniView keyed 克隆复用）。                                  ║
// ╚══════════════════════════════════════════════════════════════╝

struct Fruit {
    id: i32,
    name: String,
}

component ForDirectiveKeyDemo {
    signal items: Array<Fruit> = [
        Fruit { id: 1, name: "Apple" },
        Fruit { id: 2, name: "Banana" },
        Fruit { id: 3, name: "Cherry" },
    ];
    signal nextId: i32 = 4;

    fn addItem() {
        items = [...items, Fruit { id: nextId, name: "Fruit-" + nextId.to_string() }];
        nextId = nextId + 1;
    }

    fn removeLast() {
        if items.len() > 0 {
            items = items.slice(0, items.len() - 1);
        }
    }

    fn moveLastToFront() {
        if items.len() > 1 {
            let last = items.get(items.len() - 1);
            items = [last, ...items.slice(0, items.len() - 1)];
        }
    }

    view {
        <div class: Container>
            <h3 class: Title>@for key= 身份追踪 Demo</h3>
            <p class: subtitle>对象项列表 key={ "{item.id}" } — 增删/重排时保持列表项身份</p>

            <div class: Controls>
                <button class: Btn @onPress={addItem}>Add Item</button>
                <button class: Btn @onPress={removeLast}>Remove Last</button>
                <button class: Btn @onPress={moveLastToFront}>Move Last to Front</button>
            </div>

            <ul class: List>
                @for item in items key={item.id} {
                    <li class: list-item>#{item.id} — {item.name}</li>
                }
                @empty {
                    <li class: list-item empty>No items</li>
                }
            </ul>
            <p class: Note>Total: {items.len()} · 下一 id: {nextId}</p>
        </div>
    }
    style {
        .list-item { padding: 8px 12px; font-size: 14px; color: #374151; border-bottom: 1px solid #f3f4f6; }
        .list-item.empty { color: #9ca3af; font-style: italic; }
    
        .subtitle { font-size: 13px; color: #6b7280; margin: 0 0 12px 0; }
    }
}
