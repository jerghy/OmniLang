import omniview;


component StylePseudoDemo {
    signal clicked: i32 = 0;

    fn increment() { clicked = clicked + 1; }

    view {
        <div class: Container>
            <h3 class: Title>CSS Pseudo-Classes Demo</h3>
            <p class: Subtitle>演示 :hover :focus :active 伪类</p>

            <div class: DemoCard>
                <h4 class: Label>伪类按钮</h4>
                <button class: BtnHover>Hover me (:hover)</button>
                <button class: BtnFocus @onPress={increment}>Focus me (:focus) x{clicked}</button>
                <button class: BtnActive @onPress={increment}>Press me (:active)</button>
            </div>

            <div class: DemoCard>
                <h4 class: Label>伪类输入框</h4>
                <input class: InputFocus placeholder="Focus to see :focus style" />
            </div>

            <div class: DemoCard>
                <h4 class: Label>组合伪类</h4>
                <div class: CardHover>Hover this card (:hover)</div>
            </div>
        </div>
    }
    style {
    }
}
