// FormPage.omni - @form + validate:, boolean attrs, hyphenated attrs, @onFocus/@onBlur, @onScroll
// Demonstrates form intent validation (submit-gate + rules), accessibility attributes, and data attributes

import omniview;
import { LearnDesign } from "../design";
import { string_trim, string_starts_with } from "std/string";

component FormPage {
    signal name: String = "";
    signal email: String = "";
    signal message: String = "";
    signal submitted: bool = false;
    signal scrollPos: i32 = 0;
    signal focusField: String = "";

    // validate: custom 规则——名称不能以空格开头（单参返回 String，非空串即错误消息）
    fn noLeadingSpace(text: String) -> String {
        if string_starts_with(text, " ") { return "Name must not start with a space"; }
        return "";
    }

    fn handleNameFocus() { focusField = "name"; }
    fn handleNameBlur() { focusField = ""; }
    fn handleEmailFocus() { focusField = "email"; }
    fn handleEmailBlur() { focusField = ""; }

    // @form 提交处理——校验通过（@onSubmit 门禁拦截）后才会执行
    fn handleSubmit() {
        submitted = true;
    }

    fn handleScroll() { scrollPos = scrollPos + 1; }

    fn handleReset() {
        name = "";
        email = "";
        message = "";
        submitted = false;
        scrollPos = 0;
    }

    fn getTrimmedMessage() -> String {
        return string_trim(message);
    }

    fn getStatusText() -> String {
        if submitted { return "Form submitted successfully"; }
        if !form.valid { return "Please fix errors above"; }
        return "Fill in the form";
    }

    fn isFormValid() -> bool {
        return name != "" && email != "";
    }

    view {
        <div class: LearnDesign.Card>
            <h2 class: LearnDesign.CardTitle>FormPage Demo</h2>

            <!-- Form demonstrating @form submit-gate, validate: rules, boolean attrs, aria/data attrs -->
            <form class: Form @form @onSubmit={handleSubmit}>
                <!-- Name field with validate: rules, @onFocus/@onBlur, required, a11y block, data-testid -->
                <div class: Field>
                    <label class: Label for="name">Name</label>
                    <input
                        id="name"
                        class: Input
                        placeholder="Your name"
                        bind:value={name}
                        required
                        a11y: { label: "Full name input" }
                        data-testid="name-field"
                        data-type="text"
                        validate: { required: true, min: 2, custom: noLeadingSpace }
                        @onFocus={handleNameFocus}
                        @onBlur={handleNameBlur}
                    ></input>
                    @if form.errors.name {
                        <span class: ErrorText>{form.errors.name}</span>
                    }
                </div>

                <!-- Email field with format rule, boolean attrs and hyphenated attrs -->
                <div class: Field>
                    <label class: Label for="email">Email</label>
                    <input
                        id="email"
                        class: Input
                        placeholder="your@email.com"
                        bind:value={email}
                        required
                        a11y: { label: "Email address input" }
                        data-testid="email-field"
                        data-type="email"
                        validate: { required: true, format: "email" }
                        @onFocus={handleEmailFocus}
                        @onBlur={handleEmailBlur}
                    ></input>
                    @if form.errors.email {
                        <span class: ErrorText>{form.errors.email}</span>
                    }
                </div>

                <!-- Message field with @onInput, @onScroll, readonly (conditional) -->
                <div class: Field>
                    <label class: Label for="msg">Message</label>
                    <textarea
                        id="msg"
                        class: Textarea
                        placeholder="Your message (optional)"
                        bind:value={message}
                        a11y: { label: "Message input" }
                        data-testid="msg-field"
                        @onScroll={handleScroll}
                    ></textarea>
                </div>

                <!-- Disabled field demonstration -->
                <div class: Field>
                    <label class: Label for="disabled-field">Disabled field</label>
                    <input
                        id="disabled-field"
                        class: Input
                        placeholder="This field is disabled"
                        disabled
                        a11y: { label: "Disabled input" }
                        data-testid="disabled-field"
                    ></input>
                </div>

                <!-- Readonly field demonstration -->
                <div class: Field>
                    <label class: Label for="readonly-field">Readonly field</label>
                    <input
                        id="readonly-field"
                        class: Input
                        value="Read-only value"
                        readonly
                        a11y: { label: "Read-only input" }
                        data-testid="readonly-field"
                    ></input>
                </div>

                <!-- Scrollable area with @onScroll -->
                <div class: ScrollBox @onScroll={handleScroll}>
                    <p class: ScrollTitle>Scrollable area (scroll count: {scrollPos})</p>
                    <p class: ScrollLine>Line 1: Scroll to trigger @onScroll</p>
                    <p class: ScrollLine>Line 2: More content below</p>
                    <p class: ScrollLine>Line 3: Keep scrolling</p>
                    <p class: ScrollLine>Line 4: Almost there</p>
                    <p class: ScrollLine>Line 5: Bottom reached</p>
                </div>

                <!-- Status display -->
                <div class: StatusArea>
                    <p class: { Status: true, Success: submitted, Error: !form.valid, Idle: false }>
                        {getStatusText()}
                    </p>
                </div>

                <!-- Trimmed message display -->
                @if message != "" {
                    <div class: TrimmedArea>
                        <p class: TrimmedLabel>Trimmed message:</p>
                        <p class: TrimmedValue>{getTrimmedMessage()}</p>
                    </div>
                }

                <!-- Form actions -->
                <div class: Actions>
                    <button
                        variant: LearnDesign.Button(color=primary, size=lg)
                        type="submit"
                        disabled={false}
                        a11y: { label: "Submit form" }
                        data-testid="submit-btn"
                    >Submit</button>
                    <button
                        variant: LearnDesign.Button(color=ghost, size=lg)
                        type="button"
                        @onPress={handleReset}
                        a11y: { label: "Reset form" }
                        data-testid="reset-btn"
                    >Reset</button>
                </div>

                <!-- Conditional submit button——去掉 @onPress 直调，走 @form 门禁统一提交 -->
                <div class: ConditionalArea>
                    <button
                        variant: LearnDesign.Button(color=ghost, size=md)
                        type="submit"
                        disabled={!isFormValid()}
                        a11y: { label: "Conditional submit button" }
                        data-testid="conditional-btn"
                    >
                        {if isFormValid() { "Form is valid" } else { "Form incomplete" }}
                    </button>
                </div>
            </form>

            <!-- Focus indicator -->
            @if focusField != "" {
                <div class: FocusIndicator>
                    <p class: FocusText>Focused field: {focusField}</p>
                </div>
            }
        </div>
    }
    style {
        // 表单布局与校验样式由 design.omni 提供（Form/Field/Label/Input/Textarea/ErrorText/StatusArea 等）
    }
}
