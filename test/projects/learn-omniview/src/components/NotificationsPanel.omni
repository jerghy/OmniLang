// NotificationsPanel.omni - @slot, ref, @effect for notification tracking

import omniview;
import { LearnDesign } from "../design";
import { NotificationStore } from "../stores/NotificationStore";

component NotificationsPanel {
    // Body-level slot declarations: `{header}` / `{children}` /
    // `{footer}` interpolations mark the projection positions in the view.
    @slot header
    @slot default
    @slot footer

    @store NotificationStore;
    ref scrollContainer: HtmlElement;
    signal badgeVisible: bool = false;

    // deps 显式列出 effect 读取的 store 字段（含 getter），字段变化时重跑
    @effect(notifications, NotificationStore.unreadCount) {
        if NotificationStore.unreadCount > 0 {
            badgeVisible = true;
            // 新通知到达时滚动到列表底部，展示最新一条（RefOp: .scrollTo）
            scrollContainer.scrollTo(0, 9999);
        }
    }

    view {
        <div class: LearnDesign.Card>
            <div class: header>
                <h3 class: title>
                    Notifications
                    @if badgeVisible {
                        <span class: badge-new>New</span>
                    }
                </h3>
                <div class: header-actions>
                    <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={() => { NotificationStore.add("Notification " + NotificationStore.unreadCount.to_string()); }}>Add</button>
                    <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={() => { NotificationStore.removeLast(); }}>Remove</button>
                    <button variant: LearnDesign.Button(color=danger, size=sm) @onPress={() => { NotificationStore.clear(); badgeVisible = false; }}>Clear</button>
                </div>
            </div>

            <!-- Named slot for custom header content -->
            <div class: slot-header-area>
                {header}
            </div>

            <!-- Scroll container with ref -->
            <div class: scroll-area @ref={scrollContainer}>
                @if NotificationStore.unreadCount == 0 {
                    <!-- Unnamed slot: projected children render only in the empty state -->
                    {children}
                    <p class: LearnDesign.Hint>No notifications</p>
                }
                @for item in NotificationStore.notifications {
                    <div class: notification-item @onPress={() => { badgeVisible = false; }}>
                        <span class: dot></span>
                        <span class: item-text>{item}</span>
                    </div>
                }
            </div>

            <!-- Footer slot -->
            <div class: footer>
                <p class: count-text>Total: {NotificationStore.unreadCount}</p>
                <div class: slot-footer-area>
                    {footer}
                </div>
            </div>
        </div>
    }
    style {
        // 通知面板特有的内部布局（列表、通知项、滚动区）
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .title { font-size: 18px; color: #1f2937; display: flex; align-items: center; gap: 8px; }
        .badge-new { font-size: 11px; background: #f97316; color: white; padding: 2px 8px; border-radius: 10px; }
        .header-actions { display: flex; gap: 6px; }
        .slot-header-area { margin-bottom: 8px; }
        .scroll-area { max-height: 200px; overflow-y: auto; padding: 8px; background: #f9fafb; border-radius: 8px; }
        .notification-item { display: flex; align-items: center; gap: 8px; padding: 8px; background: white; border-radius: 6px; margin-bottom: 4px; cursor: pointer; }
        .dot { width: 8px; height: 8px; border-radius: 50%; background: #6366f1; }
        .item-text { font-size: 14px; color: #374151; }
        .footer { margin-top: 12px; display: flex; justify-content: space-between; align-items: center; }
        .count-text { font-size: 13px; color: #6b7280; }
        .slot-footer-area { }
    }
}
