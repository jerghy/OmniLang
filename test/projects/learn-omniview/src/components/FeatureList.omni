// ╔══════════════════════════════════════════════════════════════╗
// ║  FeatureList.omni —— @if + @for 折叠展开 + 列表遍历             ║
// ║  演示：signal 布尔切换、@if/@else 条件渲染、                     ║
// ║        @for 遍历固定列表、@empty 空状态                          ║
// ║  容器使用 LearnDesign.Card + Tag（Design 为第一公民）             ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";

component FeatureList {
    signal isOpen: bool = true;

    signal features: Array<String> = [
        "Store: 全局状态管理",
        "Component: 组件声明与组合",
        "Signal: 响应式信号",
        "Computed: 计算属性",
        "Prop: 外部属性传递",
        "Event: 自定义事件通信",
        "bind:value: 双向绑定",
        "if else: 条件渲染",
        "for empty: 列表渲染加空状态",
        "onPress: 事件处理加内联回调",
        "mount effect: 生命周期",
        "style: 作用域CSS样式",
        "pub fn: 公开工具函数",
        "import export: 跨文件模块",
    ];

    fn toggle() {
        isOpen = !isOpen;
    }

    view {
        <div class: LearnDesign.Card style: { background: "#fffbeb" }>
            <div class: header @onPress={toggle}>
                <h3 class: title>Features ({features.len()} items)</h3>
                <span class: arrow>{if isOpen { "^" } else { "v" }}</span>
            </div>
            @if isOpen {
                <div class: list>
                    @for f in features {
                        <span class: LearnDesign.Tag>{f}</span>
                    }
                    @empty { <span>No features</span> }
                </div>
            }
        </div>
    }
    style {
        // 特有色板（暖黄色系——组件特有的演示风格）
        .header { display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
        .title { font-size: 16px; color: #b45309; }
        .arrow { font-size: 14px; color: #a16207; }
        .list { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 12px; }
    }
}
