import omniview;

// ╔══════════════════════════════════════════════════════════════╗
// ║  🧪 Playwright Test                                         ║
// ║                                                            ║
// ║  **Steps:**                                                ║
// ║  1. Navigate to ComputedFnFormDemo component.               ║
// ║  2. Check the simple form computed and function-form        ║
// ║     computed values.                                        ║
// ║  3. Click "Clear Last Name" button.                         ║
// ║  4. Click "Set San" button.                                 ║
// ║                                                            ║
// ║  **Expected:**                                             ║
// ║  - Initial simple computed shows "Zhang ".                  ║
// ║  - Initial function-form computed shows "Zhang".            ║
// ║  - After "Clear Last Name", fullName shows just "Zhang".    ║
// ║  - After "Set San", fullName shows "Zhang San".             ║
// ╚══════════════════════════════════════════════════════════════╝

component ComputedFnFormDemo {
    signal firstName: String = "Zhang";
    signal lastName: String = "";
    signal counter: i32 = 0;

    // 已支持的：简单表达式形式
    computed simple: String = firstName + " " + lastName;

    // 函数式形式（带 () 和 -> 及完整 block）——view 中 {fullName()} 调用
    computed fullName() -> String {
        if firstName == "" && lastName == "" {
            return "Anonymous";
        }
        if lastName == "" {
            return firstName;
        }
        return firstName + " " + lastName;
    }

    fn clearLast() { lastName = ""; }
    fn setLast() { lastName = "San"; counter = counter + 1; }

    view {
        <div class: container>
            <h3 class: title>Computed Function Form Demo</h3>
            <p class: subtitle>演示 computed name() → Type {"{ }"} 函数式写法</p>

            <div class: card>
                <h4 class: label>Simple form: computed simple: String = expr</h4>
                <p class: value>{simple}</p>
            </div>

            <div class: card>
                <h4 class: label>Function form: computed fullName() → String {"{...}"}</h4>
                <p class: value>{fullName()}</p>
            </div>

            <div class: btn-row>
                <button class: btn @onPress={clearLast}>Clear Last Name</button>
                <button class: btn @onPress={setLast}>Set "San"</button>
            </div>

            <div class: info>
                <p class: small>Calls: {counter}</p>
            </div>
        </div>
    }
    style {
        .container { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 4px 0; }
        .subtitle { font-size: 13px; color: #9ca3af; margin: 0 0 16px 0; }
        .card { margin-bottom: 14px; padding: 12px; background: #f9fafb; border-radius: 8px; }
        .label { font-size: 13px; font-weight: 600; color: #6b7280; margin: 0 0 4px 0; }
        .value { font-size: 18px; font-weight: 600; color: #6366f1; margin: 0; }
        .btn-row { display: flex; gap: 8px; margin-bottom: 8px; }
        .btn { padding: 8px 16px; background: #6366f1; color: white; border: none; border-radius: 8px; font-size: 14px; cursor: pointer; }
        .info { padding: 8px 12px; background: #f3f4f6; border-radius: 6px; }
        .small { font-size: 12px; color: #6b7280; margin: 0; }
    }
}
