// ╔══════════════════════════════════════════════════════════════╗
// ║  FilterBar.omni —— 过滤排序工具栏                              ║
// ║  演示：@onChange 过滤、@onClick 排序、                            ║
// ║        computed 过滤标签、@store 读取                            ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
import { TodoStore } from "../stores/TodoStore";
import { array_length } from "std/array";

component FilterBar {
    @store TodoStore;

    signal searchText: String = "";
    signal sortAsc: bool = true;
    signal changeCount: i32 = 0;

    // Demo data for filter language-method closure demonstration
    signal demoFrameworks: Array<String> = ["React", "Vue", "Svelte", "Solid", "Angular"];

    // computed using the filter language method with a closure that filters by search text
    computed filteredFrameworks: Array<String> = demoFrameworks.filter(|f| if searchText == "" { true } else { f == searchText });

    // computed 排序标签（仅依赖本地 signal）
    computed sortLabel: String = if sortAsc { "ASC" } else { "DESC" };

    fn handleSortToggle() {
        if sortAsc { sortAsc = false; } else { sortAsc = true; }
    }

    // 搜索过滤由 @effect 承担：searchText 变化即写入 Store。
    // @onChange 内不再读取 searchText（React 目标闭包捕获旧值——缺陷修复），
    // 只保留 changeCount 计数。
    // (searchText, setFilter) 显式依赖：React 目标 useEffect 依赖数组
    // 的来源（setFilter 为 slice 局部动作，exhaustive-deps 必需）；
    // OmniView 目标 __omni_effect 自动跟踪信号读取，依赖列表忽略。
    // 首挂载守卫：setFilter("") 与 "all" 不等价（TodoList 按文本匹配过滤），
    // 空串须归一到 "all"。
    @effect (searchText, setFilter) {
        if searchText == "" {
            TodoStore.setFilter("all");
        } else {
            TodoStore.setFilter(searchText);
        }
    }

    view {
        <div class: LearnDesign.Card>
            <!-- 搜索输入 + @onChange 过滤 -->
            <div class: search-row>
                <input
                    bind:value={searchText}
                    placeholder="Filter todos..."
                    class: search-input
                    @onChange={() => {
                        // 过滤已移交 @effect（见组件体注释）——此处仅计数，
                        // 避免 React 目标闭包捕获旧 searchText 的失效读取
                        changeCount = changeCount + 1;
                    }}
                ></input>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={() => {
                    searchText = "";
                    TodoStore.setFilter("all");
                }}>X</button>
            </div>

            <!-- 排序按钮 + @onClick 排序 -->
            <div class: sort-row>
                <p class: filter-label>
                    {if searchText == "" {
                        "Showing all " + TodoStore.totalCount.to_string() + " items"
                    } else {
                        "Filter: " + searchText + " (" + TodoStore.totalCount.to_string() + " total)"
                    }}
                </p>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onClick={handleSortToggle}>
                    Sort {sortLabel}
                </button>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={() => {
                    TodoStore.fetchReminders();
                }}>
                    Sync
                </button>
            </div>

            <!-- Store 状态展示 -->
            <div class: store-info>
                <p class: LearnDesign.Hint>
                    Store: {TodoStore.totalCount} items
                    | Filter: {TodoStore.filterStatus}
                    | Changes: {changeCount}
                </p>
                <p class: LearnDesign.Hint>Last: {TodoStore.lastAction}</p>
                <p class: LearnDesign.Hint>Filtered frameworks: {array_length(filteredFrameworks)}/{array_length(demoFrameworks)}</p>
            </div>
        </div>
    }
    style {
        // 组件特有的搜索栏布局和状态区背景
        .search-row { display: flex; gap: 8px; margin-bottom: 12px; }
        .search-input { flex: 1; padding: 10px 12px; border: 2px solid #d4d4d8; border-radius: 8px; font-size: 14px; outline: none; }
        .search-input:focus { border-color: #6366f1; }
        .sort-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .filter-label { font-size: 14px; color: #374151; margin: 0; }
        .store-info { background: #f9fafb; padding: 10px 12px; border-radius: 8px; }
        // .filter-bar / .clear-btn / .sort-btn / .sync-btn / .info-text
        // 已由 LearnDesign.Card / Button 变体 / Hint 类提供
    }
}
