// ╔══════════════════════════════════════════════════════════════╗
// ║  FilterBar.omni —— 过滤排序工具栏（Phase 5）                    ║
// ║  演示：@onChange 过滤、@onClick 排序、                            ║
// ║        computed 过滤标签、@store 读取                            ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { TodoStore } from "../stores/TodoStore";
import { array_filter, array_length } from "std/array";

component FilterBar {
    @store TodoStore;

    signal searchText: String = "";
    signal sortAsc: bool = true;
    signal changeCount: i32 = 0;

    // Demo data for array_filter closure demonstration
    signal demoFrameworks: Array<String> = ["React", "Vue", "Svelte", "Solid", "Angular"];

    // computed using array_filter with a closure that filters by search text
    computed filteredFrameworks: Array<String> = array_filter(demoFrameworks, |f| if searchText == "" { true } else { f == searchText });

    // computed 排序标签（仅依赖本地 signal）
    computed sortLabel: String = if sortAsc { "ASC" } else { "DESC" };

    fn handleSortToggle() {
        if sortAsc { sortAsc = false; } else { sortAsc = true; }
    }

    view {
        <div class: filter-bar>
            <!-- 搜索输入 + @onChange 过滤 -->
            <div class: search-row>
                <input
                    bind:value={searchText}
                    placeholder="Filter todos..."
                    class: search-input
                    @onChange={() => {
                        changeCount = changeCount + 1;
                        if searchText == "" {
                            TodoStore.setFilter("all");
                        } else {
                            TodoStore.setFilter("urgent");
                        }
                    }}
                ></input>
                <button class: clear-btn @onPress={() => {
                    searchText = "";
                    TodoStore.setFilter("all");
                }}>X</button>
            </div>

            <!-- 排序按钮 + @onClick 排序 -->
            <div class: sort-row>
                <p class: filter-label>
                    {if searchText == "" {
                        "Showing all " + TodoStore.totalCount.to_string() + " items"
                    } else {
                        "Filter: " + searchText + " (" + TodoStore.totalCount.to_string() + " total)"
                    }}
                </p>
                <button class: sort-btn @onClick={handleSortToggle}>
                    Sort {sortLabel}
                </button>
                <button class: sync-btn @onPress={() => {
                    TodoStore.fetchReminders();
                }}>
                    Sync
                </button>
            </div>

            <!-- Store 状态展示 -->
            <div class: store-info>
                <p class: info-text>
                    Store: {TodoStore.totalCount} items
                    | Filter: {TodoStore.filterStatus}
                    | Changes: {changeCount}
                </p>
                <p class: info-text>Last: {TodoStore.lastAction}</p>
                <p class: info-text>Filtered frameworks: {array_length(filteredFrameworks)}/{array_length(demoFrameworks)}</p>
            </div>
        </div>
    }
    style {
        .filter-bar { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 16px 12px; margin: 16px 0; }
        .search-row { display: flex; gap: 8px; margin-bottom: 12px; }
        .search-input { flex: 1; padding: 10px 12px; border: 2px solid #d4d4d8; border-radius: 8px; font-size: 14px; }
        .clear-btn { padding: 10px 14px; background: #f3f4f6; border: 1px solid #d4d4d8; border-radius: 8px; cursor: pointer; color: #6b7280; font-size: 14px; }
        .sort-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .filter-label { font-size: 14px; color: #374151; margin: 0; }
        .sort-btn { padding: 8px 16px; background: #6366f1; color: white; border: none; border-radius: 8px; font-size: 14px; cursor: pointer; }
        .sync-btn { padding: 8px 16px; background: #10b981; color: white; border: none; border-radius: 8px; font-size: 14px; cursor: pointer; }
        .store-info { background: #f9fafb; padding: 10px 12px; border-radius: 8px; }
        .info-text { font-size: 12px; color: #6b7280; margin: 0 0 4px 0; }
    }
}
