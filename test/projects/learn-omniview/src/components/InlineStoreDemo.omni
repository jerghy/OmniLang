// ╔══════════════════════════════════════════════════════════════╗
// ║  InlineStoreDemo.omni —— Store 引用演示                       ║
// ║  演示：组件通过 @store 引用顶层 store（CartStore）            ║
// ║  迁移说明：原为组件内联 store（component 内 store { ... }），  ║
// ║  React 目标对 inline store 硬诊断 E_CODEGEN（Task 2.2，       ║
// ║  BUG-C / deferral #37），故迁至 src/stores/CartStore.omni。   ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
import { CartStore } from "../stores/CartStore";

component InlineStoreDemo {
    @store CartStore;

    signal log: String = "";

    fn addApple() {
        CartStore.addItem("Apple", 5.0);
        log = "Added: Apple ¥5.0";
    }

    fn addBook() {
        CartStore.addItem("OmniView Guide", 39.9);
        log = "Added: OmniView Guide ¥39.9";
    }

    fn addLaptop() {
        CartStore.addItem("Laptop", 5999.0);
        log = "Added: Laptop ¥5999.0";
    }

    fn remove() {
        CartStore.removeLast();
        log = "Removed last item";
    }

    fn clearCart() {
        CartStore.clear();
        log = "Cart cleared";
    }

    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>Inline Store Demo</h3>
            <p>Items: {CartStore.itemCount}</p>
            <p>Summary: {CartStore.summary}</p>
            <p>Total: {CartStore.totalPrice}</p>
            <div class: LearnDesign.Row>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={addApple}>
                    Add Apple
                </button>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={addBook}>
                    Add Book
                </button>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={addLaptop}>
                    Add Laptop
                </button>
                <button variant: LearnDesign.Button(color=danger, size=sm) @onPress={remove}>
                    Remove
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={clearCart}>
                    Clear
                </button>
            </div>
            <p class: LearnDesign.Hint>{log}</p>
        </div>
    }
}
