import omniview;

component BlockExprDemo {
    signal a: i32 = 10;
    signal b: i32 = 5;

    // ★ 块表达式 computed: 在代码块中声明临时变量，最后一行作为块的值
    computed calculation: String = {
        let a2 = a * 2;
        let b2 = b * 3;
        "a×2=" + a2.to_string() + ", b×3=" + b2.to_string()
    };

    // ★ 块表达式用于数值计算
    computed total: i32 = {
        let tmp = a + b;
        let doubled = tmp * 2;
        doubled
    };

    // 作为对比：普通 computed 不用块
    computed simpleSum: i32 = a + b;

    fn incA() { a = a + 5; }
    fn incB() { b = b + 5; }
    fn reset() { a = 10; b = 5; }

    view {
        <div class: Container>
            <h3 class: Title>Block Expression Demo</h3>
            <p class: subtitle>演示 { stmts; trailing_expr } 块表达式</p>

            <div class: DemoCard>
                <h4 class: Label>输入值: a={a}, b={b}</h4>
                <div class: BtnRow>
                    <button class: Btn @onPress={incA}>a + 5</button>
                    <button class: Btn @onPress={incB}>b + 5</button>
                    <button class: BtnOutline @onPress={reset}>Reset</button>
                </div>
            </div>

            <div class: DemoCard>
                <h4 class: Label>块表达式 computed: calculation</h4>
                <p class: ValueText>{calculation}</p>
            </div>

            <div class: DemoCard>
                <h4 class: Label>块表达式 computed: total（块内临时变量加倍）</h4>
                <p class: ValueText>total = {total}</p>
            </div>

            <div class: DemoCard>
                <h4 class: Label>对比：普通 computed: simpleSum</h4>
                <p class: ValueText>simpleSum = a + b = {simpleSum}</p>
            </div>

            <p class: Note>块表达式允许在值上下文中声明临时变量，最后一行表达式即为块的值</p>
        </div>
    }
    style {
    
        .subtitle { font-size: 13px; color: var(--textSecondary); margin: 0 0 16px 0; }
    }
}
