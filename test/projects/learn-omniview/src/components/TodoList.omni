// ╔══════════════════════════════════════════════════════════════╗
// ║  TodoList.omni —— @for 列表渲染 + @empty 空状态 + 组件组合      ║
// ║  演示：跨文件导入组件和 Store、@for/@empty、                      ║
// ║        容器组件组合叶子组件、event 中继 → store action          ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
// 跨文件导入——从其他文件引用组件和 Store
import { TodoItem } from "./TodoItem";
import { TodoStore } from "../stores/TodoStore";
import { AddTodo } from "./AddTodo";

component TodoList {
    // 引用全局 Store——列表数据以 Store 为唯一数据源
    @store TodoStore;

    // event 中继——AddTodo 的 @onAdd → 本组件 → TodoStore.add
    fn handleAdd(text: String) {
        TodoStore.add(text);
    }

    // event 中继——TodoItem 的 @onDelete → 本组件 → TodoStore.remove
    fn handleDelete(id: i32) {
        TodoStore.remove(id);
    }

    // 按 filterStatus 过滤的可见列表——FilterBar 的搜索框写入 filterStatus
    computed visibleItems: Todo[] = TodoStore.items.filter(|item| TodoStore.filterStatus == "all" || item.text == TodoStore.filterStatus);

    view {
        <div>
            <h2 class: Title>待办列表
                <span class: LearnDesign.Badge style: { background: "#6366f1", color: "#fff" }>{TodoStore.totalCount}</span>
            </h2>

            <AddTodo @onAdd={handleAdd} />

            <div class: Items>
                @for item in visibleItems key={item.id} {
                    <TodoItem id={item.id} text={item.text} @onDelete={handleDelete} />
                }
                @empty {
                    <div class: EmptyState>
                        <p class: LearnDesign.Hint style: { font-size: "16px" }>还没有待办事项，在上方添加吧</p>
                    </div>
                }
            </div>
        </div>
    }
    style {
        // 待办列表特有的标题和空状态布局
        .title { font-size: 20px; padding: 16px 16px 0 16px; color: #1f2937; display: flex; align-items: center; gap: 8px; }
        // .badge / .empty-text 已由 LearnDesign.Badge / Hint 提供
    }
}
