// ╔══════════════════════════════════════════════════════════════╗
// ║  ThemeSwitcher.omni —— 主题切换器                              ║
// ║  演示：@store ThemeStore、__omni_theme 运行时、                 ║
// ║        @onPress 切换深浅色、computed 本地标签                    ║
// ║                                                                ║
// ║  主题颜色来自 design.omni 的 @themes 声明，不在 ThemeStore      ║
// ║  中维护，直接使用 var(--surface) 等 CSS 变量。                  ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
import { ThemeStore } from "../stores/ThemeStore";

component ThemeSwitcher {
    @store ThemeStore;

    // 本地信号：hover 状态追踪
    signal isHovered: bool = false;

    // computed 本地标签（仅依赖本地 signal）
    computed buttonLabel: String = if isHovered {
        "Switch to " + ThemeStore.nextLabel
    } else {
        ThemeStore.modeLabel + " Mode"
    };

    view {
        <div class: LearnDesign.Card>
            <!-- 当前主题指示器 -->
            <div class: indicator-row>
                <div
                    class: mode-indicator
                    style: { background: "var(--surface)", border: "2px solid var(--border)" }
                >
                    <span class: mode-label style: { color: "var(--textPrimary)" }>
                        {ThemeStore.modeLabel}
                    </span>
                </div>
                <p class: toggle-info>
                    Toggled {ThemeStore.toggleCount} times
                </p>
            </div>

            <!-- 切换按钮 -->
            <button
                class: toggle-btn
                style: { background: "var(--primary)", color: "var(--surface)" }
                @onPress={() => { ThemeStore.toggle(); }}
                @onMouseEnter={() => { isHovered = true; }}
                @onMouseLeave={() => { isHovered = false; }}
            >
                {buttonLabel}
            </button>

            <!-- 主题颜色预览 -->
            <div class: palette style: { background: "var(--surfaceMuted)" }>
                <p class: palette-label style: { color: "var(--textPrimary)" }>
                    Current palette:
                </p>
                <div class: swatches>
                    <span class: swatch style: { background: "var(--surface)", border: "1px solid var(--border)" }>BG</span>
                    <span class: swatch style: { background: "var(--textPrimary)", color: "var(--surface)" }>TX</span>
                    <span class: swatch style: { background: "var(--primary)", color: "white" }>PR</span>
                    <span class: swatch style: { background: "var(--border)" }>BD</span>
                    <span class: swatch style: { background: "var(--surfaceMuted)", color: "var(--textPrimary)" }>MU</span>
                </div>
            </div>

            <!-- 快捷模式切换 -->
            <div class: quick-actions>
                <button
                    variant: LearnDesign.Button(color=ghost, size=sm)
                    @onPress={() => { ThemeStore.setMode("light"); }}
                >
                    Light
                </button>
                <button
                    variant: LearnDesign.Button(color=ghost, size=sm)
                    @onPress={() => { ThemeStore.setMode("dark"); }}
                >
                    Dark
                </button>
            </div>
        </div>
    }
    style {
        // 主题切换器特有的布局样式
        .indicator-row { display: flex; align-items: center; gap: 12px; margin: 0 0 12px 0; }
        .mode-indicator { padding: 8px 14px; border-radius: var(--radiusMd); }
        .mode-label { font-size: 14px; font-weight: 600; }
        .toggle-info { font-size: 12px; color: var(--textSecondary); margin: 0; }
        .toggle-btn { padding: 10px 20px; border: none; border-radius: var(--radiusMd); font-size: 14px; font-weight: 600; cursor: pointer; width: 100%; margin: 0 0 12px 0; }
        .palette { padding: 12px; border-radius: var(--radiusMd); margin: 0 0 12px 0; }
        .palette-label { font-size: 12px; margin: 0 0 8px 0; }
        .swatches { display: flex; gap: 6px; }
        .swatch { padding: 4px 8px; border-radius: var(--radiusSm); font-size: 10px; font-weight: 600; }
        .quick-actions { display: flex; gap: 8px; }
    }
}
