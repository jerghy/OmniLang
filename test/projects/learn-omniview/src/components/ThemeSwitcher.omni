// ╔══════════════════════════════════════════════════════════════╗
// ║  ThemeSwitcher.omni —— 主题切换器（Phase 6）                    ║
// ║  演示：@store ThemeStore、getter 驱动样式、                      ║
// ║        @onPress 切换深浅色、computed 本地标签                    ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
import { ThemeStore } from "../stores/ThemeStore";

component ThemeSwitcher {
    @store ThemeStore;

    // 本地信号：hover 状态追踪
    signal isHovered: bool = false;

    // computed 本地标签（仅依赖本地 signal）
    computed buttonLabel: String = if isHovered {
        "Switch to " + ThemeStore.nextLabel
    } else {
        ThemeStore.modeLabel + " Mode"
    };

    view {
        <div class: LearnDesign.Card>
            <!-- 当前主题指示器 -->
            <div class: indicator-row>
                <div
                    class: mode-indicator
                    style: { background: ThemeStore.currentBg, border: "2px solid " + ThemeStore.currentBorder }
                >
                    <span class: mode-label style: { color: ThemeStore.currentText }>
                        {ThemeStore.modeLabel}
                    </span>
                </div>
                <p class: toggle-info>
                    Toggled {ThemeStore.toggleCount} times
                </p>
            </div>

            <!-- 切换按钮 -->
            <button
                class: toggle-btn
                style: { background: ThemeStore.currentPrimary, color: ThemeStore.currentBg }
                @onPress={() => { ThemeStore.toggle(); }}
                @onMouseEnter={() => { isHovered = true; }}
                @onMouseLeave={() => { isHovered = false; }}
            >
                {buttonLabel}
            </button>

            <!-- 主题颜色预览 -->
            <div class: palette style: { background: ThemeStore.currentMuted }>
                <p class: palette-label style: { color: ThemeStore.currentText }>
                    Current palette:
                </p>
                <div class: swatches>
                    <span class: swatch style: { background: ThemeStore.currentBg, border: "1px solid " + ThemeStore.currentBorder }>BG</span>
                    <span class: swatch style: { background: ThemeStore.currentText, color: ThemeStore.currentBg }>TX</span>
                    <span class: swatch style: { background: ThemeStore.currentPrimary, color: "white" }>PR</span>
                    <span class: swatch style: { background: ThemeStore.currentBorder }>BD</span>
                    <span class: swatch style: { background: ThemeStore.currentMuted, color: ThemeStore.currentText }>MU</span>
                </div>
            </div>

            <!-- 快捷模式切换 -->
            <div class: quick-actions>
                <button
                    variant: LearnDesign.Button(color=ghost, size=sm)
                    @onPress={() => { ThemeStore.setMode("light"); }}
                >
                    Light
                </button>
                <button
                    variant: LearnDesign.Button(color=ghost, size=sm)
                    style: { background: "#1f2937", color: "#f9fafb" }
                    @onPress={() => { ThemeStore.setMode("dark"); }}
                >
                    Dark
                </button>
            </div>
        </div>
    }
    style {
        // 主题切换器特有的布局和色板展示
        .indicator-row { display: flex; align-items: center; gap: 12px; margin: 0 0 12px 0; }
        .mode-indicator { padding: 8px 14px; border-radius: 8px; }
        .mode-label { font-size: 14px; font-weight: 600; }
        .toggle-info { font-size: 12px; color: #6b7280; margin: 0; }
        .toggle-btn { padding: 10px 20px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; width: 100%; margin: 0 0 12px 0; }
        .palette { padding: 12px; border-radius: 8px; margin: 0 0 12px 0; }
        .palette-label { font-size: 12px; margin: 0 0 8px 0; }
        .swatches { display: flex; gap: 6px; }
        .swatch { padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: 600; }
        .quick-actions { display: flex; gap: 8px; }
        // .theme-switcher / .quick-btn / .dark-btn 已由 LearnDesign.Card / Button 变体提供
    }
}
