// ╔══════════════════════════════════════════════════════════════╗
// ║  ThemeSwitcher.omni —— 4 主题卡片选择器                       ║
// ║                                                              ║
// ║  演示：                                                      ║
// ║  - @store ThemeStore（N 主题模式）                             ║
// ║  - CSS var() 驱动主题色预览                                  ║
// ║  - 鼠标悬停 + 选中态动画                                      ║
// ║                                                              ║
// ║  主题颜色来自 design.omni 的 @themes 声明，不在 ThemeStore    ║
// ║  中维护，直接使用 var(--primary) 等 CSS 变量。               ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
import { ThemeStore } from "../stores/ThemeStore";

component ThemeSwitcher {
    @store ThemeStore;

    fn isActive(theme: String) -> bool { return ThemeStore.mode == theme; }

    fn selectTheme(theme: String) {
        ThemeStore.setMode(theme);
    }

    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>Theme Selector</h3>
            <p class: LearnDesign.Subtitle>OmniLang supports N themes — not just light/dark</p>

            <div class: ThemeGrid>
                <div class: { themeCard: true, active: isActive("light") }
                     @onPress={() => { selectTheme("light"); }}>
                    <span class: CardIcon>☀️</span>
                    <span class: CardName>Light</span>
                    <div class: CardSwatches>
                        <span class: Swatch style: { background: "#6366f1" } />
                        <span class: Swatch style: { background: "#ffffff" } />
                        <span class: Swatch style: { background: "#111827" } />
                    </div>
                </div>

                <div class: { themeCard: true, active: isActive("dark") }
                     @onPress={() => { selectTheme("dark"); }}>
                    <span class: CardIcon>🌙</span>
                    <span class: CardName>Dark</span>
                    <div class: CardSwatches>
                        <span class: Swatch style: { background: "#a5b4fc" } />
                        <span class: Swatch style: { background: "#111827" } />
                        <span class: Swatch style: { background: "#f9fafb" } />
                    </div>
                </div>

                <div class: { themeCard: true, active: isActive("sepia") }
                     @onPress={() => { selectTheme("sepia"); }}>
                    <span class: CardIcon>📜</span>
                    <span class: CardName>Sepia</span>
                    <div class: CardSwatches>
                        <span class: Swatch style: { background: "#8B4513" } />
                        <span class: Swatch style: { background: "#F5E6C8" } />
                        <span class: Swatch style: { background: "#3E2723" } />
                    </div>
                </div>

                <div class: { themeCard: true, active: isActive("highContrast") }
                     @onPress={() => { selectTheme("highContrast"); }}>
                    <span class: CardIcon>🔲</span>
                    <span class: CardName>High Contrast</span>
                    <div class: CardSwatches>
                        <span class: Swatch style: { background: "#ffff00" } />
                        <span class: Swatch style: { background: "#000000" } />
                        <span class: Swatch style: { background: "#ffffff" } />
                    </div>
                </div>
            </div>

            <div class: StatusBar>
                <span class: status-text>
                    Current: {ThemeStore.modeLabel}
                </span>
                <span class: StatusCount>
                    Toggled {ThemeStore.toggleCount} times
                </span>
            </div>

            <div class: PalettePreview>
                <p class: PaletteTitle>Token Palette — <code>var(--name)</code> live</p>
                <div class: PaletteGrid>
                    <div class: PaletteChip style: { background: "var(--surface)", border: "1px solid var(--border)" }>
                        <span class: ChipLabel>--surface</span>
                    </div>
                    <div class: PaletteChip style: { background: "var(--primary)" }>
                        <span class: ChipLabel style: { color: "white" }>--primary</span>
                    </div>
                    <div class: PaletteChip style: { background: "var(--textPrimary)" }>
                        <span class: ChipLabel style: { color: "var(--surface)" }>--textPrimary</span>
                    </div>
                    <div class: PaletteChip style: { background: "var(--success)" }>
                        <span class: ChipLabel style: { color: "white" }>--success</span>
                    </div>
                    <div class: PaletteChip style: { background: "var(--warning)" }>
                        <span class: ChipLabel style: { color: "white" }>--warning</span>
                    </div>
                    <div class: PaletteChip style: { background: "var(--danger)" }>
                        <span class: ChipLabel style: { color: "white" }>--danger</span>
                    </div>
                </div>
            </div>

            <div class: HintBar>
                <span class: HintText>
                    💡 4 themes · CSS cascade via <code>[data-theme]</code> · zero JS per toggle
                </span>
            </div>
        </div>
    }

    style {
        .themeCard {
            flex: 1; min-width: 0;
            display: flex; flex-direction: column; align-items: center; gap: 8px;
            padding: 16px 12px;
            background: var(--surface);
            border: 2px solid var(--border);
            border-radius: var(--radiusLg);
            cursor: pointer;
            transition: all var(--durationFast);
        }
        .themeCard:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadowMd);
            border-color: var(--primaryLight);
        }
        .themeCard.active {
            border-color: var(--primary);
            box-shadow: "0 0 0 3px " var(--primaryLight);
            background: var(--surfaceMuted);
        }
        .status-text { font-size: var(--fontSizeSm); color: var(--textPrimary); font-weight: var(--fontWeightSemibold); }
        .PaletteTitle code { font-size: var(--fontSizeXs); background: var(--surfaceSubtle); padding: "1px 4px"; border-radius: "3px"; }
        .HintText code { font-size: var(--fontSizeXs); background: var(--surfaceSubtle); padding: "1px 4px"; border-radius: "3px"; }
    }
}
