// ╔══════════════════════════════════════════════════════════════╗
// ║  lib/math_ext.omni —— std/math 扩展函数演示                   ║
// ║  演示：math_min, max, pow, sin, cos, tan, log, log2, log10,  ║
// ║        pi, e, clamp, random_int, round                       ║
// ║  纯逻辑文件，不写 import omniview;                              ║
// ║  注：Map 用字面量构建（{ "key": value }）——`map.set()` 方法   ║
// ║  调用在 JS 目标无后端实现，且 `Map<String, T>` 返回类型注解   ║
// ║  尚未被类型检查器解析（见 .architecture/deferrals.md #28）    ║
// ╚══════════════════════════════════════════════════════════════╝

import { math_min, math_max, math_pow, math_sin, math_cos, math_tan,
         math_log, math_log2, math_log10, math_pi, math_e,
         math_clamp, math_random_int, math_round } from "std/math";

pub fn demo_math_min_max(a: f64, b: f64) {
    return { "min": math_min(a, b), "max": math_max(a, b) };
}

pub fn demo_trig(angle: f64) {
    return { "sin": math_sin(angle), "cos": math_cos(angle), "tan": math_tan(angle) };
}

pub fn demo_logs(x: f64) {
    return { "log": math_log(x), "log2": math_log2(x), "log10": math_log10(x) };
}

pub fn demo_constants() {
    return { "pi": math_pi(), "e": math_e() };
}

pub fn demo_clamp(val: f64, min: f64, max: f64) -> f64 {
    return math_clamp(val, min, max);
}

pub fn demo_random_in_range(min: i32, max: i32) -> i32 {
    return math_random_int(min, max);
}

pub fn demo_pow(base: f64, exp: f64) -> f64 {
    return math_pow(base, exp);
}

pub fn math_summary() -> String {
    let mm = demo_math_min_max(3.0, 7.0);
    let trig = demo_trig(0.5);
    let constants = demo_constants();
    return "min=" + mm.get("min").to_string()
        + " max=" + mm.get("max").to_string()
        + " sin=" + trig.get("sin").to_string()
        + " pi=" + constants.get("pi").to_string()
        + " clamp=" + demo_clamp(5.0, 1.0, 10.0).to_string()
        + " pow=" + demo_pow(2.0, 8.0).to_string()
        + " round=" + math_round(3.7).to_string();
}
