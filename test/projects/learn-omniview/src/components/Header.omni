// ╔══════════════════════════════════════════════════════════════╗
// ║  Header.omni —— 最简单的组件：view + style                     ║
// ║  演示：组件声明、静态标题、CSS 样式                            ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;

component Header {
    view {
        <header class: header>
            <!-- 标题：使用 h1 语义标签 -->
            <h1 class: title>OmniView 教学项目</h1>
            <!-- 副标题：项目特性简介 -->
            <p class: subtitle>涵盖 Store、Signal、Computed、Prop、Event、bind:value 等核心特性</p>
        </header>
    }
    style {
        .header { background: #6366f1; color: white; padding: 24px 16px; text-align: center; border-radius: 16px; margin-bottom: 16px; }
        .title { font-size: 28px; margin: 0 0 8px 0; }
        .subtitle { font-size: 13px; margin: 0; }
    }
}
