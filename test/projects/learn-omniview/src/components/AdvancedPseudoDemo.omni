import omniview;


component AdvancedPseudoDemo {
    signal isActive: bool = false;
    signal variant: String = "default";

    fn toggle() { isActive = !isActive; }
    fn setDefault() { variant = "default"; }
    fn setDark() { variant = "dark"; }

    view {
        <div class: Container>
            <h3 class: Title>Advanced CSS Selectors Demo</h3>
            <p class: Subtitle>演示 .class1.class2 组合选择器和 .class1.class2:hover 伪类链接</p>

            <div class: DemoCard>
                <h4 class: Label>组合选择器 .activeCard.cardActive</h4>
                <!-- ★ .activeCard.cardActive —— 两个 class 同时匹配时才生效 -->
                <div class: { activeCard: true, cardActive: isActive }>
                    <p>Toggle me to see .activeCard.cardActive style</p>
                </div>
                <button class: BtnOutline @onPress={toggle}>Toggle Active ({isActive ? "ON" : "OFF"})</button>
            </div>

            <div class: DemoCard>
                <h4 class: Label>组合选择器 + 伪类: .BtnDark:hover, .BtnDark:focus, .BtnDark:active</h4>
                <div class: BtnRow>
                    <button class: BtnDark @onPress={setDark}>
                        Dark Variant
                    </button>
                    <button class: BtnOutline @onPress={setDefault}>
                        Reset
                    </button>
                </div>
                <p class: Note>.BtnDark:hover .BtnDark:focus .BtnDark:active —— 三态组合伪类</p>
            </div>

            <div class: DemoCard>
                <h4 class: Label>多组合 + 多伪类: .PanelHighlight:hover, .PanelHighlight:focus</h4>
                <div class: PanelHighlight>
                    <p>Hover or Focus this panel</p>
                    <input class: PanelInput placeholder="Tab to focus me"></input>
                </div>
            </div>
        </div>
    }
    style {
        // ★ 组合选择器：两个 class 必须同时匹配
        .activeCard { padding: 16px; border-radius: 8px; background: "#f1f5f9"; color: #64748b; font-size: 14px; text-align: center; }
        .activeCard.cardActive { background: "#dcfce7"; color: #166534; border: 2px solid "#86efac"; }
        // ★ 简单伪类
        .BtnDark:hover { background: "#334155"; }
        .BtnDark:focus { outline: 2px solid "#fbbf24"; outline-offset: 2; }
        .BtnDark:active { background: "#0f172a"; transform: scale(0.97); }
        // ★ 多组合 + 多伪类
        .PanelHighlight:hover { background: "#fef08a"; border: 1px solid "#eab308"; }
        .PanelHighlight:focus { background: "#fefce8"; border: 1px solid "#6366f1"; }
    }
}
