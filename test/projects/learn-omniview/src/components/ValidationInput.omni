// ╔══════════════════════════════════════════════════════════════╗
// ║  ValidationInput.omni —— let + while + action + 三元运算符      ║
// ║                                                              ║
// ║  本组件演示：let 声明、while 循环、组件内 action（带参数/返回）、 ║
// ║  三元运算符（if-expr）。纯逻辑关键字（break/continue 等）见     ║
// ║  lib/transform.omni 与 components/StatsDashboard.omni。        ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
import { string_length, string_contains, string_trim } from "std/string";

component ValidationInput {
    signal input: String = "";
    signal result: String = "";
    signal isProcessing: bool = false;

    fn getDefaultMessage() -> String {
        let prefix = "Enter";
        let suffix = "text";
        return prefix + " " + suffix;
    }

    // while 循环 + 模运算 %
    fn countEvenPositions(text: String) -> i32 {
        let mut count = 0;
        let mut i = 0;
        while i < text.len() {
            if i % 2 == 0 { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    // 组件内 action（带参数和返回类型）
    action validate(text: String): String {
        let trimmed = string_trim(text);
        if trimmed == "" { return "Input cannot be empty"; }
        if string_length(trimmed) < 3 { return "Need at least 3 characters"; }
        if string_length(trimmed) > 50 { return "Cannot exceed 50 characters"; }
        if string_contains(trimmed, "@") { return "Email pattern not allowed in generic validation"; }
        return "OK Validation passed";
    }

    // 三元运算符（if-expr）在 return 中使用
    fn getStatusLabel() -> String {
        return if result == "" { "Waiting for input" } else { "Result ready" };
    }

    fn handleValidate() {
        isProcessing = true;
        result = validate(input);
        isProcessing = false;
    }

    fn handleClear() {
        input = "";
        result = "";
    }

    view {
        <div class: LearnDesign.Card>
            <h3 class: LearnDesign.CardTitle>ValidationInput Demo</h3>
            <p class: LearnDesign.Hint>{getDefaultMessage()}</p>

            <div class: row>
                <input bind:value={input} placeholder="Enter text to validate..." class: Input></input>
                <button variant: LearnDesign.Button(color=primary, size=md) @onPress={handleValidate}>
                    {if isProcessing { "..." } else { "Validate" }}
                </button>
                <button variant: LearnDesign.Button(color=danger, size=md) @onPress={handleClear}>Clear</button>
            </div>

            <div class: ResultArea>
                <p class: ResultText>Status: {getStatusLabel()}</p>
                <p class: ResultValue>
                    {if result == "" { "-" } else { result }}
                </p>
                <p class: Stats>Chars: {input.len()} | EvenPos: {countEvenPositions(input)}</p>
            </div>

        </div>
    }
    style {
        // 验证器特有的输入行布局和状态区
    
        .row { display: flex; gap: 8px; margin: 0 0 12px 0; }
    }
}
