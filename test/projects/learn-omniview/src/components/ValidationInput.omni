// ╔══════════════════════════════════════════════════════════════╗
// ║  ValidationInput.omni —— let + while + action + 三元运算符      ║
// ║                                                              ║
// ║  Phase 4 功能交叉引用（编译器限制：仅纯逻辑文件支持这些关键字）：  ║
// ║  · break/continue  → lib/transform.omni                      ║
// ║  · *= /= %=        → components/StatsDashboard.omni          ║
// ║  · return-in-while → lib/transform.omni (return-as-break)     ║
// ║                                                              ║
// ║  本组件演示：let、while、action、三元运算符                       ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { string_length, string_contains, string_trim } from "std/string";

component ValidationInput {
    signal input: String = "";
    signal result: String = "";
    signal isProcessing: bool = false;

    fn getDefaultMessage() -> String {
        let prefix = "Enter";
        let suffix = "text";
        return prefix + " " + suffix;
    }

    // while 循环 + 模运算 %
    fn countEvenPositions(text: String) -> i32 {
        let mut count = 0;
        let mut i = 0;
        while i < text.len() {
            if i % 2 == 0 { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    // 组件内 action（带参数和返回类型）
    action validate(text: String): String {
        let trimmed = string_trim(text);
        if trimmed == "" { return "Input cannot be empty"; }
        if string_length(trimmed) < 3 { return "Need at least 3 characters"; }
        if string_length(trimmed) > 50 { return "Cannot exceed 50 characters"; }
        if string_contains(trimmed, "@") { return "Email pattern not allowed in generic validation"; }
        return "OK Validation passed";
    }

    // 三元运算符（if-expr）在 return 中使用
    fn getStatusLabel() -> String {
        return if result == "" { "Waiting for input" } else { "Result ready" };
    }

    fn handleValidate() {
        isProcessing = true;
        result = validate(input);
        isProcessing = false;
    }

    fn handleClear() {
        input = "";
        result = "";
    }

    view {
        <div class: container>
            <h3 class: title>ValidationInput Demo</h3>
            <p class: hint>{getDefaultMessage()}</p>

            <div class: row>
                <input bind:value={input} placeholder="Enter text to validate..." class: input></input>
                <button class: btn-validate @onPress={handleValidate}>
                    {if isProcessing { "..." } else { "Validate" }}
                </button>
                <button class: btn-clear @onPress={handleClear}>Clear</button>
            </div>

            <div class: result-area>
                <p class: result-text>Status: {getStatusLabel()}</p>
                <p class: result-value>
                    {if result == "" { "-" } else { result }}
                </p>
                <p class: stats>Chars: {input.len()} | EvenPos: {countEvenPositions(input)}</p>
            </div>

            <!-- Phase 4 交叉引用提示 -->
            <div class: phase4-area>
                <h4 class: phase4-title>Phase 4: 表达式与控制流</h4>
                <p class: phase4-hint>See lib/transform.omni and StatsDashboard.omni for Phase 4 features</p>
            </div>
        </div>
    }
    style {
        .container { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; margin: 0 0 12px 0; color: #1f2937; }
        .hint { font-size: 13px; color: #9ca3af; margin: 0 0 12px 0; }
        .row { display: flex; gap: 8px; margin: 0 0 12px 0; }
        .input { flex: 1; padding: 12px; border: 2px solid #d4d4d8; border-radius: 8px; font-size: 16px; }
        .btn-validate { padding: 12px 20px; background: #6366f1; color: white; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; }
        .btn-clear { padding: 12px 16px; background: #fdf2f2; color: #dc2626; border: 1px solid #fdcaca; border-radius: 8px; font-size: 14px; cursor: pointer; }
        .result-area { background: #f9fafb; padding: 12px; border-radius: 8px; }
        .result-text { font-size: 14px; color: #6b7280; margin: 0 0 4px 0; }
        .result-value { font-size: 18px; font-weight: bold; color: #1f2937; margin: 0 0 4px 0; }
        .stats { font-size: 12px; color: #9ca3af; margin: 0; }
        .phase4-area { margin-top: 12px; padding: 10px 12px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px; }
        .phase4-title { font-size: 13px; font-weight: 600; color: #0369a1; margin: 0 0 4px 0; }
        .phase4-hint { font-size: 11px; color: #888; margin: 0; }
    }
}
