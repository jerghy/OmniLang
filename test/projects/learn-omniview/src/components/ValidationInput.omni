// ╔══════════════════════════════════════════════════════════════╗
// ║  ValidationInput.omni —— @form + validate: 规则声明             ║
// ║                                                              ║
// ║  本组件演示：@form 意图（@onSubmit 提交拦截 + 校验门禁）、       ║
// ║  validate: 规则（required/min/max/custom）、form.errors 显式    ║
// ║  错误渲染，以及 let 声明、while 循环、三元运算符（if-expr）。     ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
import { string_contains } from "std/string";

component ValidationInput {
    signal input: String = "";
    signal result: String = "";

    fn getDefaultMessage() -> String {
        let prefix = "Enter";
        let suffix = "text";
        return prefix + " " + suffix;
    }

    // while 循环 + 模运算 %
    fn countEvenPositions(text: String) -> i32 {
        let mut count = 0;
        let mut i = 0;
        while i < text.len() {
            if i % 2 == 0 { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    // validate: custom 规则——单参返回 String，非空串即错误消息
    fn noAtCheck(text: String) -> String {
        if string_contains(text, "@") { return "Email pattern not allowed in generic validation"; }
        return "";
    }

    // 三元运算符（if-expr）在 return 中使用
    fn getStatusLabel() -> String {
        return if result == "" { "Waiting for input" } else { "Result ready" };
    }

    // @form 提交处理——校验通过（@onSubmit 门禁拦截）后才会执行
    fn submit() {
        result = "OK Validation passed";
    }

    fn handleClear() {
        input = "";
        result = "";
    }

    view {
        <div class: LearnDesign.Card>
            <h3 class: LearnDesign.CardTitle>ValidationInput Demo</h3>
            <p class: LearnDesign.Hint>{getDefaultMessage()}</p>

            <form @form @onSubmit={submit}>
                <div class: row>
                    <input
                        bind:value={input}
                        placeholder="Enter text to validate..."
                        class: Input
                        validate: { required: true, min: 3, max: 50, custom: noAtCheck }
                    ></input>
                    <button variant: LearnDesign.Button(color=primary, size=md) type="submit">
                        Validate
                    </button>
                    <button variant: LearnDesign.Button(color=danger, size=md) type="button" @onPress={handleClear}>Clear</button>
                </div>
                @if form.errors.input {
                    <p class: ErrorText id="err-input">{form.errors.input}</p>
                }
            </form>

            <div class: ResultArea>
                <p class: ResultText>Status: {getStatusLabel()}</p>
                <p class: ResultValue>
                    {if result == "" { "-" } else { result }}
                </p>
                <p class: Stats>Chars: {input.len()} | EvenPos: {countEvenPositions(input)} | Submitting: {form.submitting}</p>
            </div>

        </div>
    }
    style {
        // 验证器特有的输入行布局和状态区

        .row { display: flex; gap: 8px; margin: 0 0 12px 0; }
    }
}
