// ╔══════════════════════════════════════════════════════════════╗
// ║  ElementRefDemo.omni — Element Reference System               ║
// ║                                                              ║
// ║  演示 ref 声明 + @ref 绑定 + 语义化 ref 操作 API:            ║
// ║    · ref name: Element   — 元素引用声明                      ║
// ║    · @ref={name}         — 绑定到元素                        ║
// ║    · style: { width: sig } — 信号驱动样式绑定                 ║
// ║    · .focus() / .blur()  — 焦点管理（命令式）                ║
// ║    · focus={sig}         — 语义化焦点绑定（信号驱动 focus/blur）║
// ║    · .select() / .setSelection(s, e) — 文本全选 / 选区控制    ║
// ║    · scroll-y={sig}      — 响应式滚动绑定                    ║
// ║    · .scrollTo() / .scrollBy() — 命令式滚动控制（可单参）      ║
// ║    · .measure()          — 位置/尺寸查询                      ║
// ║    · .width/.height/.position — 字段读取形式（measure 简写）    ║
// ║    · scrollTo(0, ref.measure().y) — 嵌套 ref 操作组合          ║
// ║    · @drag / @dragEnd — 拖拽意图（指针捕获为编译器内部细节）      ║
// ║    · @ref + @drag + style 绑定 — 高频拖拽意图（零中间层）      ║
// ║    · @drag-horizontal / @drag-vertical — scrubbing 语法糖     ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";

// ── Scrubbing 动画（@drag-* 语法糖）：手势进度映射到 keyframe 范围 ──
@motion dragX300 {
    from { translateX: 0 }
    to   { translateX: 300 }
    over: 300ms
    easing: power2-out
}
@motion dragX150 {
    from { translateX: 0 }
    to   { translateX: 150 }
    over: 300ms
    easing: power2-out
}
@motion dragY100 {
    from { translateY: 0 }
    to   { translateY: 100 }
    over: 300ms
    easing: power2-out
}

component ElementRefDemo {
    // ── ref 声明 ──
    ref inputBox: Element;
    ref scrollArea: Element;
    ref rectBox: Element;
    ref sizeBox: Element;
    ref mirrorInput: Element;
    ref selectInput: Element;
    ref rangeInput: Element;
    ref focusSigInput: Element;
    ref pointerBox: Element;
    ref dragBox: Element;

    // ── 本地信号 ──
    signal focusStatus: String = "not focused";
    signal scrollPos: String = "top";
    signal scrollTarget: f64 = 0;           // 驱动 scroll-y={scrollTarget} 绑定
    signal rectInfo: String = "—";
    signal boxWidth: f64 = 200;             // measure() 查询结果（仅查询写入）
    signal boxHeight: f64 = 80;             // measure() 高度查询结果（仅查询写入）
    signal boxWidthNum: f64 = 200;          // 滑块/按钮驱动（高频连续变更 → 数值绑定）
    signal boxHeightNum: f64 = 80;          // 按钮驱动的 style 值（数值）
    computed boxWidthPx: String = boxWidthNum.to_string() + "px";   // 派生 px 显示串
    computed boxHeightPx: String = boxHeightNum.to_string() + "px"; // 派生 px 显示串
    signal mirrorText: String = "";
    signal selectText: String = "0123456789 全选演示文本";
    signal selectStatus: String = "—";
    signal rangeText: String = "0123456789";
    signal rangeStatus: String = "—";
    signal shouldFocus: Bool = false;       // 驱动 focus={shouldFocus} 绑定
    signal sigFocusStatus: String = "focus=false";
    signal pointerActive: Bool = false;     // 指针捕获中的视觉状态
    signal pointerStatus: String = "free";
    signal dragging: Bool = false;          // 拖拽中（视觉状态 → class 绑定）
    signal dragX: f64 = 0;                  // 拖拽位移（→ style transform 绑定）
    signal dragY: f64 = 0;

    // ── @mount：挂载后置 shouldFocus = true → focus={shouldFocus} 绑定自动聚焦 ──
    @mount {
        shouldFocus = true;
        sigFocusStatus = "focus=true（挂载自动聚焦）";
    }

    // ── 焦点操作（命令式 RefOp：.focus() / .blur()） ──
    fn focusInput() {
        inputBox.focus();
        focusStatus = "focused";
    }
    fn blurInput() {
        inputBox.blur();
        focusStatus = "blurred";
    }

    // ── 滚动控制：响应式 scroll-y 绑定 + 命令式 .scrollBy / .scrollTo ──
    // scroll-y={scrollTarget} 是 scrollTo 的响应式形态：按钮只更新信号，
    // 绑定自动驱动元素滚动；.scrollBy(0, 100) 增量滚动与 .scrollTo(0, y)
    // 定点跳转保持命令式（与绑定互补）。
    fn scrollToTop() {
        scrollTarget = 0;
        scrollPos = "top";
    }
    fn scrollToBottom() {
        scrollTarget = 9999;
        scrollPos = "bottom";
    }
    fn scrollByDown() {
        scrollArea.scrollBy(0, 100);
        scrollPos = "scrolled +100px";
    }
    fn scrollToDirect() {
        scrollArea.scrollTo(0, 0);
        scrollPos = "scrollTo(0, 0)";
    }
    fn scrollTo200() {
        scrollArea.scrollTo(0, 200);
        scrollPos = "scrollTo(0, 200)";
    }

    // ── 嵌套 ref 操作组合：测量结果直接作滚动参数 ──
    // scrollTo(0, rectBox.measure().y)：先测量目标盒当前位置，再滚动
    // 滚动区到该 y —— 一次调用完成「测量 + 定位」，参数可以是任意
    // 表达式（信号、字段读取、甚至另一个 ref 操作）。
    fn scrollToMeasuredRect() {
        scrollArea.scrollTo(0, rectBox.measure().y);
        scrollPos = "scrolled to rectBox 顶部（嵌套 ref 操作）";
    }

    // ── 位置查询（ref.measure()） ──
    fn queryRect() {
        let rect = rectBox.measure();
        rectInfo = "x:" + rect.x.to_string() + " y:" + rect.y.to_string()
                 + " w:" + rect.width.to_string() + " h:" + rect.height.to_string();
    }

    // ── 尺寸查询（ref.measure().width / .height） ──
    fn querySize() {
        let w = sizeBox.measure().width;
        let h = sizeBox.measure().height;
        boxWidth = w;
        boxHeight = h;
    }

    // ── 字段读取形式（ref.width / ref.height / ref.position） ──
    // 字段读取 = measure() 的简写：ref.width → getBoundingClientRect().width，
    // ref.position → getBoundingClientRect()（DOMRect，可继续 .x/.y 访问）。
    fn querySizeFields() {
        boxWidth = sizeBox.width;
        boxHeight = sizeBox.height;
    }
    fn queryPositionField() {
        let pos = rectBox.position;
        rectInfo = "x:" + pos.x.to_string() + " y:" + pos.y.to_string() + "（字段读取 ref.position）";
    }

    // ── 信号驱动样式（style: { width: sig } 绑定，替代 ref.style 直接操作） ──
    // 绑定数值信号（f64）——Flutter 的 width/height 参数是 double，String
    // px 值无法映射（编译期诊断）；px 显示串由 computed 派生（boxWidthPx）。
    fn expandBox() {
        boxWidthNum = 300;
        boxHeightNum = 120;
    }
    fn resetBox() {
        boxWidthNum = 200;
        boxHeightNum = 80;
    }

    // ── 多 ref 联动（输入 → 镜像） ──
    fn syncMirror() {
        let val = mirrorInput.value;
        mirrorText = val;
    }

    // ── 文本全选（.select()） ──
    fn selectAllText() {
        selectInput.select();
        selectStatus = "已全选 " + selectText.len().to_string() + " 字符";
    }

    // ── 选区控制（.setSelection(start, end) → setSelectionRange） ──
    fn selectFirst3() {
        rangeInput.setSelection(0, 3);
        rangeStatus = "已调用 setSelection(0, 3)";
    }
    fn selectMiddle5() {
        rangeInput.setSelection(2, 7);
        rangeStatus = "已调用 setSelection(2, 7)";
    }
    // @onSelect 事件数据（SelectEvent: start/end/text）实时回显选区
    fn onRangeSelect(e) {
        rangeStatus = "选区 [" + e.start.to_string() + ", " + e.end.to_string() + ") 文本: " + e.text;
    }

    // ── 语义绑定 focus={sig}（信号驱动 focus/blur） ──
    fn toggleFocusSig() {
        shouldFocus = !shouldFocus;
        if shouldFocus {
            sigFocusStatus = "focus=true（已聚焦）";
        } else {
            sigFocusStatus = "focus=false（已失焦）";
        }
    }

    // ── 拖拽意图（@drag / @dragEnd，ADR-071/073） ──
    // 指针捕获降级为编译器内部细节：React setPointerCapture / Flutter
    // GestureDetector pan（onPanStart 即手势竞技场获胜）/ OmniView
    // capturePointer 原语——源码只写 @drag 意图，捕获后指针移出元素仍跟随。
    // 事件数据 {x, y, dx, dy, pointerId, startX, startY}：dx/dy 为相对
    // 按下点的累计位移。
    fn onPtrDrag() {
        pointerActive = true;
        pointerStatus = "dragging";
    }
    fn onPtrEnd() {
        pointerActive = false;
        pointerStatus = "released";
    }

    // ── 高频拖拽（@drag 意图） ──
    // 移动元素 = @drag 意图直接驱动 style 绑定，零中间层：编译器接线捕获，
    // @drag 处理器把 dx/dy 累计位移写入 dragX/dragY 信号，transform 绑定
    // 即时跟随。无 duration/easing/keyframes —— 高频操作就是要简单直接
    // （@drag-* 仅作 scrubbing 语法糖，见下方 section）。
    fn onDragMove(e) {
        dragging = true;
        dragX = e.dx;
        dragY = e.dy;
    }
    fn onDragEnd() {
        dragging = false;
    }

    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>Element Reference System</h3>
            <p class: LearnDesign.Subtitle>ref · @ref · .focus() · .select() · .setSelection() · .width/.height/.position 字段读取 · 嵌套组合 scrollTo(0, ref.measure().y) · @drag 意图</p>

            <!-- ═══ 焦点管理 ═══ -->
            <h4 class: LearnDesign.SectionTitle>焦点管理 (.focus / .blur)</h4>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={inputBox}
                    @onInput={() => {}}
                    placeholder="ref-bound input"
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={focusInput}>
                    Focus
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={blurInput}>
                    Blur
                </button>
                <span class: StatusText>Status: {focusStatus}</span>
            </div>

            <!-- ═══ 文本全选 ═══ -->
            <h4 class: LearnDesign.SectionTitle>文本全选 (.select)</h4>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={selectInput}
                    bind:value={selectText}
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={selectAllText}>
                    全选
                </button>
                <span class: StatusText>{selectStatus}</span>
            </div>

            <!-- ═══ 选区控制 ═══ -->
            <h4 class: LearnDesign.SectionTitle>选区控制 (.setSelection(start, end))</h4>
            <p class: LearnDesign.Hint>
                点击按钮调用 setSelection(start, end)（→ setSelectionRange）；手动拖动文本时
                @onSelect 事件（SelectEvent: start/end/text）也会实时回显选区
            </p>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={rangeInput}
                    bind:value={rangeText}
                    @onSelect={onRangeSelect}
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={selectFirst3}>
                    前 3 字符 (0, 3)
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={selectMiddle5}>
                    中间 5 字符 (2, 7)
                </button>
                <span class: StatusText>{rangeStatus}</span>
            </div>

            <!-- ═══ 语义绑定 focus={sig} ═══ -->
            <h4 class: LearnDesign.SectionTitle>语义绑定 (focus={"{}"}sig{"{}"})</h4>
            <p class: LearnDesign.Hint>
                focus={shouldFocus} 把布尔信号绑定到元素焦点：true → .focus()，false → .blur()。
                @mount 中置 true，进入本页即自动聚焦。
            </p>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={focusSigInput}
                    focus={shouldFocus}
                    placeholder="focus={shouldFocus} 驱动"
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={toggleFocusSig}>
                    切换 focus={shouldFocus}
                </button>
                <span class: StatusText>{sigFocusStatus}</span>
            </div>

            <!-- ═══ 滚动控制 ═══ -->
            <h4 class: LearnDesign.SectionTitle>滚动控制 (scroll-y 绑定 + .scrollBy + .scrollTo + 嵌套组合)</h4>
            <div scroll-y={scrollTarget} @ref={scrollArea} class: ScrollBox>
                <p class: ScrollItem>Item 1 — 滚动演示区域</p>
                <p class: ScrollItem>Item 2 — 使用 scroll-y 绑定跳转</p>
                <p class: ScrollItem>Item 3 — 使用 .scrollBy() 增量</p>
                <p class: ScrollItem>Item 4 — Element Ref API</p>
                <p class: ScrollItem>Item 5 — Element Ref API 全集</p>
                <p class: ScrollItem>Item 6 — 底部</p>
            </div>
            <div class: LearnDesign.Row>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollToTop}>
                    Scroll To Top
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollToBottom}>
                    Scroll To Bottom
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollByDown}>
                    ScrollBy +100px
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollToDirect}>
                    scrollTo(0, 0)
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollTo200}>
                    scrollTo(0, 200)
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={scrollToMeasuredRect}>
                    scrollTo(0, rectBox.measure().y)
                </button>
                <span class: StatusText>Pos: {scrollPos}</span>
            </div>

            <!-- ═══ 位置查询 ═══ -->
            <h4 class: LearnDesign.SectionTitle>位置查询 (.measure / .position 字段读取)</h4>
            <div @ref={rectBox} class: RectBox>
                <p>Query Box — click "Query Rect" to read position</p>
            </div>
            <div class: LearnDesign.Row>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={queryRect}>
                    Query Rect (.measure)
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={queryPositionField}>
                    Query Position (字段读取)
                </button>
                <span class: StatusText>{rectInfo}</span>
            </div>

            <!-- ═══ 尺寸查询 + 样式绑定 ═══ -->
            <h4 class: LearnDesign.SectionTitle>尺寸查询 + 样式绑定 (.measure / style 绑定)</h4>
            <p class: LearnDesign.Hint>
                连续属性变更 = 信号 + 声明式绑定：拖动滑块连续更新 boxWidthNum，
                绑定实时生效 —— 无命令式 DOM 写入。绑定用数值信号（Flutter
                width/height 参数是 double），px 显示串由 computed 派生。
                尺寸查询有方法形式（.measure().width）与字段读取形式（.width）两种写法，
                字段读取是 measure 的简写，同样返回响应式数值。
            </p>
            <div class: DemoRow>
                <div @ref={sizeBox} class: SizeBox
                    style: { width: boxWidthNum, height: boxHeightNum }>
                    <p>resize via style binding</p>
                </div>
                <input type="range" min="120" max="400" bind:value={boxWidthNum} class: DemoRange />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={querySize}>
                    Query Size
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={querySizeFields}>
                    Query Size (字段读取)
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={expandBox}>
                    Expand
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={resetBox}>
                    Reset
                </button>
                <span class: StatusText>Width: {boxWidthPx} · 实测: {boxWidth}px · Height: {boxHeightPx} · 实测: {boxHeight}px</span>
            </div>

            <!-- ═══ 多 ref 联动 ═══ -->
            <h4 class: LearnDesign.SectionTitle>多 ref 联动 (.value)</h4>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={mirrorInput}
                    placeholder="Type here..."
                    @onInput={syncMirror}
                />
                <span class: MirrorText>
                    Mirror: {mirrorText}
                </span>
            </div>

            <!-- ═══ 拖拽意图 @drag（指针捕获为编译器内部细节） ═══ -->
            <h4 class: LearnDesign.SectionTitle>拖拽意图 (@drag / @dragEnd)</h4>
            <p class: LearnDesign.Hint>
                指针按下 → 编译器接线捕获（{'ADR-071/073'}）：React setPointerCapture / Flutter
                GestureDetector pan（手势竞技场）/ OmniView capturePointer 原语——源码只写
                @drag 意图。事件数据 {'{x, y, dx, dy, pointerId, startX, startY}'}：dx/dy 为
                相对按下点的累计位移；捕获后指针移出元素仍跟随（隐式捕获语义）。
            </p>
            <div class: DemoRow>
                <div
                    @ref={pointerBox}
                    @drag={onPtrDrag}
                    @dragEnd={onPtrEnd}
                    class: { Pointerbox: true, PointerCaptured: pointerActive }
                >
                    <p>Press & hold me</p>
                </div>
                <span class: StatusText>Pointer: {pointerStatus}</span>
            </div>

            <!-- ═══ 高频拖拽（@drag 意图） ═══ -->
            <h4 class: LearnDesign.SectionTitle>高频拖拽 (@drag 意图)</h4>
            <p class: LearnDesign.Hint>
                拖拽移动元素用 @drag 意图而非动画：编译器接线捕获（React
                setPointerCapture / Flutter GestureDetector pan / OmniView
                capturePointer），@drag 处理器把 dx/dy 累计位移写入 dragX/dragY
                信号，style 的 transform 绑定即时跟随 —— 无 duration/easing/
                keyframes，高频操作就是简单直接。
            </p>
            <div class: LearnDesign.Row>
                <div
                    @ref={dragBox}
                    @drag={onDragMove}
                    @dragEnd={onDragEnd}
                    style: { transform: "translate(" + dragX + "px, " + dragY + "px)" }
                    class: { DragBox: true, DragBoxActive: dragging }
                >
                    <p>↔ Drag me（直接跟随指针）</p>
                </div>
            </div>

            <h4 class: LearnDesign.SectionTitle>手势 Scrubbing (@drag-horizontal / @drag-vertical)</h4>
            <p class: LearnDesign.Hint>
                @drag-* 是 scrubbing 语法糖：手势进度映射到 motion 自身的 keyframe 范围
                （水平 translateX / 垂直 translateY），由 WAAPI 动画引擎驱动 —— 适合
                「滑动解锁」式进度控制；移动元素用上方 @drag 意图。
                constraints: [min, max] 限定手势范围（超出部分由 elastic 回弹）。
            </p>
            <div class: ConstraintsRow>
                <div @drag-horizontal={dragX300} class: DragDemoBox>
                    <p>↔ 无约束（keyframe 300px）</p>
                </div>
                <div @drag-horizontal constraints: [-150, 150] elastic: 0.4={dragX150} class: DragDemoBox>
                    <p>↔ 约束 ±150px</p>
                </div>
                <div @drag-vertical constraints: [0, 100] elastic: 0.5={dragY100} class: DragDemoBox>
                    <p>↕ 约束 0–100px</p>
                </div>
            </div>
        </div>
    }

    style {
        .SizeBox p { font-size: var(--fontSizeXs); color: white; margin: 0; }
        .Pointerbox p { font-size: var(--fontSizeXs); color: var(--textSecondary); margin: 0; }
        .PointerCaptured p { color: white; }
        .DragBox p { font-size: var(--fontSizeXs); color: var(--textSecondary); margin: 0; }
        .DragBoxActive p { color: white; }
        .DragBoxActive { cursor: grabbing; }
        .DragDemoBox p { font-size: var(--fontSizeXs); margin: 0; }
    }
}
