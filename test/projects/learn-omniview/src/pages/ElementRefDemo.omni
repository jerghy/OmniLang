// ╔══════════════════════════════════════════════════════════════╗
// ║  ElementRefDemo.omni — Element Reference System               ║
// ║                                                              ║
// ║  演示 ref 声明 + @ref 绑定 + 语义化 ref 操作 API:            ║
// ║    · ref name: Element   — 元素引用声明                      ║
// ║    · @ref={name}         — 绑定到元素                        ║
// ║    · style: { width: sig } — 信号驱动样式绑定                 ║
// ║    · .focus() / .blur()  — 焦点管理（命令式）                ║
// ║    · focus={sig}         — 语义化焦点绑定（信号驱动 focus/blur）║
// ║    · .select() / .setSelection(s, e) — 文本全选 / 选区控制    ║
// ║    · scroll-y={sig}      — 响应式滚动绑定                    ║
// ║    · .scrollTo() / .scrollBy() — 命令式滚动控制              ║
// ║    · .measure()          — 位置/尺寸查询                      ║
// ║    · .capturePointer() / .releasePointer() — 指针捕获         ║
// ║    · @drag-horizontal / @drag-vertical — 拖拽触发器 + motion 接线 ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";

// ── 拖拽动画：translateX/Y 映射到拖拽范围，元素跟随拖拽进度 ──
@motion dragX300 {
    from { translateX: 0 }
    to   { translateX: 300 }
    over: 300ms
    easing: power2-out
}
@motion dragX150 {
    from { translateX: 0 }
    to   { translateX: 150 }
    over: 300ms
    easing: power2-out
}
@motion dragY100 {
    from { translateY: 0 }
    to   { translateY: 100 }
    over: 300ms
    easing: power2-out
}

component ElementRefDemo {
    // ── ref 声明 ──
    ref inputBox: Element;
    ref scrollArea: Element;
    ref rectBox: Element;
    ref sizeBox: Element;
    ref mirrorInput: Element;
    ref selectInput: Element;
    ref rangeInput: Element;
    ref focusSigInput: Element;
    ref pointerBox: Element;

    // ── 本地信号 ──
    signal focusStatus: String = "not focused";
    signal scrollPos: String = "top";
    signal scrollTarget: f64 = 0;           // 驱动 scroll-y={scrollTarget} 绑定
    signal rectInfo: String = "—";
    signal boxWidth: f64 = 200;             // measure() 查询结果（仅查询写入）
    signal boxHeight: f64 = 80;             // measure() 高度查询结果（仅查询写入）
    signal boxWidthPx: String = "200px";    // style 绑定值（含单位）
    signal boxHeightPx: String = "80px";
    signal mirrorText: String = "";
    signal selectText: String = "0123456789 全选演示文本";
    signal selectStatus: String = "—";
    signal rangeText: String = "0123456789";
    signal rangeStatus: String = "—";
    signal shouldFocus: Bool = false;       // 驱动 focus={shouldFocus} 绑定
    signal sigFocusStatus: String = "focus=false";
    signal pointerActive: Bool = false;     // 指针捕获中的视觉状态
    signal pointerStatus: String = "free";

    // ── @mount：挂载后置 shouldFocus = true → focus={shouldFocus} 绑定自动聚焦 ──
    @mount {
        shouldFocus = true;
        sigFocusStatus = "focus=true（挂载自动聚焦）";
    }

    // ── 焦点操作（命令式 RefOp：.focus() / .blur()） ──
    fn focusInput() {
        inputBox.focus();
        focusStatus = "focused";
    }
    fn blurInput() {
        inputBox.blur();
        focusStatus = "blurred";
    }

    // ── 滚动控制：响应式 scroll-y 绑定 + 命令式 .scrollBy / .scrollTo ──
    // scroll-y={scrollTarget} 是 scrollTo 的响应式形态：按钮只更新信号，
    // 绑定自动驱动元素滚动；.scrollBy(0, 100) 增量滚动与 .scrollTo(0, y)
    // 定点跳转保持命令式（与绑定互补）。
    fn scrollToTop() {
        scrollTarget = 0;
        scrollPos = "top";
    }
    fn scrollToBottom() {
        scrollTarget = 9999;
        scrollPos = "bottom";
    }
    fn scrollByDown() {
        scrollArea.scrollBy(0, 100);
        scrollPos = "scrolled +100px";
    }
    fn scrollToDirect() {
        scrollArea.scrollTo(0, 0);
        scrollPos = "scrollTo(0, 0)";
    }
    fn scrollTo200() {
        scrollArea.scrollTo(0, 200);
        scrollPos = "scrollTo(0, 200)";
    }

    // ── 位置查询（ref.measure()） ──
    fn queryRect() {
        let rect = rectBox.measure();
        rectInfo = "x:" + rect.x.to_string() + " y:" + rect.y.to_string()
                 + " w:" + rect.width.to_string() + " h:" + rect.height.to_string();
    }

    // ── 尺寸查询（ref.measure().width / .height） ──
    fn querySize() {
        let w = sizeBox.measure().width;
        let h = sizeBox.measure().height;
        boxWidth = w;
        boxHeight = h;
    }

    // ── 信号驱动样式（style: { width: sig } 绑定，替代 ref.style 直接操作） ──
    fn expandBox() {
        boxWidthPx = "300px";
        boxHeightPx = "120px";
    }
    fn resetBox() {
        boxWidthPx = "200px";
        boxHeightPx = "80px";
    }

    // ── 多 ref 联动（输入 → 镜像） ──
    fn syncMirror() {
        let val = mirrorInput.value;
        mirrorText = val;
    }

    // ── 文本全选（.select()） ──
    fn selectAllText() {
        selectInput.select();
        selectStatus = "已全选 " + selectText.len().to_string() + " 字符";
    }

    // ── 选区控制（.setSelection(start, end) → setSelectionRange） ──
    fn selectFirst3() {
        rangeInput.setSelection(0, 3);
        rangeStatus = "已调用 setSelection(0, 3)";
    }
    fn selectMiddle5() {
        rangeInput.setSelection(2, 7);
        rangeStatus = "已调用 setSelection(2, 7)";
    }
    // @onSelect 事件数据（SelectEvent: start/end/text）实时回显选区
    fn onRangeSelect(e) {
        rangeStatus = "选区 [" + e.start.to_string() + ", " + e.end.to_string() + ") 文本: " + e.text;
    }

    // ── 语义绑定 focus={sig}（信号驱动 focus/blur） ──
    fn toggleFocusSig() {
        shouldFocus = !shouldFocus;
        if shouldFocus {
            sigFocusStatus = "focus=true（已聚焦）";
        } else {
            sigFocusStatus = "focus=false（已失焦）";
        }
    }

    // ── 指针捕获（.capturePointer / .releasePointer，无参形式） ──
    // 语义 = 「锁定后续指针事件到本元素」：无参调用，由各目标运行时自动
    // 使用活动指针（pointerdown 的 pointerId）；有参调用是编译错误。
    fn onPtrDown() {
        pointerBox.capturePointer();
        pointerActive = true;
        pointerStatus = "captured";
    }
    fn onPtrUp() {
        pointerBox.releasePointer();
        pointerActive = false;
        pointerStatus = "released";
    }

    // ── 高频拖拽 ──
    // 拖拽由 @drag-horizontal / @drag-vertical 触发器 + @motion 驱动
    // （声明式，无手动 DOM 写入）。

    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>Element Reference System</h3>
            <p class: LearnDesign.Subtitle>ref · @ref · .focus() · .select() · .setSelection() · focus={"{sig}"} · scroll-y · .scrollTo() · .capturePointer()</p>

            <!-- ═══ 焦点管理 ═══ -->
            <h4 class: LearnDesign.SectionTitle>焦点管理 (.focus / .blur)</h4>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={inputBox}
                    @onInput={() => {}}
                    placeholder="ref-bound input"
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={focusInput}>
                    Focus
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={blurInput}>
                    Blur
                </button>
                <span class: StatusText>Status: {focusStatus}</span>
            </div>

            <!-- ═══ 文本全选 ═══ -->
            <h4 class: LearnDesign.SectionTitle>文本全选 (.select)</h4>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={selectInput}
                    bind:value={selectText}
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={selectAllText}>
                    全选
                </button>
                <span class: StatusText>{selectStatus}</span>
            </div>

            <!-- ═══ 选区控制 ═══ -->
            <h4 class: LearnDesign.SectionTitle>选区控制 (.setSelection(start, end))</h4>
            <p class: LearnDesign.Hint>
                点击按钮调用 setSelection(start, end)（→ setSelectionRange）；手动拖动文本时
                @onSelect 事件（SelectEvent: start/end/text）也会实时回显选区
            </p>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={rangeInput}
                    bind:value={rangeText}
                    @onSelect={onRangeSelect}
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={selectFirst3}>
                    前 3 字符 (0, 3)
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={selectMiddle5}>
                    中间 5 字符 (2, 7)
                </button>
                <span class: StatusText>{rangeStatus}</span>
            </div>

            <!-- ═══ 语义绑定 focus={sig} ═══ -->
            <h4 class: LearnDesign.SectionTitle>语义绑定 (focus={"{}"}sig{"{}"})</h4>
            <p class: LearnDesign.Hint>
                focus={shouldFocus} 把布尔信号绑定到元素焦点：true → .focus()，false → .blur()。
                @mount 中置 true，进入本页即自动聚焦。
            </p>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={focusSigInput}
                    focus={shouldFocus}
                    placeholder="focus={shouldFocus} 驱动"
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={toggleFocusSig}>
                    切换 focus={shouldFocus}
                </button>
                <span class: StatusText>{sigFocusStatus}</span>
            </div>

            <!-- ═══ 滚动控制 ═══ -->
            <h4 class: LearnDesign.SectionTitle>滚动控制 (scroll-y 绑定 + .scrollBy + .scrollTo)</h4>
            <div scroll-y={scrollTarget} @ref={scrollArea} class: ScrollBox>
                <p class: ScrollItem>Item 1 — 滚动演示区域</p>
                <p class: ScrollItem>Item 2 — 使用 scroll-y 绑定跳转</p>
                <p class: ScrollItem>Item 3 — 使用 .scrollBy() 增量</p>
                <p class: ScrollItem>Item 4 — Element Ref API</p>
                <p class: ScrollItem>Item 5 — Element Ref API 全集</p>
                <p class: ScrollItem>Item 6 — 底部</p>
            </div>
            <div class: LearnDesign.Row>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollToTop}>
                    Scroll To Top
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollToBottom}>
                    Scroll To Bottom
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollByDown}>
                    ScrollBy +100px
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollToDirect}>
                    scrollTo(0, 0)
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollTo200}>
                    scrollTo(0, 200)
                </button>
                <span class: StatusText>Pos: {scrollPos}</span>
            </div>

            <!-- ═══ 位置查询 ═══ -->
            <h4 class: LearnDesign.SectionTitle>位置查询 (.measure)</h4>
            <div @ref={rectBox} class: RectBox>
                <p>Query Box — click "Query Rect" to read position</p>
            </div>
            <div class: LearnDesign.Row>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={queryRect}>
                    Query Rect
                </button>
                <span class: StatusText>{rectInfo}</span>
            </div>

            <!-- ═══ 尺寸查询 + 样式绑定 ═══ -->
            <h4 class: LearnDesign.SectionTitle>尺寸查询 + 样式绑定 (.measure / style 绑定)</h4>
            <div class: DemoRow>
                <div @ref={sizeBox} class: SizeBox
                    style: { width: boxWidthPx, height: boxHeightPx }>
                    <p>resize via style binding</p>
                </div>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={querySize}>
                    Query Size
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={expandBox}>
                    Expand
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={resetBox}>
                    Reset
                </button>
                <span class: StatusText>Width: {boxWidthPx} · 实测: {boxWidth}px · Height: {boxHeightPx} · 实测: {boxHeight}px</span>
            </div>

            <!-- ═══ 多 ref 联动 ═══ -->
            <h4 class: LearnDesign.SectionTitle>多 ref 联动 (.value)</h4>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={mirrorInput}
                    placeholder="Type here..."
                    @onInput={syncMirror}
                />
                <span class: MirrorText>
                    Mirror: {mirrorText}
                </span>
            </div>

            <!-- ═══ 指针捕获 ═══ -->
            <h4 class: LearnDesign.SectionTitle>指针捕获 (.capturePointer / .releasePointer)</h4>
            <p class: LearnDesign.Hint>
                pointerdown 捕获、pointerup 释放；捕获后即使指针移出元素，后续事件仍定向到该元素。
                capturePointer() / releasePointer() 为无参语义（设计 D3）：运行时自动使用活动指针，
                多指针锁定不支持（有参调用为编译错误）。
            </p>
            <div class: DemoRow>
                <div
                    @ref={pointerBox}
                    @onPointerDown={onPtrDown}
                    @onPointerUp={onPtrUp}
                    class: { Pointerbox: true, PointerCaptured: pointerActive }
                >
                    <p>Press & hold me</p>
                </div>
                <span class: StatusText>Pointer: {pointerStatus}</span>
            </div>

            <!-- ═══ 高频拖拽（@drag-horizontal 触发器） ═══ -->
            <h4 class: LearnDesign.SectionTitle>高频拖拽 (@drag-horizontal)</h4>
            <p class: LearnDesign.Hint>
                无约束时拖拽范围由 motion 自身 keyframe 范围决定（dragX300 → 拖动 300px 走完动画）
            </p>
            <div class: LearnDesign.Row>
                <div
                    @drag-horizontal={dragX300}
                    class: DragBox>
                    <p>↔ Drag me</p>
                </div>
            </div>

            <h4 class: LearnDesign.SectionTitle>拖拽方向与范围变体（constraints 约束）</h4>
            <p class: LearnDesign.Hint>
                constraints: [min, max] 限定拖拽范围（超出部分由 elastic 回弹）；
                拖拽进度映射到 motion 自身的 keyframe 范围（水平用 translateX、垂直用 translateY）。
            </p>
            <div class: ConstraintsRow>
                <div @drag-horizontal constraints: [-150, 150] elastic: 0.4={dragX150} class: DragDemoBox>
                    <p>↔ 约束 ±150px</p>
                </div>
                <div @drag-vertical constraints: [0, 100] elastic: 0.5={dragY100} class: DragDemoBox>
                    <p>↕ 约束 0–100px</p>
                </div>
            </div>
        </div>
    }

    style {
        .SizeBox p { font-size: var(--fontSizeXs); color: white; margin: 0; }
        .Pointerbox p { font-size: var(--fontSizeXs); color: var(--textSecondary); margin: 0; }
        .PointerCaptured p { color: white; }
        .DragDemoBox p { font-size: var(--fontSizeXs); margin: 0; }
    }
}
