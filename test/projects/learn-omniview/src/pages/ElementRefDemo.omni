// ╔══════════════════════════════════════════════════════════════╗
// ║  ElementRefDemo.omni — Element Reference System               ║
// ║                                                              ║
// ║  演示 ref 声明 + @ref 绑定 + 语义化 ref 操作 API:            ║
// ║    · ref name: Element   — 元素引用声明                      ║
// ║    · @ref={name}         — 绑定到元素                        ║
// ║    · style: { width: sig } — 信号驱动样式绑定（直写通道）    ║
// ║    · .focus() / .blur()  — 焦点管理（命令式）                ║
// ║    · focus={sig}         — 语义化焦点绑定（信号驱动 focus/blur）║
// ║    · .select() / .setSelection(s, e) — 文本全选 / 选区控制    ║
// ║    · scroll-y={sig}      — 响应式滚动绑定                    ║
// ║    · scroll-x={sig}      — 响应式水平滚动绑定                ║
// ║    · .scrollTo() / .scrollBy() — 命令式滚动控制（可单参）      ║
// ║    · .measure()          — 位置/尺寸查询                      ║
// ║    · .width/.height/.position — 字段读取形式（measure 简写）    ║
// ║    · scrollTo(0, ref.measure().y) — 嵌套 ref 操作组合          ║
// ║    · @drag / @dragEnd — 拖拽意图（指针捕获为编译器内部细节）      ║
// ║    · @ref + @drag + style 绑定 — 高频拖拽意图（零中间层）      ║
// ║    · @drag-horizontal / @drag-vertical — scrubbing 语法糖     ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
import { async_sleep } from "std/async";

// ── Scrubbing 动画（@drag-* 语法糖）：手势进度映射到 keyframe 范围 ──
@motion dragX300 {
    from { translateX: 0 }
    to   { translateX: 300 }
    over: 300ms
    easing: power2-out
}
@motion dragX150 {
    from { translateX: 0 }
    to   { translateX: 150 }
    over: 300ms
    easing: power2-out
}
@motion dragY100 {
    from { translateY: 0 }
    to   { translateY: 100 }
    over: 300ms
    easing: power2-out
}

component ElementRefDemo {
    // ── ref 声明 ──
    ref inputBox: Element;
    ref scrollArea: Element;
    ref scrollAreaX: Element;
    ref rectBox: Element;
    ref sizeBox: Element;
    ref mirrorInput: Element;
    ref selectInput: Element;
    ref rangeInput: Element;
    ref focusSigInput: Element;
    ref pointerBox: Element;
    ref dragBox: Element;
    ref padBoard: Element;

    // ── 本地信号 ──
    signal focusStatus: String = "not focused";
    signal scrollPos: String = "top";
    signal scrollTarget: f64 = 0;           // 驱动 scroll-y={scrollTarget} 绑定
    signal scrollTargetX: f64 = 0;          // 驱动 scroll-x={scrollTargetX} 绑定
    signal rectInfo: String = "—";
    signal boxWidth: f64 = 200;             // measure() 查询结果（仅查询写入）
    signal boxHeight: f64 = 80;             // measure() 高度查询结果（仅查询写入）
    signal boxWidthNum: f64 = 200;          // 滑块/按钮驱动（高频连续变更 → 数值绑定）
    signal boxHeightNum: f64 = 80;          // 按钮驱动的 style 值（数值）
    computed boxWidthPx: String = boxWidthNum.to_string() + "px";   // 派生 px 显示串
    computed boxHeightPx: String = boxHeightNum.to_string() + "px"; // 派生 px 显示串
    // ── 多属性样式绑定（滑块驱动，全部经 style 绑定直写通道） ──
    signal boxRadiusNum: f64 = 12;          // 圆角
    signal boxOpacityNum: f64 = 100;        // 透明度（滑块 0-100，computed 转 CSS 0-1）
    signal boxFontNum: f64 = 14;            // 字号
    signal boxLetterNum: f64 = 0;           // 字距
    signal boxPadNum: f64 = 0;              // 内边距
    signal boxHueNum: f64 = 230;            // 背景色相 0-360（HSL 滑块）
    computed boxRadiusPx: String = boxRadiusNum.to_string() + "px";
    computed boxFontPx: String = boxFontNum.to_string() + "px";
    computed boxLetterPx: String = boxLetterNum.to_string() + "px";
    computed boxPadPx: String = boxPadNum.to_string() + "px";
    computed boxOpacityCss: f64 = boxOpacityNum / 100;   // 滑块 0-100 → CSS 0-1
    computed boxBgCss: String = "hsl(" + boxHueNum.to_string() + ", 70%, 60%)";
    signal mirrorText: String = "";
    signal selectText: String = "0123456789 全选演示文本";
    signal selectStatus: String = "—";
    signal rangeText: String = "0123456789";
    signal rangeStatus: String = "—";
    signal shouldFocus: Bool = false;       // 驱动 focus={shouldFocus} 绑定

    // ── 滑块高频拖动：transition 实时跟随 ──
    // design.omni 的 SizeBox 带 transition: all 300ms——Expand/Reset 等
    // 低频按钮路径的过渡合理；但滑块拖动是连续高频修改，每个中间值都被
    // 300ms 平滑化（实测视觉滞后 ~290ms），感觉"不实时"。@onInput 把
    // transition 信号置 "none"（style 绑定直写禁用过渡——ref.style 直写
    // 被 ADR-070 契约禁止，style 绑定是声明式通道），停止拖动 200ms 后
    // 恢复（seq 计数防止旧 async 恢复抢先）。
    signal sliderTransition: String = "";
    signal sliderSeq: i32 = 0;

    // ── 触控板手势 → 显示区增量控制 ──
    // 真实触控板语义：手指按下后滑动是增量手势（delta 累积），不是指针
    // 位置映射——手指在触控板上滑 N 像素，右侧元素向同方向移动 N 像素。
    // 元素从显示区中心起始，clamp 在区内；move 处理器只做增量运算
    // （不调用 measure，无强制 layout，高频直写零开销）。
    signal stageX: f64 = 100;               // 显示区元素位置（px，中心起始）
    signal stageY: f64 = 60;
    signal padDragging: bool = false;
    signal padDX: f64 = 0;                  // 手势累计位移（相对按下点）
    signal padDY: f64 = 0;
    signal padDownX: f64 = 110;             // 按下点（触控板局部 px）
    signal padDownY: f64 = 75;
    signal lastClientX: f64 = 0;            // 增量计算的上一指针位置
    signal lastClientY: f64 = 0;
    computed stageTransform: String = "translate(" + stageX.to_string() + "px, " + stageY.to_string() + "px)";
    computed padDotLeft: String = (padDownX + padDX).to_string() + "px";
    computed padDotTop: String = (padDownY + padDY).to_string() + "px";

    fn onPadDown(e) {
        padDragging = true;
        padDX = 0;
        padDY = 0;
        lastClientX = e.clientX;
        lastClientY = e.clientY;
        let rect = padBoard.measure();
        padDownX = e.clientX - rect.x;
        padDownY = e.clientY - rect.y;
    }
    fn onPadUp() { padDragging = false; }
    fn onPadMove(e) {
        if padDragging {
            let dx = e.clientX - lastClientX;
            let dy = e.clientY - lastClientY;
            lastClientX = e.clientX;
            lastClientY = e.clientY;
            padDX = padDX + dx;
            padDY = padDY + dy;
            stageX = stageX + dx;
            stageY = stageY + dy;
            if stageX < 0 { stageX = 0; }
            if stageX > 200 { stageX = 200; }
            if stageY < 0 { stageY = 0; }
            if stageY > 120 { stageY = 120; }
        }
    }

    action onSliderInput() async {
        sliderSeq = sliderSeq + 1;
        let mySeq = sliderSeq;
        sliderTransition = "none";
        await async_sleep(200);
        if sliderSeq == mySeq {
            sliderTransition = "";
        }
    }
    signal sigFocusStatus: String = "focus=false";
    signal pointerActive: Bool = false;     // 指针捕获中的视觉状态
    signal pointerStatus: String = "free";
    signal dragging: Bool = false;          // 拖拽中（视觉状态 → class 绑定）
    signal dragX: f64 = 0;                  // 拖拽位移（→ style transform 绑定）
    signal dragY: f64 = 0;

    // ── @mount：挂载后置 shouldFocus = true → focus={shouldFocus} 绑定自动聚焦 ──
    @mount {
        shouldFocus = true;
        sigFocusStatus = "focus=true（挂载自动聚焦）";
    }

    // ── 焦点操作（命令式 RefOp：.focus() / .blur()） ──
    fn focusInput() {
        inputBox.focus();
        focusStatus = "focused";
    }
    fn blurInput() {
        inputBox.blur();
        focusStatus = "blurred";
    }

    // ── 滚动控制：响应式 scroll-y 绑定 + 命令式 .scrollBy / .scrollTo ──
    // scroll-y={scrollTarget} 是 scrollTo 的响应式形态：按钮只更新信号，
    // 绑定自动驱动元素滚动；.scrollBy(0, 100) 增量滚动与 .scrollTo(0, y)
    // 定点跳转保持命令式（与绑定互补）。
    fn scrollToTop() {
        // 命令式跳转（scrollTarget 已是 0 时响应式绑定不重触发——
        // 信号值未变 effect 不运行，命令式 scrollBy 造成的偏移无法复位）
        scrollArea.scrollTo(0, 0);
        scrollPos = "top";
    }
    fn scrollToBottom() {
        scrollTarget = 9999;
        scrollPos = "bottom";
    }
    fn scrollByDown() {
        scrollArea.scrollBy(0, 100);
        scrollPos = "scrolled +100px";
    }
    fn scrollToDirect() {
        scrollArea.scrollTo(0, 0);
        scrollPos = "scrollTo(0, 0)";
    }
    fn scrollTo200() {
        scrollArea.scrollTo(0, 200);
        scrollPos = "scrollTo(0, 200)";
    }

    // ── 滚动控制：响应式 scroll-x 绑定（水平滚动区） ──
    // scroll-x={scrollTargetX} 与 scroll-y 同族（SEMANTIC_BINDINGS）：
    // 按钮只更新信号，绑定自动驱动元素水平滚动。
    fn scrollXLeft() {
        scrollTargetX = 0;
        scrollPos = "scroll-x=0";
    }
    fn scrollX200() {
        scrollTargetX = 200;
        scrollPos = "scroll-x=200";
    }

    // ── 嵌套 ref 操作组合：测量结果直接作滚动参数 ──
    // scrollTo(0, rectBox.measure().y)：先测量目标盒当前位置，再滚动
    // 滚动区到该 y —— 一次调用完成「测量 + 定位」，参数可以是任意
    // 表达式（信号、字段读取、甚至另一个 ref 操作）。
    fn scrollToMeasuredRect() {
        scrollArea.scrollTo(0, rectBox.measure().y);
        scrollPos = "scrolled to rectBox 顶部（嵌套 ref 操作）";
    }

    // ── 位置查询（ref.measure()） ──
    fn queryRect() {
        let rect = rectBox.measure();
        rectInfo = "x:" + rect.x.to_string() + " y:" + rect.y.to_string()
                 + " w:" + rect.width.to_string() + " h:" + rect.height.to_string();
    }

    // ── 尺寸查询（ref.measure().width / .height） ──
    fn querySize() {
        let w = sizeBox.measure().width;
        let h = sizeBox.measure().height;
        boxWidth = w;
        boxHeight = h;
    }

    // ── 字段读取形式（ref.width / ref.height / ref.position） ──
    // 字段读取 = measure() 的简写：ref.width → getBoundingClientRect().width，
    // ref.position → getBoundingClientRect()（DOMRect，可继续 .x/.y 访问）。
    fn querySizeFields() {
        boxWidth = sizeBox.width;
        boxHeight = sizeBox.height;
    }
    fn queryPositionField() {
        let pos = rectBox.position;
        rectInfo = "x:" + pos.x.to_string() + " y:" + pos.y.to_string() + "（字段读取 ref.position）";
    }

    // ── 信号驱动样式（style: { width: sig } 绑定，替代 ref.style 直接操作） ──
    // 动态 style 绑定经直写通道发射：React useRef + 直接 DOM 写（零重渲染），
    // Flutter ValueNotifier + ListenableBuilder（无 setState 整树重建），
    // OmniView el.style.setProperty 直接 DOM 写。
    // 绑定数值信号（f64）——Flutter 的 width/height 参数是 double，String
    // px 值无法映射（编译期诊断）；px 显示串由 computed 派生（boxWidthPx）。
    // Expand / Reset：多属性同帧变化（按钮低频路径保留 300ms 过渡动画，
    // 滑块高频路径的 transition 由 onSliderInput 拖动中禁用）。
    fn expandBox() {
        boxWidthNum = 320;
        boxHeightNum = 130;
        boxRadiusNum = 32;
        boxOpacityNum = 65;
        boxFontNum = 20;
        boxLetterNum = 3;
        boxPadNum = 20;
        boxHueNum = 12;
    }
    fn resetBox() {
        boxWidthNum = 200;
        boxHeightNum = 80;
        boxRadiusNum = 12;
        boxOpacityNum = 100;
        boxFontNum = 14;
        boxLetterNum = 0;
        boxPadNum = 0;
        boxHueNum = 230;
    }

    // ── 多 ref 联动（输入 → 镜像） ──
    fn syncMirror() {
        let val = mirrorInput.value;
        mirrorText = val;
    }

    // ── 文本全选（.select()） ──
    fn selectAllText() {
        selectInput.select();
        selectStatus = "已全选 " + selectText.len().to_string() + " 字符";
    }

    // ── 选区控制（.setSelection(start, end) → setSelectionRange） ──
    fn selectFirst3() {
        rangeInput.setSelection(0, 3);
        rangeStatus = "已调用 setSelection(0, 3)";
    }
    fn selectMiddle5() {
        rangeInput.setSelection(2, 7);
        rangeStatus = "已调用 setSelection(2, 7)";
    }
    // @onSelect 事件数据（SelectEvent: start/end/text）实时回显选区
    fn onRangeSelect(e) {
        rangeStatus = "选区 [" + e.start.to_string() + ", " + e.end.to_string() + ") 文本: " + e.text;
    }

    // ── 语义绑定 focus={sig}（信号驱动 focus/blur） ──
    fn toggleFocusSig() {
        shouldFocus = !shouldFocus;
        if shouldFocus {
            sigFocusStatus = "focus=true（已聚焦）";
        } else {
            sigFocusStatus = "focus=false（已失焦）";
        }
    }

    // ── 拖拽意图（@drag / @dragEnd，ADR-071/073） ──
    // 指针捕获降级为编译器内部细节：React setPointerCapture / Flutter
    // GestureDetector pan（onPanStart 即手势竞技场获胜）/ OmniView
    // capturePointer 原语——源码只写 @drag 意图，捕获后指针移出元素仍跟随。
    // 事件数据 {x, y, dx, dy, pointerId, startX, startY}：dx/dy 为相对
    // 按下点的累计位移。
    fn onPtrDrag() {
        pointerActive = true;
        pointerStatus = "dragging";
    }
    fn onPtrEnd() {
        pointerActive = false;
        pointerStatus = "released";
    }

    // ── 高频拖拽（@drag 意图） ──
    // 移动元素 = @drag 意图直接驱动 style 绑定，零中间层：编译器接线捕获，
    // @drag 处理器把 dx/dy 累计位移写入 dragX/dragY 信号，transform 绑定
    // 即时跟随。无 duration/easing/keyframes —— 高频操作就是要简单直接
    // （@drag-* 仅作 scrubbing 语法糖，见下方 section）。
    fn onDragMove(e) {
        dragging = true;
        dragX = e.dx;
        dragY = e.dy;
    }
    fn onDragEnd() {
        dragging = false;
    }

    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>Element Reference System</h3>
            <p class: LearnDesign.Subtitle>ref · @ref · .focus() · .select() · .setSelection() · .width/.height/.position · scrollTo(0, ref.measure().y) · @drag/@dragEnd 拖拽意图 · style 信号绑定直写通道</p>

            <!-- ═══ 焦点管理 ═══ -->
            <h4 class: LearnDesign.SectionTitle>焦点管理 (.focus / .blur)</h4>
            <div class: DemoRow>
                <!-- @onInput 空回调：仅保持 input 可交互（焦点演示，无需处理逻辑） -->
                <input
                    class: RefInput
                    @ref={inputBox}
                    @onInput={() => {}}
                    placeholder="ref-bound input"
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={focusInput}>
                    Focus
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={blurInput}>
                    Blur
                </button>
                <span class: StatusText>Status: {focusStatus}</span>
            </div>

            <!-- ═══ 文本全选 ═══ -->
            <h4 class: LearnDesign.SectionTitle>文本全选 (.select)</h4>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={selectInput}
                    bind:value={selectText}
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={selectAllText}>
                    全选
                </button>
                <span class: StatusText>{selectStatus}</span>
            </div>

            <!-- ═══ 选区控制 ═══ -->
            <h4 class: LearnDesign.SectionTitle>选区控制 (.setSelection(start, end))</h4>
            <p class: LearnDesign.Hint>
                点击按钮调用 setSelection(start, end)（→ setSelectionRange）；手动拖动文本时
                @onSelect 事件（SelectEvent: start/end/text）也会实时回显选区
            </p>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={rangeInput}
                    bind:value={rangeText}
                    @onSelect={onRangeSelect}
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={selectFirst3}>
                    前 3 字符 (0, 3)
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={selectMiddle5}>
                    中间 5 字符 (2, 7)
                </button>
                <span class: StatusText>{rangeStatus}</span>
            </div>

            <!-- ═══ 语义绑定 focus={sig} ═══ -->
            <h4 class: LearnDesign.SectionTitle>语义绑定 (focus={"{}"}sig{"{}"})</h4>
            <p class: LearnDesign.Hint>
                focus={shouldFocus} 把布尔信号绑定到元素焦点：true → .focus()，false → .blur()。
                @mount 中置 true，进入本页即自动聚焦。
            </p>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={focusSigInput}
                    focus={shouldFocus}
                    placeholder="focus={shouldFocus} 驱动"
                />
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={toggleFocusSig}>
                    切换 focus={shouldFocus}
                </button>
                <span class: StatusText>{sigFocusStatus}</span>
            </div>

            <!-- ═══ 滚动控制 ═══ -->
            <h4 class: LearnDesign.SectionTitle>滚动控制 (scroll-y / scroll-x 绑定 + .scrollBy + .scrollTo + 嵌套组合)</h4>
            <div scroll-y={scrollTarget} @ref={scrollArea} class: ScrollBox>
                <p class: ScrollItem>Item 1 — 滚动演示区域</p>
                <p class: ScrollItem>Item 2 — 使用 scroll-y 绑定跳转</p>
                <p class: ScrollItem>Item 3 — 使用 .scrollBy() 增量</p>
                <p class: ScrollItem>Item 4 — Element Ref API</p>
                <p class: ScrollItem>Item 5 — Element Ref API 全集</p>
                <p class: ScrollItem>Item 6 — 底部</p>
            </div>
            <div class: LearnDesign.Row>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollToTop}>
                    Scroll To Top
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollToBottom}>
                    Scroll To Bottom
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollByDown}>
                    ScrollBy +100px
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollToDirect}>
                    scrollTo(0, 0)
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollTo200}>
                    scrollTo(0, 200)
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={scrollToMeasuredRect}>
                    scrollTo(0, rectBox.measure().y)
                </button>
                <span class: StatusText>Pos: {scrollPos}</span>
            </div>

            <!-- ═══ 水平滚动（scroll-x 绑定） ═══ -->
            <div scroll-x={scrollTargetX} @ref={scrollAreaX} class: ScrollBoxX>
                <p class: ScrollItemX>Item A — 水平滚动区（scroll-x 绑定）</p>
                <p class: ScrollItemX>Item B — 使用 scroll-x 绑定跳转</p>
                <p class: ScrollItemX>Item C — 水平滚动演示</p>
                <p class: ScrollItemX>Item D — scroll-x={scrollTargetX}</p>
                <p class: ScrollItemX>Item E — 水平滚动演示结束</p>
            </div>
            <div class: LearnDesign.Row>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={scrollXLeft}>scroll-x=0</button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={scrollX200}>scroll-x=200</button>
                <span class: StatusText>X: {scrollTargetX}</span>
            </div>

            <!-- ═══ 位置查询 ═══ -->
            <h4 class: LearnDesign.SectionTitle>位置查询 (.measure / .position 字段读取)</h4>
            <div @ref={rectBox} class: RectBox>
                <p>Query Box — click "Query Rect" to read position</p>
            </div>
            <div class: LearnDesign.Row>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={queryRect}>
                    Query Rect (.measure)
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={queryPositionField}>
                    Query Position (字段读取)
                </button>
                <span class: StatusText>{rectInfo}</span>
            </div>

            <!-- ═══ 尺寸查询 + 样式绑定 ═══ -->
            <h4 class: LearnDesign.SectionTitle>尺寸查询 + 样式绑定 (.measure / style 绑定)</h4>
            <p class: LearnDesign.Hint>
                连续属性变更 = 信号 + 声明式绑定：拖动滑块连续更新 boxWidthNum，
                绑定实时生效 —— 无命令式 DOM 写入。绑定用数值信号（Flutter
                width/height 参数是 double），px 显示串由 computed 派生。
                尺寸查询有方法形式（.measure().width）与字段读取形式（.width）两种写法，
                字段读取是 measure 的简写，同样返回响应式数值。
            </p>
            <div class: DemoRow>
                <div @ref={sizeBox} class: SizeBox
                    style: {
                        width: boxWidthNum,
                        height: boxHeightNum,
                        borderRadius: boxRadiusNum,
                        opacity: boxOpacityCss,
                        fontSize: boxFontNum,
                        letterSpacing: boxLetterNum,
                        padding: boxPadNum,
                        backgroundColor: boxBgCss,
                        transition: sliderTransition
                    }>
                    <p>resize via style binding</p>
                </div>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={querySize}>
                    Query Size
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={querySizeFields}>
                    Query Size (字段读取)
                </button>
                <button variant: LearnDesign.Button(color=accent, size=sm) @onPress={expandBox}>
                    Expand
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={resetBox}>
                    Reset
                </button>
            </div>

            <!-- 多属性滑块：每个属性一个 range，全部经 style 绑定直写通道高频更新 -->
            <div class: SliderGrid>
                <div class: SliderRow>
                    <span class: SliderLabel>Width</span>
                    <input type="range" min="120" max="400" bind:value={boxWidthNum} class: DemoRange @onInput={onSliderInput} />
                    <span class: SliderValue>{boxWidthPx}</span>
                </div>
                <div class: SliderRow>
                    <span class: SliderLabel>Height</span>
                    <input type="range" min="60" max="220" bind:value={boxHeightNum} class: DemoRange @onInput={onSliderInput} />
                    <span class: SliderValue>{boxHeightPx}</span>
                </div>
                <div class: SliderRow>
                    <span class: SliderLabel>Radius</span>
                    <input type="range" min="0" max="48" bind:value={boxRadiusNum} class: DemoRange @onInput={onSliderInput} />
                    <span class: SliderValue>{boxRadiusPx}</span>
                </div>
                <div class: SliderRow>
                    <span class: SliderLabel>Opacity</span>
                    <input type="range" min="20" max="100" bind:value={boxOpacityNum} class: DemoRange @onInput={onSliderInput} />
                    <span class: SliderValue>{boxOpacityNum}</span>
                </div>
                <div class: SliderRow>
                    <span class: SliderLabel>FontSize</span>
                    <input type="range" min="12" max="32" bind:value={boxFontNum} class: DemoRange @onInput={onSliderInput} />
                    <span class: SliderValue>{boxFontPx}</span>
                </div>
                <div class: SliderRow>
                    <span class: SliderLabel>LetterSpacing</span>
                    <input type="range" min="0" max="6" bind:value={boxLetterNum} class: DemoRange @onInput={onSliderInput} />
                    <span class: SliderValue>{boxLetterPx}</span>
                </div>
                <div class: SliderRow>
                    <span class: SliderLabel>Padding</span>
                    <input type="range" min="0" max="32" bind:value={boxPadNum} class: DemoRange @onInput={onSliderInput} />
                    <span class: SliderValue>{boxPadPx}</span>
                </div>
                <div class: SliderRow>
                    <span class: SliderLabel>Color</span>
                    <input type="range" min="0" max="360" bind:value={boxHueNum} class: DemoRange @onInput={onSliderInput} />
                    <span class: SliderValue>hsl({boxHueNum})</span>
                </div>
            </div>
            <p class: SizeStatus>
                Width: {boxWidthPx} · 实测: {boxWidth}px · Height: {boxHeightPx} · 实测: {boxHeight}px ·
                Radius: {boxRadiusPx} · Opacity: {boxOpacityNum}% · FontSize: {boxFontPx} · Letter: {boxLetterPx} · Padding: {boxPadPx} · Color: {boxBgCss}
            </p>

            <!-- ═══ 触控板手势 → 显示区联动 ═══ -->
            <h4 class: LearnDesign.SectionTitle>触控板手势 → 显示区联动 (增量滑动)</h4>
            <p class: LearnDesign.Hint>
                左侧触控板按住并滑动：增量手势（手指滑 N 像素，右侧元素同方向
                移动 N 像素）——真实触控板语义，非指针位置映射。元素从显示区
                中心起始，clamp 在区内；触控板上的指示点显示手势位移（相对按下点）。
            </p>
            <div class: PadDemo>
                <div
                    class: PadBoard
                    @ref={padBoard}
                    @onPointerDown={onPadDown}
                    @onPointerMove={onPadMove}
                    @onPointerUp={onPadUp}
                    @onPointerCancel={onPadUp}
                >
                    <span class: PadDot style: { left: padDotLeft, top: padDotTop }></span>
                    <p class: PadHint>触控板（按住滑动）</p>
                </div>
                <div class: PadStage>
                    <span class: StageDot style: { transform: stageTransform }></span>
                </div>
            </div>
            <p class: SizeStatus>
                {if padDragging { "手势滑动中 · " } else { "" }}位移 ({padDX}, {padDY}) · 元素位置 {stageTransform}
            </p>

            <!-- ═══ 多 ref 联动 ═══ -->
            <h4 class: LearnDesign.SectionTitle>多 ref 联动 (.value)</h4>
            <div class: DemoRow>
                <input
                    class: RefInput
                    @ref={mirrorInput}
                    placeholder="Type here..."
                    @onInput={syncMirror}
                />
                <span class: MirrorText>
                    Mirror: {mirrorText}
                </span>
            </div>

            <!-- ═══ 拖拽意图 @drag（指针捕获为编译器内部细节） ═══ -->
            <h4 class: LearnDesign.SectionTitle>拖拽意图 (@drag / @dragEnd)</h4>
            <p class: LearnDesign.Hint>
                指针按下 → 编译器接线捕获（{'ADR-071/073'}）：React setPointerCapture / Flutter
                GestureDetector pan（手势竞技场）/ OmniView capturePointer 原语——源码只写
                @drag 意图。事件数据 {'{x, y, dx, dy, pointerId, startX, startY}'}：dx/dy 为
                相对按下点的累计位移；捕获后指针移出元素仍跟随（隐式捕获语义）。
            </p>
            <div class: DemoRow>
                <div
                    @ref={pointerBox}
                    @drag={onPtrDrag}
                    @dragEnd={onPtrEnd}
                    class: { Pointerbox: true, PointerCaptured: pointerActive }
                >
                    <p>Press & hold me</p>
                </div>
                <span class: StatusText>Pointer: {pointerStatus}</span>
            </div>

            <!-- ═══ 高频拖拽（@drag 意图） ═══ -->
            <h4 class: LearnDesign.SectionTitle>高频拖拽 (@drag 意图)</h4>
            <p class: LearnDesign.Hint>
                拖拽移动元素用 @drag 意图而非动画：编译器接线捕获（React
                setPointerCapture / Flutter GestureDetector pan / OmniView
                capturePointer），@drag 处理器把 dx/dy 累计位移写入 dragX/dragY
                信号，style 的 transform 绑定即时跟随 —— 无 duration/easing/
                keyframes，高频操作就是简单直接。
            </p>
            <div class: LearnDesign.Row>
                <div
                    @ref={dragBox}
                    @drag={onDragMove}
                    @dragEnd={onDragEnd}
                    style: { transform: "translate(" + dragX + "px, " + dragY + "px)" }
                    class: { DragBox: true, DragBoxActive: dragging }
                >
                    <p>↔ Drag me（直接跟随指针）</p>
                </div>
            </div>

            <h4 class: LearnDesign.SectionTitle>手势 Scrubbing (@drag-horizontal / @drag-vertical)</h4>
            <p class: LearnDesign.Hint>
                @drag-* 是 scrubbing 语法糖：手势进度映射到 motion 自身的 keyframe 范围
                （水平 translateX / 垂直 translateY），由 WAAPI 动画引擎驱动 —— 适合
                「滑动解锁」式进度控制；移动元素用上方 @drag 意图。
                constraints: [min, max] 限定手势范围（超出部分由 elastic 回弹）。
            </p>
            <div class: ConstraintsRow>
                <div @drag-horizontal={dragX300} class: DragDemoBox>
                    <p>↔ 无约束（keyframe 300px）</p>
                </div>
                <div @drag-horizontal constraints: [-150, 150] elastic: 0.4={dragX150} class: DragDemoBox>
                    <p>↔ 约束 ±150px</p>
                </div>
                <div @drag-vertical constraints: [0, 100] elastic: 0.5={dragY100} class: DragDemoBox>
                    <p>↕ 约束 0–100px</p>
                </div>
            </div>
        </div>
    }

    style {
        .SliderGrid { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; padding: 12px; background: var(--surfaceSubtle); border-radius: 8px; }
        .SliderRow { display: flex; align-items: center; gap: 10px; }
        .SliderLabel { width: 96px; font-size: 12px; font-weight: 600; color: var(--textSecondary); flex: 0 0 auto; }
        .SliderRow input[type="range"] { flex: 1; min-width: 0; }
        .SliderValue { width: 56px; font-size: 12px; font-family: monospace; color: var(--textSecondary); text-align: right; flex: 0 0 auto; }
        .SizeStatus { margin-top: 10px; font-size: 12px; color: var(--textSecondary); }
        // font-size: inherit——否则 p 的显式字号规则覆盖 sizeBox 的
        // inline font-size 绑定（fontSize 滑块拖动 p 文字不变）
        .SizeBox p { font-size: inherit; color: white; margin: 0; }
        // 触控板 → 显示区联动
        .PadDemo { display: flex; gap: 16px; margin-top: 12px; align-items: flex-start; }
        .PadBoard { position: relative; width: 220px; height: 150px; background: var(--surfaceSubtle); border: 1px dashed var(--border); border-radius: 10px; cursor: crosshair; touch-action: none; overflow: hidden; }
        .PadDot { position: absolute; width: 14px; height: 14px; border-radius: 50%; background: var(--primary); transform: translate(-50%, -50%); pointer-events: none; }
        .PadHint { position: absolute; bottom: 8px; left: 0; right: 0; text-align: center; font-size: 11px; color: var(--textSecondary); margin: 0; pointer-events: none; }
        .PadStage { position: relative; width: 260px; height: 150px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
        .StageDot { position: absolute; top: 0; left: 0; width: 36px; height: 36px; border-radius: 50%; background: var(--accent); box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2); pointer-events: none; }
        .Pointerbox p { font-size: var(--fontSizeXs); color: var(--textSecondary); margin: 0; }
        .PointerCaptured p { color: white; }
        .DragBox p { font-size: var(--fontSizeXs); color: var(--textSecondary); margin: 0; }
        .DragBoxActive p { color: white; }
        .DragBoxActive { cursor: grabbing; }
        .DragDemoBox p { font-size: var(--fontSizeXs); margin: 0; }
        .ScrollBoxX { width: 100%; height: 64px; overflow-x: auto; overflow-y: hidden; background: var(--surfaceSubtle); border-radius: 8px; display: flex; gap: 8px; padding: 8px; }
        .ScrollBoxX p { flex: 0 0 auto; white-space: nowrap; font-size: var(--fontSizeXs); color: var(--textSecondary); margin: 0; }
    }
}
