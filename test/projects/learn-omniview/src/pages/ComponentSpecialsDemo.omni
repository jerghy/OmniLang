// ╔══════════════════════════════════════════════════════════════════════╗
// ║  ComponentSpecialsDemo — 组件级特殊语法覆盖                        ║
// ║                                                                    ║
// ║  · if_mode: "wait"  — 组件级 @if 过渡模式默认值                    ║
// ║  · @slot(name)      — 带括号的命名插槽语法                         ║
// ║  · @hero NAME { }   — 组件级 hero 过渡定义                          ║
// ║  · on: { signal }   — 信号驱动的动画绑定                           ║
// ╚══════════════════════════════════════════════════════════════════════╝
import omniview;

// ╔══════════════════════════════════════════════════════════════╗
// ║  🧪 Playwright Test                                         ║
// ║                                                            ║
// ║  **Steps:**                                                ║
// ║  1. Navigate to ComponentSpecialsDemo component page.      ║
// ║  2. Verify if_mode section with toggle button and panel.   ║
// ║     Click "Show Panel" to open, click "Hide Panel" to      ║
// ║     close — check that leave animation completes first.    ║
// ║  3. Check @slot(name) section: click "Open Slot Demo" to   ║
// ║     render SlotContainer with slot="header"/"body"/        ║
// ║     "footer" children.                                     ║
// ║  4. Verify @hero section: div with @hero="hero-demo-1"     ║
// ║     and @hero-transition={scaleGlow} renders.              ║
// ║  5. Check on: signal binding section: click "Advance" btn  ║
// ║     to increment progressPct. Verify the signal-bar div    ║
// ║     binding updates.                                       ║
// ║                                                            ║
// ║  **Expected:**                                             ║
// ║  - if_mode="wait" panel toggles with @enter/@leave anims.  ║
// ║  - SlotContainer renders slot= children in correct slots.   ║
// ║  - @hero div has data-hero="hero-demo-1" and               ║
// ║    @hero-transition={scaleGlow} data.                      ║
// ║  - @hero cardHero defined with over:400, ease:power2Out.   ║
// ║  - signal-bar div has on: binding with progressPct.        ║
// ║  - Advancing progressPct updates the on: bound element.    ║
// ╚══════════════════════════════════════════════════════════════╝

// ── 子组件：演示 @slot(name) 括号形式 ─────────────────────
component SlotContainer {
    event onClose: Void;

    view {
        <div class: slot-box>
            <div class: slot-header>
                @slot(header)
            </div>
            <div class: slot-body>
                @slot(body)
            </div>
            <div class: slot-footer>
                @slot(footer)
                <button class: close-btn @onPress={onClose}>Close</button>
            </div>
        </div>
    }

    style {
        .slot-box { border: 1px solid #d4d4d8; border-radius: 10px; overflow: hidden; background: #fff; }
        .slot-header { padding: 12px 14px; background: #f3f0ff; border-bottom: 1px solid #e5e7eb; font-size: 14px; font-weight: 600; color: #374151; }
        .slot-body { padding: 14px; font-size: 13px; color: #4b5563; min-height: 40px; }
        .slot-footer { padding: 10px 14px; background: #f9fafb; border-top: 1px solid #e5e7eb; display: flex; justify-content: flex-end; gap: 8px; align-items: center; }
        .close-btn { padding: 6px 14px; background: #6b7280; color: #fff; border: none; border-radius: 6px; font-size: 12px; cursor: pointer; }
    }
}

// ── 动画定义 ───────────────────────────────────────────────
@motion fadeSlideOut {
    from { opacity: 1, x: 0 }
    to   { opacity: 0, x: 30 }
    over 300 ease easeOut
}

@motion fadeEnter {
    from { opacity: 0, y: 10 }
    to   { opacity: 1, y: 0 }
    over 400 ease power2Out
}

@motion scaleGlow {
    to { scale: 1.08, boxShadow: "0 0 0 4px rgba(99,102,241,0.4)" }
    over 200 ease easeOut
}

// ══════════════════════════════════════════════════════════════════════
//  主组件：演示所有组件级特殊语法
// ══════════════════════════════════════════════════════════════════════
component ComponentSpecialsDemo {
    // 组件级 @if 过渡模式：等待离开动画完成再渲染新内容
    if_mode: "wait";

    signal showPanel: bool = false;
    signal slotVisible: bool = false;
    signal progressPct: i32 = 0;
    signal counter: i32 = 0;

    // 组件级 @hero 定义
    @hero cardHero { over: 400, ease: power2Out }

    fn toggle() { showPanel = !showPanel; }
    fn openSlot() { slotVisible = true; }
    fn closeSlot() { slotVisible = false; }
    fn advancePct() { progressPct = progressPct + 10; if progressPct > 100 { progressPct = 0; } }
    fn increment() { counter = counter + 1; }

    view {
        <div class: container>
            <h3 class: title>组件级特殊语法</h3>
            <p class: subtitle>if_mode: wait · slot(name) 括号形式 · hero 组件级 · on: 信号绑定</p>

            <!-- ═══ if_mode: "wait" ═══ -->
            <h4 class: group-title>if_mode: "wait"（组件级 if 过渡默认值）</h4>
            <div class: demo-card>
                <p class: hint>当 showPanel 切换时，leave 动画（fadeSlideOut 300ms）会在新内容渲染前完成</p>
                <button class: btn @click={toggle}>
                    {if showPanel { "Hide Panel" } else { "Show Panel" }}
                </button>

                @if showPanel {
                    <div @enter={fadeEnter} @leave={fadeSlideOut} class: panel>
                        <p>这个面板会在旧面板离开动画完成后才渲染</p>
                    </div>
                }
            </div>

            <!-- ═══ @slot(name) 括号形式 ═══ -->
            <h4 class: group-title>slot(name) 带括号形式</h4>
            <div class: demo-card>
                <p class: hint>slot(header) · slot(body) · slot(footer) — 代替 @slot header 的无括号形式</p>
                <button class: btn @click={openSlot}>Open Slot Demo</button>

                @if slotVisible {
                    <SlotContainer @onClose={closeSlot}>
                        <div slot="header">带括号标题头</div>
                        <p slot="body">这是 slot(name) 括号语法的主体内容演示</p>
                        <button slot="footer" @onPress={closeSlot}>关闭</button>
                    </SlotContainer>
                }
            </div>

            <!-- ═══ 组件级 @hero ═══ -->
            <h4 class: group-title>组件级 @hero</h4>
            <div class: demo-card>
                <p class:hint>在组件级定义 @hero cardHero (over: 400, ease: power2Out)</p>
                <div @hero="hero-demo-1" @hero-transition={scaleGlow} class: hero-box>
                    <p>@hero="hero-demo-1" 引用组件级 cardHero</p>
                </div>
            </div>

            <!-- ═══ on: 信号绑定 ═══ -->
            <h4 class: group-title>on: (signal) 信号绑定</h4>
            <div class: demo-card>
                <p class: hint>点击按钮增加 progressPct（0→100 循环），驱动下方元素动画进度</p>
                <button class: btn @click={advancePct}>Advance {progressPct.to_string()}%</button>
                <div on: { progressPct } class: signal-bar>
                    <p>progressPct: {progressPct.to_string()}%</p>
                </div>
            </div>
        </div>
    }

    style {
        .container { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 4px 0; }
        .subtitle { font-size: 12px; color: #9ca3af; margin: 0 0 14px 0; }

        .group-title { font-size: 14px; font-weight: 600; color: #374151; margin: 20px 0 10px 0; padding-bottom: 4px; border-bottom: 1px solid #e5e7eb; }
        .demo-card { padding: 14px; background: #f9fafb; border-radius: 10px; border: 1px solid #e5e7eb; margin-bottom: 12px; }
        .hint { font-size: 11px; color: #9ca3af; margin: 0 0 10px 0; }
        .btn { padding: 8px 16px; background: #6366f1; color: #fff; border: none; border-radius: 6px; font-size: 13px; cursor: pointer; margin-right: 8px; }

        .panel { padding: 14px; background: #eef2ff; border-radius: 8px; border: 1px solid #c7d2fe; margin-top: 10px; }
        .panel p { font-size: 13px; color: #4338ca; margin: 0; }

        .hero-box { padding: 14px; background: #fef3c7; border-radius: 10px; border: 1px solid #fcd34d; text-align: center; }
        .hero-box p { font-size: 12px; color: #92400e; margin: 0; }

        .signal-bar { padding: 14px; background: #dbeafe; border-radius: 8px; border: 1px solid #93c5fd; margin-top: 8px; text-align: center; }
        .signal-bar p { font-size: 13px; color: #1e40af; margin: 0; }
    }
}
