import { CssVarsDemo } from "../components/CssVarsDemo";
import { CssUnitsDemo } from "../components/CssUnitsDemo";
import { TokenTypeDemo } from "../components/TokenTypeDemo";

component DesignTheme {
    view {
        <section class: LearnDesign.DemoSection>
            <ThemeSwitcher />
            <ThemeSourceDemo />
            <DesignTokenPanel />
            <VariantShowcase />
