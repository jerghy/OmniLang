// DataSubmit.omni —— HTTP POST 表单提交
// 演示：json_stringify + http_post + await + @if 状态切换

import omniview;
import { http_post } from "std/http";
import { json_stringify } from "std/json";

component DataSubmit {
    signal title: String = "";
    signal body: String = "";
    signal submitStatus: String = "idle";
    signal responseText: String = "";

    // async action: 用 json_stringify 构造请求体，http_post 发送
    action submitForm() async {
        if title == "" {
            submitStatus = "error";
            responseText = "Title is required";
            return;
        }
        submitStatus = "loading";
        let payload = json_stringify(title + ":::" + body);
        let raw = await http_post(
            "https://jsonplaceholder.typicode.com/posts",
            payload
        );
        if raw == "" {
            submitStatus = "error";
            responseText = "No response from server";
            return;
        }
        responseText = raw;
        submitStatus = "success";
    }

    fn reset() {
        title = "";
        body = "";
        submitStatus = "idle";
        responseText = "";
    }

    view {
        <div class: DataSubmit>
            <h3 class: Title>HTTP POST Demo</h3>
            <p class: Desc>json_stringify + http_post + await + @if 状态切换</p>

            <div class: Form>
                <label class: FieldLabel>Title</label>
                <input bind:value={title} placeholder="Enter title..." class: FieldInput></input>

                <label class: FieldLabel>Body</label>
                <textarea bind:value={body} placeholder="Enter body..." rows="3" class: FieldTextarea></textarea>

                <div class: BtnRow>
                    <button class: BtnSubmit @onPress={submitForm}>Submit</button>
                    <button class: BtnReset @onPress={reset}>Reset</button>
                </div>
            </div>

            @if submitStatus == "loading" {
                <div class: StatusBox LoadingBox>
                    <p class: LoadingText>Submitting...</p>
                </div>
            }
            @else if submitStatus == "success" {
                <div class: StatusBox SuccessBox>
                    <p class: Label>Server Response:</p>
                    <pre class: Result>{responseText}</pre>
                </div>
            }
            @else if submitStatus == "error" {
                <div class: StatusBox ErrorBox>
                    <p class: Label>Error:</p>
                    <p class: ErrorText>{responseText}</p>
                </div>
            }
        </div>
    }
    style {
    }
}
