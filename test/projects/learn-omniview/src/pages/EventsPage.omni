// EventsPage — 事件/表单/插槽
import omniview;
import { LearnDesign } from "../design";
import { EventShorthand } from "../components/EventShorthand";
import { FormControlsDemo } from "../components/FormControlsDemo";
import { EventsDemo } from "../components/EventsDemo";
import { EventDataDemo } from "./EventDataDemo";
import { SlotDefaultDemo } from "../components/SlotDefaultDemo";
import { EmitKeywordDemo } from "../components/EmitKeywordDemo";
import { EmitEventDemo } from "../components/EmitEventDemo";

component EventsPage {
    view {
        <section class: LearnDesign.DemoSection>
            <div class: LearnDesign.Row>
                <div class: LearnDesign.Col><EventShorthand /></div>
                <div class: LearnDesign.Col><FormControlsDemo /></div>
            </div>
            <div class: LearnDesign.DemoFull><EventsDemo /></div>
            <div class: LearnDesign.DemoFull><EventDataDemo /></div>
            <div class: LearnDesign.Row>
                <div class: LearnDesign.Col><SlotDefaultDemo /></div>
                <div class: LearnDesign.Col><EmitKeywordDemo /></div>
            </div>
            <div class: LearnDesign.DemoFull><EmitEventDemo /></div>
        </section>
    }
}
