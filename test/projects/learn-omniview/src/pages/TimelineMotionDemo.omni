import omniview;

// ╔══════════════════════════════════════════════════════════════╗
// ║  🧪 Playwright Test                                         ║
// ║                                                            ║
// ║  **Steps:**                                                ║
// ║  1. Navigate to TimelineMotionDemo component page.         ║
// ║  2. Verify the container div has @timeline={pageEnter}.    ║
// ║  3. Check h3 heading has @timeline={pageEnter} attribute.  ║
// ║  4. Verify header, body, and footer cards each have        ║
// ║     @timeline={pageEnter} attribute.                       ║
// ║  5. Confirm page loads with timeline-driven animations.    ║
// ║                                                            ║
// ║  **Expected:**                                             ║
// ║  - Container div has data-timeline="pageEnter".            ║
// ║  - Heading and 3 card divs have data-timeline="pageEnter". ║
// ║  - @timeline pageEnter runs set/label/stagger on page      ║
// ║    enter with header body footer sequenced animations.     ║
// ║  - Elements animate in correct stagger order (0.05s gap).  ║
// ╚══════════════════════════════════════════════════════════════╝

// NOTE: set { opacity: 0 } was removed because the compiler compiles it to
// document.querySelector("[data-nid]") which selects the FIRST data-nid element
// in the entire page, causing a full-page flash/zoom effect.
@timeline pageEnter {
    label intro
    stagger(0.05)
    header { from { y: -20 opacity: 0 } to { y: 0 opacity: 1 } over 300 ease easeOut }
    body   { from { opacity: 0 } to { opacity: 1 } over 400 delay 200 ease easeOut }
    label outro
    footer { from { y: 20 opacity: 0 } to { y: 0 opacity: 1 } over 300 ease easeOut }
}

component TimelineMotionDemo {
    view {
        <div class: container @timeline={pageEnter}>
            <h3 class: title>Timeline Motion Demo</h3>
            <p class: subtitle>@timeline · set · stagger · label</p>

            <div class: card @timeline={pageEnter}>
                <h4 class: label>header</h4>
                <p>包含在 pageEnter timeline 中</p>
            </div>
            <div class: card @timeline={pageEnter}>
                <h4 class: label>body</h4>
                <p>stagger 0.05s 逐个入场</p>
            </div>
            <div class: card @timeline={pageEnter}>
                <h4 class: label>footer</h4>
                <p>最后入场（label outro 之后）</p>
            </div>
        </div>
    }
    style {
        .container { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 4px 0; }
        .subtitle { font-size: 13px; color: #9ca3af; margin: 0 0 16px 0; }
        .card { margin-bottom: 12px; padding: 12px; background: #f9fafb; border-radius: 8px; border: 1px solid #e5e7eb; }
        .label { font-size: 14px; font-weight: 600; color: #374151; margin: 0 0 4px 0; }
    }
}
