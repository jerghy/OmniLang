// ╔══════════════════════════════════════════════════════════════╗
// ║  KeyframeAnimationDemo.omni — 全触发器 + 播放属性 + 缓动     ║
// ║                                                              ║
// ║  动画功能全集：                                               ║
// ║    8 触发器: @enter @hover @press @focus @in-view @scroll    ║
// ║              @drag-horizontal @drag-vertical                 ║
// ║    4 播放属性: Loop Direction Fill Delay                    ║
// ║    4 缓动变体: Named CubicBezier Back Elastic               ║
// ║    多停靠关键帧（百分比）                                     ║
// ║                                                              ║
// ║  触发器的控制维度（@scroll start/end/scrub、@drag            ║
// ║  constraints/elastic/threshold）见 MotionTriggersDemo。       ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";

// ═══════════════════════════════════════════════════════════════
// @motion 定义 — 覆盖全部 8 触发器 + 4 播放属性 + 4 缓动变体
// ═══════════════════════════════════════════════════════════════

// ── @enter 入场动画 ──
@motion enterFadeUp {
    from { opacity: 0, translateY: 20 }
    to   { opacity: 1, translateY: 0 }
    over: 500ms
    easing: power2-out
}

// ── @hover 悬停动画 ──
@motion hoverScale {
    to { scale: 1.05 }
    over: 200ms
    easing: ease-out
}

// ── @press 按压动画 ──
@motion pressShrink {
    to { scale: 0.95 }
    over: 100ms
    easing: ease-out
}

// ── @focus 聚焦动画 ──
@motion focusGlow {
    to { scale: 1.05 }
    over: 200ms
    easing: ease-out
}

// ── @in-view 滚动入视 ──
@motion inViewSlide {
    from { opacity: 0, translateY: 30 }
    to   { opacity: 1, translateY: 0 }
    over: 600ms
    easing: power2-out
}

// ── @scroll 滚动驱动 ──
@motion scrollProgress {
    from { opacity: 0.3, scale: 0.95 }
    to   { opacity: 1, scale: 1 }
    over: 500ms
    easing: ease-out
}

// ── @drag-horizontal 水平拖拽 ──
@motion dragSlideX {
    from { translateX: 0 }
    to   { translateX: 100 }
    over: 300ms
    easing: power2-out
}

// ── @drag-vertical 垂直拖拽 ──
@motion dragSlideY {
    from { translateY: 0 }
    to   { translateY: 60 }
    over: 300ms
    easing: power2-out
}

// ── Loop（循环） ──
@motion spinLoop {
    to { rotate: 360 }
    over: 2000ms
    easing: linear
    loop
}

// ── Direction（方向） ──
@motion dirAlternate {
    from { scale: 1 }
    to   { scale: 1.3 }
    over: 800ms
    easing: power2-out
    direction alternate
}

@motion dirAltReverse {
    from { scale: 1 }
    to   { scale: 1.4 }
    over: 800ms
    easing: power2-out
    direction alternateReverse
}

// ── Fill（填充） ──
@motion fillForwards {
    from { translateX: -20, opacity: 0 }
    to   { translateX: 0, opacity: 1 }
    over: 1000ms
    easing: power2-out
    fill forwards
}

@motion fillBackwards {
    from { opacity: 0 }
    to   { opacity: 1 }
    over: 600ms
    easing: power2-out
    delay 500
    fill backwards
}

@motion fillBoth {
    from { scale: 0.8, opacity: 0 }
    to   { scale: 1.2, opacity: 1 }
    over: 600ms
    easing: power2-out
    delay 300
    fill both
}

// ── Delay（延迟） ──
@motion delayedEntrance {
    from { translateY: 20, opacity: 0 }
    to   { translateY: 0, opacity: 1 }
    over: 400ms
    easing: power2-out
    delay 500
}

// ── CubicBezier 缓动 ──
@motion cubicDemo {
    from { translateX: 0 }
    to   { translateX: 180 }
    over: 800ms
    easing: cubic(x1: 0.68, y1: -0.55, x2: 0.27, y2: 1.55)
}

// ── Back 缓动（named-only） ──
@motion backEaseDemo {
    from { translateX: 0 }
    to   { translateX: 180 }
    over: 800ms
    easing: back-out
}

// ── Elastic 缓动（named-only） ──
@motion elasticEaseDemo {
    from { translateX: 0 }
    to   { translateX: 180 }
    over: 1200ms
    easing: elastic-out
}

// ── 多停靠关键帧（百分比） ──
@motion multiStopDemo {
    0%   { opacity: 0, scale: 0.5, backgroundColor: "#6366f1" }
    25%  { opacity: 0.5, scale: 0.8 }
    50%  { opacity: 1, scale: 1.2, backgroundColor: "#10b981" }
    75%  { opacity: 1, scale: 1.05 }
    100% { opacity: 1, scale: 1, backgroundColor: "#f59e0b" }
    over: 1200ms
    easing: ease-in-out
}

// ═══════════════════════════════════════════════════════════════
// 组件
// ═══════════════════════════════════════════════════════════════
component KeyframeAnimationDemo {
    // 重放机制：切换 playAll 信号会重放本组件全部命名 @enter 动画
    // （omniview 运行时语义：命名 @enter 动画随信号变化重放）
    signal playAll: bool = false;

    fn toggleAll() { playAll = !playAll; }

    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>Keyframe Animation Demo</h3>
            <p class: LearnDesign.Subtitle>8 触发器 · 4 播放属性 · 4 缓动变体 · 多停靠关键帧</p>

            <!-- 重放全部：切换 playAll 信号 → 重放本组件所有命名 @enter 动画 -->
            <button variant: LearnDesign.Button(color=primary, size=sm) @click={toggleAll}>
                Replay All @enter Animations
            </button>

            <!-- ═══ 触发器组 ═══ -->
            <h4 class: LearnDesign.SectionTitle>全部 8 触发器</h4>

            <div class: TriggerGrid>
                <!-- @enter -->
                <div class: MotionCard @enter={enterFadeUp}>
                    <strong>@enter</strong>
                    <p>入场动画 fadeUp 500ms</p>
                </div>

                <!-- @hover -->
                <div class: MotionCard @hover={hoverScale}>
                    <strong>@hover</strong>
                    <p>悬停缩放 1.05x</p>
                </div>

                <!-- @press -->
                <div class: MotionCard @press={pressShrink}>
                    <strong>@press</strong>
                    <p>按压缩小 0.95x</p>
                </div>

                <!-- @focus -->
                <div class: MotionCard>
                    <strong>focus</strong>
                    <p>聚焦按钮触发</p>
                    <button class: FocusBtn @focus={focusGlow}>Focus me</button>
                </div>

                <div class: MotionCard @in-view={inViewSlide}>
                    <strong>@in-view</strong>
                    <p>进入视口触发</p>
                </div>

                <!-- @scroll / @drag 的控制维度（start/end/scrub、constraints/elastic）见 MotionTriggersDemo -->
                <div class: "MotionCard ScrollArea" @scroll={scrollProgress}>
                    <strong>@scroll</strong>
                    <p>滚动驱动</p>
                </div>

                <div class: MotionCard @drag-horizontal={dragSlideX}>
                    <strong>@drag-horizontal</strong>
                    <p>水平拖拽 →</p>
                </div>

                <div class: MotionCard @drag-vertical={dragSlideY}>
                    <strong>@drag-vertical</strong>
                    <p>垂直拖拽 ↓</p>
                </div>
            </div>

            <!-- ═══ 播放属性组 ═══ -->
            <h4 class: LearnDesign.SectionTitle>4 个播放属性：Loop · Direction · Fill · Delay</h4>

            <div class: TriggerGrid>
                <div class: MotionCard @enter={spinLoop}>
                    <strong>Loop</strong>
                    <p>无限旋转 360°</p>
                </div>
                <div class: MotionCard @enter={dirAlternate}>
                    <strong>Direction alternate</strong>
                    <p>交替往返</p>
                </div>
                <div class: MotionCard @enter={dirAltReverse}>
                    <strong>Direction alternateReverse</strong>
                    <p>交替反向</p>
                </div>
                <div class: MotionCard @enter={fillForwards}>
                    <strong>Fill forwards</strong>
                    <p>保持终点状态</p>
                </div>
                <div class: MotionCard @enter={fillBackwards}>
                    <strong>Fill backwards + Delay</strong>
                    <p>delay 500ms 前即跳到 from 态</p>
                </div>
                <div class: MotionCard @enter={fillBoth}>
                    <strong>Fill both + Delay</strong>
                    <p>前后都填充 · delay 300ms</p>
                </div>
                <div class: MotionCard @enter={delayedEntrance}>
                    <strong>Delay 500ms</strong>
                    <p>延迟 0.5 秒开始</p>
                </div>
            </div>

            <!-- ═══ 缓动变体组 ═══ -->
            <h4 class: LearnDesign.SectionTitle>4 种缓动变体：Named · CubicBezier · Back · Elastic</h4>
            <div class: TriggerGrid>
                <div class: MotionCard @enter={enterFadeUp}>
                    <strong>Named (power2-out)</strong>
                    <p>命名曲线（缓动全集见 EasingFunctionsDemo）</p>
                </div>
                <div class: MotionCard @enter={cubicDemo}>
                    <strong>CubicBezier</strong>
                    <p>cubic(0.68, -0.55, 0.27, 1.55)</p>
                </div>
                <div class: MotionCard @enter={backEaseDemo}>
                    <strong>Back (named-only)</strong>
                    <p>back-out 回弹曲线</p>
                </div>
                <div class: MotionCard @enter={elasticEaseDemo}>
                    <strong>Elastic (named-only)</strong>
                    <p>elastic-out 弹性曲线</p>
                </div>
            </div>

            <!-- ═══ 多停靠关键帧 ═══ -->
            <h4 class: LearnDesign.SectionTitle>多停靠关键帧（百分比：0% 25% 50% 75% 100%）</h4>
            <div class: "MotionCard MultiStop" @enter={multiStopDemo}>
                <strong>Multi-stop Keyframe</strong>
                <p>5 个停靠点 · 颜色渐变 · 缩放循环</p>
            </div>
        </div>
    }

    style {
        .MotionCard strong { font-size: 13px; color: var(--textPrimary); display: block; margin-bottom: 4px; }
        .MotionCard p { font-size: 11px; color: var(--textSecondary); margin: 0; }
    }
}
