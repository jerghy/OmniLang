// ╔══════════════════════════════════════════════════════════════╗
// ║  KeyframeAnimationDemo.omni — 全触发器 + 播放属性 + 缓动     ║
// ║                                                              ║
// ║  覆盖 ADR-032 保留的全部 16 项动画功能：                     ║
// ║    8 触发器: @enter @hover @press @focus @in-view @scroll    ║
// ║              @drag-horizontal @drag-vertical                 ║
// ║    4 播放属性: Loop Direction Fill Delay                    ║
// ║    4 缓动变体: Named CubicBezier Back Elastic               ║
// ║    多停靠关键帧（百分比）                                     ║
// ║                                                              ║
// ║  注：触发器子属性（@in-view-once/@in-view-threshold/         ║
// ║  @scroll-start/@scroll-end/@scroll-scrub/@drag-constraints/ ║
// ║  @drag-elastic/@drag-scrub/@drag-momentum）与元素级          ║
// ║  @paused 属性已按 semantic-level DSL 规范移除，              ║
// ║  待独立属性重新实现后恢复。paused 播放关键字仅作语法兼容     ║
// ║  解析、运行时不生效（PlaybackIR.paused 已按 ADR-053 删除）。║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";

// ═══════════════════════════════════════════════════════════════
// @motion 定义 — 覆盖全部 7 触发器 + 5 播放属性 + 4 缓动变体
// ═══════════════════════════════════════════════════════════════

// ── @enter 入场动画 ──
@motion enterFadeUp {
    from { opacity: 0, translateY: 20 }
    to   { opacity: 1, translateY: 0 }
    over: 500ms
    easing: power2-out
}

// ── @hover 悬停动画 ──
@motion hoverScale {
    to { scale: 1.05 }
    over: 200ms
    easing: ease-out
}

// ── @press 按压动画 ──
@motion pressShrink {
    to { scale: 0.95 }
    over: 100ms
    easing: ease-out
}

// ── @focus 聚焦动画 ──
@motion focusGlow {
    to { scale: 1.05 }
    over: 200ms
    easing: ease-out
}

// ── @in-view 滚动入视 ──
@motion inViewSlide {
    from { opacity: 0, translateY: 30 }
    to   { opacity: 1, translateY: 0 }
    over: 600ms
    easing: power2-out
}

// ── @scroll 滚动驱动 ──
@motion scrollProgress {
    from { opacity: 0.3, scale: 0.95 }
    to   { opacity: 1, scale: 1 }
    over: 500ms
    easing: ease-out
}

// ── @drag-horizontal 水平拖拽 ──
@motion dragSlideX {
    from { translateX: 0 }
    to   { translateX: 100 }
    over: 300ms
    easing: power2-out
}

// ── @drag-vertical 垂直拖拽 ──
@motion dragSlideY {
    from { translateY: 0 }
    to   { translateY: 60 }
    over: 300ms
    easing: power2-out
}

// ── Loop（循环） ──
@motion spinLoop {
    to { rotate: 360 }
    over: 2000ms
    easing: linear
    loop
}

// ── Direction（方向） ──
@motion dirAlternate {
    from { scale: 1 }
    to   { scale: 1.3 }
    over: 800ms
    easing: power2-out
    direction alternate
}

@motion dirAltReverse {
    from { scale: 1 }
    to   { scale: 1.4 }
    over: 800ms
    easing: power2-out
    direction alternateReverse
}

// ── Fill（填充） ──
@motion fillForwards {
    from { translateX: -20, opacity: 0 }
    to   { translateX: 0, opacity: 1 }
    over: 1000ms
    easing: power2-out
    fill forwards
}

@motion fillBackwards {
    from { opacity: 0 }
    to   { opacity: 1 }
    over: 600ms
    easing: power2-out
    delay 500
    fill backwards
}

@motion fillBoth {
    from { scale: 0.8, opacity: 0 }
    to   { scale: 1.2, opacity: 1 }
    over: 600ms
    easing: power2-out
    delay 300
    fill both
}

// ── Delay（延迟） ──
@motion delayedEntrance {
    from { translateY: 20, opacity: 0 }
    to   { translateY: 0, opacity: 1 }
    over: 400ms
    easing: power2-out
    delay 500
}

// ── CubicBezier 缓动 ──
@motion cubicDemo {
    from { translateX: 0 }
    to   { translateX: 180 }
    over: 800ms
    easing: cubic(x1: 0.68, y1: -0.55, x2: 0.27, y2: 1.55)
}

// ── Back 缓动（named-only） ──
@motion backEaseDemo {
    from { translateX: 0 }
    to   { translateX: 180 }
    over: 800ms
    easing: back-out
}

// ── Elastic 缓动（named-only） ──
@motion elasticEaseDemo {
    from { translateX: 0 }
    to   { translateX: 180 }
    over: 1200ms
    easing: elastic-out
}

// ── 多停靠关键帧（百分比） ──
@motion multiStopDemo {
    0%   { opacity: 0, scale: 0.5, backgroundColor: "#6366f1" }
    25%  { opacity: 0.5, scale: 0.8 }
    50%  { opacity: 1, scale: 1.2, backgroundColor: "#10b981" }
    75%  { opacity: 1, scale: 1.05 }
    100% { opacity: 1, scale: 1, backgroundColor: "#f59e0b" }
    over: 1200ms
    easing: ease-in-out
}

// ═══════════════════════════════════════════════════════════════
// 组件
// ═══════════════════════════════════════════════════════════════
component KeyframeAnimationDemo {
    signal playTriggers: bool = false;
    signal playPlayback: bool = false;

    fn toggleTriggers() { playTriggers = !playTriggers; }
    fn togglePlayback() { playPlayback = !playPlayback; }

    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>Keyframe Animation Demo</h3>
            <p class: LearnDesign.Subtitle>8 触发器 · 4 播放属性 · 4 缓动变体 · 多停靠关键帧 (ADR-032)</p>

            <!-- ═══ 触发器组 ═══ -->
            <h4 class: LearnDesign.SectionTitle>全部 8 触发器</h4>
            <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={toggleTriggers}>
                {if playTriggers { "Reset Triggers" } else { "Play All Triggers" }}
            </button>

            <div class: trigger-grid>
                <!-- @enter -->
                <div class: card @enter={enterFadeUp}>
                    <strong>@enter</strong>
                    <p>入场动画 fadeUp 500ms</p>
                </div>

                <!-- @hover -->
                <div class: card @hover={hoverScale}>
                    <strong>@hover</strong>
                    <p>悬停缩放 1.05x</p>
                </div>

                <!-- @press -->
                <div class: card @press={pressShrink}>
                    <strong>@press</strong>
                    <p>按压缩小 0.95x</p>
                </div>

                <!-- @focus -->
                <div class: card>
                    <strong>focus</strong>
                    <p>聚焦按钮触发</p>
                    <button class: focus-btn @focus={focusGlow}>Focus me</button>
                </div>

                <!-- @in-view（子属性 @in-view-once/@in-view-threshold 已移除，待重新实现） -->
                <div class: card @in-view={inViewSlide}>
                    <strong>@in-view</strong>
                    <p>进入视口触发</p>
                </div>

                <!-- @scroll（子属性 @scroll-start/@scroll-end/@scroll-scrub 已移除，待重新实现） -->
                <div class: "card scroll-area" @scroll={scrollProgress}>
                    <strong>@scroll</strong>
                    <p>滚动驱动</p>
                </div>

                <!-- @drag-horizontal（子属性 @drag-constraints/@drag-elastic/@drag-scrub/@drag-momentum 已移除，待重新实现） -->
                <div class: card @drag-horizontal={dragSlideX}>
                    <strong>@drag-horizontal</strong>
                    <p>水平拖拽 →</p>
                </div>

                <!-- @drag-vertical（子属性 @drag-constraints/@drag-elastic/@drag-scrub 已移除，待重新实现） -->
                <div class: card @drag-vertical={dragSlideY}>
                    <strong>@drag-vertical</strong>
                    <p>垂直拖拽 ↓</p>
                </div>
            </div>

            <!-- ═══ 播放属性组 ═══ -->
            <h4 class: LearnDesign.SectionTitle>4 个播放属性：Loop · Direction · Fill · Delay</h4>
            <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={togglePlayback}>
                {if playPlayback { "Reset" } else { "Play Playback Props" }}
            </button>

            <div class: trigger-grid>
                <div class: card @enter={spinLoop}>
                    <strong>Loop</strong>
                    <p>无限旋转 360°</p>
                </div>
                <div class: card @enter={dirAlternate}>
                    <strong>Direction alternate</strong>
                    <p>交替往返</p>
                </div>
                <div class: card @enter={dirAltReverse}>
                    <strong>Direction alternateReverse</strong>
                    <p>交替反向</p>
                </div>
                <div class: card @enter={fillForwards}>
                    <strong>Fill forwards</strong>
                    <p>保持终点状态</p>
                </div>
                <div class: card @enter={fillBackwards}>
                    <strong>Fill backwards + Delay</strong>
                    <p>delay 500ms 前即跳到 from 态</p>
                </div>
                <div class: card @enter={fillBoth}>
                    <strong>Fill both + Delay</strong>
                    <p>前后都填充 · delay 300ms</p>
                </div>
                <div class: card @enter={delayedEntrance}>
                    <strong>Delay 500ms</strong>
                    <p>延迟 0.5 秒开始</p>
                </div>
            </div>

            <!-- ═══ 缓动变体组 ═══ -->
            <h4 class: LearnDesign.SectionTitle>4 种缓动变体：Named · CubicBezier · Back · Elastic</h4>
            <div class: trigger-grid>
                <div class: card @enter={enterFadeUp}>
                    <strong>Named (power2-out)</strong>
                    <p>29 种命名曲线之一</p>
                </div>
                <div class: card @enter={cubicDemo}>
                    <strong>CubicBezier</strong>
                    <p>cubic(0.68, -0.55, 0.27, 1.55)</p>
                </div>
                <div class: card @enter={backEaseDemo}>
                    <strong>Back (named-only)</strong>
                    <p>back-out 回弹曲线</p>
                </div>
                <div class: card @enter={elasticEaseDemo}>
                    <strong>Elastic (named-only)</strong>
                    <p>elastic-out 弹性曲线</p>
                </div>
            </div>

            <!-- ═══ 多停靠关键帧 ═══ -->
            <h4 class: LearnDesign.SectionTitle>多停靠关键帧（百分比：0% 25% 50% 75% 100%）</h4>
            <div class: "card multi-stop" @enter={multiStopDemo}>
                <strong>Multi-stop Keyframe</strong>
                <p>5 个停靠点 · 颜色渐变 · 缩放循环</p>
            </div>

            <!-- ═══ 元素级 @paused 属性已移除 ═══
                 按 semantic-level DSL 规范，@paused={expr} 元素属性已被移除
                 （条件渲染可替代该语义）；paused 播放关键字仅作语法兼容解析、
                 运行时不生效（PlaybackIR.paused 已按 ADR-053 删除）。 -->
        </div>
    }

    style {
        .trigger-grid { display: flex; flex-wrap: wrap; gap: 10px; margin: 12px 0; }
        .card { flex: 0 0 auto; padding: 14px 16px; background: var(--surfaceMuted); border-radius: var(--radiusMd); border: 1px solid var(--borderLight); text-align: center; min-width: 140px; cursor: default; }
        .card strong { font-size: 13px; color: var(--textPrimary); display: block; margin-bottom: 4px; }
        .card p { font-size: 11px; color: var(--textSecondary); margin: 0; }
        .scroll-area { height: 100px; overflow-y: auto; }
        .multi-stop { padding: 24px; text-align: center; background: var(--surfaceMuted); }
        .focus-btn { margin-top: 6px; padding: 4px 10px; font-size: 11px; background: var(--primary); color: #fff; border: none; border-radius: 6px; cursor: pointer; }
    }
}
