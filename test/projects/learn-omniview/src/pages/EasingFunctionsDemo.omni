// ╔══════════════════════════════════════════════════════════════════════╗
// ║  EasingFunctionsDemo — 缓动全家桶覆盖（24 种未使用的缓动）          ║
// ║                                                                    ║
// ║  Power 组：   easeIn, power1In/Out/InOut, power2In/InOut,          ║
// ║               power3In/InOut, power4In/Out/InOut                   ║
// ║  Back 组：    backIn/Out/InOut (with intensity)                    ║
// ║  Bounce 组：  bounceIn/Out/InOut                                   ║
// ║  Elastic 组： elasticIn/Out/InOut (with amplitude/period)          ║
// ║  Spring 组：  spring(tension, friction, velocity)                  ║
// ║  Custom 组：  cubic(x1,y1,x2,y2), steps(count,direction)           ║
// ╚══════════════════════════════════════════════════════════════════════╝
import omniview;

// ╔══════════════════════════════════════════════════════════════╗
// ║  🧪 Playwright Test                                         ║
// ║                                                            ║
// ║  **Steps:**                                                ║
// ║  1. Navigate to EasingFunctionsDemo component page.        ║
// ║  2. Verify all 24 easing function cards render.            ║
// ║  3. Check Power group: easeIn, power1/2/3/4 variants.      ║
// ║  4. Check Back group: backIn/Out/InOut + custom intensity. ║
// ║  5. Check Bounce group: bounceIn/Out/InOut.               ║
// ║  6. Check Elastic group: elasticIn/Out/InOut + custom.     ║
// ║  7. Check Spring group: spring(tension,friction,velocity). ║
// ║  8. Check Custom group: cubic-bezier and steps.            ║
// ║  9. Click "Play All Animations" button to trigger @enter   ║
// ║     on all cards.                                          ║
// ║                                                            ║
// ║  **Expected:**                                             ║
// ║  - 24 cards rendered, each with @enter motion data attr.   ║
// ║  - easeIn card has @enter={easeInMove} (ease easeIn).      ║
// ║  - power4InOut card has @enter={power4InOutMove} (ease     ║
// ║    power4InOut).                                           ║
// ║  - backOutIntensity card has ease backOut(intensity:3.5).  ║
// ║  - elasticCustom card has ease elasticOut(amp:2,per:0.8).  ║
// ║  - springBouncy card uses spring(120,8,2).                 ║
// ║  - cubicCustom card uses cubic(x1,y1,x2,y2).              ║
// ║  - stepsDemo card uses steps(count:6,direction:end).       ║
// ║  - "Play All Animations" button rendered and clickable.    ║
// ╚══════════════════════════════════════════════════════════════╝

// ══════════════════════════════════════════════════════════════════════
//  POWER 系列 — power1 (quadratic)
// ══════════════════════════════════════════════════════════════════════

@motion power1InMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease power1In
}

@motion power1OutMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease power1Out
}

@motion power1InOutMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease power1InOut
}

// ══════════════════════════════════════════════════════════════════════
//  POWER 系列 — power2 (cubic) · In 和 InOut 未使用（Out 已用）
// ══════════════════════════════════════════════════════════════════════

@motion power2InMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease power2In
}

@motion power2InOutMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease power2InOut
}

// ══════════════════════════════════════════════════════════════════════
//  POWER 系列 — power3 (quartic) · In 和 InOut 未使用（Out 已用）
// ══════════════════════════════════════════════════════════════════════

@motion power3InMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease power3In
}

@motion power3InOutMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease power3InOut
}

// ══════════════════════════════════════════════════════════════════════
//  POWER 系列 — power4 (quintic) 全部未使用
// ══════════════════════════════════════════════════════════════════════

@motion power4InMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease power4In
}

@motion power4OutMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease power4Out
}

@motion power4InOutMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease power4InOut
}

// ── base easeIn（最简单） ───────────────────────────────────
@motion easeInMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease easeIn
}

// ══════════════════════════════════════════════════════════════════════
//  BACK 系列 — overshoot 弹回
// ══════════════════════════════════════════════════════════════════════

@motion backInMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease backIn
}

@motion backOutMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease backOut
}

@motion backInOutMove {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease backInOut
}

@motion backOutIntensity {
    from { x: 0 }
    to   { x: 200 }
    over 800 ease backOut(intensity: 3.5)
}

// ══════════════════════════════════════════════════════════════════════
//  BOUNCE 系列
// ══════════════════════════════════════════════════════════════════════

@motion bounceInMove {
    from { x: 0 }
    to   { x: 180 }
    over 1000 ease bounceIn
}

@motion bounceOutMove {
    from { x: 0 }
    to   { x: 180 }
    over 1000 ease bounceOut
}

@motion bounceInOutMove {
    from { x: 0 }
    to   { x: 180 }
    over 1000 ease bounceInOut
}

// ══════════════════════════════════════════════════════════════════════
//  ELASTIC 系列
// ══════════════════════════════════════════════════════════════════════

@motion elasticInMove {
    from { x: 0 }
    to   { x: 180 }
    over 1200 ease elasticIn
}

@motion elasticOutMove {
    from { x: 0 }
    to   { x: 180 }
    over 1200 ease elasticOut
}

@motion elasticInOutMove {
    from { x: 0 }
    to   { x: 180 }
    over 1200 ease elasticInOut
}

@motion elasticCustomMove {
    from { x: 0 }
    to   { x: 200 }
    over 1500 ease elasticOut(amplitude: 2.0, period: 0.8)
}

// ══════════════════════════════════════════════════════════════════════
//  SPRING 物理缓动
// ══════════════════════════════════════════════════════════════════════

@motion springDefault {
    from { x: 0, opacity: 0.3 }
    to   { x: 180, opacity: 1 }
    over 1000 ease spring(tension: 180, friction: 12)
}

@motion springBouncy {
    from { x: 0 }
    to   { x: 200 }
    over 1000 ease spring(tension: 120, friction: 8, velocity: 2)
}

@motion springStiff {
    from { scale: 1 }
    to   { scale: 1.3 }
    over 600 ease spring(tension: 400, friction: 30)
}

// ══════════════════════════════════════════════════════════════════════
//  CUBIC BEZIER — 4 参数自定义三次贝塞尔
// ══════════════════════════════════════════════════════════════════════

@motion cubicCustom {
    from { x: 0 }
    to   { x: 180 }
    over 800 ease cubic(x1: 0.68, y1: -0.55, x2: 0.27, y2: 1.55)
}

// ══════════════════════════════════════════════════════════════════════
//  STEPS — 逐帧动画
// ══════════════════════════════════════════════════════════════════════

@motion stepsDemo {
    from { x: 0 }
    to   { x: 180 }
    over 1000 ease steps(count: 6, direction: end)
}

// ══════════════════════════════════════════════════════════════════════
//  组件
// ══════════════════════════════════════════════════════════════════════
component EasingFunctionsDemo {
    signal playAll: bool = false;

    fn toggleAll() { playAll = !playAll; }

    view {
        <div class: container>
            <h3 class: title>缓动函数全家桶</h3>
            <p class: subtitle>24 种未测试缓动 · 点击按钮播放当前屏幕所有 @enter 动画</p>
            <button @press={springStiff} @click={toggleAll} class: trigger-btn>
                {if playAll { "Reset" } else { "Play All Animations" }}
            </button>

            <!-- ═══ Power 组 ═══ -->
            <h4 class: group-title>Power 曲线（easeIn · power1 · power2 · power3 · power4）</h4>
            <div class: grid>
                <div class: card @enter={easeInMove}><strong>easeIn</strong><p>三次方加速</p></div>
                <div class: card @enter={power1InMove}><strong>power1In</strong><p>二次方入</p></div>
                <div class: card @enter={power1OutMove}><strong>power1Out</strong><p>二次方出</p></div>
                <div class: card @enter={power1InOutMove}><strong>power1InOut</strong><p>二次方出入</p></div>
                <div class: card @enter={power2InMove}><strong>power2In</strong><p>三次方入</p></div>
                <div class: card @enter={power2InOutMove}><strong>power2InOut</strong><p>三次方出入</p></div>
                <div class: card @enter={power3InMove}><strong>power3In</strong><p>四次方入</p></div>
                <div class: card @enter={power3InOutMove}><strong>power3InOut</strong><p>四次方出入</p></div>
                <div class: card @enter={power4InMove}><strong>power4In</strong><p>五次方入</p></div>
                <div class: card @enter={power4OutMove}><strong>power4Out</strong><p>五次方出</p></div>
                <div class: card @enter={power4InOutMove}><strong>power4InOut</strong><p>五次方出入</p></div>
            </div>

            <!-- ═══ Back 组 ═══ -->
            <h4 class: group-title>Back 弹回（带可选 intensity 参数）</h4>
            <div class: grid>
                <div class: card @enter={backInMove}><strong>backIn</strong><p>默认 intensity 1.7</p></div>
                <div class: card @enter={backOutMove}><strong>backOut</strong><p>默认 intensity 1.7</p></div>
                <div class: card @enter={backInOutMove}><strong>backInOut</strong><p>默认 intensity 1.7</p></div>
                <div class: card @enter={backOutIntensity}><strong>backOut(3.5)</strong><p>自定义弹回强度</p></div>
            </div>

            <!-- ═══ Bounce 组 ═══ -->
            <h4 class: group-title>Bounce 弹跳</h4>
            <div class: grid>
                <div class: card @enter={bounceInMove}><strong>bounceIn</strong><p>弹跳入</p></div>
                <div class: card @enter={bounceOutMove}><strong>bounceOut</strong><p>弹跳出</p></div>
                <div class: card @enter={bounceInOutMove}><strong>bounceInOut</strong><p>弹跳出入</p></div>
            </div>

            <!-- ═══ Elastic 组 ═══ -->
            <h4 class: group-title>Elastic 弹性（带可选 amplitude/period 参数）</h4>
            <div class: grid>
                <div class: card @enter={elasticInMove}><strong>elasticIn</strong><p>默认振幅 1.0/周期 0.5</p></div>
                <div class: card @enter={elasticOutMove}><strong>elasticOut</strong><p>默认振幅 1.0/周期 0.5</p></div>
                <div class: card @enter={elasticInOutMove}><strong>elasticInOut</strong><p>默认振幅 1.0/周期 0.5</p></div>
                <div class: card @enter={elasticCustomMove}><strong>elasticOut(2,0.8)</strong><p>自定义振幅/周期</p></div>
            </div>

            <!-- ═══ Spring 组 ═══ -->
            <h4 class: group-title>Spring 物理缓动（tension · friction · velocity）</h4>
            <div class: grid>
                <div class: card @enter={springDefault}><strong>spring(180,12)</strong><p>默认弹簧参数</p></div>
                <div class: card @enter={springBouncy}><strong>spring(120,8,2)</strong><p>弹性大·阻尼小</p></div>
                <div class: card @enter={springStiff}><strong>spring(400,30)</strong><p>刚硬弹簧·scale</p></div>
            </div>

            <!-- ═══ Custom 组 ═══ -->
            <h4 class: group-title>自定义缓动（cubic-bezier · steps）</h4>
            <div class: grid>
                <div class: card @enter={cubicCustom}><strong>cubic(x1,y1,x2,y2)</strong><p>自定义贝塞尔 overshoot</p></div>
                <div class: card @enter={stepsDemo}><strong>steps(6,end)</strong><p>6 帧逐帧动画</p></div>
            </div>
        </div>
    }

    style {
        .container { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 4px 0; }
        .subtitle { font-size: 12px; color: #9ca3af; margin: 0 0 12px 0; }
        .trigger-btn { padding: 8px 16px; background: #6366f1; color: #fff; border: none; border-radius: 6px; font-size: 13px; cursor: pointer; margin-bottom: 8px; }
        .group-title { font-size: 14px; font-weight: 600; color: #374151; margin: 20px 0 10px 0; padding-bottom: 4px; border-bottom: 1px solid #e5e7eb; }
        .grid { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 4px; }
        .card { flex: 0 0 auto; padding: 12px 14px; background: #f9fafb; border-radius: 10px; border: 1px solid #e5e7eb; text-align: center; min-width: 110px; }
        .card strong { font-size: 11px; color: #374151; display: block; margin-bottom: 2px; }
        .card p { font-size: 10px; color: #6b7280; margin: 0; }
    }
}
