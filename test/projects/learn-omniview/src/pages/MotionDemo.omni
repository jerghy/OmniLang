import omniview;

@motion fadeInUp {
  from { opacity: 0, translateY: 20 }
  to   { opacity: 1, translateY: 0 }
  over: 400ms
  easing: ease-out
}

@motion scalePress {
  to { scale: 0.95 }
  over: 100ms
  easing: ease-out
}

@motion listItem {
  from { opacity: 0, translateX: -20 }
  to   { opacity: 1, translateX: 0 }
  over: 300ms
  easing: power2-out
}

@motion pulse {
  to { scale: 1.05 }
  over: 800ms
  easing: ease-in-out
  direction alternate
  loop
}

component MotionDemo {
  signal count: i32 = 0;
  signal isOpen: bool = false;

  fn toggleModal() {
    isOpen = !isOpen
  }

  fn addItem() {
    count = count + 1
  }

  fn removeItem() {
    count = count - 1
  }

  view {
    <div>
      <h1 @enter={fadeInUp}>Motion Demo</h1>

      <p>Count: {count}</p>

      <button @press={scalePress} @hover={pulse} @onPress={toggleModal}>
        Toggle Modal
      </button>

      <!-- @modal 受控模态：焦点陷阱 / Esc / 遮罩点击 / aria 由编译器生成，@enter 打开动画 -->
      <dialog @modal={isOpen} @enter={fadeInUp}>
        @slot header {
          <h2>Modal Content</h2>
        }
        @slot body {
          <p>受控信号 isOpen 为唯一真源——打开/关闭（含 Esc、遮罩点击）均回写该信号。</p>
        }
        @slot footer {
          <button @onPress={toggleModal}>关闭</button>
        }
      </dialog>

      <button @press={scalePress} @onPress={addItem}>Add Item</button>
      <button @press={scalePress} @onPress={removeItem}>Remove Item</button>

      <div @hover={pulse} @press={scalePress}>
        Interactive Panel
      </div>
    </div>
  }
}
