import omniview;
import { LearnDesign } from "../design";

// ╔══════════════════════════════════════════════════════════════╗
// ║  🧪 Playwright Test                                         ║
// ║                                                            ║
// ║  **Steps:**                                                ║
// ║  1. Navigate to MotionTriggersDemo component page.         ║
// ║  2. Verify all trigger sections render: @unhover button,   ║
// ║     @focus input, @animate spin-box, @inView divs,         ║
// ║     @scroll area, @dragHorizontal/@dragVertical boxes.     ║
// ║  3. Hover then unhover the "Hover then leave" button.      ║
// ║  4. Focus the input field — verify focusGlow animation.    ║
// ║  5. Check the spinning div has @animate={autoSpin}.        ║
// ║  6. Scroll page to trigger @inView elements (slideInView). ║
// ║  7. Scroll within the scroll area to trigger @scroll.      ║
// ║  8. Attempt drag on the horizontal and vertical drag boxes.║
// ║                                                            ║
// ║  **Expected:**                                             ║
// ║  - @unhover button has @hover and @unhover data attrs.     ║
// ║  - Input has @focus/focusGlow animation attribute.         ║
// ║  - Spin-box div has @animate={autoSpin} with loop.         ║
// ║  - @inView divs have @in-view-once/@in-view-repeat and     ║
// ║    @in-view-threshold attributes.                          ║
// ║  - @scroll div has @scroll-start, @scroll-end,             ║
// ║    @scroll-scrub attributes.                               ║
// ║  - Drag boxes have @dragHorizontal/@dragVertical,           ║
// ║    @drag-constraints, @drag-elastic, @drag-scrub,           ║
// ║    @drag-momentum, @drag-threshold, @drag-velocity-max.    ║
// ╚══════════════════════════════════════════════════════════════╝

// ═══ 动效定义 ═══
@motion unbounce {
    to { scale: 1.05 }
    over 150 ease easeOut
}

@motion focusGlow {
    to { boxShadow: "0 0 0 3px rgba(99,102,241,0.4)" }
    over 200 ease easeOut
}

@motion autoSpin {
    to { rotate: 360 }
    over 2000 ease linear
    loop
}

@motion slideInView {
    from { opacity: 0 y: 30 }
    to   { opacity: 1 y: 0 }
    over 400 ease power2Out
}

@motion scrollFade {
    from { opacity: 0.3 scale: 0.95 }
    to   { opacity: 1 scale: 1 }
    over 500 ease easeOut
}

@motion dragSlide {
    from { x: 0 }
    to   { x: 100 }
    over 300 ease power2Out
}

component MotionTriggersDemo {
    signal isHovered: bool = false;
    signal isFocused: bool = false;
    signal dragX: f64 = 0;

    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>Motion Triggers Demo</h3>
            <p class: LearnDesign.Subtitle>@unhover · @focus · @animate · @inView · @scroll · @drag</p>

            <!-- @unhover -->
            <div class: card>
                <h4 class: label>@unhover 触发器</h4>
                <button class: btn-hover
                    @hover={unbounce}
                    @unhover={unbounce}>
                    Hover then leave
                </button>
            </div>

            <!-- @focus -->
            <div class: card>
                <h4 class: label>@focus 触发器</h4>
                <input class: input-focus
                    placeholder="Focus me"
                    @focus={focusGlow} />
            </div>

            <!-- @animate -->
            <div class: card>
                <h4 class: label>@animate 触发器（持续循环）</h4>
                <div class: spin-box @animate={autoSpin}>
                    <p>↻</p>
                </div>
            </div>

            <!-- @inView + @in-view-once/重复/阈值 -->
            <div class: card>
                <h4 class: label>@inView 触发器 + 子属性</h4>
                <div @inView={slideInView}
                     @in-view-once={true}>
                    <p>Slide in once</p>
                </div>
                <div @inView={slideInView}
                     @in-view-repeat={true}
                     @in-view-threshold={0.5}>
                    <p>Slide in repeat (threshold 0.5)</p>
                </div>
            </div>

            <!-- @scroll + 子属性 -->
            <div class: card>
                <h4 class: label>@scroll 触发器 + scroll-start/end/scrub</h4>
                <div @scroll={scrollFade}
                     @scroll-start="top 80%"
                     @scroll-end="bottom 20%"
                     @scroll-scrub={0.5}
                     class: scroll-area>
                    <p>Scroll to animate</p>
                </div>
            </div>

            <!-- @dragHorizontal + @dragVertical + 拖拽子属性 -->
            <div class: card>
                <h4 class: label>@dragHorizontal / @dragVertical 拖拽</h4>
                <div @dragHorizontal={dragSlide}
                     @drag-constraints="left:0 right:300"
                     @drag-elastic={0.2}
                     @drag-scrub={true}
                     @drag-momentum={0.95}
                     @drag-threshold={30}
                     @drag-velocity-max={2000}
                     class: drag-box>
                    <p>Drag me →</p>
                </div>
                <div @dragVertical={dragSlide}
                     @drag-constraints="top:0 bottom:200"
                     @drag-elastic={0.3}
                     @drag-scrub={true}
                     @drag-momentum={0.9}
                     class: drag-box-vertical>
                    <p>Drag me ↓</p>
                </div>
            </div>
        </div>
    }
    style {
        .card { margin-bottom: 14px; padding: 12px; background: var(--surfaceMuted); border-radius: var(--radiusMd); }
        .btn-hover { padding: 10px 20px; background: var(--primary); color: white; border: none; border-radius: var(--radiusMd); font-size: 14px; cursor: pointer; }
        .input-focus { padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radiusMd); font-size: 14px; outline: none; width: 100%; }
        .spin-box { width: 60px; height: 60px; background: var(--primary); color: white; border-radius: var(--radiusLg); display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .scroll-area { height: 120px; overflow-y: auto; background: var(--surfaceSubtle); padding: 16px; border-radius: var(--radiusMd); }
        .drag-box { width: 120px; padding: 16px; background: var(--accent); color: white; border-radius: var(--radiusMd); text-align: center; cursor: grab; user-select: none; }
        .drag-box-vertical { width: 100px; padding: 16px; background: var(--primary); color: white; border-radius: var(--radiusMd); text-align: center; cursor: grab; user-select: none; margin-top: 8px; }
    }
}
