// ╔══════════════════════════════════════════════════════════════════════╗
// ║  AnimPropertiesDemo — 可动画属性覆盖（17 个属性）                      ║
// ║                                                                    ║
// ║  变换组：   scale · scaleX · scaleY · rotate · rotateX ·           ║
// ║             rotateY · rotateZ · skewX · skewY                      ║
// ║  位移组：   translateX · translateY · translateZ                   ║
// ║  视觉组：   opacity · backgroundColor · color · width · height     ║
// ║                                                                    ║
// ║  属性白名单共 19 项（另含 borderRadius · fontSize，见设计文档）。   ║
// ╚══════════════════════════════════════════════════════════════════════╝

import omniview;

// ── 变换：scaleX（X 轴缩放） ──────────────────────────
@motion scaleXDemo {
    from { scaleX: 1 }
    to   { scaleX: 1.8 }
    over: 600ms
    easing: power2-out
}

// ── 变换：scaleY（Y 轴缩放） ──────────────────────────
@motion scaleYDemo {
    from { scaleY: 1 }
    to   { scaleY: 1.5 }
    over: 500ms
    easing: power2-out
}

// ── 变换：scale（等比缩放） ──
@motion scalePulseDemo {
    from { scale: 1 }
    to   { scale: 1.25 }
    over: 700ms
    easing: ease-out
}

// ── 变换：rotateX（X 轴旋转） ─────────────────────────
@motion rotateXDemo {
    from { rotateX: 0 }
    to   { rotateX: 360 }
    over: 2000ms
    easing: ease-in-out
}

// ── 变换：rotateY（Y 轴旋转） ─────────────────────────
@motion rotateYDemo {
    from { rotateY: 0 }
    to   { rotateY: 360 }
    over: 2000ms
    easing: ease-in-out
}

// ── 变换：rotateZ（Z 轴旋转，等价于普通 rotate） ────
@motion rotateZDemo {
    from { rotateZ: 0 }
    to   { rotateZ: 360 }
    over: 1500ms
    easing: power2-out
}

// ── 变换：rotate（平面旋转） ──
@motion rotateDemo {
    from { rotate: 0 }
    to   { rotate: 180 }
    over: 700ms
    easing: ease-out
}

// ── 变换：skewX（X 轴倾斜） ────────────────────────────
@motion skewXDemo {
    from { skewX: 0 }
    to   { skewX: 15 }
    over: 600ms
    easing: power2-out
}

// ── 变换：skewY（Y 轴倾斜） ────────────────────────────
@motion skewYDemo {
    from { skewY: 0 }
    to   { skewY: 10 }
    over: 600ms
    easing: power2-out
}

// ── 位移：translateX + translateY ──
@motion translateDemo {
    from { translateX: 0, translateY: 0 }
    to   { translateX: 120, translateY: -20 }
    over: 600ms
    easing: power2-out
}

// ── 位移：translateZ ──
@motion translateZDemo {
    from { translateZ: 0 }
    to   { translateZ: 60 }
    over: 800ms
    easing: ease-in-out
}

// ── 视觉：opacity ──
@motion opacityPulseDemo {
    from { opacity: 0.3 }
    to   { opacity: 1 }
    over: 800ms
    easing: ease-out
}

// ── 视觉：backgroundColor ──
@motion bgColorDemo {
    from { backgroundColor: "#6366f1" }
    to   { backgroundColor: "#f97316" }
    over: 1200ms
    easing: ease-in-out
}

// ── 视觉：color ──
@motion textColorDemo {
    from { color: "var(--textPrimary)" }
    to   { color: "#dc2626" }
    over: 800ms
    easing: power2-out
}

// ── 视觉：width 动画 ─────────────────────────────────────
@motion widthDemo {
    from { width: 60 }
    to   { width: 200 }
    over: 900ms
    easing: ease-out
}

// ── 视觉：height 动画 ────────────────────────────────────
@motion heightDemo {
    from { height: 40 }
    to   { height: 120 }
    over: 700ms
    easing: power3-out
}

// ══════════════════════════════════════════════════════════════════════
//  组件
// ══════════════════════════════════════════════════════════════════════
component AnimPropertiesDemo {
    // 重放机制：切换 playAll 信号会重放本组件全部命名 @enter 动画
    signal playAll: bool = false;

    fn toggleAll() { playAll = !playAll; }

    view {
        <div class: Container>
            <h3 class: Title>全动画属性覆盖</h3>
            <p class: Subtitle>17 个可动画属性 · 点击按钮播放所有 @enter 动画</p>

            <button @click={toggleAll} class: TriggerBtn>
                Replay All Animations
            </button>

            <!-- ═══ 变换组 ═══ -->
            <h4 class: GroupTitle>变换组（scale · scaleX · scaleY · rotate · rotateX · rotateY · rotateZ · skewX · skewY）</h4>
            <div class: Grid>
                <div class: MotionCard @enter={scaleXDemo}>
                    <strong>scaleX</strong>
                    <p>X 轴 1→1.8 缩放</p>
                </div>
                <div class: MotionCard @enter={scaleYDemo}>
                    <strong>scaleY</strong>
                    <p>Y 轴 1→1.5 缩放</p>
                </div>
                <div class: MotionCard @enter={scalePulseDemo}>
                    <strong>scale</strong>
                    <p>等比 1→1.25 脉冲</p>
                </div>
                <div class: MotionCard @enter={rotateXDemo}>
                    <strong>rotateX</strong>
                    <p>X 轴 360° 旋转</p>
                </div>
                <div class: MotionCard @enter={rotateYDemo}>
                    <strong>rotateY</strong>
                    <p>Y 轴 360° 旋转</p>
                </div>
                <div class: MotionCard @enter={rotateZDemo}>
                    <strong>rotateZ</strong>
                    <p>Z 轴 360° 摆动</p>
                </div>
                <div class: MotionCard @enter={rotateDemo}>
                    <strong>rotate</strong>
                    <p>平面 0→180° 旋转</p>
                </div>
                <div class: MotionCard @enter={skewXDemo}>
                    <strong>skewX</strong>
                    <p>X 轴 0→15° 倾斜</p>
                </div>
                <div class: MotionCard @enter={skewYDemo}>
                    <strong>skewY</strong>
                    <p>Y 轴 0→10° 倾斜</p>
                </div>
            </div>

            <!-- ═══ 位移组 ═══ -->
            <h4 class: GroupTitle>位移组（translateX · translateY · translateZ）</h4>
            <div class: Grid>
                <div class: CardTranslate @enter={translateDemo}>
                    <strong>translateX + translateY</strong>
                    <p>位移 120px, -20px</p>
                </div>
                <div class: MotionCard @enter={translateZDemo}>
                    <strong>translateZ</strong>
                    <p>Z 轴 0→60px</p>
                </div>
            </div>

            <!-- ═══ 视觉组 ═══ -->
            <h4 class: GroupTitle>视觉组（opacity · backgroundColor · color · width · height）</h4>
            <div class: Grid>
                <div class: MotionCard @enter={opacityPulseDemo}>
                    <strong>opacity</strong>
                    <p>透明度 0.3→1 脉冲</p>
                </div>
                <div class: MotionCard @enter={bgColorDemo}>
                    <strong>backgroundColor</strong>
                    <p>背景色渐变</p>
                </div>
                <div class: CardColor @enter={textColorDemo}>
                    <strong>color</strong>
                    <p>文字颜色渐变</p>
                </div>
                <div class: Box @enter={widthDemo}>
                    <strong>width</strong>
                    <p>宽度 60→200px</p>
                </div>
                <div class: Box @enter={heightDemo}>
                    <strong>height</strong>
                    <p>高度 40→120px</p>
                </div>
            </div>
        </div>
    }

    style {
        .MotionCard strong { font-size: 13px; color: var(--textPrimary); display: block; margin-bottom: 4px; }
        .MotionCard p { font-size: 11px; color: var(--textSecondary); margin: 0; }
        .CardColor strong { font-size: 13px; color: var(--textPrimary); display: block; margin-bottom: 4px; }
        .CardColor p { font-size: 11px; color: var(--textSecondary); margin: 0; }
        .Box strong { font-size: 12px; color: #4338ca; display: block; margin-bottom: 4px; }
        .Box p { font-size: 11px; color: #6366f1; margin: 0; white-space: nowrap; }
        .CardTranslate strong { font-size: 13px; color: var(--textPrimary); display: block; margin-bottom: 4px; }
        .CardTranslate p { font-size: 11px; color: var(--textSecondary); margin: 0; }
    }
}
