// ╔══════════════════════════════════════════════════════════════════════╗
// ║  AnimPropertiesDemo — 全动画属性覆盖（26 个属性）                    ║
// ║                                                                    ║
// ║  变换组：   scaleX · scaleY · rotateX · rotateY · rotateZ          ║
// ║             skewX · skewY                                          ║
// ║  滤镜组：   blur · brightness · contrast · saturate · hueRotate    ║
// ║  颜色组：   backgroundColor · color · borderColor · borderRadius   ║
// ║  尺寸组：   width · height · margin · padding                      ║
// ║  排版组：   fontSize · letterSpacing                               ║
// ║  盒模型组： borderWidth · top · left                               ║
// ╚══════════════════════════════════════════════════════════════════════╝
import omniview;

// ╔══════════════════════════════════════════════════════════════╗
// ║  🧪 Playwright Test                                         ║
// ║                                                            ║
// ║  **Steps:**                                                ║
// ║  1. Navigate to AnimPropertiesDemo component page.         ║
// ║  2. Verify all 4 property groups render: 3D transforms,    ║
// ║     filters, colors, dimensions.                           ║
// ║  3. Check scaleX/scaleY/rotateX/rotateY/rotateZ cards.    ║
// ║  4. Check blur/brightness cards.                          ║
// ║  5. Check backgroundColor+borderRadius and color+          ║
// ║     borderColor cards.                                     ║
// ║  6. Check width/height/margin+padding cards.               ║
// ║  7. Click "Play All Animations" button to trigger @enter.  ║
// ║                                                            ║
// ║  **Expected:**                                             ║
// ║  - 26 animation cards rendered across 7 property groups.   ║
// ║  - Each card has @enter pointing to its @motion definition.║
// ║  - scaleX card: @enter={scaleXDemo}, from scaleX:1→1.8.   ║
// ║  - skewX card: @enter={skewXDemo}, skewX 0→15deg.         ║
// ║  - contrast card: @enter={contrastDemo}, contrast 1→2.5.   ║
// ║  - saturate card: @enter={saturateDemo}, saturate 1→3.     ║
// ║  - hueRotate card: @enter={hueRotateDemo}, 0→180deg.      ║
// ║  - fontSize card: @enter={fontSizeDemo}, 14→28px.          ║
// ║  - letterSpacing card: @enter={letterSpacingDemo}, 0→8px.  ║
// ║  - borderWidth card: @enter={borderWidthDemo}, 1→6px.     ║
// ║  - topLeft card: @enter={topLeftDemo}, top/left shift.    ║
// ║  - "Play All Animations" button exists and clickable.      ║
// ╚══════════════════════════════════════════════════════════════╝

// ── 3D 变换：scaleX（X 轴缩放） ──────────────────────────
@motion scaleXDemo {
    from { scaleX: 1 }
    to   { scaleX: 1.8 }
    over 600 ease power2Out
}

// ── 3D 变换：scaleY（Y 轴缩放） ──────────────────────────
@motion scaleYDemo {
    from { scaleY: 1 }
    to   { scaleY: 1.5 }
    over 500 ease power2Out
}

// ── 3D 变换：rotateX（X 轴旋转） ─────────────────────────
@motion rotateXDemo {
    from { rotateX: 0 }
    to   { rotateX: 360 }
    over 2000 ease easeInOut
}

// ── 3D 变换：rotateY（Y 轴旋转） ─────────────────────────
@motion rotateYDemo {
    from { rotateY: 0 }
    to   { rotateY: 360 }
    over 2000 ease easeInOut
}

// ── 3D 变换：rotateZ（Z 轴旋转，等价于普通 rotate） ────
@motion rotateZDemo {
    from { rotateZ: 0 }
    to   { rotateZ: 360 }
    over 1500 ease power2Out
}

// ── 滤镜：blur（高斯模糊） ───────────────────────────────
@motion blurDemo {
    from { blur: 0 }
    to   { blur: 6 }
    over 800 ease easeOut
}

// ── 滤镜：brightness（亮度） ─────────────────────────────
@motion brightnessDemo {
    from { brightness: 1 }
    to   { brightness: 2.5 }
    over 700 ease easeOut
}

// ── 颜色：backgroundColor + borderRadius 组合 ──────────
@motion bgColorDemo {
    from { backgroundColor: "#6366f1", borderRadius: 4 }
    to   { backgroundColor: "#f97316", borderRadius: 24 }
    over 1200 ease easeInOut
}

// ── 颜色：color + borderColor 组合 ──────────────────────
@motion textColorDemo {
    from { color: "#1f2937", borderColor: "#d4d4d8" }
    to   { color: "#dc2626", borderColor: "#dc2626" }
    over 800 ease power2Out
}

// ── 尺寸：width 动画 ─────────────────────────────────────
@motion widthDemo {
    from { width: 60 }
    to   { width: 200 }
    over 900 ease easeOut
}

// ── 尺寸：height 动画 ────────────────────────────────────
@motion heightDemo {
    from { height: 40 }
    to   { height: 120 }
    over 700 ease power3Out
}

// ── 尺寸：margin + padding 组合 ─────────────────────────
@motion spacingDemo {
    from { margin: 4, padding: 8 }
    to   { margin: 16, padding: 24 }
    over 1000 ease easeInOut
}

// ── 变换：skewX（X 轴倾斜） ────────────────────────────
@motion skewXDemo {
    from { skewX: 0 }
    to   { skewX: 15 }
    over 600 ease power2Out
}

// ── 变换：skewY（Y 轴倾斜） ────────────────────────────
@motion skewYDemo {
    from { skewY: 0 }
    to   { skewY: 10 }
    over 600 ease power2Out
}

// ── 滤镜：contrast（对比度） ────────────────────────────
@motion contrastDemo {
    from { contrast: 1 }
    to   { contrast: 2.5 }
    over 700 ease easeOut
}

// ── 滤镜：saturate（饱和度） ────────────────────────────
@motion saturateDemo {
    from { saturate: 1 }
    to   { saturate: 3 }
    over 700 ease easeOut
}

// ── 滤镜：hueRotate（色相旋转） ─────────────────────────
@motion hueRotateDemo {
    from { hueRotate: 0 }
    to   { hueRotate: 180 }
    over 800 ease easeInOut
}

// ── 排版：fontSize（字号） ──────────────────────────────
@motion fontSizeDemo {
    from { fontSize: 14 }
    to   { fontSize: 28 }
    over 700 ease power2Out
}

// ── 排版：letterSpacing（字间距） ───────────────────────
@motion letterSpacingDemo {
    from { letterSpacing: 0 }
    to   { letterSpacing: 8 }
    over 700 ease easeOut
}

// ── 盒模型：borderWidth（边框宽度） ──────────────────────
@motion borderWidthDemo {
    from { borderWidth: 1 }
    to   { borderWidth: 6 }
    over 600 ease easeOut
}

// ── 定位：top + left（位移） ────────────────────────────
@motion topLeftDemo {
    from { top: 0, left: 0 }
    to   { top: -20, left: 30 }
    over 600 ease power2Out
}

// ══════════════════════════════════════════════════════════════════════
//  组件
// ══════════════════════════════════════════════════════════════════════
component AnimPropertiesDemo {
    signal playAll: bool = false;

    fn toggleAll() { playAll = !playAll; }

    view {
        <div class: container>
            <h3 class: title>全动画属性覆盖</h3>
            <p class: subtitle>26 个 keyframe 属性 · scaleX/Y · rotateX/Y/Z · skewX/Y · blur · brightness · contrast · saturate · hueRotate · backgroundColor · color · borderColor · borderRadius · width · height · margin · padding · fontSize · letterSpacing · borderWidth · top · left · 点击按钮播放所有 @enter 动画</p>

            <button @click={toggleAll} class: trigger-btn>
                {if playAll { "Reset" } else { "Play All Animations" }}
            </button>

            <!-- ═══ 3D 变换组 ═══ -->
            <h4 class: group-title>变换组（scaleX · scaleY · rotateX · rotateY · rotateZ · skewX · skewY）</h4>
            <div class: grid>
                <div class: card @enter={scaleXDemo}>
                    <strong>scaleX</strong>
                    <p>X 轴 1→1.8 缩放</p>
                </div>
                <div class: card @enter={scaleYDemo}>
                    <strong>scaleY</strong>
                    <p>Y 轴 1→1.5 缩放</p>
                </div>
                <div class: card @enter={rotateXDemo}>
                    <strong>rotateX</strong>
                    <p>X 轴 360° 旋转</p>
                </div>
                <div class: card @enter={rotateYDemo}>
                    <strong>rotateY</strong>
                    <p>Y 轴 360° 旋转</p>
                </div>
                <div class: card @enter={rotateZDemo}>
                    <strong>rotateZ</strong>
                    <p>Z 轴 360° 摆动</p>
                </div>
                <div class: card @enter={skewXDemo}>
                    <strong>skewX</strong>
                    <p>X 轴 0→15° 倾斜</p>
                </div>
                <div class: card @enter={skewYDemo}>
                    <strong>skewY</strong>
                    <p>Y 轴 0→10° 倾斜</p>
                </div>
            </div>

            <!-- ═══ 滤镜组 ═══ -->
            <h4 class: group-title>滤镜组（blur · brightness · contrast · saturate · hueRotate）</h4>
            <div class: grid>
                <div class: card @enter={blurDemo}>
                    <strong>blur</strong>
                    <p>模糊 0→6px 脉冲</p>
                </div>
                <div class: card @enter={brightnessDemo}>
                    <strong>brightness</strong>
                    <p>亮度 1→2.5 脉冲</p>
                </div>
                <div class: card @enter={contrastDemo}>
                    <strong>contrast</strong>
                    <p>对比度 1→2.5</p>
                </div>
                <div class: card @enter={saturateDemo}>
                    <strong>saturate</strong>
                    <p>饱和度 1→3 脉冲</p>
                </div>
                <div class: card @enter={hueRotateDemo}>
                    <strong>hueRotate</strong>
                    <p>色相旋转 0→180°</p>
                </div>
            </div>

            <!-- ═══ 颜色组 ═══ -->
            <h4 class: group-title>颜色组（backgroundColor · color · borderColor · borderRadius）</h4>
            <div class: grid>
                <div class: card @enter={bgColorDemo}>
                    <strong>backgroundColor + borderRadius</strong>
                    <p>背景色与圆角联动</p>
                </div>
                <div class: card-border @enter={textColorDemo}>
                    <strong>color + borderColor</strong>
                    <p>文字色与边框色联动</p>
                </div>
            </div>

            <!-- ═══ 尺寸组 ═══ -->
            <h4 class: group-title>尺寸组（width · height · margin · padding）</h4>
            <div class: grid>
                <div class: box @enter={widthDemo}>
                    <strong>width</strong>
                    <p>宽度 60→200px</p>
                </div>
                <div class: box @enter={heightDemo}>
                    <strong>height</strong>
                    <p>高度 40→120px</p>
                </div>
                <div class: card @enter={spacingDemo}>
                    <strong>margin + padding</strong>
                    <p>内外边距联动</p>
                </div>
            </div>

            <!-- ═══ 排版组 ═══ -->
            <h4 class: group-title>排版组（fontSize · letterSpacing）</h4>
            <div class: grid>
                <div class: card @enter={fontSizeDemo}>
                    <strong>fontSize</strong>
                    <p>字号 14→28px</p>
                </div>
                <div class: card @enter={letterSpacingDemo}>
                    <strong>letterSpacing</strong>
                    <p>字间距 0→8px</p>
                </div>
            </div>

            <!-- ═══ 盒模型 + 定位组 ═══ -->
            <h4 class: group-title>盒模型 + 定位（borderWidth · top · left）</h4>
            <div class: grid>
                <div class: card-border-demo @enter={borderWidthDemo}>
                    <strong>borderWidth</strong>
                    <p>边框宽度 1→6px</p>
                </div>
                <div class: card-pos @enter={topLeftDemo}>
                    <strong>top + left</strong>
                    <p>相对位移 top -20px, left 30px</p>
                </div>
            </div>
        </div>
    }

    style {
        .container { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 4px 0; }
        .subtitle { font-size: 12px; color: #9ca3af; margin: 0 0 8px 0; line-height: 1.5; }
        .trigger-btn { padding: 8px 16px; background: #6366f1; color: #fff; border: none; border-radius: 6px; font-size: 13px; cursor: pointer; margin-bottom: 8px; }
        .group-title { font-size: 14px; font-weight: 600; color: #374151; margin: 20px 0 10px 0; padding-bottom: 4px; border-bottom: 1px solid #e5e7eb; }
        .grid { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 4px; }
        .card { flex: 0 0 auto; padding: 14px 16px; background: #f9fafb; border-radius: 10px; border: 1px solid #e5e7eb; text-align: center; min-width: 120px; }
        .card strong { font-size: 13px; color: #374151; display: block; margin-bottom: 4px; }
        .card p { font-size: 11px; color: #6b7280; margin: 0; }
        .card-border { flex: 0 0 auto; padding: 14px 16px; background: #f9fafb; border-radius: 10px; border: 2px solid #d4d4d8; text-align: center; min-width: 140px; }
        .card-border strong { font-size: 13px; color: #374151; display: block; margin-bottom: 4px; }
        .card-border p { font-size: 11px; color: #6b7280; margin: 0; }
        .box { flex: 0 0 auto; padding: 12px; background: #eef2ff; border-radius: 8px; border: 1px solid #6366f1; text-align: center; overflow: hidden; }
        .box strong { font-size: 12px; color: #4338ca; display: block; margin-bottom: 4px; }
        .box p { font-size: 11px; color: #6366f1; margin: 0; white-space: nowrap; }
        .card-border-demo { flex: 0 0 auto; padding: 14px 16px; background: #f9fafb; border-radius: 10px; border: 2px solid #d4d4d8; text-align: center; min-width: 120px; }
        .card-border-demo strong { font-size: 13px; color: #374151; display: block; margin-bottom: 4px; }
        .card-border-demo p { font-size: 11px; color: #6b7280; margin: 0; }
        .card-pos { flex: 0 0 auto; padding: 14px 16px; background: #fef9c3; border-radius: 10px; border: 1px solid #eab308; text-align: center; min-width: 120px; position: relative; }
        .card-pos strong { font-size: 13px; color: #374151; display: block; margin-bottom: 4px; }
        .card-pos p { font-size: 11px; color: #6b7280; margin: 0; }
    }
}
