// ╔══════════════════════════════════════════════════════════════════════╗
// ║  PlaybackAdvancedDemo — 播放属性进阶覆盖                           ║
// ║                                                                    ║
// ║  Direction:  reverse · alternateReverse                            ║
// ║  Fill:       backwards · both                                      ║
// ║  Interrupt:  stop · complete · replace                             ║
// ╚══════════════════════════════════════════════════════════════════════╝
import omniview;

// ╔══════════════════════════════════════════════════════════════╗
// ║  🧪 Playwright Test                                         ║
// ║                                                            ║
// ║  **Steps:**                                                ║
// ║  1. Navigate to PlaybackAdvancedDemo component page.       ║
// ║  2. Verify all 7 motion cards render in the grid.          ║
// ║  3. Check Direction group: dirReverse (reverse) and        ║
// ║     dirAltReverse (alternateReverse) with @enter.          ║
// ║  4. Check Fill group: fillBackwards (backwards) and        ║
// ║     fillBoth (both) with @enter.                           ║
// ║  5. Check Interrupt group: intStop (stop), intComplete     ║
// ║     (complete), intReplace (replace) with @animate + loop. ║
// ║  6. Click "Play Direction & Fill" button to trigger        ║
// ║     @enter animations.                                     ║
// ║                                                            ║
// ║  **Expected:**                                             ║
// ║  - dirReverse card: @enter={dirReverse} with direction     ║
// ║    reverse attribute.                                      ║
// ║  - dirAltReverse card: @enter={dirAltReverse} with         ║
// ║    direction alternateReverse attribute.                   ║
// ║  - fillBackwards card: @enter={fillBackwards} with         ║
// ║    fill="backwards" and delay attribute.                   ║
// ║  - fillBoth card: @enter={fillBoth} with fill attribute.   ║
// ║  - intStop/Complete/Replace cards: @animate with           ║
// ║    interrupt attribute and loop.                           ║
// ║  - "Play Direction & Fill" button exists and clickable.    ║
// ╚══════════════════════════════════════════════════════════════╝

// ── direction: reverse ─────────────────────────────────────
@motion dirReverse {
    from { x: 0, opacity: 0.3 }
    to   { x: 160, opacity: 1 }
    over 600 ease power2Out
    direction reverse
}

// ── direction: alternateReverse ────────────────────────────
@motion dirAltReverse {
    from { scale: 1 }
    to   { scale: 1.4 }
    over 800 ease power2Out
    direction alternateReverse
}

// ── fill: backwards（动画开始前立即跳到 from 态） ─────────
@motion fillBackwards {
    from { x: -20, opacity: 0 }
    to   { x: 0, opacity: 1 }
    over 1000 ease power2Out
    delay 500
    fill backwards
}

// ── fill: both（前后都填充） ──────────────────────────────
@motion fillBoth {
    from { scale: 0.8, opacity: 0 }
    to   { scale: 1.2, opacity: 1 }
    over 600 ease power2Out
    delay 300
    fill forwards
}

// ── interrupt: stop ────────────────────────────────────────
@motion intStop {
    from { x: 0 }
    to   { x: 180 }
    over 400 ease easeOut
    interrupt stop
    direction alternate
    loop
}

// ── interrupt: complete ────────────────────────────────────
@motion intComplete {
    from { scale: 1 }
    to   { scale: 1.3 }
    over 400 ease easeOut
    interrupt complete
    direction alternate
    loop
}

// ── interrupt: replace ─────────────────────────────────────
@motion intReplace {
    from { x: 0 }
    to   { x: 180 }
    over 400 ease easeOut
    interrupt replace
    direction alternate
    loop
}

// ══════════════════════════════════════════════════════════════════════
//  组件
// ══════════════════════════════════════════════════════════════════════
component PlaybackAdvancedDemo {
    signal playDirFill: bool = false;

    fn toggleDirFill() { playDirFill = !playDirFill; }

    view {
        <div class: container>
            <h3 class: title>播放属性进阶</h3>
            <p class:subtitle>direction reverse/alternateReverse · fill backwards/both · interrupt stop/complete/replace</p>

            <!-- ═══ Direction + Fill 组（点击播放） ═══ -->
            <button @click={toggleDirFill} class: trigger-btn>
                {if playDirFill { "Reset" } else { "Play Direction & Fill" }}
            </button>

            <h4 class: group-title>Direction 方向（reverse · alternateReverse）</h4>
            <div class: grid>
                <div class: card @enter={dirReverse}>
                    <strong>direction reverse</strong>
                    <p>反向播放（终点→起点）</p>
                </div>
                <div class: card @enter={dirAltReverse}>
                    <strong>direction alternateReverse</strong>
                    <p>交替反向</p>
                </div>
            </div>

            <h4 class: group-title>Fill 填充（backwards · both）</h4>
            <div class: grid>
                <div class: card @enter={fillBackwards}>
                    <strong>fill backwards</strong>
                    <p>delay 500ms 前即跳到 from 态</p>
                </div>
                <div class: card @enter={fillBoth}>
                    <strong>fill both</strong>
                    <p>前后都填充·delay 300ms</p>
                </div>
            </div>

            <!-- ═══ Interrupt 组（保持 loop 自动播放以演示中断） ═══ -->
            <h4 class: group-title>Interrupt 中断行为（stop · complete · replace）</h4>
            <div class: grid>
                <div class: card @animate={intStop}>
                    <strong>interrupt stop</strong>
                    <p>中断即停在当前值</p>
                </div>
                <div class: card @animate={intComplete}>
                    <strong>interrupt complete</strong>
                    <p>中断时快速跳到终点</p>
                </div>
                <div class: card @animate={intReplace}>
                    <strong>interrupt replace</strong>
                    <p>中断即替换为新动画</p>
                </div>
            </div>

            <p class: note>interrupt demo 使用 direction alternate + loop 来触发多次中断（保持自动重播以测试中断行为）</p>
            <p class: note>direction 与 fill demo 点击上方按钮播放（不需要自动重播即可测试）</p>
        </div>
    }

    style {
        .container { background: white; border: 1px solid #d4d4d8; border-radius: 12px; padding: 20px 16px; margin: 16px 0; }
        .title { font-size: 18px; color: #1f2937; margin: 0 0 4px 0; }
        .subtitle { font-size: 12px; color: #9ca3af; margin: 0 0 8px 0; }
        .trigger-btn { padding: 8px 16px; background: #6366f1; color: #fff; border: none; border-radius: 6px; font-size: 13px; cursor: pointer; margin-bottom: 8px; }
        .group-title { font-size: 14px; font-weight: 600; color: #374151; margin: 18px 0 10px 0; padding-bottom: 4px; border-bottom: 1px solid #e5e7eb; }
        .grid { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 4px; }
        .card { flex: 0 0 auto; padding: 14px 16px; background: #f9fafb; border-radius: 10px; border: 1px solid #e5e7eb; text-align: center; min-width: 130px; }
        .card strong { font-size: 12px; color: #374151; display: block; margin-bottom: 4px; }
        .card p { font-size: 11px; color: #6b7280; margin: 0; }
        .note { font-size: 11px; color: #9ca3af; margin: 6px 0 0 0; font-style: italic; }
    }
}
