// ╔══════════════════════════════════════════════════════════════╗
// ║  design.omni —— 全局设计系统（Design 为第一公民）               ║
// ║                                                              ║
// ║  本文件定义 LearnDesign 设计系统，包括：                        ║
// ║    1. 设计令牌（颜色、间距、圆角、阴影、排版等）                ║
// ║    2. CSS 类（页面布局、卡片、标签页、输入框、徽章等）          ║
// ║    3. 组件变体（Button 多维度参数化主题化）                    ║
// ║                                                              ║
// ║  各组件通过 import { LearnDesign } 引用设计类/变体：           ║
// ║    class: LearnDesign.Card             设计 CSS 类            ║
// ║    variant: LearnDesign.Button(...)     组件变体              ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { DynamicTokenStore } from "./stores/DynamicTokenStore";

// ── 编译时常量 ──
const TOKEN_RADIUS = "12px";
const TOKEN_SHADOW = "0 4px 12px rgba(0,0,0,0.08)";
const TOKEN_SPACING = "16px";

design LearnDesign {
    // ── 主题声明 ──
    @themes { light, dark, sepia, highContrast }
    @default-theme light;

    // ═══════════════════════════════════════════════════════════
    // 1. 设计令牌（DESIGN TOKENS）
    //    8 种类型：Color, Size, Radius, Shadow, FontFamily, FontSize,
    //    FontWeight, Duration
    //    令牌值编译为 :root { --name: value; } CSS 变量
    //    在类/变体中引用：token(name) → var(--name)
    //    主题覆盖值语法：token name: type = "默认值" themeName "主题值"
    //    生成 [data-theme="themeName"] 作用域
    // ═══════════════════════════════════════════════════════════

    // ── 品牌色 ──
    token primary: color = "#6366f1" dark "#a5b4fc" sepia "#8B4513" highContrast "#ffff00";
    token primaryLight: color = "#a5b4fc" sepia "#D2A679" highContrast "#ffff99";
    token primaryDark: color = "#4338ca" sepia "#5D3A1A" highContrast "#cccc00";

    // ── 语义色 ──
    token success: color = "#10b981" sepia "#6B8E23" highContrast "#00ff00";
    token warning: color = "#f59e0b" sepia "#CC7722" highContrast "#ffaa00";
    token danger: color = "#ef4444" sepia "#A0522D" highContrast "#ff4444";
    token accent: color = "#f97316" sepia "#CD853F" highContrast "#ff8800";

    // ── 中性色（多主题） ──
    token surface: color = "#ffffff" dark "#111827" sepia "#F5E6C8" highContrast "#000000";
    token surfaceMuted: color = "#f9fafb" dark "#1f2937" sepia "#EDE0C8" highContrast "#0a0a0a";
    token surfaceSubtle: color = "#f3f4f6" dark "#374151" sepia "#E0D0B0" highContrast "#1a1a1a";
    token textPrimary: color = "#111827" dark "#f9fafb" sepia "#3E2723" highContrast "#ffffff";
    token textSecondary: color = "#6b7280" dark "#9ca3af" sepia "#5D4037" highContrast "#cccccc";
    token textMuted: color = "#9ca3af" dark "#d1d5db" sepia "#8D6E63" highContrast "#999999";
    token border: color = "#d4d4d8" dark "#4b5563" sepia "#BCAAA4" highContrast "#666666";
    token borderLight: color = "#e5e7eb" dark "#374151" sepia "#D7CCC8" highContrast "#444444";
    token borderLighter: color = "#f3f4f6" dark "#1f2937" sepia "#EFEBE9" highContrast "#333333";

    // ── 间距 ──
    token spaceXs: size = "4px";
    token spaceSm: size = "8px";
    token spaceMd: size = "16px";
    token spaceLg: size = "24px";
    token spaceXl: size = "32px";
    token spaceXxl: size = "48px";

    // ── 圆角 ──
    token radiusSm: radius = "4px";
    token radiusMd: radius = "8px";
    token radiusLg: radius = "12px";
    token radiusFull: radius = "9999px";
    token cardRadius: radius = "12px";

    // ── 阴影 ──
    token shadowSm: shadow = "0 1px 2px rgba(0,0,0,0.05)";
    token shadowMd: shadow = "0 4px 6px rgba(0,0,0,0.07)";
    token shadowLg: shadow = "0 10px 25px rgba(0,0,0,0.1)";

    // ── 排版 ──
    token fontFamily: fontFamily = "system-ui, sans-serif";
    token fontSizeXs: fontSize = "11px";
    token fontSizeSm: fontSize = "13px";
    token fontSizeMd: fontSize = "14px";
    token fontSizeLg: fontSize = "16px";
    token fontSizeXl: fontSize = "18px";
    token fontSize3xl: fontSize = "22px";
    token fontSize4xl: fontSize = "28px";
    token fontWeightMedium: fontWeight = "500";
    token fontWeightSemibold: fontWeight = "600";
    token fontWeightBold: fontWeight = "700";

    // ── 过渡时长 ──
    token durationFast: duration = "150ms";

    // ── 行高 / 字距 / 缓动 / 透明度 / 层级（域 5 类型补齐） ──
    token lineHeightBody: lineHeight = "1.5" dark "1.6" sepia "1.65" highContrast "1.5";
    token letterSpacingWide: letterSpacing = "0.5px" sepia "1px" highContrast "0.75px";
    token easeStandard: easing = "ease-in-out" sepia "ease-out";
    token surfaceOpacity: opacity = "1" dark "0.92" sepia "0.95";
    token zIndexTop: zIndex = "100" highContrast "200";

    // ── 编译时常量引用（const → token 值） ──
    token constRadius: radius = TOKEN_RADIUS;
    token constShadow: shadow = TOKEN_SHADOW;
    token constSpacing: size = TOKEN_SPACING;

    // ── 运行时信号引用（Store.signal → token 值） ──
    // 这些 token 通过 __omni_effect 动态更新 CSS 变量
    // ⚠ 动态 token 不能有 theme 覆盖值
    token dynColor: color = DynamicTokenStore.liveColor;
    token dynBg: color = DynamicTokenStore.liveBg;
    token dynAccent: color = DynamicTokenStore.liveAccent;

    // ═══════════════════════════════════════════════════════════
    // 2. CSS 类（DESIGN CLASSES）
    //    引用令牌用 token(name) 语法 → 编译为 var(--name)
    //    伪类用 &:hover / &:focus / &:active 语法
    // ═══════════════════════════════════════════════════════════

    // ── 页面布局 ──
    class Page {
        max-width: "1200px";
        width: "92vw";
        margin: "0 auto";
        background: token(surfaceMuted);
        min-height: "100vh";
    }

    class Section {
        padding: "0 " token(spaceMd) " " token(spaceMd) " " token(spaceMd);
    }

    class Row {
        display: flex;
        gap: token(spaceSm);
        margin-bottom: token(spaceSm);
    }

    class Col {
        flex: 1;
        min-width: 0;
    }

    class DemoSection {
        margin: "16px 0";
    }

    class DemoFull {
        margin-bottom: token(spaceSm);
    }

    class PageTitle {
        font-size: token(fontSize3xl);
        font-weight: token(fontWeightBold);
        color: token(textPrimary);
        margin: "0 0 4px 0";
    }

    class PageSubtitle {
        font-size: token(fontSizeSm);
        color: token(textSecondary);
        margin: 0;
    }

    class SectionTitle {
        font-size: token(fontSizeMd);
        font-weight: token(fontWeightSemibold);
        color: token(textSecondary);
        margin: "16px 0 8px 0";
        text-transform: uppercase;
        letter-spacing: "0.5px";
    }

    // ── Banner（顶部横幅） ──
    class Banner {
        background: token(primary);
        color: white;
        padding-top: token(spaceLg);
        padding-bottom: token(spaceLg);
        padding-left: token(spaceMd);
        padding-right: token(spaceMd);
        text-align: center;
        border-radius: token(radiusMd);
        margin-bottom: token(spaceMd);
    }

    class BannerTitle {
        font-size: token(fontSize4xl);
        margin: "0 0 8px 0";
    }

    class BannerSubtitle {
        font-size: token(fontSizeSm);
        margin: 0;
    }

    // ── Card（通用卡片） ──
    class Card {
        background: token(surface);
        border: "1px solid " token(border);
        border-radius: token(radiusLg);
        padding-top: token(spaceLg);
        padding-bottom: token(spaceLg);
        padding-left: token(spaceMd);
        padding-right: token(spaceMd);
        margin: "16px 0";
        &:hover {
            box-shadow: token(shadowSm);
        }
    }

    class CardTitle {
        font-size: token(fontSizeXl);
        margin-bottom: token(spaceSm);
        color: token(textPrimary);
    }

    // ── Demo 通用容器（替代各处硬编码 .container / .box）──
    class Container {
        background: token(surface);
        border: "1px solid " token(border);
        border-radius: token(radiusLg);
        padding-top: token(spaceLg);
        padding-bottom: token(spaceLg);
        padding-left: token(spaceMd);
        padding-right: token(spaceMd);
        margin: "16px 0";
        // C2a review HIGH-1: CssUnitsDemo's cq units (BoxCq…) resolve against
        // this query container — restored from the legacy style block
        container-type: inline-size;
    }

    class Subtitle {
        font-size: token(fontSizeSm);
        color: token(textMuted);
        margin: "0 0 16px 0";
    }

    class Label {
        font-size: token(fontSizeMd);
        font-weight: token(fontWeightSemibold);
        color: token(textPrimary);
        margin: "0 0 8px 0";
    }

    // ── Footer ──
    class Footer {
        text-align: center;
        padding: token(spaceLg);
        border-top: "1px solid " token(borderLight);
    }

    class FooterText {
        font-size: token(fontSizeSm);
        color: token(textSecondary);
    }

    // ── 标签页导航 ──
    class TabContent {
        background: token(surface);
        border: "1px solid " token(border);
        border-top: none;
        border-radius: "0 0 " token(radiusMd) " " token(radiusMd);
        padding: token(spaceMd);
    }

    // ── 输入框 ──
    class Input {
        padding: "12px";
        border: "2px solid " token(borderLight);
        border-radius: token(radiusMd);
        font-size: token(fontSizeLg);
        font-family: token(fontFamily);
        outline: none;
        width: 100%;
        box-sizing: border-box;
        &:focus {
            border-color: token(primary);
            box-shadow: "0 0 0 3px " token(primaryLight);
        }
    }

    // ── 徽章 ──
    class Badge {
        display: inline-flex;
        align-items: center;
        font-size: token(fontSizeXs);
        padding: "2px 10px";
        border-radius: token(radiusFull);
    }

    // ── 小标签 ──
    class Tag {
        font-size: token(fontSizeSm);
        padding-top: token(spaceXs);
        padding-bottom: token(spaceXs);
        padding-left: token(spaceSm);
        padding-right: token(spaceSm);
        border-radius: token(radiusSm);
        background: token(surfaceSubtle);
        color: token(textSecondary);
    }

    // ── 页脚提示 ──
    class Hint {
        font-size: token(fontSizeXs);
        color: token(textMuted);
    }

    // ═══════════════════════════════════════════════════════════
    // 3. 组件变体（VARIANTS）
    //    多维度参数化主题化
    //    在 view 中引用：variant: LearnDesign.Button(color=primary, size=md)
    // ═══════════════════════════════════════════════════════════

    variant Button {
        @dim color: primary | danger | ghost | accent;
        @dim size: sm | md | lg;

        @default { color: primary; size: md; }

        base {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: none;
            border-radius: token(radiusMd);
            font-family: token(fontFamily);
            cursor: pointer;
            font-weight: token(fontWeightSemibold);
            transition: "all " token(durationFast);
        }

        color.primary { background: token(primary); color: white; }
        color.danger  { background: token(danger); color: white; }
        color.ghost   { background: transparent; color: token(textPrimary); border: "1px solid " token(border); }
        color.accent  { background: token(accent); color: white; }

        size.sm {
            padding-top: token(spaceXs);
            padding-bottom: token(spaceXs);
            padding-left: token(spaceSm);
            padding-right: token(spaceSm);
            font-size: token(fontSizeSm);
        }
        size.md {
            padding-top: token(spaceSm);
            padding-bottom: token(spaceSm);
            padding-left: token(spaceMd);
            padding-right: token(spaceMd);
            font-size: token(fontSizeMd);
        }
        size.lg {
            padding-top: token(spaceSm);
            padding-bottom: token(spaceSm);
            padding-left: token(spaceLg);
            padding-right: token(spaceLg);
            font-size: token(fontSizeLg);
        }
    }

    // ═══════════════════════════════════════════════════════════
    // 4. 演示类（C2a 迁移）——由各 demo 的 legacy style block 迁移而来
    //    属性值原样保留（var(--x) 归一为 token(x)）；Flutter 端仅
    //    BoxDecoration 可映射属性生效，其余属性诚实降级
    // ═══════════════════════════════════════════════════════════

    // (C2a migration) 4 properties
    class ActionRow {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 14px;
    }
    // (C2a migration) 2 properties
    class Actions {
        display: flex;
        gap: 8px;
    }
    // (C2a migration) 1 properties
    class AddTodoContainer {
        padding: 0 16px 16px 16px;
    }
    // (C2a migration) 5 properties
    class AnimBox {
        background: #f3e8ff;
        border: 1px solid #e9d5ff;
        border-radius: 8px;
        padding: 12px;
        text-align: center;
    }
    // (C2a migration) 1 properties
    class ArrayArea {
        margin-bottom: 12px;
    }
    // (C2a migration) 2 properties
    class Arrow {
        color: #a16207;
        font-size: 14px;
    }
    // (C2a migration) 5 properties
    class BadgeBlurred {
        background: #f3f4f6;
        border-radius: 12px;
        color: #6b7280;
        font-size: 14px;
        padding: 4px 12px;
    }
    // (C2a migration) 5 properties
    class BadgeFocused {
        background: #dbf0ff;
        border-radius: 12px;
        color: #1d40d0;
        font-size: 14px;
        padding: 4px 12px;
    }
    // (C2a migration) 5 properties
    class BadgeIdle {
        background: #fdf0c0;
        border-radius: 12px;
        color: #924000;
        font-size: 14px;
        padding: 4px 12px;
    }
    // (C2a migration) 5 properties
    class BadgeNew {
        background: #f97316;
        border-radius: 10px;
        color: white;
        font-size: 11px;
        padding: 2px 8px;
    }
    // (C2a migration) 5 properties
    class BadgeUnknown {
        background: #fddddd;
        border-radius: 12px;
        color: #dc2626;
        font-size: 14px;
        padding: 4px 12px;
    }
    // (C2a migration) 4 properties
    class BigNumber {
        color: token(primary);
        font-size: 36px;
        font-weight: bold;
        margin: 4px 0;
    }
    // (C2a migration) 5 properties
    class Blockquote {
        border-left: 3px solid #d4d4d8;
        color: #6b7280;
        font-size: 13px;
        margin: 6px 0;
        padding-left: 12px;
    }
    // (C2a migration) 7 properties
    class Box {
        background: #eef2ff;
        border: 1px solid #6366f1;
        border-radius: 8px;
        flex: 0 0 auto;
        overflow: hidden;
        padding: 12px;
        text-align: center;
    }
    // (C2a migration) 6 properties
    class BoxCh {
        background: #e0e7ff;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        width: 20ch;
    }
    // (C2a migration) 6 properties
    class BoxCm {
        background: #fef08a;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        width: 1cm;
    }
    // (C2a migration) 6 properties
    class BoxCq {
        background: #ede9fe;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        width: 10cqw;
    }
    // (C2a migration) 6 properties
    class BoxCqb {
        background: #a5f3fc;
        border-radius: 6px;
        font-size: 12px;
        height: 5cqb;
        padding: 8px;
        text-align: center;
    }
    // (C2a migration) 6 properties
    class BoxCqh {
        background: #fbcfe8;
        border-radius: 6px;
        font-size: 12px;
        height: 5cqh;
        padding: 8px;
        text-align: center;
    }
    // (C2a migration) 7 properties
    class BoxCqi {
        background: #ffedd5;
        border-radius: 6px;
        font-size: 10px;
        height: 5cqb;
        padding: 4px;
        text-align: center;
        width: 5cqi;
    }
    // (C2a migration) 7 properties
    class BoxCqmax {
        background: #d9f99d;
        border-radius: 6px;
        font-size: 10px;
        height: 5cqmax;
        padding: 4px;
        text-align: center;
        width: 5cqmax;
    }
    // (C2a migration) 7 properties
    class BoxCqmin {
        background: #fed7aa;
        border-radius: 6px;
        font-size: 10px;
        height: 5cqmin;
        padding: 4px;
        text-align: center;
        width: 5cqmin;
    }
    // (C2a migration) 6 properties
    class BoxDeg {
        background: #fbcfe8;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        transform: rotate(15deg);
    }
    // (C2a migration) 6 properties
    class BoxDvh {
        background: #d1fae5;
        border-radius: 6px;
        font-size: 12px;
        height: 5dvh;
        padding: 8px;
        text-align: center;
    }
    // (C2a migration) 6 properties
    class BoxDvw {
        background: #ddd6fe;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        width: 5dvw;
    }
    // (C2a migration) 6 properties
    class BoxEx {
        background: #fee2e2;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        width: 10ex;
    }
    // (C2a migration) 5 properties
    class BoxFr {
        background: #bbf7d0;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
    }
    // (C2a migration) 6 properties
    class BoxGrad {
        background: #d9f99d;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        transform: rotate(50grad);
    }
    // (C2a migration) 6 properties
    class BoxIc {
        background: #dbeafe;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        width: 15ic;
    }
    // (C2a migration) 6 properties
    class BoxLh {
        background: #f3e8ff;
        border-radius: 6px;
        font-size: 12px;
        line-height: 2lh;
        padding: 8px;
        text-align: center;
    }
    // (C2a migration) 6 properties
    class BoxLvh {
        background: #fce7f3;
        border-radius: 6px;
        font-size: 12px;
        height: 5lvh;
        padding: 8px;
        text-align: center;
    }
    // (C2a migration) 6 properties
    class BoxLvw {
        background: #fde68a;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        width: 5lvw;
    }
    // (C2a migration) 6 properties
    class BoxMm {
        background: #ddd6fe;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        width: 10mm;
    }
    // (C2a migration) 6 properties
    class BoxMs {
        background: #fed7aa;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        transition-duration: 150ms;
    }
    // (C2a migration) 5 properties
    class BoxPt {
        background: #bfdbfe;
        border-radius: 6px;
        font-size: 12pt;
        padding: 8px;
        text-align: center;
    }
    // (C2a migration) 6 properties
    class BoxRad {
        background: #a5f3fc;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        transform: rotate(0.5rad);
    }
    // (C2a migration) 6 properties
    class BoxRlh {
        background: #f3e8ff;
        border-radius: 6px;
        font-size: 12px;
        line-height: 2rlh;
        padding: 8px;
        text-align: center;
    }
    // (C2a migration) 6 properties
    class BoxS {
        animation-duration: 1s;
        background: #fecdd3;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
    }
    // (C2a migration) 6 properties
    class BoxSvh {
        background: #cffafe;
        border-radius: 6px;
        font-size: 12px;
        height: 5svh;
        padding: 8px;
        text-align: center;
    }
    // (C2a migration) 6 properties
    class BoxSvw {
        background: #c7d2fe;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        width: 5svw;
    }
    // (C2a migration) 6 properties
    class BoxTurn {
        background: #e9d5ff;
        border-radius: 6px;
        font-size: 12px;
        padding: 8px;
        text-align: center;
        transform: rotate(0.25turn);
    }
    // (C2a migration) 6 properties
    class BoxVh {
        background: #fecaca;
        border-radius: 6px;
        font-size: 12px;
        height: 10vh;
        padding: 8px;
        text-align: center;
    }
    // (C2a migration) 7 properties
    class BoxVmax {
        background: #a7f3d0;
        border-radius: 6px;
        font-size: 10px;
        height: 5vmax;
        padding: 4px;
        text-align: center;
        width: 5vmax;
    }
    // (C2a migration) 7 properties
    class BoxVmin {
        background: #fde68a;
        border-radius: 6px;
        font-size: 10px;
        height: 5vmin;
        padding: 4px;
        text-align: center;
        width: 5vmin;
    }
    // (C2a migration) 7 properties
