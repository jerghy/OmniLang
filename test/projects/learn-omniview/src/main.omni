// ╔══════════════════════════════════════════════════════════════╗
// ║    OmniView 教学项目 —— 多文件项目结构（56 源文件全覆盖）       ║
// ║                                                              ║
// ║  运行：omnic run                                               ║
// ║  编译：omnic build --target omniview                           ║
// ║                                                              ║
// ║  项目结构：                                                   ║
// ║    src/main.omni              ← 入口 + App 根组件             ║
// ║    src/lib.omni               ← 工具函数                      ║
// ║    src/lib/types.omni         ← pub struct + pub type         ║
// ║    src/lib/reexports.omni     ← export { X } from "./..."     ║
// ║    src/lib/stats.omni         ← 统计引擎（pub fn）            ║
// ║    src/lib/validation.omni    ← 输入验证（tagged union）       ║
// ║    src/lib/transform.omni     ← 数据转换（break/continue）    ║
// ║    src/lib/api.omni           ← API 类型 + HTTP 工具          ║
// ║    src/stores/TodoStore.omni  ← Store (multi-param + async)  ║
// ║    src/stores/ThemeStore.omni ← 主题状态管理                   ║
// ║    src/stores/NotificationStore.omni ← 通知队列               ║
// ║    src/shared/theme.omni      ← theme 设计令牌                ║
// ║    src/shared/constants.omni  ← 全局常量                       ║
// ║    src/components/* (38 个组件 + 辅助文件)                    ║
// ║    src/pages/* (6 个页面)                                    ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;

// ── 页面级组件（每个页面聚合多个子组件） ──────────────────────────
import { Header } from "./components/Header";
import { FeatureList } from "./components/FeatureList";
import { Dashboard } from "./pages/Dashboard";
import { TodoPage } from "./pages/TodoPage";
import { SettingsPage } from "./pages/SettingsPage";

// ── 独立演示组件 ─────────────────────────────────────────────────
import { ValidationInput } from "./components/ValidationInput";
import { Timer } from "./components/Timer";
import { Modal } from "./components/Modal";
import { TabPanel } from "./components/TabPanel";
import { DataTable } from "./components/DataTable";
import { NotificationsPanel } from "./components/NotificationsPanel";
import { FormPage } from "./components/FormPage";

// Phase 8: 编译器新特性演示（match / await / variant / http / json / storage）
import { DataFetching } from "./pages/DataFetching";
import { DataSubmit } from "./pages/DataSubmit";
import { UserSettings } from "./pages/UserSettings";

// Task 11: 运动动画 E2E 测试
import { MotionDemo } from "./pages/MotionDemo";

// ── 全局 Store ─────────────────────────────────────────────────
import { TodoStore } from "./stores/TodoStore";
import { ThemeStore } from "./stores/ThemeStore";
import { NotificationStore } from "./stores/NotificationStore";

// Phase 7: 仅类型导入（type-only import）
import type { StatisticsData } from "./lib/types";

// Phase 7: 通过 reexports 导入（重新导出链：types → reexports → main）
import { Percentage } from "./lib/reexports";

// Phase 7: 命名空间导入
import "./lib/types" as Types;

// ═══════════════════════════════════════════════════════════════
// Phase 9: 新增演示组件 — 全覆盖 56 源文件
// ═══════════════════════════════════════════════════════════════

// ── 视图组件 ────────────────────────────────────────────────────
import { CssUnitsDemo } from "./components/CssUnitsDemo";
import { EventShorthand } from "./components/EventShorthand";
import { EventsDemo } from "./components/EventsDemo";
import { FormControlsDemo } from "./components/FormControlsDemo";
import { InlineStoreDemo } from "./components/InlineStoreDemo";
import { NullishDemo } from "./components/NullishDemo";
import { StringLiteralsDemo } from "./components/StringLiteralsDemo";
import { TypeSystemDemo } from "./components/TypeSystemDemo";
import { ViewAttributesDemo } from "./components/ViewAttributesDemo";

// ── 纯逻辑 lib ─────────────────────────────────────────────────
import "./lib/stats" as StatsLib;
import "./lib/transform" as TransformLib;
import "./lib/validation" as ValidationLib;
import "./components/array_ext" as ArrayExtLib;
import "./components/async_demo" as AsyncDemoLib;
import "./components/datetime_demo" as DateTimeDemoLib;
import "./components/encode_demo" as EncodeDemoLib;
import "./components/error_handling" as ErrorHandlingLib;
import "./components/math_ext" as MathExtLib;
import "./components/numerics" as NumericsLib;
import "./components/regex_demo" as RegexDemoLib;
import "./components/string_ext" as StringExtLib;
import "./components/strings" as StringsLib;
import "./components/type_system" as TypeSystemLib;

// ── 共享模块 ────────────────────────────────────────────────────
import "./shared/theme" as ThemeTokens;
import { Constants } from "./shared/constants";

// ═══════════════════════════════════════════════════════════════
// App —— 根组件，页面级路由入口
// ═══════════════════════════════════════════════════════════════

component App {
    @store TodoStore;
    @store ThemeStore;
    @store NotificationStore;

    // Phase 7: 使用 import type { Percentage } 的类型标注
    signal completionRate: Percentage = 42.0;

    view {
        <div class: app>
            <Header />
            <Dashboard />
            <TodoPage />
            <FeatureList />
            <SettingsPage />

            <!-- ═══ 独立演示组件 ═══ -->
            <section class: demo-section>
                <h2 class: demo-section-title>独立演示组件</h2>

                <div class: demo-row>
                    <div class: demo-col>
                        <ValidationInput />
                    </div>
                    <div class: demo-col>
                        <Timer />
                    </div>
                </div>

                <div class: demo-row>
                    <div class: demo-col>
                        <Modal />
                    </div>
                    <div class: demo-col>
                        <TabPanel />
                    </div>
                </div>

                <div class: demo-full>
                    <DataTable />
                </div>

                <div class: demo-full>
                    <FormPage />
                </div>

                <div class: demo-full>
                    <NotificationsPanel />
                </div>
            </section>

            <!-- ═══ 编译器新特性（Phase 8） ═══ -->
            <section class: demo-section>
                <h2 class: demo-section-title>Phase 8: 编译器新特性</h2>

                <div class: demo-full>
                    <DataFetching />
                </div>

                <div class: demo-full>
                    <DataSubmit />
                </div>

                <div class: demo-full>
                    <UserSettings />
                </div>
            </section>

            <!-- ═══ Task 11: 运动动画 E2E 测试 ═══ -->
            <section class: demo-section>
                <h2 class: demo-section-title>Motion Animation</h2>

                <div class: demo-full>
                    <MotionDemo />
                </div>
            </section>

            <!-- ═══ Phase 9: 新增演示组件（事件 / CSS / 表单 / 类型系统） ═══ -->
            <section class: demo-section>
                <h2 class: demo-section-title>Phase 9: 新增演示组件</h2>

                <div class: demo-row>
                    <div class: demo-col>
                        <EventShorthand />
                    </div>
                    <div class: demo-col>
                        <FormControlsDemo />
                    </div>
                </div>

                <div class: demo-full>
                    <EventsDemo />
                </div>

                <div class: demo-row>
                    <div class: demo-col>
                        <InlineStoreDemo />
                    </div>
                    <div class: demo-col>
                        <NullishDemo />
                    </div>
                </div>

                <div class: demo-full>
                    <CssUnitsDemo />
                </div>

                <div class: demo-full>
                    <StringLiteralsDemo />
                </div>

                <div class: demo-row>
                    <div class: demo-col>
                        <TypeSystemDemo />
                    </div>
                    <div class: demo-col>
                        <ViewAttributesDemo />
                    </div>
                </div>
            </section>

            <footer class: footer>
                <p class: footer-text>OmniView 教学项目 · 56 源文件 · omnic run</p>
            </footer>
        </div>
    }
    style {
        .app { max-width: 700px; width: 92vw; margin: 0 auto; background: #f9fafb; min-height: 100vh; }
        .footer { text-align: center; padding: 24px; border-top: 1px solid #ddd; }
        .footer-text { font-size: 13px; color: #888; }

        .demo-section { margin: 24px 0; }
        .demo-section-title { font-size: 20px; color: #1f2937; margin: 0 0 16px 0; padding: 0 4px; }
        .demo-row { display: flex; gap: 12px; margin-bottom: 12px; }
        .demo-col { flex: 1; min-width: 0; }
        .demo-full { margin-bottom: 12px; }
    }
}
