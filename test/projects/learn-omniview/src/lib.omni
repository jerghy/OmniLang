// ║  注意：纯逻辑文件不写 import omniview;                          ║
// ║  使用 pub 标记才能在跨文件导入时被访问                           ║
// ╚══════════════════════════════════════════════════════════════╝

pub fn format_count(n: i32) -> String {
    if n == 0 { return "零"; }
    return n.to_string();
}
