// ╔══════════════════════════════════════════════════════════════╗
// ║  TodoStore.omni —— 全局状态管理（Phase 5 升级）                 ║
// ║  Store 语法：store Name { signal → getter → action }          ║
// ║                                                              ║
// ║  Phase 5 新增：                                               ║
// ║  · 多参数 action addTask(title, priority, due) 带返回类型        ║
// ║  · 异步 async action fetchReminders() 带返回类型                ║
// ║  · filter 信号驱动过滤 UI                                       ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;

store TodoStore {
    // ── 响应式状态 ─────────────────────────────────────────────
    signal items: Array<String> = [];
    signal filter: String = "all";     // 驱动 FilterBar 过滤 UI
    signal lastAction: String = "";    // 追踪最后一次操作

    // ── 派生值（getter）────────────────────────────────────────
    getter totalCount: i32 = items.len();
    getter filterStatus: String = filter;

    // ── 基础 action（向后兼容 Phase 1）───────────────────────────
    action add(text: String) {
        if text != "" {
            items.push(text);
            lastAction = "added: " + text;
        }
    }

    // ── 多参数 action 带返回类型 ─────────────────────────────────
    // 演示：多个参数、返回 String、访问内部信号
    action addTask(title: String, priority: i32, due: String): String {
        if title == "" {
            return "error: title required";
        }
        if priority < 1 {
            return "error: priority too low";
        }
        let mut entry = title;
        if priority > 5 {
            entry = "[URGENT] " + title + " (P" + priority.to_string() + " due " + due + ")";
            items.push(entry);
            lastAction = "urgent task added";
            return "ok: urgent " + title;
        }
        entry = title + " [P" + priority.to_string() + " due " + due + "]";
        items.push(entry);
        lastAction = "task added";
        return "ok: " + title;
    }

    // ── 异步 action 带返回类型 ──────────────────────────────────
    // 演示：async 关键字在返回类型之后
    action fetchReminders(): String async {
        if items.len() == 0 {
            return "no items to sync";
        }
        // 模拟异步操作：统计并返回摘要
        let mut count = 0;
        let mut i = 0;
        while i < items.len() {
            count = count + 1;
            i = i + 1;
        }
        lastAction = "synced " + count.to_string() + " items";
        return "synced " + count.to_string() + " reminders";
    }

    // ── filter 切换 action ─────────────────────────────────────
    action setFilter(mode: String) {
        if mode == "all" { filter = "all"; }
        if mode == "urgent" { filter = "urgent"; }
        if mode == "recent" { filter = "recent"; }
    }

    action remove() {
        items.pop();
        lastAction = "removed last item";
    }

    action clear() {
        items = [];
        lastAction = "all cleared";
    }
}
