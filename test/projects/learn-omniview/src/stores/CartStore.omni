// ╔══════════════════════════════════════════════════════════════╗
// ║  CartStore.omni —— 顶层 Store（购物车）                        ║
// ║  迁移自 InlineStoreDemo 组件的内联 store 定义（Task 2.2）：    ║
// ║  React 目标对 inline store 硬诊断 E_CODEGEN（BUG-C，           ║
// ║  deferral #37）——组件内联 store 无 React 发射路径。           ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;
import { array_get } from "std/array";

store CartStore {
    signal items: Array<String> = [];
    // 与 items 平行记录单价，removeLast 才能扣减正确金额
    signal prices: Array<f64> = [];
    signal totalPrice: f64 = 0.0;

    getter itemCount: i32 = items.len();
    getter summary: String = if items.len() == 0 {
        "cart empty"
    } else {
        "total: " + items.len().to_string() + " items"
    };

    action addItem(name: String, price: f64) {
        items.push(name);
        prices.push(price);
        totalPrice = totalPrice + price;
    }

    action removeLast() {
        if items.len() > 0 {
            let lastPrice = array_get(prices, items.len() - 1);
            items.pop();
            prices.pop();
            totalPrice = totalPrice - lastPrice;
        }
    }

    action clear() {
        items = [];
        prices = [];
        totalPrice = 0.0;
    }
}
