// ╔══════════════════════════════════════════════════════════════╗
// ║  ThemeStore.omni —— 主题状态管理                              ║
// ║                                                              ║
// ║  颜色值来自 design.omni 的 @themes 声明的主题令牌，            ║
// ║  通过 CSS 变量自动切换，不需要在此维护颜色 getter。             ║
// ║  本 store 仅管理 mode 标签和 toggleCount 用于 UI 显示。       ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;

store ThemeStore {
    // 当前主题模式："light" 或 "dark"
    signal mode: String = "light";

    // 切换次数追踪
    signal toggleCount: i32 = 0;

    // getter: 模式标签
    getter modeLabel: String = if mode == "dark" { "Dark" } else { "Light" };

    // getter: 下一个模式标签
    getter nextLabel: String = if mode == "dark" { "Light" } else { "Dark" };

    // action: 切换深浅色模式
    action toggle() {
        if mode == "dark" {
            mode = "light";
        } else {
            mode = "dark";
        }
        toggleCount = toggleCount + 1;
    }

    // action: 设置指定模式
    action setMode(newMode: String) {
        if newMode == "dark" {
            mode = "dark";
        } else {
            mode = "light";
        }
    }

    // action: 初始化（主题由 CSS 的 [data-theme] 属性驱动）
    action load() {
        // Nothing needed here — design block's @default-theme sets initial CSS
    }
}
