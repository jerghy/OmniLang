// ╔══════════════════════════════════════════════════════════════╗
// ║  lib/stats.omni —— 统计计算引擎                                ║
// ║  演示：let 声明、while 循环、return、&&/||、!=、< > <= >=      ║
// ║  纯逻辑文件，不写 import omniview;                              ║
// ╚══════════════════════════════════════════════════════════════╝

// ── 1. calculate_average —— 演示 let、while、return ──────────────

pub fn calculate_average(values: Array<f64>) -> f64 {
    // let 声明（不带类型标注，自动推断）
    let sum = 0.0;
    // let 声明（带类型标注）
    let count: i32 = 0;
    // let 带 mut（可变变量）
    let mut i = 0;

    // while 循环
    while i < values.len() {
        sum = sum + values.get(i);
        count = count + 1;
        i = i + 1;
    }

    // return 提前返回（演示 != 比较）
    if count != 0 {
        return sum / count;
    }

    // 默认返回值
    return 0.0;
}

// ── 2. is_in_range —— 演示 < > <= >= && || ────────────────────

pub fn is_in_range(value: f64, min: f64, max: f64) -> bool {
    // 逻辑与 && 和比较运算符组合
    return value >= min && value <= max;
}

// ── 3. needs_attention —— 演示 || != ──────────────────────────

pub fn needs_attention(percentage: f64, count: i32) -> bool {
    // 逻辑或 || 和 != 组合
    if percentage > 90.0 || count <= 0 {
        return true;
    }
    if percentage < 10.0 && count != 0 {
        return true;
    }
    return false;
}

// ── 4. classify_range —— 演示 < > <= >= 完整覆盖 ──────────────

pub fn classify_range(value: f64) -> String {
    // 低区间
    if value < 25.0 {
        return "低";
    }
    // 中低区间（组合使用 <= 和 <）
    if value >= 25.0 && value < 50.0 {
        return "中低";
    }
    // 中高区间
    if value >= 50.0 && value < 75.0 {
        return "中高";
    }
    // 高区间（>= 75 但排除异常值）
    if value <= 100.0 {
        return "高";
    }
    // 超范围
    return "异常";
}

// ── 5. find_max_index —— 演示 while + if + < ──────────────────

pub fn find_max_index(values: Array<f64>) -> i32 {
    let mut max_idx: i32 = 0;
    let mut i = 1;

    // while 循环 + 比较运算符 + let mut
    while i < values.len() {
        if values.get(i) > values.get(max_idx) {
            max_idx = i;
        }
        i = i + 1;
    }

    // 空数组返回 -1（与 find_index 未命中约定一致，避免越界索引 0）
    if values.len() == 0 {
        return -1;
    }
    return max_idx;
}
