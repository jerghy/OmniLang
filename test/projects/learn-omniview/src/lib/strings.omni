// ╔══════════════════════════════════════════════════════════════╗
// ║  lib/strings.omni —— 字符串转义序列                                      ║
// ║  演示：\n 换行、\t 制表、\" 引号、\\ 反斜杠、\u{XXXX} Unicode       ║
// ║  纯逻辑文件，不写 import omniview;                                ║
// ╚══════════════════════════════════════════════════════════════╝

// ── 1. 换行符 \n ──────────────────────────────────────────────

pub fn multiline_greeting() -> String {
    return "Hello\nWorld\n!";            // 三段文本用换行分隔
}

pub fn numbered_list() -> String {
    return "1.\n2.\n3.\n4.";             // 多行编号列表
}

// ── 2. 制表符 \t ──────────────────────────────────────────────

pub fn tabular_data() -> String {
    return "Name\tAge\tCity";            // TSV 格式行
}

pub fn indented_block() -> String {
    return "\tLine 1\n\tLine 2";         // 缩进 + 换行组合
}

// ── 3. 双引号 \" ──────────────────────────────────────────────

pub fn quoted_value() -> String {
    return "He said \"Hello\" to me";    // 字符串内嵌双引号
}

pub fn json_fragment() -> String {
    return "{\"key\": \"value\"}";       // 模拟 JSON 片段
}

// ── 4. 反斜杠 \\ ──────────────────────────────────────────────

pub fn windows_path() -> String {
    return "C:\\Users\\Admin\\Docs";     // Windows 路径
}

// ── 5. Unicode 转义 \u{XXXX} ─────────────────────────────────

pub fn emoji_smile() -> String {
    return "Smile: \u{1F600}";           // 😀
}

pub fn emoji_fire() -> String {
    return "Fire: \u{1F525}";            // 🔥
}

pub fn emoji_rocket() -> String {
    return "Rocket: \u{1F680}";          // 🚀
}

pub fn japanese_hello() -> String {
    return "\u{3053}\u{3093}\u{306B}\u{3061}\u{306F}";  // こんにちは
}

// ── 6. 组合演示 ───────────────────────────────────────────────

pub fn format_card(name: String, title: String) -> String {
    return "┌──────────────────────┐\n\tName:\t" + name + "\n\tTitle:\t" + title + "\n└──────────────────────┘";
}

pub fn status_message(ok: bool) -> String {
    if ok {
        return "\u{2705} Success";        // ✅
    }
    return "\u{274C} Failed";             // ❌
}
