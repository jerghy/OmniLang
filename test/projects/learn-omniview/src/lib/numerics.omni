// ╔══════════════════════════════════════════════════════════════╗
// ║  components/numerics.omni —— 进制字面量 + 一元取反 + 科学计数法            ║
// ║  演示：0xFF/0o77/0b1010、-x、2.5e10                             ║
// ║  纯逻辑文件，不写 import omniview;                                ║
// ╚══════════════════════════════════════════════════════════════╝

// ── 1. 十六进制字面量 ──────────────────────────────────────────

pub fn hex_max() -> i32 {
    return 0xFF;                         // 255
}

pub fn hex_color_code() -> i32 {
    return 0x1A2B;                       // 6699
}

// ── 2. 八进制字面量 ────────────────────────────────────────────

pub fn octal_perms() -> i32 {
    return 0o755;                        // 493
}

pub fn octal_small() -> i32 {
    return 0o10;                         // 8
}

// ── 3. 二进制字面量 ────────────────────────────────────────────

pub fn binary_mask() -> i32 {
    return 0b11110000;                   // 240
}

pub fn binary_flags() -> i32 {
    return 0b10101010;                   // 170
}

// ── 4. 科学计数法浮点字面量 ────────────────────────────────────

pub fn avogadro_approx() -> f64 {
    return 6.022e23;                     // 科学计数法大数
}

pub fn electron_charge() -> f64 {
    return 1.6e-19;                      // 科学计数法小数
}

pub fn million() -> f64 {
    return 1E+6;                         // 大写 E 同样有效
}

// ── 5. 一元取反（负号）── ──────────────────────────────────────

pub fn negate(x: i32) -> i32 {
    return -x;
}

pub fn abs_diff(a: i32, b: i32) -> i32 {
    let diff = a - b;
    if diff < 0 {
        return -diff;                    // 一元取反用于绝对值
    }
    return diff;
}

// ── 6. 组合使用 ───────────────────────────────────────────────

pub fn color_from_hex() -> String {
    let r = 0xFF;
    let g = 0x80;
    let b = 0x40;
    return "rgb(" + r.to_string() + "," + g.to_string() + "," + b.to_string() + ")";
}

pub fn physics_summary() -> String {
    let charge = -electron_charge();     // 一元取反 + 科学计数法
    let molecules = avogadro_approx();
    return "e⁻ = " + charge.to_string() + " | NA = " + molecules.to_string();
}
