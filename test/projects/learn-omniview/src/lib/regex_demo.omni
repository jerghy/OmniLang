// ║  components/regex_demo.omni —— std/regex 模块演示                   ║
// ║  演示：regex_match, regex_search, regex_replace              ║
// ║  纯逻辑文件，不写 import omniview;                              ║
// ╚══════════════════════════════════════════════════════════════╝

import { regex_match, regex_search, regex_replace } from "std/regex";

pub fn test_regex_match() -> bool {
    return regex_match("hello@example.com", "^[\\w.]+@[\\w]+\\.[a-z]+$");
}

pub fn test_regex_search() -> Array<String> {
    return regex_search("apple banana cherry apple", "apple");
}

pub fn test_regex_replace() -> String {
    return regex_replace("Hello 2024 World 2024", "\\d{4}", "2025");
}

pub fn validate_email(email: String) -> bool {
    return regex_match(email, "^[\\w.]+@[\\w]+\\.[a-z]+$");
}

pub fn extract_numbers(text: String) -> Array<String> {
    return regex_search(text, "\\d+");
}

pub fn sanitize_input(text: String) -> String {
    let cleaned = regex_replace(text, "<[^>]+>", "");
    return regex_replace(cleaned, "\\s+", " ");
}

pub fn regex_demo_summary() -> String {
    let emailTest = test_regex_match();
    let searchResult = test_regex_search();
    let replaceResult = test_regex_replace();
    let emailValid = validate_email("user@example.com");
    let nums = extract_numbers("abc 123 def 456");

    return "match=" + emailTest.to_string()
        + " search_count=" + searchResult.len().to_string()
        + " replace=" + replaceResult
        + " valid_email=" + emailValid.to_string()
        + " nums=" + nums.len().to_string();
}
