import omniview;

store CartStore {
    signal items: Array<String> = [];
    signal total: f64 = 0.0;

    getter count: i32 = 0;
}

component CartIcon {
    signal count: i32 = 0;

    view {
        <div>
            <span>{count}</span>
            <span>Cart</span>
        </div>
    }
}

component ProductList {
    signal products: Array<String> = ["Widget", "Gadget", "Thingamajig"];

    view {
        <div>
            <h2>Products</h2>
            <ul>
                @for product in products {
                    <li>{product}</li>
                }
                @empty {
                    <li>No products available</li>
                }
            </ul>
        </div>
    }
}

component App {
    @store CartStore;

    view {
        <div>
            <header>
                <CartIcon />
            </header>
            <main>
                <ProductList />
            </main>
        </div>
    }
}
