import omniview;

pub struct Post {
    title: String,
    body: String,
    author: String,
}

pub fn format_date(timestamp: i64) -> String {
    return "2026-06-17";
}

component PostCard {
    signal title: String = "";
    signal body: String = "";
    signal author: String = "";

    view {
        <div>
            <h2>{title}</h2>
            <p>{body}</p>
            <span>By {author}</span>
        </div>
    }
}

component App {
    signal posts: Array<String> = ["First Post", "Second Post"];

    view {
        <div>
            <h1>My Blog</h1>
            @for post in posts {
                <PostCard title={post} />
            }
            @empty {
                <p>No posts yet.</p>
            }
        </div>
    }
}
