import omniview;
import { Post } from "../models/post.omni";
import { format_date } from "../models/post.omni";

component PostCard {
    signal post: Post = Post { title: "", body: "", author: "" };

    view {
        <div class: card>
            <h2>{post.title}</h2>
            <p>{post.body}</p>
            <span>By {post.author}</span>
        </div>
    }
}
