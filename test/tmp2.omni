import omniview;

// ╔══════════════════════════════════════════════════════════════╗
// ║     OmniView 教学项目 —— 从零掌握所有核心特性                ║
// ║                                                              ║
// ║  运行：omnic run src/main.omni                                ║
// ║  编译：omnic build --target omniview                          ║
// ║                                                              ║
// ║  涵盖知识点：                                                 ║
// ║  1. Store      2. Component  3. Signal     4. Computed       ║
// ║  5. Prop       6. Event      7. @if/@for   8. bind:value     ║
// ║  9. @onPress   10. style     11. @mount/@effect  12. 组件组合║
// ╚══════════════════════════════════════════════════════════════╝


// ═══════════════════════════════════════════════════════════════
// 一、Store（全局状态管理）
// ═══════════════════════════════════════════════════════════════
// Store 是全局单例。结构：signal → getter → action

store TodoStore {
    signal items: Array<String> = [];
    signal filter: String = "all";

    getter totalCount: i32 = items.len();

    action addItem(text: String) {
        if text != "" {
            items.push(text);
        }
    }

    action removeLast() { items.pop(); }

    action clearAll() { items = []; }

    action setFilter(f: String) { filter = f; }
}


// ═══════════════════════════════════════════════════════════════
// 二、工具函数
// ═══════════════════════════════════════════════════════════════

pub fn format_count(n: i32) -> String {
    if n == 0 { return "零"; }
    return n.to_string();
}


// ═══════════════════════════════════════════════════════════════
// 三、组件
// ═══════════════════════════════════════════════════════════════
// 声明顺序：prop → signal → computed → event
//           → @mount → @effect → fn → view → style


// ─────────────────────────────────────────────────────────────
// 组件：Header（最简单组件：只有 view + style）
// ─────────────────────────────────────────────────────────────

component Header {
    view {
        <header class: header>
            <h1 class: title>📋 OmniView 教学项目</h1>
            <p class: subtitle>—— 单文件覆盖全部核心特性</p>
        </header>
    }

    style {
        .header {
            background: #6366f1;
            color: white;
            padding: 24px;
            text-align: center;
            border-radius: 16px;
        }
        .title { font-size: 28px; }
        .subtitle { font-size: 14px; }
    }
}


// ─────────────────────────────────────────────────────────────
// 组件：AddTodo（输入绑定 + 生命周期 + 事件）
// ─────────────────────────────────────────────────────────────
// 知识点：signal, computed, bind:value, @onPress, @mount, @effect

component AddTodo {
    // prop：父组件传入的回调函数引用（通过事件）
    event onAdd: String;
    event onClear: String;

    // signal：组件局部响应式状态
    signal input: String = "";

    // computed：自动追踪依赖
    computed hint: String = if input == "" {
        "输入待办事项..."
    } else {
        "已输入 " + input.len().to_string() + " 字符，点击添加"
    };

    // @mount：挂载后执行一次
    @mount {
        println("AddTodo 组件已挂载！");
    }

    // @effect：input 变化后在 DOM 更新后触发
    @effect(input) {
        if input.len() > 20 {
            println("输入较长：" + input.len().to_string() + " 字符");
        }
    }

    // fn：事件处理
    fn handleAdd() {
        if input != "" {
            // 触发父组件事件，传递数据
            onAdd(input);
            input = "";
        }
    }

    fn handleClear() {
        onClear();
    }

    view {
        <div class: container>
            <div class: row>
                {/* bind:value 双向绑定 */}
                <input
                    bind:value={input}
                    placeholder={hint}
                    class: input
                />
                <button class: btn-add @onPress={handleAdd}>添加</button>
                <button class: btn-clear @onPress={handleClear}>清空</button>
            </div>
            <p class: counter>已输入 {input.len()} 字符</p>
        </div>
    }

    style {
        .container { padding: 0 16px 16px 16px; }
        .row { display: flex; gap: 8px; }
        .input {
            flex: 1;
            padding: 12px;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            font-size: 16px;
        }
        .btn-add {
            padding: 12px 20px;
            background: #6366f1;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            cursor: pointer;
        }
        .btn-clear {
            padding: 12px 16px;
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
        }
        .counter { font-size: 12px; color: #9ca3af; padding-top: 8px; }
    }
}


// ─────────────────────────────────────────────────────────────
// 组件：TodoItem（prop + event + 局部 signal）
// ─────────────────────────────────────────────────────────────
// 知识点：prop（外部属性）, event（子→父通信）, signal（局部状态）

component TodoItem {
    prop text: String;          // 必填属性
    prop index: i32 = 0;       // 可选属性（有默认值）

    event onDelete: i32;        // 删除事件
    event onToggle: i32;        // 切换事件

    signal checked: bool = false;  // 局部选中状态

    fn handleToggle() {
        checked = !checked;        // 修改局部 signal
        onToggle(index);           // 通知父组件
    }

    fn handleDelete() {
        onDelete(index);
    }

    view {
        <div class: item>
            <button class: check-btn @onPress={handleToggle}>
                {if checked { "✅" } else { "⬜" }}
            </button>
            <span class: text>{text}</span>
            <span class: badge>#{index + 1}</span>
            <button class: del-btn @onPress={handleDelete}>✕</button>
        </div>
    }

    style {
        .item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            background: white;
            border-radius: 8px;
            margin-bottom: 4px;
        }
        .check-btn { width: 28px; height: 28px; border: none; background: none; cursor: pointer; font-size: 18px; padding: 0; }
        .text { flex: 1; font-size: 16px; color: #1f2937; }
        .badge { font-size: 11px; background: #f3f4f6; color: #9ca3af; padding: 2px 8px; border-radius: 10px; }
        .del-btn { width: 32px; height: 32px; border: none; background: none; cursor: pointer; font-size: 14px; color: #ef4444; border-radius: 6px; }
    }
}


// ─────────────────────────────────────────────────────────────
// 组件：StatsPanel（统计面板）
// ─────────────────────────────────────────────────────────────
// 知识点：prop 接收数据, @if 条件渲染

component StatsPanel {
    prop total: i32 = 0;

    view {
        <div class: panel>
            <h3 class: title>📊 统计面板（通过 prop 接收）</h3>

            <div class: grid>
                <div class: card>
                    <span class: value>{total}</span>
                    <span class: label>总事项</span>
                </div>
                <div class: card>
                    <span class: value>{if total > 0 { "✓" } else { "-" }}</span>
                    <span class: label">状态</span>
                </div>
            </div>

            <div class: msg>
                @if total == 0 {
                    <p>✨ 开始添加第一个待办事项吧！</p>
                } else {
                    <p>📝 已添加 {total} 个事项</p>
                }
            </div>
        </div>
    }

    style {
        .panel { background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; margin: 16px; }
        .title { font-size: 18px; margin-bottom: 16px; color: #1f2937; }
        .grid { display: flex; gap: 12px; margin-bottom: 16px; }
        .card { flex: 1; background: white; padding: 16px; border-radius: 8px; text-align: center; }
        .value { font-size: 28px; font-weight: bold; color: #6366f1; }
        .label { font-size: 13px; color: #6b7280; }
        .msg { text-align: center; }
        .msg p { font-size: 14px; color: #6b7280; }
    }
}


// ─────────────────────────────────────────────────────────────
// 组件：FilterBar（筛选按钮栏）
// ─────────────────────────────────────────────────────────────
// 知识点：event 子→父通信, @onPress

component FilterBar {
    prop currentFilter: String = "all";
    prop totalCount: i32 = 0;

    event onFilterChange: String;

    fn showAll()    { onFilterChange("all"); }
    fn showActive() { onFilterChange("active"); }
    fn showDone()   { onFilterChange("done"); }

    view {
        <div class: bar>
            <span class: label>筛选：</span>
            <button class: btn @onPress={showAll}>
                全部（{totalCount}）
            </button>
            <button class: btn @onPress={showActive}>活跃</button>
            <button class: btn @onPress={showDone}>已完成</button>
            <span class: current">当前：{currentFilter}</span>
        </div>
    }

    style {
        .bar { display: flex; align-items: center; gap: 8px; padding: 8px 16px; }
        .label { font-size: 14px; color: #666; }
        .btn { padding: 6px 14px; border: 1px solid #ddd; border-radius: 20px; background: white; cursor: pointer; font-size: 13px; color: #555; }
        .current { font-size: 12px; color: #6366f1; margin-left: 8px; }
    }
}


// ─────────────────────────────────────────────────────────────
// 组件：TodoList（列表容器）
// ─────────────────────────────────────────────────────────────
// 知识点：@for/@empty 列表渲染, 组件组合, event 中继

component TodoList {
    prop items: Array<String> = [];

    event onDelete: i32;
    event onToggle: i32;
    event onAdd: String;
    event onClear: String;
    event onFilterChange: String;

    fn handleDelete(index: i32) { onDelete(index); }
    fn handleToggle(index: i32) { onToggle(index); }
    fn handleAdd(text: String)   { onAdd(text); }
    fn handleClear()             { onClear(); }
    fn handleFilter(f: String)   { onFilterChange(f); }

    view {
        <div>
            <h2 class: title>
                待办列表
                <span class: badge>{items.len()}</span>
            </h2>

            <FilterBar
                totalCount={items.len()}
                @onFilterChange={handleFilter}
            />

            <AddTodo
                @onAdd={handleAdd}
                @onClear={handleClear}
            />

            {/* @for 遍历 + @empty 空状态 */}
            <div class: items>
                @for item in items {
                    <TodoItem
                        text={item}
                        @onDelete={handleDelete}
                        @onToggle={handleToggle}
                    />
                }
                @empty {
                    <div class: empty-state>
                        <span class: empty-icon>📝</span>
                        <p class: empty-text>还没有待办事项，在上方添加吧！</p>
                    </div>
                }
            </div>
        </div>
    }

    style {
        .title { font-size: 20px; padding: 16px 16px 0 16px; color: #1f2937; display: flex; align-items: center; gap: 8px; }
        .badge { font-size: 13px; background: #6366f1; color: white; padding: 2px 10px; border-radius: 12px; }
        .items { padding: 0 16px 16px 16px; }
        .empty-state { text-align: center; padding: 48px 24px; }
        .empty-icon { font-size: 48px; }
        .empty-text { font-size: 16px; color: #9ca3af; }
    }
}


// ─────────────────────────────────────────────────────────────
// 组件：Counter（独立计数器）
// ─────────────────────────────────────────────────────────────
// 知识点：signal 修改, computed, @onPress 内联回调

component Counter {
    signal count: i32 = 0;
    signal step: i32 = 1;

    computed doubled: i32 = count * 2;
    computed isEven: bool = count % 2 == 0;

    fn increment() { count = count + step; }
    fn decrement() { count = count - step; }
    fn reset()     { count = 0; }

    view {
        <div class: box>
            <h3 class: title>🔢 计数器演示</h3>
            <p class: big-number>{count}</p>
            <p class: info>翻倍：{doubled} | {if isEven { "偶数" } else { "奇数" }}</p>

            <div class: ctrl-row>
                <button class: btn @onPress={decrement}>−</button>
                <span class: step-label>步长：{step}</span>
                <button class: btn @onPress={increment}>+</button>
            </div>

            <div class: ctrl-row>
                {/* 内联回调：直接修改 signal */}
                <button class: btn-sm @onPress={() => { step = 1; }}>步长1</button>
                <button class: btn-sm @onPress={() => { step = 5; }}>步长5</button>
                <button class: btn-sm @onPress={() => { step = 10; }}>步长10</button>
                <button class: btn-reset @onPress={reset}>重置</button>
            </div>
        </div>
    }

    style {
        .box { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; margin: 16px; text-align: center; }
        .title { font-size: 18px; margin-bottom: 12px; color: #1f2937; }
        .big-number { font-size: 48px; font-weight: bold; color: #6366f1; margin: 8px 0; }
        .info { font-size: 14px; color: #6b7280; }
        .ctrl-row { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 12px; }
        .step-label { font-size: 14px; color: #6b7280; }
        .btn { width: 40px; height: 40px; border: 2px solid #e5e7eb; border-radius: 8px; background: white; font-size: 20px; cursor: pointer; color: #374151; }
        .btn-sm { padding: 6px 12px; border: 1px solid #e5e7eb; border-radius: 6px; background: white; font-size: 13px; cursor: pointer; color: #374151; }
        .btn-reset { padding: 6px 12px; border: 1px solid #fecaca; border-radius: 6px; background: #fef2f2; font-size: 13px; cursor: pointer; color: #dc2626; }
    }
}


// ─────────────────────────────────────────────────────────────
// 组件：FeatureList（知识点列表）
// ─────────────────────────────────────────────────────────────
// 知识点：signal 布尔切换, @for 遍历数组, @if 条件渲染

component FeatureList {
    signal isOpen: bool = true;

    signal features: Array<String> = [
        "Store（全局状态管理）",
        "Signal（响应式信号）+ Computed（计算属性）",
        "Prop（外部属性）+ Event（自定义事件）",
        "bind:value（双向绑定）",
        "if、@if / @else（条件渲染）",
        "while、for-in、@for / @empty（循环/列表）",
        "@onPress（事件处理）+ 内联回调",
        "async fn / await（Python + JS）",
        "@mount / @effect（生命周期）",
        "style（作用域样式）",
        "struct + pub fn（数据结构+工具函数）",
        "组件组合（Component Composition）",
    ];

    fn toggle() { isOpen = !isOpen; }

    view {
        <div class: panel>
            <div class: header @onPress={toggle}>
                <h3 class: title>📚 涵盖知识点（{features.len()} 项）</h3>
                <span>{if isOpen { "▲" } else { "▼" }}</span>
            </div>

            @if isOpen {
                <div class: list>
                    @for f in features {
                        <span class: tag>{f}</span>
                    }
                    @empty {
                        <span>加载中...</span>
                    }
                </div>
            }
        </div>
    }

    style {
        .panel { background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; padding: 16px; margin: 16px; }
        .header { display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
        .title { font-size: 16px; color: #92400e; }
        .list { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 12px; }
        .tag { font-size: 13px; color: #78350f; padding: 4px 8px; background: #fef3c7; border-radius: 6px; }
    }
}


// ═══════════════════════════════════════════════════════════════
// 四、根组件 App（必须放在最后）
// ═══════════════════════════════════════════════════════════════
// App 是唯一使用 @store 的组件
// 所有数据通过 prop 向下传递，通过 event 向上接收

component App {
    @store TodoStore;

    // ── App 层的处理函数：调用 Store action ──
    fn handleAdd(text: String) {
        TodoStore.addItem(text);
    }
    fn handleDelete(index: i32) {
        TodoStore.removeLast();
    }
    fn handleToggle(index: i32) {
        println("切换第 " + index.to_string() + " 项");
    }
    fn handleClear() {
        TodoStore.clearAll();
    }
    fn handleFilterChange(f: String) {
        TodoStore.setFilter(f);
    }

    view {
        <div class: app>
            <Header />

            {/* prop 传递数据：total={TodoStore.totalCount} */}
            <StatsPanel total={TodoStore.totalCount} />

            {/* prop 传递列表 + event 接收操作 */}
            <TodoList
                items={TodoStore.items}
                @onAdd={handleAdd}
                @onDelete={handleDelete}
                @onToggle={handleToggle}
                @onClear={handleClear}
                @onFilterChange={handleFilterChange}
            />

            <Counter />
            <FeatureList />

            <footer class: footer>
                <p class: footer-text">OmniView 教学项目 · 运行 omnic run src/main.omni 查看</p>
            </footer>
        </div>
    }

    style {
        .app { max-width: 700px; margin: 0 auto; background: #f9fafb; min-height: 100vh; }
        .footer { text-align: center; padding: 24px; }
        .footer-text { font-size: 13px; color: #9ca3af; }
    }
}
