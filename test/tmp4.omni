import omniview;




store TodoStore {
    signal items: Array<String> = [];
    signal filter: String = "all";
    getter totalCount: i32 = items.len();
    action add(text: String) { if text != "" { items.push(text); } }
    action remove() { items.pop(); }
    action clear() { items = []; }
    action setFilter(f: String) { filter = f; }
}



pub fn format_count(n: i32) -> String {
    if n == 0 { return "零"; }
    return n.to_string();
}





component Header {
    view {
        <header class: header>
            <h1 class: title> OmniView 教学项目</h1>
            <p class: subtitle>—— 涵盖 Store / Signal / Computed / Prop / Event / @if / @for / bind:value / 生命周期 / 样式</p>
        </header>
    }

    style {
        .header { background: #6366f1; color: white; padding: 24px; text-align: center; border-radius: 16px; }
        .title { font-size: 28px; }
        .subtitle { font-size: 13px; opacity: 0.85; }
    }
}



component AddTodo {
    event onAdd: String;

    signal input: String = "";

    computed hint: String = if input == "" {
        "输入待办事项..."
    } else {
        "已输入 " + input.len().to_string() + " 字符，点击添加"
    };

    @mount {
        println("AddTodo 组件已挂载！");
    }

    @effect(input) {
        if input.len() > 20 {
            println("输入较长：" + input.len().to_string() + " 字符");
        }
    }

    fn handleAdd() {
        if input != "" {
            onAdd(input);  
            input = "";
        }
    }

    view {
        <div class: container>
            <div class: row>
                <input bind:value={input} placeholder={hint} class: input />
                <button class: btn-add @onPress={handleAdd}>添加</button>
            </div>
            <p class: counter>已输入 {input.len()} 字符</p>
        </div>
    }

    style {
        .container { padding: 0 16px 16px 16px; }
        .row { display: flex; gap: 8px; }
        .input { flex: 1; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 16px; }
        .btn-add { padding: 12px 20px; background: #6366f1; color: white; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; }
        .counter { font-size: 12px; color: #9ca3af; padding-top: 8px; }
    }
}



component TodoItem {
    prop text: String;         
    prop index: i32 = 0;      
    event onDelete: i32;       

    signal checked: bool = false;

    fn toggle() {
        checked = !checked;    
    }

    fn handleDelete() {
        onDelete(index);       
    }

    view {
        <div class: item>
            <button class: check-btn @onPress={toggle}>
                {if checked { "" } else { "" }}
            </button>
            <span class: text>{text}</span>
            <span class: badge>#{index + 1}</span>
            <button class: del-btn @onPress={handleDelete}>x</button>
        </div>
    }

    style {
        .item { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: white; border-radius: 8px; margin-bottom: 4px; }
        .check-btn { width: 28px; height: 28px; border: none; background: none; cursor: pointer; font-size: 18px; padding: 0; }
        .text { flex: 1; font-size: 16px; color: #1f2937; }
        .badge { font-size: 11px; background: #f3f4f6; color: #9ca3af; padding: 2px 8px; border-radius: 10px; }
        .del-btn { width: 32px; height: 32px; border: none; background: none; cursor: pointer; font-size: 14px; color: #ef4444; border-radius: 6px; }
    }
}



component StatsPanel {
    prop total: i32 = 0;

    view {
        <div class: panel>
            <h3 class: title> 统计面板(数据通过 prop 接收)</h3>
            <div class: grid>
                <div class: card>
                    <span class: value>{total}</span>
                    <span class: label>总事项</span>
                </div>
                <div class: card>
                    <span class: value>{if total > 0 { "✓" } else { "-" }}</span>
                    <span class: label>状态</span>
                </div>
            </div>
            <div class: msg>
                @if total == 0 {
                    <p> 开始添加第一个待办事项吧！</p>
                } else {
                    <p> 已添加 {total} 个事项</p>
                }
            </div>
        </div>
    }

    style {
        .panel { background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; margin: 16px; }
        .title { font-size: 18px; margin-bottom: 16px; color: #1f2937; }
        .grid { display: flex; gap: 12px; margin-bottom: 16px; }
        .card { flex: 1; background: white; padding: 16px; border-radius: 8px; text-align: center; }
        .value { font-size: 28px; font-weight: bold; color: #6366f1; }
        .label { font-size: 13px; color: #6b7280; }
        .msg { text-align: center; }
        .msg p { font-size: 14px; color: #6b7280; }
    }
}



component TodoList {
    prop items: Array<String> = [];
    event onDelete: i32;
    event onAdd: String;

    fn handleDelete(index: i32) { onDelete(index); }
    fn handleAdd(text: String)   { onAdd(text); }

    view {
        <div>
            <h2 class: title>
                待办列表 <span class: badge>{items.len()}</span>
            </h2>

            <AddTodo @onAdd={handleAdd} />

            <div class: items>
                @for item in items {
                    <TodoItem text={item} @onDelete={handleDelete} />
                }
                @empty {
                    <div class: empty-state>
                        <span class: empty-icon></span>
                        <p class: empty-text>还没有待办事项</p>
                    </div>
                }
            </div>
        </div>
    }

    style {
        .title { font-size: 20px; padding: 16px 16px 0 16px; color: #1f2937; display: flex; align-items: center; gap: 8px; }
        .badge { font-size: 13px; background: #6366f1; color: white; padding: 2px 10px; border-radius: 12px; }
        .items { padding: 0 16px 16px 16px; }
        .empty-state { text-align: center; padding: 48px 24px; }
        .empty-icon { font-size: 48px; }
        .empty-text { font-size: 16px; color: #9ca3af; }
    }
}



component Counter {
    signal count: i32 = 0;
    signal step: i32 = 1;

    computed doubled: i32 = count * 2;
    computed label: String = if count % 2 == 0 { "偶数" } else { "奇数" };

    fn inc() { count = count + step; }
    fn dec() { count = count - step; }
    fn reset() { count = 0; }

    view {
        <div class: box>
            <h3 class: title> 计数器演示</h3>
            <p class: big-number>{count}</p>
            <p class: info>翻倍：{doubled} | {label}</p>
            <div class: row>
                <button class: btn @onPress={dec}>−</button>
                <span class: step-text>步长 {step}</span>
                <button class: btn @onPress={inc}>+</button>
            </div>
            <div class: row>
                {/* 内联回调：直接在 JSX 中写逻辑 */}
                <button class: btn-sm @onPress={() => { step = 1; }}>步长1</button>
                <button class: btn-sm @onPress={() => { step = 5; }}>步长5</button>
                <button class: btn-sm @onPress={() => { step = 10; }}>步长10</button>
                <button class: btn-reset @onPress={reset}>重置</button>
            </div>
        </div>
    }

    style {
        .box { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px; margin: 16px; text-align: center; }
        .title { font-size: 18px; margin-bottom: 12px; color: #1f2937; }
        .big-number { font-size: 48px; font-weight: bold; color: #6366f1; margin: 8px 0; }
        .info { font-size: 14px; color: #6b7280; }
        .row { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 12px; }
        .step-text { font-size: 14px; color: #6b7280; }
        .btn { width: 40px; height: 40px; border: 2px solid #e5e7eb; border-radius: 8px; background: white; font-size: 20px; cursor: pointer; color: #374151; }
        .btn-sm { padding: 6px 12px; border: 1px solid #e5e7eb; border-radius: 6px; background: white; font-size: 13px; cursor: pointer; color: #374151; }
        .btn-reset { padding: 6px 12px; border: 1px solid #fecaca; border-radius: 6px; background: #fef2f2; font-size: 13px; cursor: pointer; color: #dc2626; }
    }
}



component FeatureList {
    signal isOpen: bool = true;
    signal features: Array<String> = [
        "Store(全局状态管理)",
        "Component(组件声明与组合)",
        "Signal(响应式信号)",
        "Computed(计算属性)",
        "Prop(外部属性传递)",
        "Event(自定义事件通信)",
        "bind:value(双向绑定)",
        "@if / @else(条件渲染)",
        "@for / @empty(列表渲染+空状态)",
        "@onPress(事件处理)+ 内联回调",
        "@mount / @effect(生命周期)",
        "style(作用域 CSS 样式)",
        "pub fn(公开工具函数)",
        "struct(数据结构定义)",
    ];

    fn toggle() { isOpen = !isOpen; }

    view {
        <div class: panel>
            <div class: header @onPress={toggle}>
                <h3 class: title> 涵盖知识点({features.len()} 项)</h3>
                <span class: arrow>{if isOpen { "^" } else { "v" }}</span>
            </div>
            @if isOpen {
                <div class: list>
                    @for f in features {
                        <span class: tag>{f}</span>
                    }
                    @empty { <span>加载中...</span> }
                </div>
            }
        </div>
    }

    style {
        .panel { background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; padding: 16px; margin: 16px; }
        .header { display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
        .title { font-size: 16px; color: #92400e; }
        .arrow { font-size: 14px; color: #a16207; }
        .list { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 12px; }
        .tag { font-size: 13px; color: #78350f; padding: 4px 8px; background: #fef3c7; border-radius: 6px; }
    }
}



component App {
    @store TodoStore;

    view {
        <div class: app>
            <Header />
            <StatsPanel total={TodoStore.totalCount} />

            {/* 通过内联回调直接调用 Store action */}
            <TodoList
                items={TodoStore.items}
                @onAdd={(text: String) => { TodoStore.add(text); }}
                @onDelete={(index: i32) => { TodoStore.remove(); }}
            />

            <Counter />
            <FeatureList />

            <footer class: footer>
                <p class: footer-text">OmniView 教学项目 · 运行 omnic run src/main.omni 查看</p>
            </footer>
        </div>
    }

    style {
        .app { max-width: 700px; margin: 0 auto; background: #f9fafb; min-height: 100vh; }
        .footer { text-align: center; padding: 24px; }
        .footer-text { font-size: 13px; color: #9ca3af; }
    }
}
