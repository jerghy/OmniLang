import omniview;

component TodoApp {
    signal tasks: Array<String> = ["Buy groceries", "Finish report", "Call dentist"];
    signal done_tasks: Array<String> = ["Learn OmniLang"];
    signal new_task_text: String = "";
    signal filter: String = "all";
    signal task_count: i32 = 3;

    fn add_task() {
        tasks.push(new_task_text);
        new_task_text = "";
        task_count = task_count + 1;
    }

    fn set_filter_all() { filter = "all"; }
    fn set_filter_active() { filter = "active"; }
    fn set_filter_done() { filter = "done"; }

    fn clear_done() {
        done_tasks = [];
    }

    view {
        <div>
            <div class="app-shell">
                <header class="header">
                    <h1 class="title">Tasks</h1>
                    <p class="subtitle" testId="task-count">{task_count}</p>
                </header>

                <div class="input-row">
                    <input placeholder="Add a new task..." bind:value={new_task_text} testId="todo-input" />
                    <button onClick={add_task} testId="btn-add" class="btn-add">Add</button>
                </div>

                <div class="filter-bar">
                    <button onClick={set_filter_all} testId="filter-all" class="filter-btn">All</button>
                    <button onClick={set_filter_active} testId="filter-active" class="filter-btn">Active</button>
                    <button onClick={set_filter_done} testId="filter-done" class="filter-btn">Done</button>
                </div>

                @if filter == "all" || filter == "active" {
                    <div class="task-section">
                        <h3 class="section-title">Active</h3>
                        @for task in tasks {
                            <div class="task-item" testId="task-item">
                                <span class="task-dot" />
                                <span class="task-text">{task}</span>
                            </div>
                        }
                        @empty {
                            <div class="empty-state">All done! Add a new task above.</div>
                        }
                    </div>
                }

                @if filter == "all" || filter == "done" {
                    <div class="task-section">
                        <h3 class="section-title">Completed</h3>
                        @for task in done_tasks {
                            <div class="task-item" testId="done-item">
                                <span class="task-dot-done" />
                                <span class="task-text-done">{task}</span>
                            </div>
                        }
                        @empty {
                            <div class="empty-state">Nothing completed yet</div>
                        }
                    </div>
                }

                <div class="footer" testId="footer">
                    <span class="summary" testId="footer-summary">{task_count}</span>
                    <button onClick={clear_done} testId="btn-clear" class="btn-clear">Clear done</button>
                </div>
            </div>
        </div>
    }

    style {
        .app-shell { maxWidth: 560; margin: "40px auto"; padding: 32; background: "#0f0f23"; borderRadius: 24; color: "#e4e4e7"; }
        .header { textAlign: center; marginBottom: 32; }
        .title { fontSize: 36; fontWeight: 800; margin: 0; color: "#a78bfa"; letterSpacing: "-0.5px"; }
        .subtitle { fontSize: 14; color: "#52525b"; marginTop: 6; fontWeight: 400; }
        .input-row { display: flex; gap: 10; marginBottom: 24; }
        .btn-add { padding: "14px 24px"; background: "#6366f1"; color: white; border: none; borderRadius: 14; fontSize: 15; fontWeight: 600; cursor: pointer; whiteSpace: nowrap; }
        .filter-bar { display: flex; gap: 4; marginBottom: 28; padding: 4; background: "rgba(255,255,255,0.04)"; borderRadius: 12; }
        .filter-btn { flex: 1; padding: "10px 16px"; fontSize: 13; fontWeight: 600; borderRadius: 10; border: none; background: transparent; color: "#71717a"; cursor: pointer; }
        .section-title { fontSize: 11; fontWeight: 700; textTransform: uppercase; letterSpacing: 1; color: "#52525b"; marginBottom: 10; paddingLeft: 4; }
        .task-section { marginBottom: 24; }
        .task-item { display: flex; alignItems: center; gap: 12; padding: "14px 16px"; marginBottom: 4; borderRadius: 14; background: "rgba(255,255,255,0.03)"; border: "1px solid rgba(255,255,255,0.05)"; }
        .task-dot { width: 8; height: 8; borderRadius: 4; background: "#6366f1"; flexShrink: 0; }
        .task-dot-done { width: 8; height: 8; borderRadius: 4; background: "#22c55e"; flexShrink: 0; opacity: 0.6; }
        .task-text { fontSize: 15; color: "#d4d4d8"; }
        .task-text-done { fontSize: 15; color: "#52525b"; textDecoration: "line-through"; }
        .empty-state { textAlign: center; padding: "32px 24px"; color: "#3f3f46"; fontSize: 14; }
        .footer { display: flex; justifyContent: space-between; alignItems: center; paddingTop: 20; marginTop: 28; borderTop: "1px solid rgba(255,255,255,0.06)"; }
        .summary { fontSize: 13; color: "#52525b"; fontWeight: 500; }
        .btn-clear { padding: "8px 16px"; fontSize: 12; fontWeight: 600; borderRadius: 8; border: "1px solid rgba(239,68,68,0.25)"; background: transparent; color: "#f87171"; cursor: pointer; }
    }
}
