import omniview;
import { CssVarsDemo } from "./CssVarsDemo";
import { ThemeCssVarsDemo } from "./ThemeCssVarsDemo";
import { ThemeStore } from "./ThemeStore";

component App {
    @store ThemeStore;

    view {
        <div class: app>
            <h1 class: page-title>CSS Variables Testing</h1>
            <CssVarsDemo />
            <ThemeCssVarsDemo />
        </div>
    }
    style {
        .app { max-width: 700px; width: 92vw; margin: 0 auto; background: #f9fafb; min-height: 100vh; padding: 20px; }
        .page-title { font-size: 24px; color: #1f2937; margin: 0 0 20px 0; }
    }
}
