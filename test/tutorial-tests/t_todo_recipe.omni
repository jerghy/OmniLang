import omniview;
component TodoList {
    signal items: Array<String> = [];
    signal input: String = "";
    fn add_item() { if input != "" { items.push(input); input = ""; } }
    view {
        <div><h2>Todo List</h2>
        <input bind:value={input} placeholder="Add a task..." />
        <button @onPress={add_item}>Add</button>
        <ul>@for item in items {<li>{item}</li>}@empty {<li>No items yet</li>}</ul></div>
    }
}
