import omniview;

component Card {
    prop title: String;
    prop idx: i32 = 0;

    view {
        <div testId={title}>
            <h1>{title}</h1>
            <p>Index: {idx}</p>
        </div>
    }
}

component App {
    signal items: Array<String> = ["First", "Second", "Third"];
    signal name: String? = null;

    fn getDisplayName() -> String {
        return name ?? "Guest";
    }

    fn riskyOperation() {
        try {
            println("Starting...");
            throw "Something wrong";
        } catch e {
            println(e);
        } finally {
            println("Cleanup done");
        }
    }

    view {
        <h1>Welcome, {getDisplayName()}</h1>
        <button testId="btn-risky" @onPress={riskyOperation}>Run Risk</button>
        @for item in items key={item} {
            <Card title={item} />
        }
        @empty {
            <p testId="empty-msg">No items</p>
        }
    }
}
