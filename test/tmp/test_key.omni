import omniview;

component Item {
    prop name: String;
    prop id: i32 = 0;

    view {
        <div>
            <span>{name}</span>
        </div>
    }
}

component List {
    signal items: Array<String> = ["a", "b", "c"];

    view {
        <div>
            @for item in items key={item} {
                <Item name={item} />
            }
            @empty {
                <p>No items</p>
            }
        </div>
    }
}
