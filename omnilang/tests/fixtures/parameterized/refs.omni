// refs.omni — element refs, semantic bindings (value/focus), and ref ops
// (.value write, .focus()). Exercises the Element Reference System across
// all P0 backends.

import omniview;

component SearchBox {
    ref input: HtmlElement;
    signal query: string = "";
    signal isFocused: bool = false;
    // Read ONLY inside style: { ... } — must still receive a state hook
    // (regression: inline-style reads were not collected for the React
    // useState decision, emitting the signal undeclared).
    signal boxColor: string = "red";

    action clearInput() {
        input.value = "";
    }

    action focusInput() {
        input.focus();
    }

    action recolorBox() {
        boxColor = "blue";
    }

    view {
        <input
            class: search-input
            @ref={input}
            value={query}
            focus={isFocused}
        />
        <div class: color-box style: { color: boxColor }></div>
        <button @onPress={clearInput}>Clear</button>
        <button @onPress={focusInput}>Focus</button>
        <button @onPress={recolorBox}>Recolor</button>
    }
}
