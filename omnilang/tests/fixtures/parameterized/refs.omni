// refs.omni — element refs, bind:value two-way binding, focus semantic
// binding, and ref ops (.focus() reads; the imperative .value write was
// removed — the clear action writes the bound signal instead). Exercises
// the Element Reference System across all P0 backends.

import omniview;

component SearchBox {
    ref input: HtmlElement;
    signal query: string = "";
    signal isFocused: bool = false;
    // Read ONLY inside style: { ... } — must still receive a state hook
    // (regression: inline-style reads were not collected for the React
    // useState decision, emitting the signal undeclared).
    signal boxColor: string = "red";

    action clearInput() {
        query = "";
    }

    action focusInput() {
        input.focus();
    }

    action recolorBox() {
        boxColor = "blue";
    }

    view {
        <input
            class: search-input
            @ref={input}
            bind:value={query}
            focus={isFocused}
        />
        <div class: color-box style: { color: boxColor }></div>
        <button @onPress={clearInput}>Clear</button>
        <button @onPress={focusInput}>Focus</button>
        <button @onPress={recolorBox}>Recolor</button>
    }
}
