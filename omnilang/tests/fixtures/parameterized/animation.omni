// animation.omni — semantic-level DSL motion: named @motion with colon
// timing (over:/easing:), inline tween triggers, named trigger refs, and the
// v1 @scroll/@drag control dimensions (Task 5.1).

import omniview;

@motion pulse {
    from { scale: 1.0 }
    to { scale: 1.05 }
    over: 200ms
    easing: ease-out
}

@motion parallaxScroll {
    from { translateY: -100 }
    to   { translateY: 0 }
    over: 1s
}

@motion swipeX {
    from { translateX: 0 }
    to   { translateX: 300 }
    over: 300ms
}

component MotionCard {
    view {
        <div class: card @enter={{ opacity: 0, translateY: 20 }}>
            Hello
        </div>
        <div class: card @hover={pulse}>
            Hover me
        </div>
        <div class: card @scroll start: 0 end: 1000 scrub: true ={parallaxScroll}>
            Scroll-driven parallax
        </div>
        <div class: card @drag-horizontal constraints: [-100, 100] elastic: 0.5 threshold: 0.3 ={swipeX}>
            Drag me
        </div>
    }
}
