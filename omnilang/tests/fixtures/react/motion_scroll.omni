@motion fadeScroll {
  from { opacity: 0.3 }
  to   { opacity: 1 }
  over: 500ms
  easing: ease-out
}

component MotionScroll {
  view {
    <div>
      <div @scroll start: 0 end: 1000 scrub: true ={fadeScroll}>
        <p>Scroll-driven animation</p>
      </div>
      <div @scroll={fadeScroll}>
        <p>Scroll-driven animation (default range)</p>
      </div>
    </div>
  }
}
