@motion fadeIn {
  from { opacity: 0, translateY: 20 }
  to   { opacity: 1, translateY: 0 }
  over: 400ms
  easing: ease-out
}

@motion pulse {
  to { scale: 1.05 }
  over: 200ms
  easing: ease-out
}

@motion slideIn {
  from { opacity: 0, translateX: -30 }
  to   { opacity: 1, translateX: 0 }
  over: 500ms
  easing: ease-out
}

component MotionCombined {
  view {
    <div>
      <h1 @enter={fadeIn}>Title</h1>
      <button @hover={pulse}>Hover Me</button>
      <div @in-view={slideIn}>
        <p>Content</p>
      </div>
    </div>
  }
}
