// combinations/refop_array.omni — ref-op 参数内数组方法（v4 compiler HIGH-1）：
// `box.setSelection(DataStore.items.filter(|i| i > 1).len(), 5)` 的 .filter 必须
// 被重写为 Dart 的 .where(...).toList()——verbatim `.filter(` 生成不存在的方法
// （Dart List 没有 filter，dart analyze 报 `List.filter` 不存在）。
//
// 注：本 fixture 不在 parameterized/ 枚举内（不会被全量 dart analyze 门自动拾取），
// 只被 generated_code_validation.rs::combinations_refop_array_flutter_compiles 编译。

import omniview;

store DataStore {
    signal items: Array<i32> = [1, 2, 3, 4, 5];
}

component App {
    ref box: Element;
    @store DataStore;

    view {
        <input @ref={box} />
        <button @onPress={() => {
            box.setSelection(DataStore.items.filter(|i| i > 1).len(), 5);
        }}>Go</button>
    }
}
