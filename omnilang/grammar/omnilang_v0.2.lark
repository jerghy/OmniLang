// OmniLang v0.2 EBNF Grammar
// Target: lark-parser LALR(1) with Earley fallback validation
// Extends v0.1 grammar with Phase 1 features

start: program

// ── Top Level ───────────────────────────────────────

program: (function_def | struct_def | tagged_union_def | class_def | import_stmt | export_stmt | impl_block)*

import_stmt: "import" "{" CNAME ("," CNAME)* "}" "from" STRING_LIT ";"
export_stmt: "export" (function_def | struct_def | class_def | tagged_union_def)

function_def: [ASYNC] FN CNAME ["<" generic_params ">"] "(" [params] ")" ["->" return_type] block

params: param ("," param)*
param: CNAME ":" type
     | "..." CNAME ":" type   // rest parameter
return_type: type

// ── Generics (Phase 2, grammar added in Phase 1) ────

generic_params: generic_param ("," generic_param)*
generic_param: CNAME ["+" CNAME]   // T or T + Display

// ── Types ───────────────────────────────────────────

type: union_type
union_type: struct_type ("|" struct_type)*
struct_type: base_type ("<" type_args ">")?
           | optional_type
           | fn_type

optional_type: base_type "?"   // T? → T | null
base_type: TYPE_NAME | CNAME   // CNAME for user-defined types (struct names)
type_args: type ("," type)*

TYPE_NAME: "i32" | "f64" | "bool" | "String" | "Array" | "Map" | "void" | "null"

// ── Statements ──────────────────────────────────────

stmt: var_decl
    | assign
    | if_stmt
    | while_stmt
    | for_stmt
    | break_stmt
    | continue_stmt
    | return_stmt
    | print_stmt
    | expr_stmt
    | block_stmt

var_decl: LET_KW [MUT_KW] (CNAME [":" type]) "=" expr ";"       // simple binding (type optional)
        | LET_KW [MUT_KW] array_pattern "=" expr ";"            // destructure array
        | LET_KW [MUT_KW] object_pattern "=" expr ";"           // destructure object

array_pattern: "[" pattern_elem ("," pattern_elem)* [","] ["," rest_pattern] "]"
             | "[" rest_pattern "]"
rest_pattern: "..." CNAME
pattern_elem: CNAME | "_" | array_pattern | object_pattern
object_pattern: "{" CNAME ("," CNAME)* [","] "}"

LET_KW: "let"
MUT_KW: "mut"
FN: "fn"
ASYNC: "async"
AWAIT: "await"
NOMINAL: "nominal"

assign: CNAME index? ASSIGN_OP expr ";"

if_stmt: "if" expr block else_tail?
else_tail: "else" (if_stmt | block)
while_stmt: "while" expr block
for_stmt: "for" CNAME "in" expr block
break_stmt: "break" ";"
continue_stmt: "continue" ";"
return_stmt: "return" [expr] ";"

print_stmt: "println" "(" expr ")" ";" -> println_stmt
          | "print" "(" expr ")" ";"

expr_stmt: expr ";"
block_stmt: block

// ── Block with optional trailing expression ─────────

block: "{" body_contents "}"
body_contents: (stmt* [expr_no_semi])?
expr_no_semi: expr   // no trailing semicolon, only valid at end of block

// ── Index ───────────────────────────────────────────

index: "[" expr "]"

// ── Expressions ─────────────────────────────────────

?expr: closure_expr | arrow_expr | match_expr | null_coalesce

?null_coalesce: or_expr ("??" or_expr)*

?or_expr: and_expr (OR and_expr)*
?and_expr: comp_expr ("&&" comp_expr)*
?comp_expr: add_expr (COMP_OP add_expr)*
?add_expr: mul_expr (ADD_OP mul_expr)*
?mul_expr: unary_expr (MUL_OP unary_expr)*
?unary_expr: AWAIT unary_expr -> await_expr | UNARY_OP unary_expr | postfix_expr
?postfix_expr: atom_expr (method_call | func_call | index | optional_chain)*
?atom_expr: literal | if_expr | var_ref | struct_lit | "(" expr ")" | spread_expr | template_string

// ── Closures & Arrow functions ──────────────────────

closure_expr: OR ["->" type] closure_body                    // no-param closure
            | PIPE closure_params PIPE ["->" type] closure_body  // closure with params

arrow_expr: "(" [params] ")" ARROW closure_body

closure_body: block | expr

closure_params: closure_param ("," closure_param)*
closure_param: CNAME [":" type]

// ── Match expression ───────────────────────────────

match_expr: "match" expr "{" match_arm ("," match_arm)* [","] "}"
match_arm: match_pattern ["if" expr] "=>" (block | expr)

match_pattern: match_pattern "|" match_pattern      // or-pattern (lowest priority)
             | literal_pattern                       // 42, "hello", true, false
             | struct_pattern                        // Some { value }
             | CNAME                                 // variable binding
             | "_"                                   // wildcard
             | "(" match_pattern ")"

literal_pattern: NUMBER | STRING_LIT | TRUE | FALSE
struct_pattern: CNAME ["{" match_field ("," match_field)* [","] "}"]
match_field: CNAME [":" match_pattern]

// ── Function type ───────────────────────────────────

fn_type: FN "(" [type ("," type)*] ")" "->" type

// ── Optional chain ──────────────────────────────────

optional_chain: "?." CNAME ["(" [call_args] ")"]   // obj?.field or obj?.method()
              | "?" index                            // obj?.[idx]

// ── Spread expression ───────────────────────────────

spread_expr: "..." expr

// ── Template strings ────────────────────────────────

// Template strings are tokenized as a single terminal to avoid LALR ambiguity.
// Interpolation (${expr}) is handled in the transformer via post-processing.
template_string: TEMPLATE_STRING

// ── Ternary / if-expr ───────────────────────────────

if_expr: "if" expr "{" expr "}" "else" "{" expr "}"

var_ref: CNAME
struct_lit: CNAME "{" struct_lit_field ("," struct_lit_field)* [","] "}"

method_call: DOT CNAME "(" [call_args] ")"
func_call: "(" [call_args] ")"
call_args: expr ("," expr)*

// ── Struct definition ───────────────────────────────

struct_def: ["nominal"] "struct" CNAME ["<" generic_params ">"] "{" struct_field* "}"
struct_field: CNAME ":" type ","?

// ── Tagged union definition ──────────────────────────

tagged_union_def: "type" CNAME ["<" generic_params ">"] "=" variant ("|" variant)*
variant: CNAME ["{" struct_field* "}"]

impl_block: "impl" CNAME ["<" generic_params ">"] "{" function_def* "}"

// ── Class definition ────────────────────────────────

class_def: "class" CNAME [extends_clause] [implements_clause] "{" class_member* "}"
extends_clause: "extends" CNAME
implements_clause: "implements" CNAME ("," CNAME)*
class_member: [STATIC] [PRIVATE] CNAME ":" type ["=" expr] ";"
            | [OVERRIDE] FN CNAME "(" [params] ")" ["->" return_type] block
STATIC: "static"
PRIVATE: "private"
OVERRIDE: "@override"

// ── Struct literal (merged with cname_expr for LALR compat) ──

struct_lit_field: CNAME ":" expr

// ── Literals ────────────────────────────────────────

?literal: array_lit | map_lit | bool_lit -> literal_bool | string_lit -> literal_string
        | number_lit -> literal_number

bool_lit: TRUE | FALSE
TRUE: "true"
FALSE: "false"
string_lit: STRING_LIT
number_lit: NUMBER

array_lit: "[" [expr ("," expr)* [","] ] "]"
map_lit: "{" map_entry ("," map_entry)* [","] "}"   // must have at least one entry
map_entry: expr ":" expr

// ── Operators ───────────────────────────────────────

ASSIGN_OP: "=" | "+=" | "-=" | "*=" | "/=" | "%="
COMP_OP: "==" | "!=" | "<" | ">" | "<=" | ">="
ADD_OP: "+" | "-"
MUL_OP: "*" | "/" | "%"
UNARY_OP: "-" | "!"
OR: "||"
PIPE: "|"
ARROW: "=>"

// ── Terminals ───────────────────────────────────────

NUMBER: /0[xX][0-9a-fA-F]+/ | /0[oO][0-7]+/ | /0[bB][01]+/ | /\d+\.\d+([eE][+-]?\d+)?/ | /\d+[eE][+-]?\d+/ | /\d+/
DOT: "."
STRING_LIT: /"(?:[^"\\]|\\.)*"/
TEMPLATE_STRING: /`(?:[^`\\]|\\.)*`/

CNAME: /[a-zA-Z_][a-zA-Z0-9_]*/

// ── Whitespace and comments ─────────────────────────

%import common.WS
%ignore WS
%ignore COMMENT_SINGLE
%ignore COMMENT_BLOCK

COMMENT_SINGLE: /\/\/[^\n]*/
COMMENT_BLOCK: /\/\*[\s\S]*?\*\//
