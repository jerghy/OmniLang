// OmniLang/OmniView shared core terminals and operators
// Imported by both omnilang.lark and omniview/grammar.lark

// ── Literal Keywords ──────────────────────────────────

TRUE: "true"
FALSE: "false"

// ── Operators ─────────────────────────────────────────

ASSIGN_OP: "=" | "+=" | "-=" | "*=" | "/=" | "%="
COMP_OP: "==" | "!=" | "<" | ">" | "<=" | ">="
ADD_OP: "+" | "-"
MUL_OP: "*" | "/" | "%"
UNARY_OP: "-" | "!"
AND: "&&"
OR: "||"
DOT: "."

// ── Terminals ─────────────────────────────────────────

NUMBER: /0[xX][0-9a-fA-F]+/ | /0[oO][0-7]+/ | /0[bB][01]+/
      | /\d+\.\d+([eE][+-]?\d+)?/ | /\d+[eE][+-]?\d+/ | /\d+/
STRING_LIT: /"(?:[^"\\]|\\.)*"/
TEMPLATE_STRING: /`(?:[^`\\]|\\.)*`/

CNAME: /[a-zA-Z_][a-zA-Z0-9_]*/

// ── Whitespace and Comments ───────────────────────────

%import common.WS
%ignore WS
%ignore COMMENT_SINGLE
%ignore COMMENT_BLOCK

COMMENT_SINGLE: /\/\/[^\n]*/
COMMENT_BLOCK: /\/\*[\s\S]*?\*\//
