/// Immutable state for AppStore.
class AppStoreState {
    final int count;

    const AppStoreState({
        required this.count,
    });

    @override
    bool operator ==(Object other) =>
        identical(this, other) ||
        other is AppStoreState &&
        runtimeType == other.runtimeType &&
        count == other.count;

    @override
    int get hashCode => count.hashCode;

    static const _unset = Object();

    AppStoreState copyWith({
        Object? count = _unset,
    }) {
        return AppStoreState(
            count: count == _unset ? this.count : count as int,
        );
    }
}

/// Riverpod 3.0 Notifier for AppStore.
