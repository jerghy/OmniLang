// Generated by OmniLang — Store: AppStore

import 'package:flutter/material.dart';

class AppStore extends ChangeNotifier {
    int count = 0;

    AppStore() {
        this.count = 0;
    }

    void increment() {
        setState(() {
            count += 1;
        });
        notifyListeners();
    }

    void setCount(int value) {
        this.count = value;
        notifyListeners();
    }
}
