// Generated by OmniLang — React target

import React, { useEffect } from 'react';
import { animate } from "@omni/animation";

export function MotionScroll() {
    // -- Motion definitions --
    const _M={
        fadeScroll:{kf:[{offset:0,properties:{"opacity":0.3}},{offset:1,properties:{"opacity":1}}],opts:{duration:500,easing:"ease-out",fill:"forwards"}},
    };

    // @enter: mount animations + MutationObserver for conditional rendering
    useEffect(()=>{
        const runEnter=el=>{
            const n=el.getAttribute('data-motion-name');
            if(n&&_M[n]){
                const{kf,opts}=_M[n];
                animate(el,kf,opts);
            }
        };
        document.querySelectorAll('[data-motion-enter]').forEach(runEnter);
        const obs=new MutationObserver(muts=>{
            muts.forEach(mut=>{
                mut.addedNodes.forEach(node=>{
                    if(node.nodeType===1){
                        if(node.matches&&node.matches('[data-motion-enter]'))runEnter(node);
                        if(node.querySelectorAll)node.querySelectorAll('[data-motion-enter]').forEach(runEnter);
                    }
                });
            });
        });
        obs.observe(document.body,{childList:true,subtree:true});
        return()=>obs.disconnect();
    },[]);

    // @hover/@press: interactive triggers with cleanup + MutationObserver
    useEffect(()=>{
        const hoverHandlers=[];
        const pressHandlers=[];
        const setupHover=el=>{
            const n=el.getAttribute('data-motion-hover-name');
            if(n&&_M[n]){
                const{kf,opts}=_M[n];
                const enter=()=>animate(el,kf,opts);
                const leave=()=>animate(el,[...kf].reverse(),opts);
                el.addEventListener('mouseenter',enter);
                el.addEventListener('mouseleave',leave);
                hoverHandlers.push({el,enter,leave});
            }
        };
        const setupPress=el=>{
            const n=el.getAttribute('data-motion-press-name');
            if(n&&_M[n]){
                const{kf,opts}=_M[n];
                const down=()=>animate(el,kf,opts);
                const up=()=>animate(el,[...kf].reverse(),opts);
                el.addEventListener('mousedown',down);
                el.addEventListener('mouseup',up);
                pressHandlers.push({el,down,up});
            }
        };
        document.querySelectorAll('[data-motion-hover]').forEach(setupHover);
        document.querySelectorAll('[data-motion-press]').forEach(setupPress);
        const obs=new MutationObserver(muts=>{
            muts.forEach(mut=>{
                mut.addedNodes.forEach(node=>{
                    if(node.nodeType===1){
                        if(node.matches&&node.matches('[data-motion-hover]'))setupHover(node);
                        if(node.matches&&node.matches('[data-motion-press]'))setupPress(node);
                        if(node.querySelectorAll){
                            node.querySelectorAll('[data-motion-hover]').forEach(setupHover);
                            node.querySelectorAll('[data-motion-press]').forEach(setupPress);
                        }
                    }
                });
            });
        });
        obs.observe(document.body,{childList:true,subtree:true});
        return()=>{
            hoverHandlers.forEach(({el,enter,leave})=>{
                el.removeEventListener('mouseenter',enter);
                el.removeEventListener('mouseleave',leave);
            });
            pressHandlers.forEach(({el,down,up})=>{
                el.removeEventListener('mousedown',down);
                el.removeEventListener('mouseup',up);
            });
            obs.disconnect();
        };
    },[]);
    // @scroll: scroll-driven animation progress + MutationObserver
    useEffect(() => {
        var els = document.querySelectorAll('[data-motion-scroll]');
        function parseScrollTrigger(cfg, el, vh) {
            if (!cfg || typeof cfg !== 'string') return 0;
            const parts = cfg.split(' ');
            if (parts.length < 2) return 0;
            const edge = parts[0];
            const offset = parts[1];
            const elRect = el.getBoundingClientRect();
            let elPos;
            if (edge === 'top') elPos = elRect.top;
            else if (edge === 'center') elPos = elRect.top + elRect.height / 2;
            else if (edge === 'bottom') elPos = elRect.bottom;
            else elPos = elRect.top;
            if (offset.endsWith('%')) {
                return window.scrollY + elPos - vh * (parseFloat(offset) / 100);
            } else if (offset === 'bottom') {
                return window.scrollY + elPos - vh;
            } else if (offset === 'top') {
                return window.scrollY + elPos;
            }
            return window.scrollY + elPos - vh * 0.5;
        }
        function computeProgress(el) {
            const vh = window.innerHeight;
            const startCfg = el.getAttribute('data-scroll-start') || 'top 80%';
            const endCfg = el.getAttribute('data-scroll-end') || 'bottom 20%';
            const startPos = parseScrollTrigger(startCfg, el, vh);
            const endPos = parseScrollTrigger(endCfg, el, vh);
            const raw = (window.scrollY - startPos) / (endPos - startPos);
            return Math.max(0, Math.min(1, raw));
        }
        function scrubValue(el, target) {
            const delay = parseFloat(el.getAttribute('data-scroll-scrub') || '0');
            if (delay > 0) {
                return (scrubCache.get(el) || 0) + (target - (scrubCache.get(el) || 0)) * Math.min(1, 16.67 / (delay * 1000));
            }
            return target;
        }
        var scrubCache = new Map();
        const handleScroll = () => {
            els.forEach(el => {
                const target = computeProgress(el);
                const scrubbed = scrubValue(el, target);
                scrubCache.set(el, scrubbed);
                const anims = el.getAnimations();
                anims.forEach(a => {
                    const duration = a.effect?.getTiming()?.duration || 300;
                    a.currentTime = scrubbed * duration;
                });
            });
        };
        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll();
        const obs = new MutationObserver(muts => {
            muts.forEach(mut => {
                mut.addedNodes.forEach(node => {
                    if (node.nodeType === 1) {
                        if (node.matches && node.matches('[data-motion-scroll]')) els = document.querySelectorAll('[data-motion-scroll]');
                        if (node.querySelectorAll && node.querySelectorAll('[data-motion-scroll]').length) els = document.querySelectorAll('[data-motion-scroll]');
                    }
                });
            });
        });
        obs.observe(document.body, { childList: true, subtree: true });
        return () => { window.removeEventListener('scroll', handleScroll); obs.disconnect(); };
    }, []);

    return (
        <div>
            <div
                data-motion-scroll="true"
                data-scroll-start="top 80%"
                data-scroll-end="bottom 20%"
                data-scroll-scrub="0"
            >
                <p>
                    {'Scroll-driven animation'}
                </p>
            </div>
        </div>
    );
}
