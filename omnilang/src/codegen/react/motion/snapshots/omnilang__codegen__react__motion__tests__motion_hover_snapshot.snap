// Generated by OmniLang — React target

import React, { useEffect } from 'react';
import { animate } from "@omni/animation";

export function MotionHover() {
    // -- Motion definitions --
    const _M={
        pulse:{kf:[{offset:0,properties:{}},{offset:1,properties:{"scale":1.05}}],opts:{duration:200,easing:"ease-out",fill:"forwards"}},
    };

    // @enter: mount animations + MutationObserver for conditional rendering
    useEffect(()=>{
        const runEnter=el=>{
            const n=el.getAttribute('data-motion-name');
            if(n&&_M[n]){
                const{kf,opts}=_M[n];
                animate(el,kf,opts);
            }
        };
        document.querySelectorAll('[data-motion-enter]').forEach(runEnter);
        const obs=new MutationObserver(muts=>{
            muts.forEach(mut=>{
                mut.addedNodes.forEach(node=>{
                    if(node.nodeType===1){
                        if(node.matches&&node.matches('[data-motion-enter]'))runEnter(node);
                        if(node.querySelectorAll)node.querySelectorAll('[data-motion-enter]').forEach(runEnter);
                    }
                });
            });
        });
        obs.observe(document.body,{childList:true,subtree:true});
        return()=>obs.disconnect();
    },[]);

    // @hover/@press: interactive triggers with cleanup + MutationObserver
    useEffect(()=>{
        const hoverHandlers=[];
        const pressHandlers=[];
        const setupHover=el=>{
            const n=el.getAttribute('data-motion-hover-name');
            if(n&&_M[n]){
                const{kf,opts}=_M[n];
                const enter=()=>animate(el,kf,opts);
                const leave=()=>animate(el,[...kf].reverse(),opts);
                el.addEventListener('mouseenter',enter);
                el.addEventListener('mouseleave',leave);
                hoverHandlers.push({el,enter,leave});
            }
        };
        const setupPress=el=>{
            const n=el.getAttribute('data-motion-press-name');
            if(n&&_M[n]){
                const{kf,opts}=_M[n];
                const down=()=>animate(el,kf,opts);
                const up=()=>animate(el,[...kf].reverse(),opts);
                el.addEventListener('mousedown',down);
                el.addEventListener('mouseup',up);
                pressHandlers.push({el,down,up});
            }
        };
        document.querySelectorAll('[data-motion-hover]').forEach(setupHover);
        document.querySelectorAll('[data-motion-press]').forEach(setupPress);
        const obs=new MutationObserver(muts=>{
            muts.forEach(mut=>{
                mut.addedNodes.forEach(node=>{
                    if(node.nodeType===1){
                        if(node.matches&&node.matches('[data-motion-hover]'))setupHover(node);
                        if(node.matches&&node.matches('[data-motion-press]'))setupPress(node);
                        if(node.querySelectorAll){
                            node.querySelectorAll('[data-motion-hover]').forEach(setupHover);
                            node.querySelectorAll('[data-motion-press]').forEach(setupPress);
                        }
                    }
                });
            });
        });
        obs.observe(document.body,{childList:true,subtree:true});
        return()=>{
            hoverHandlers.forEach(({el,enter,leave})=>{
                el.removeEventListener('mouseenter',enter);
                el.removeEventListener('mouseleave',leave);
            });
            pressHandlers.forEach(({el,down,up})=>{
                el.removeEventListener('mousedown',down);
                el.removeEventListener('mouseup',up);
            });
            obs.disconnect();
        };
    },[]);

    return (
        <div>
            <button
                data-motion-hover="true"
                data-motion-hover-name="pulse"
                type="button"
            >
                {'Hover Me'}
            </button>
        </div>
    );
}
