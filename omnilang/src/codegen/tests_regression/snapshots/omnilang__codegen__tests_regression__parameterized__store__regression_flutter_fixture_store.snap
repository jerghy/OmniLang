// Generated by OmniLang — Store: AppStore

import 'package:flutter_riverpod/flutter_riverpod.dart';

// — Signal providers —
final appStoreCountProvider = StateProvider<int>((ref) => 0);

final appStoreDoubleCountProvider = Provider<dynamic>((ref) {
    final count = ref.watch(appStoreCountProvider);
    return count * 2;
});

// — Action functions —
void appStoreIncrement(WidgetRef ref) {
    ref.read(appStoreCountProvider.notifier).state += 1;
}
