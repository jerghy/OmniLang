  // characters during CSS tokenization (CSS Syntax §4.3.7), so
  // "jav\r\nascript:" would be normalized by the browser to "javascript:".
  // This mirrors the same normalization in __omni_sanitizeUrl.
  str = str.replace(/[\r\n\t]/g, '');
