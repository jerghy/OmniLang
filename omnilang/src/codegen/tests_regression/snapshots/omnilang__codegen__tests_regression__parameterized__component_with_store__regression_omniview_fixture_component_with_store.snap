  // literal LF (\d a CR, \9 a TAB) here. Without this second strip,
  // "java\ascript:" — decoded to "java\nscript:" — would bypass the
  // keyword checks below. Mirrors sanitize_css_value in sanitize.rs.
  str = str.replace(/[\r\n\t]/g, '');
