import 'package:flutter/material.dart';

import './AppStore_store.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';


class CounterWithStore extends ConsumerStatefulWidget {
    const CounterWithStore({super.key});

    @override
    ConsumerState<CounterWithStore> createState() => _CounterWithStoreState();
}

class _CounterWithStoreState extends ConsumerState<CounterWithStore> {
    @override
    Widget build(BuildContext context) {
        return Container(children: [Text('Count: '), Text(ref.watch(appStoreProvider.select(((s) => s.count))))]);
    }
}
