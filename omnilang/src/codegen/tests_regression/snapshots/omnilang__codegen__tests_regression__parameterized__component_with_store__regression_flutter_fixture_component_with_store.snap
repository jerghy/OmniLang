// Generated by OmniLang — Store: AppStore

import 'package:flutter_riverpod/flutter_riverpod.dart';

/// Immutable state for AppStore.
class AppStoreState {
    final int count;

    const AppStoreState({
        required this.count,
    });

    AppStoreState copyWith({
        int? count,
    }) {
        return AppStoreState(
            count: count ?? this.count,
        );
    }
}

/// Riverpod 3.0 Notifier for AppStore.
class AppStore extends Notifier<AppStoreState> {
    @override
    AppStoreState build() {
        return const AppStoreState(count: 0);
    }

    void increment() {
        state = state.copyWith(count: state.count + 1);
    }

}

final appStoreProvider = NotifierProvider<AppStore, AppStoreState>(AppStore.new);
