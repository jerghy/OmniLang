// Generated by OmniLang — Zustand store: useAppStore
import { create } from 'zustand';

interface AppStoreState {
  count: number;
  increment: () => void;
}

export const useAppStore = create<AppStoreState>()((set, get) => ({
    count: 0,
    increment: () => {
        const state = get();
        set({ count: state.count + 1 });
    },
}));
