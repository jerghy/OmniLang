// Generated by OmniLang — React target

import { useAppStore } from './useAppStore';

export function CounterWithStore() {
    const AppStore = useAppStore();

    return (
        <div
            onClick={() => { AppStore.increment(); }}
        >
            {'Count: '}
            {AppStore.count}
        </div>
    );
}

