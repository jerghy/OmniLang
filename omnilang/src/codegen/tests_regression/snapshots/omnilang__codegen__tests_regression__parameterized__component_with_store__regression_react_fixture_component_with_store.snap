// Generated by OmniLang — React target

import { useAppStore } from './useAppStore';

export function CounterWithStore() {
    const count = useAppStore((s) => s.count);
    const increment = useAppStore((s) => s.increment);

    return (
        <div
            onClick={() => { increment(); }}
        >
            {'Count: '}
            {count}
        </div>
    );
}

