// Generated by OmniLang — Zustand store: useAppStore
import { create } from 'zustand';

interface AppStoreState {
  count: number;
  readonly doubleCount: any;
  increment: () => void;
}

export const useAppStore = create<AppStoreState>()((set, get) => ({
    count: 0,
    get doubleCount() { return get().count * 2; },
    increment: () => {
        const state = get();
        set({ count: state.count + 1 });
    },
}));

export function useCount() {
    return useAppStore((s) => s.count);
}

export function useDoubleCount() {
    return useAppStore((s) => s.doubleCount);
}

export function useIncrement() {
    return useAppStore((s) => s.increment);
}
