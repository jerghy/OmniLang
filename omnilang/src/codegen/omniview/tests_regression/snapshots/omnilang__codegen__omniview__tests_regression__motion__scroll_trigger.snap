// === mount_js ===

// === js ===
/// ─── Shared scroll handler — single listener for all @scroll triggers
var __omni_scrollElements = [];
var __omni_scrollHandler = null;
/// Progress target for one @scroll entry: numeric start/end range
/// when given (Task 5.1), otherwise the legacy viewport-relative
/// string configs resolved by Omni.scrollProgress.
function __omni_scrollTarget(entry) {
  if (entry.startPos !== undefined && entry.endPos !== undefined) {
   var raw = (window.scrollY - entry.startPos) / (entry.endPos - entry.startPos);
   return Math.max(0, Math.min(1, raw));
  }
  return Omni.scrollProgress(entry.el, entry.startCfg, entry.endCfg);
}
function __omni_ensureScrollHandler() {
  if (__omni_scrollHandler) return;
  __omni_scrollHandler = function() {
   __omni_scrollElements.forEach(function(entry) {
    var el = entry.el;
    var anim = entry.anim;
    var dur = entry.dur;
    var target = __omni_scrollTarget(entry);
    if (entry.scrubDelay > 0) {
     entry.currentProgress += (target - entry.currentProgress) * Math.min(1, 16.67 / (entry.scrubDelay * 1000));
     anim.currentTime = entry.currentProgress * dur;
    } else {
     entry.currentProgress = target;
     anim.currentTime = target * dur;
    }
   });
  };
  window.addEventListener('scroll', __omni_scrollHandler, { passive: true });
}
function __omni_scrollRemoveEntry(nid) {
  var el = __omni_el(nid);
  if (!el || !__omni_scrollElements) return;
  __omni_scrollElements = __omni_scrollElements.filter(function(entry) {
   return entry.el !== el;
  });
}

// @scroll trigger
(function() {
  const el = __omni_el("el-scroll-001");
  if (!el) return;
  const anim = __omni_motion_fadeIn(el, { trigger: "scroll" });
  if (!__omni_animations.has("el-scroll-001")) __omni_animations.set("el-scroll-001", new Map());
  __omni_animations.get("el-scroll-001").set("scroll", anim);
  anim.pause();
  const dur = anim.effect?.getTiming()?.duration || 300;
  __omni_scrollElements.push({
   el,
   anim,
   dur,
   startCfg: "top 80%",
   endCfg: "bottom 20%",
   scrubDelay: true,
   currentProgress: 0,
startPos: 0,
endPos: 500,
  });
  __omni_ensureScrollHandler();
  anim.currentTime = __omni_scrollTarget(__omni_scrollElements[__omni_scrollElements.length - 1]) * dur;
})();
