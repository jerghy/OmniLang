// @focus trigger
(function() {
  const el = __omni_el("el-input-003");
  if (el) {
   const anim = __omni_motion_pulse(el, { trigger: "focus" });
   if (!__omni_animations.has("el-input-003")) __omni_animations.set("el-input-003", new Map());
   __omni_animations.get("el-input-003").set("focus", anim);
   el.addEventListener("focusin", function() { var a = __omni_animations.get("el-input-003")?.get("focus"); if (a) { if (a.playState === "reversed") { a.reverse(); } else { a.play(); } } });
   el.addEventListener("focusout", function() { var a = __omni_animations.get("el-input-003")?.get("focus"); if (a) { if (a.effect && a.effect.getTiming && a.effect.getTiming().iterations === Infinity) { a.pause(); } else { a.reverse(); } } });
  }
})();
