function __omni_signal(name, init) {
  let val = init;
  const subs = new Set();
  const signal = {
    _default: init,
    get value() {
      if (__omni_activeEffect) {
        subs.add(__omni_activeEffect);
        __omni_activeEffect._deps.add(() => subs.delete(__omni_activeEffect));
