// counter.omni — signal 声明、修改、computed 计算；点击按钮验证文本变化

component Counter {
    signal count: i32 = 0;
    computed label: String = "Count: " + count;

    view {
        <Container>
            <Text test-id="counter-label">{label}</Text>
            <Button onPress={fn() { count = count + 1; }} test-id="btn-increment">
                +1
            </Button>
            <Button onPress={fn() { count = count - 1; }} test-id="btn-decrement">
                -1
            </Button>
            <Button onPress={fn() { count = 0; }} test-id="btn-reset">
                Reset
            </Button>
        </Container>
    }
}
