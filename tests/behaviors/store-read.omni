// store-read.omni — Store signal 读取和精确订阅

store TestStore {
    signal message: String = "Hello";
    signal count: i32 = 0;

    getter info: String = message;

    action update_message(text: String) {
        message = text;
    }

    action increment() {
        count = count + 1;
    }
}

component StoreRead {
    @store TestStore;

    view {
        <Container>
            <Text test-id="store-message">{store.message}</Text>
            <Text test-id="store-count">{store.count}</Text>
            <Button onPress={fn() { store.increment(); }} test-id="btn-inc">
                +1
            </Button>
        </Container>
    }
}
