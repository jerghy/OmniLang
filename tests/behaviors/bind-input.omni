// bind-input.omni — bind:value 双向绑定；验证输入→状态→输出同步

component BindInput {
    signal text: String = "";

    view {
        <Container>
            <Input bind:value={text} placeholder="Type here" test-id="input-field" />
            <Text test-id="output-label">{text}</Text>
            <Button onPress={fn() { text = ""; }} test-id="btn-clear">
                Clear
            </Button>
        </Container>
    }
}
