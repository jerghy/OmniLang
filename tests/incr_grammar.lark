// Incremental v0.2 grammar built on v0.1 base

start: program

// ── Top Level ───────────────────────────────────────

program: function_def*

function_def: "fn" CNAME "(" [params] ")" ["->" return_type] block

params: param ("," param)*
param: CNAME ":" type
return_type: type

// ── Types ───────────────────────────────────────────

type: base_type ("<" type_args ">")? ("|" type ("|" type)*)?
base_type: TYPE_NAME
type_args: type ("," type)*

TYPE_NAME: "i32" | "f64" | "bool" | "String" | "Array" | "Map" | "void"

// ── Statements ──────────────────────────────────────

stmt: var_decl
    | assign
    | if_stmt
    | while_stmt
    | for_stmt
    | break_stmt
    | continue_stmt
    | return_stmt
    | print_stmt
    | expr_stmt
    | block_stmt

var_decl: LET_KW [MUT_KW] CNAME ":" type "=" expr ";"
LET_KW: "let"
MUT_KW: "mut"
assign: CNAME index? ASSIGN_OP expr ";"
if_stmt: "if" expr block else_tail?
else_tail: "else" (if_stmt | block)
while_stmt: "while" expr block
for_stmt: "for" CNAME "in" expr block
break_stmt: "break" ";"
continue_stmt: "continue" ";"
return_stmt: "return" [expr] ";"
print_stmt: "println" "(" expr ")" ";" -> println_stmt
          | "print" "(" expr ")" ";"
expr_stmt: expr ";"
block_stmt: block

// ── Block with optional trailing expression ─────────

block: "{" body_contents "}"
body_contents: (stmt* [expr_no_semi])?
expr_no_semi: expr   // no trailing semicolon, only valid at end of block

// ── Index ───────────────────────────────────────────

index: "[" expr "]"

// ── Expressions ─────────────────────────────────────

?expr: or_expr

?or_expr: and_expr ("||" and_expr)*
?and_expr: comp_expr ("&&" comp_expr)*
?comp_expr: add_expr (COMP_OP add_expr)*
?add_expr: mul_expr (ADD_OP mul_expr)*
?mul_expr: unary_expr (MUL_OP unary_expr)*
?unary_expr: UNARY_OP unary_expr | postfix_expr
?postfix_expr: atom_expr (method_call | func_call | index)*
?atom_expr: literal | if_expr | var_ref | "(" expr ")"

if_expr: "if" expr "{" expr "}" "else" "{" expr "}"
var_ref: CNAME
method_call: DOT CNAME "(" [call_args] ")"
func_call: "(" [call_args] ")"
call_args: expr ("," expr)*

?literal: array_lit | map_lit | bool_lit -> literal_bool | string_lit -> literal_string
        | number_lit -> literal_number

bool_lit: TRUE | FALSE
TRUE: "true"
FALSE: "false"
string_lit: STRING_LIT
number_lit: NUMBER

array_lit: "[" [expr ("," expr)* [","] ] "]"
map_lit: "{" map_entry ("," map_entry)* [","] "}"   // must have at least one entry
map_entry: expr ":" expr

// ── Operators ───────────────────────────────────────

ASSIGN_OP: "=" | "+=" | "-=" | "*=" | "/=" | "%="
COMP_OP: "==" | "!=" | "<" | ">" | "<=" | ">="
ADD_OP: "+" | "-"
MUL_OP: "*" | "/" | "%"
UNARY_OP: "-" | "!"

// ── Terminals ───────────────────────────────────────

NUMBER: /0[xX][0-9a-fA-F]+/ | /0[oO][0-7]+/ | /0[bB][01]+/ | /\d+\.\d+([eE][+-]?\d+)?/ | /\d+[eE][+-]?\d+/ | /\d+/
DOT: "."
STRING_LIT: /"(?:[^"\]|\.)*"/

CNAME: /[a-zA-Z_][a-zA-Z0-9_]*/

// ── Whitespace and comments ─────────────────────────

%import common.WS
%ignore WS
%ignore COMMENT_SINGLE
%ignore COMMENT_BLOCK

COMMENT_SINGLE: /\/\/[^\n]*/
COMMENT_BLOCK: /\/\*[\s\S]*?\*\//
