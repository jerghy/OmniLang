// Behavior Test 02: List Rendering — @for loop + key
// Tests: @for + @empty + event in loop + key
component TodoList {
  signal items: Array<String> = ["Buy milk", "Walk dog"];
  signal new_item: String = "";

  fn add_item() {
    items = [...items, new_item];
    new_item = "";
  }

  fn remove_item(index: i32) {
    // Filter out item at index (simplified — real impl would use filter)
    new_item = "";
  }

  view {
    <Container>
      <Heading level="2" test-id="list-title">Todo List</Heading>
      <Flex direction="row" gap="8px">
        <Input bind:value={new_item} placeholder="Add item..." test-id="input-new" />
        <Button onPress={add_item} test-id="btn-add">Add</Button>
      </Flex>
      <List test-id="item-list">
        @for item in items {
          <ListItem key={item} test-id="list-item">
            <Text>{item}</Text>
          </ListItem>
        }
        @empty {
          <Text test-id="empty-message">No items yet</Text>
        }
      </List>
      <Text test-id="item-count">Total: {items.length}</Text>
    </Container>
  }
}
