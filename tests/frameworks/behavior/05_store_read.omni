// Behavior Test 05: Store Read — store getter + action call
// Tests: store signal + getter + action + component store access
store UserStore {
  signal username: String = "Guest";
  signal login_count: i32 = 0;
  getter display_name: String = username;

  action login(name: String) {
    username = name;
    login_count = login_count + 1;
  }

  action logout() {
    username = "Guest";
  }
}

component UserProfile {
  @store UserStore;
  signal input_name: String = "";

  fn handle_login() {
    store.login(input_name);
    input_name = "";
  }

  fn handle_logout() {
    store.logout();
  }

  view {
    <Container>
      <Heading level="2" test-id="welcome">Welcome, {store.display_name}!</Heading>
      <Text test-id="login-count">Logins: {store.login_count}</Text>
      <Flex direction="row" gap="8px">
        <Input bind:value={input_name} placeholder="Enter name" test-id="input-name" />
        <Button onPress={handle_login} test-id="btn-login">Login</Button>
        <Button onPress={handle_logout} test-id="btn-logout">Logout</Button>
      </Flex>
    </Container>
  }
}
