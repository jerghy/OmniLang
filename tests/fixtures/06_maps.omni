fn main() {
    let m: Map<String, i32> = {"a": 1, "b": 2};
    println(m.len().to_string());
    println(m.is_empty().to_string());

    let v: i32 = m.get("a");
    println(v.to_string());

    println(m.contains("b").to_string());

    let mut m2: Map<i32, String> = {1: "one"};
    m2.insert(2, "two");
    println(m2.len().to_string());
    println(m2.get(2));

    m2[3] = "three";
    println(m2[3]);
}
