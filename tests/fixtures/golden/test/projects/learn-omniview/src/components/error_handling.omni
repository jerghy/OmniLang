// ── 1. safe_divide —— throw 语句演示 ────────────────────────────

pub fn safe_divide(a: f64, b: f64) -> f64 {
    if b == 0.0 {
        throw "division by zero";
    }
    return a / b;
}

// ── 2. try_catch_divide —— try/catch 演示 ──────────────────────

pub fn try_catch_divide(a: f64, b: f64) -> String {
    try {
        let result = safe_divide(a, b);
        return "result: " + result.to_string();
    } catch err {
        return "error: " + err;
    }
}

// ── 3. try_catch_finally_divide —— try/catch/finally 演示 ─────

pub fn try_catch_finally_divide(a: f64, b: f64) -> String {
    let mut status = "";
    try {
        let result = safe_divide(a, b);
        status = "ok";
        return "result: " + result.to_string();
    } catch err {
        status = "failed";
        return "error: " + err;
    } finally {
        // finally 总是执行，此处仅用 print 验证（不改变返回值）
        print("finally: division attempted, status=" + status);
    }
}

// ── 4. parse_config —— Map<K,V> 类型注解演示 ───────────────────

pub fn parse_config(raw: String) -> Map<String, String> {
    let mut map: Map<String, String> = {};
    if raw != "" {
        map.set("parsed", "true");
        map.set("length", raw.len().to_string());
    }
    return map;
}

// ── 5. get_or_throw —— Map<K,V> + try/catch 组合 ──────────────

pub fn get_or_throw(map: Map<String, String>, key: String) -> String {
    if map.contains(key) {
        return map.get(key);
    }
    throw "key not found: " + key;
}

// ── 6. safe_get —— 包装 get_or_throw 用 try/catch ──────────────

pub fn safe_get(map: Map<String, String>, key: String) -> String {
    try {
        return get_or_throw(map, key);
    } catch err {
        return "fallback:" + err;
    }
}

// ── 7. try_catch_as_expr —— try/catch 作为表达式使用 ──────────



// ── 8. complex_parse —— 综合示例 ────────────────────────────────

pub fn complex_parse(key: String, raw: String) -> String {
    let config = parse_config(raw);
    try {
        let value = get_or_throw(config, key);
        return "found: " + value;
    } catch err {
        return "not found: " + err;
    } finally {
        print("parse complete for key=" + key);
    }
}
