// ╔══════════════════════════════════════════════════════════════════╗
// ║  SlotDefaultDemo.omni — @slot 默认回退内容                         ║
// ║                                                                  ║
// ║  插槽在组件体内声明（body-level），view 中用 {name} / {children}   ║
// ║  插值标记投影位置：                                                ║
// ║    @slot name { 默认内容 }   — 命名插槽 + 回退                     ║
// ║    @slot { 默认内容 }        — 匿名插槽 + 回退                     ║
// ║    @slot name                — 无默认值的插槽                      ║
// ║                                                                  ║
// ║  消费者用命名属性投影命名插槽（name={<.../>}），匿名插槽由           ║
// ║  子元素隐式投影：                                                  ║
// ║    <SlotPanel header={<div>...</div>}>...</SlotPanel>             ║
// ╚══════════════════════════════════════════════════════════════════╝

import omniview;

// ── SlotPanel: 接收插槽的组件 ──────────────────────────
component SlotPanel {
    // Body-level slot declarations with fallback content;
    // the view references them via {header} / {children} / {footer}.
    @slot header {
        <span class: DefaultText>Default Header (来自 header 插槽声明的回退)</span>
    }
    @slot {
        <p class: DefaultText>Default Body — 这是匿名插槽的默认回退内容</p>
    }
    @slot footer

    view {
        <div class: SlotPanel>
            <div class: slot-section>
                <span class: SectionLabel>header slot:</span>
                {header}
            </div>

            <div class: slot-section main>
                <span class: SectionLabel>main slot:</span>
                {children}
            </div>

            <div class: slot-section>
                <span class: SectionLabel>footer slot:</span>
                {footer}
            </div>
        </div>
    }
    style {
        .slot-section { margin-bottom: 10px; padding: 10px; background: #f8fafc; border-radius: 6px; border: 1px dashed #cbd5e1; }
        .slot-section.main { background: #f0f9ff; border-color: #bae6fd; }
    }
}

// ── 主演示组件 ──────────────────────────────────────
component SlotDefaultDemo {
    signal useCustomContent: bool = false;

    fn toggleContent() { useCustomContent = !useCustomContent; }

    view {
        <div class: Wrapper>
            <h3 class: SectionHeader>Slot Default Content (回退内容)</h3>
            <p class: subtitle>
                演示插槽默认回退内容语法 + 对比有/无自定义内容
            </p>

            <!-- 演示区 1: 使用默认回退（无自定义插槽内容） -->
            <div class: DemoCardPanel>
                <h4 class: DemoLabel>① Using Default Slot Content</h4>
                <p class: DemoDesc>
                    消费者<strong>没有</strong>提供插槽内容 →
                    组件显示 <code>header</code> 插槽声明中定义的默认回退。
                </p>
                <div class: DemoBox>
                    <!-- 没有传入插槽内容，使用默认回退 -->
                    <SlotPanel />
                </div>
            </div>

            <!-- 演示区 2: 提供自定义插槽内容（覆盖默认回退） -->
            <div class: DemoCardPanel>
                <h4 class: DemoLabel>② Overriding Default with Custom Content</h4>
                <p class: DemoDesc>
                    消费者<strong>提供</strong>插槽内容 → 默认回退被覆盖。
                    <code>footer</code> 插槽没有默认值，若未提供则保持空白。
                </p>
                <div class: DemoBox>
                    <!-- 命名属性投影命名插槽；子元素隐式进入匿名插槽 -->
                    <SlotPanel
                        header={<div class: custom-header><span class: CustomIcon>★</span><span>Custom Header — 覆盖了默认回退</span></div>}
                    >
                        <div class: custom-body>
                            <p>Custom Body Content</p>
                            <p class: CustomNote>默认回退已被消费者替代</p>
                        </div>
                        <!-- 不提供 footer → footer 为空（无默认值） -->
                    </SlotPanel>
                </div>
            </div>

            <!-- 演示区 3: 条件切换 -->
            <div class: DemoCardPanel>
                <h4 class: DemoLabel>③ Toggle: With / Without Custom Content</h4>
                <p class: DemoDesc>
                    点击按钮在有/无自定义插槽内容之间切换，
                    观察默认回退的出现和消失。
                </p>
                <button class: ToggleBtn @onPress={toggleContent}>
                    {if useCustomContent { "Reset to Defaults" } else { "Provide Custom Content" }}
                </button>
                <div class: DemoBox ToggleArea>
                    @if useCustomContent {
                        <SlotPanel
                            header={<div class: custom-header alt><span class: CustomIcon>✦</span><span>Custom Header (alt)</span></div>}
                            footer={<div class: CustomFooter><span>提供了 footer 插槽</span></div>}
                        >
                            <p class: custom-body alt>Custom body — 回退已被覆盖</p>
                        </SlotPanel>
                    } @else {
                        <SlotPanel />
                    }
                </div>
            </div>

            <!-- 技术说明 -->
            <div class: TechNote>
                <h4 class: NoteTitle>💡 插槽默认内容语义</h4>
                <ul class: NoteList>
                    <li>如果消费者<strong>没有</strong>为命名的 <code>{"@slot"}</code> 提供内容，显示其默认回退</li>
                    <li>如果消费者<strong>有</strong>提供内容，默认回退被完全替换</li>
                    <li>不带默认值的 <code>{"@slot 声明"}</code>（无回退体）在无内容时渲染空白</li>
                    <li>匿名插槽（不写名字的声明）同样支持默认回退</li>
                    <li>回退内容可以是任意 OmniLang view 模板（元素、文本、插值、条件等）</li>
                </ul>
            </div>
        </div>
    }

    style {
        code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 12px; }
        // Custom content styles
        .custom-header { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: #e0e7ff; border-radius: 6px; font-size: 13px; color: #3730a3; font-weight: 600; }
        .custom-header.alt { background: #fce7f3; color: #9d174d; }
        .custom-body { padding: 10px; background: #dbeafe; border-radius: 6px; font-size: 13px; color: #1e40af; margin: 0; }
        .custom-body.alt { background: #d1fae5; color: #065f46; }
        .NoteList li { font-size: 12px; color: #94a3b8; margin-bottom: 4px; line-height: 1.5; }
    
        .subtitle { font-size: 13px; color: #64748b; margin: 0 0 16px 0; }

    }
}
