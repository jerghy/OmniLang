// ╔══════════════════════════════════════════════════════════════╗
// ║  TypeSystemDemo.omni —— 类型系统演示组件                      ║
// ║  演示：所有整数/浮点类型变体、isize/usize、Void               ║
// ╚══════════════════════════════════════════════════════════════╝

import omniview;

import { demo_i8, demo_i16, demo_i64,
         demo_u8, demo_u16, demo_u32, demo_u64,
         demo_f32, demo_isize, demo_usize,
         demo_void,
         type_system_summary } from "../lib/type_system";

component TypeSystemDemo {
    signal summary: String = "";

    fn loadSummary() {
        summary = type_system_summary();
    }

    @mount {
        loadSummary();
        // Void 演示：无返回值函数调用（输出 "void function called" 到控制台）
        demo_void();
    }

    view {
        <div class: Container>
            <h3 class: Title>类型系统全覆盖</h3>
            <p class: Subtitle>i8 · i16 · i64 · u8 · u16 · u32 · u64 · f32 · isize · usize · Void</p>

            <div class: SectionBox>
                <h4 class: section-title>有符号整数</h4>
                <ul class: List>
                    <li class: Item><code class: Code>i8</code> max = {demo_i8()}</li>
                    <li class: Item><code class: Code>i16</code> max = {demo_i16()}</li>
                    <li class: Item><code class: Code>i64</code> max = {demo_i64()}</li>
                    <li class: Item><code class: Code>isize</code> = {demo_isize()}</li>
                </ul>
            </div>

            <div class: SectionBox>
                <h4 class: section-title>无符号整数</h4>
                <ul class: List>
                    <li class: Item><code class: Code>u8</code> max = {demo_u8()}</li>
                    <li class: Item><code class: Code>u16</code> max = {demo_u16()}</li>
                    <li class: Item><code class: Code>u32</code> max = {demo_u32()}</li>
                    <li class: Item><code class: Code>u64</code> max = {demo_u64()}</li>
                    <li class: Item><code class: Code>usize</code> = {demo_usize()}</li>
                </ul>
            </div>

            <div class: SectionBox>
                <h4 class: section-title>浮点类型</h4>
                <ul class: List>
                    <li class: Item><code class: Code>f32</code> = {demo_f32()}</li>
                </ul>
            </div>

            <div class: SectionBox>
                <h4 class: section-title>Void 类型</h4>
                <ul class: List>
                    <li class: Item><code class: Code>Void</code> demo_void() —— 无返回值函数（挂载时已调用，控制台打印 "void function called"）</li>
                </ul>
            </div>

            <div class: SummaryBox>
                <p class: SummaryText>综合: {summary}</p>
            </div>
        </div>
    }
    style {
    
        .section-title { font-size: 15px; color: #374151; margin: 0 0 8px 0; border-bottom: 1px solid #e5e7eb; padding-bottom: 4px; }
    }
}
