import omniview;
import { LearnDesign } from "../design";

struct Point { x: i32, y: i32, }
struct StatisticsData { name: String, count: i32, percentage: f64, active: bool, }

component FeatureCard {
    signal status: String = "idle";
    signal focusCount: i32 = 0;
    // bind:value 只绑定命名信号 inputText；status 由焦点事件单独驱动
    signal inputText: String = "";

    fn getOriginX() -> i32 {
        let p = Point { x: 0, y: 0 };
        return p.x;
    }

    fn getStats() -> StatisticsData {
        return StatisticsData { name: "demo", count: focusCount, percentage: 75.5, active: true, };
    }

    fn handleFocus() {
        focusCount = focusCount + 1;
        status = "focused";
    }

    fn handleBlur() {
        status = "blurred";
    }

    fn reset() {
        focusCount = 0;
        status = "idle";
    }

    view {
        <div class: LearnDesign.Card>
            <h3 class: LearnDesign.CardTitle>FeatureCard Demo</h3>
            <input class: Input placeholder="Click" bind:value={inputText} @onFocus={handleFocus} @onBlur={handleBlur}></input>
            @if status == "focused" {
                <span class: BadgeFocused>Focused</span>
            }
            @else if status == "blurred" {
                <span class: BadgeBlurred>Blurred</span>
            }
            @else if status == "idle" {
                <span class: BadgeIdle>Idle</span>
            }
            @else {
                <span class: BadgeUnknown>Unknown</span>
            }
            <p class: Text>X: {getOriginX()} | Focus: {focusCount} | Stats: {getStats().name} / {getStats().count} / {getStats().percentage}</p>
            <button variant: LearnDesign.Button(color=ghost, size=md) @onPress={reset}>Reset</button>
        </div>
    }
    style {
        // 状态徽章颜色由 design.omni 提供（BadgeFocused/BadgeBlurred/BadgeIdle/BadgeUnknown）
    }
}
