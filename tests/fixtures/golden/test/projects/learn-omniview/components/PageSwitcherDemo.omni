// PageSwitcherDemo.omni — 导航/路由 demo（批次 2 迁移，spec §8 #1/#2）
// 旧形态：组件根部 @if 互斥 + onSwitch 事件（顶层页面切换）→ 已迁移为
// @route 声明 + navigate() 内建调用（HomePage @route "/home"、AboutPage
// @route "/about"）。
//
// Flutter 目标保挂载差异注记（spec §6 边界 7——v0 标准 ShellRoute）：
// 旧形态的顶层 @if 互斥在 Flutter 发射 IndexedStack——切页时所有页面保持
// 挂载，表单输入/滚动位置不丢失；路由形态下两页为独立 GoRoute，切换走
// context.push/pop，前一页卸载（draft 输入不保留）。页面保挂载仅对
// @layout 的 ShellRoute 子路由生效（StatefulShellRoute.indexedStack 变体
// 随语料扩展，编译器不代劳）。

import omniview;

component HomePage {
    @route "/home";

    signal draft: String = "";

    view {
        <div class: DemoPage>
            <h3>Home Page</h3>
            <input
                class: Field
                placeholder="Home draft"
                bind:value={draft}
                a11y: { label: "Home draft input" }
            ></input>
            <button @onPress={() => { navigate("/about"); }}>Go to About</button>
        </div>
    }
    style {
    }
}

component AboutPage {
    @route "/about";

    signal draft: String = "";

    view {
        <div class: DemoPage>
            <h3>About Page</h3>
            <input
                class: Field
                placeholder="About draft"
                bind:value={draft}
                a11y: { label: "About draft input" }
            ></input>
            <button @onPress={() => { navigate("/home"); }}>Back to Home</button>
        </div>
    }
    style {
    }
}
