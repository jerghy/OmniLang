import omniview;

component ComputedFnFormDemo {
    signal firstName: String = "Zhang";
    signal lastName: String = "";
    signal counter: i32 = 0;

    // 简单表达式形式
    computed simple: String = firstName + " " + lastName;

    // 函数式形式（带 () 和 -> 及完整 block）——view 中 {fullName()} 调用
    computed fullName() -> String {
        if firstName == "" && lastName == "" {
            return "Anonymous";
        }
        if lastName == "" {
            return firstName;
        }
        return firstName + " " + lastName;
    }

    fn clearLast() { lastName = ""; }
    fn setLast() { lastName = "San"; counter = counter + 1; }

    view {
        <div class: Container>
            <h3 class: Title>Computed Function Form Demo</h3>
            <p class: Subtitle>演示 computed name() → Type 函数式写法</p>

            <div class: DemoCard>
                <h4 class: label>Simple form: computed simple: String = expr</h4>
                <p class: value>{simple}</p>
            </div>

            <div class: DemoCard>
                <h4 class: label>Function form: computed fullName() → String（函数体）</h4>
                <p class: value>{fullName()}</p>
            </div>

            <div class: BtnRow>
                <button class: Btn @onPress={clearLast}>Clear Last Name</button>
                <button class: Btn @onPress={setLast}>Set "San"</button>
            </div>

            <div class: Info>
                <p class: Small>Calls: {counter}</p>
            </div>
        </div>
    }
    style {
        .value { font-size: 18px; font-weight: 600; color: #6366f1; margin: 0; }
    
        .label { font-size: 13px; font-weight: 600; color: #6b7280; margin: 0 0 4px 0; }
    }
}
