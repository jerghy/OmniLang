import omniview;


component TernaryExprDemo {
    signal count: i32 = 0;
    signal score: i32 = 75;

    // ★ 三元表达式 computed: cond ? then : else
    computed label: String = count > 0 ? "Positive" : "Zero or negative";
    // ★ 链式三元表达式
    computed grade: String = score >= 90 ? "A" : score >= 80 ? "B" : score >= 70 ? "C" : score >= 60 ? "D" : "F";

    fn inc() { count = count + 1; }
    fn dec() { count = count - 1; }
    fn setScore(s: i32) { score = s; }

    view {
        <div class: Container>
            <h3 class: Title>Ternary ( ? : ) 三元表达式 Demo</h3>
            <p class: subtitle>演示 cond ? then : else 运算符</p>

            <div class: DemoCard>
                <h4 class: Label>数值判定: count = {count}</h4>
                <p class: ValueText>结果: {label}</p>
                <p class: ValueText>直接内联: {count > 0 ? "正数哦" : "非正数哦"}</p>
                <div class: BtnRow>
                    <button class: BtnInc @onPress={inc}>count + 1</button>
                    <button class: BtnDec @onPress={dec}>count - 1</button>
                </div>
            </div>

            <div class: DemoCard>
                <h4 class: Label>成绩判定: score = {score}</h4>
                <p class: ValueText>等级: {grade}</p>
                <div class: BtnRow>
                    <button class: BtnSmall @onPress={() => { setScore(95); }}>95 → A</button>
                    <button class: BtnSmall @onPress={() => { setScore(85); }}>85 → B</button>
                    <button class: BtnSmall @onPress={() => { setScore(72); }}>72 → C</button>
                    <button class: BtnSmall @onPress={() => { setScore(55); }}>55 → F</button>
                </div>
            </div>

            <p class: Note>三元 ? : 是 if-expr 的紧凑形式，用于值上下文</p>
        </div>
    }
    style {
    
        .subtitle { font-size: 13px; color: var(--textSecondary); margin: 0 0 16px 0; }
    }
}
