import omniview;
import { LearnDesign } from "../design";

component TodoItem {
  prop id: i32 = 0;
  prop text: String = "";
  // 自定义事件——携带待办 id，由父组件中继到 Store
  event onDelete: i32;

  view {
    <div class: todo-item>
      <span class: todo-text>{text}</span>
      <button class: delete-btn @onPress={() => { onDelete(id); }}>✕</button>
    </div>
  }
  style {
    .todo-item { display: flex; align-items: center; padding: 12px 16px; border-bottom: 1px solid #f3f4f6; }
    .todo-text { font-size: 15px; color: #1f2937; }
    .delete-btn { margin-left: auto; padding: 4px 10px; border: none; border-radius: 6px; background: #f3f4f6; color: #6b7280; font-size: 13px; cursor: pointer; }
    .delete-btn:hover { background: #fee2e2; color: #dc2626; }
  }
}