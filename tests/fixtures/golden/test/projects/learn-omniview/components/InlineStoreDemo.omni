// ╔══════════════════════════════════════════════════════════════╗
// ║  InlineStoreDemo.omni —— 内联 Store 演示                       ║
// ║  演示：在 component 内部使用 store Name { ... } 定义局部 store   ║
// ║  Phase 5.2（IR wave）：内联 store 提升为模块级 StoreIR——React   ║
// ║  目标发射真实 Zustand store + 切片订阅（deferral #37 关闭），   ║
// ║  撤销 Task 2.2 的 E_CODEGEN 硬诊断迁移（src/stores/CartStore   ║
// ║  已删除）。                                                    ║
// ╚════════════════════════════════════════════════════════════════╝

import omniview;
import { LearnDesign } from "../design";
import { array_get } from "std/array";

component InlineStoreDemo {
    // 内联 store 定义在 component 内部，不导出到外部
    store CartStore {
        signal items: Array<String> = [];
        // 与 items 平行记录单价，removeLast 才能扣减正确金额
        signal prices: Array<f64> = [];
        signal totalPrice: f64 = 0.0;

        getter itemCount: i32 = items.len();
        getter summary: String = if items.len() == 0 {
            "cart empty"
        } else {
            "total: " + items.len().to_string() + " items"
        };

        action addItem(name: String, price: f64) {
            items.push(name);
            prices.push(price);
            totalPrice = totalPrice + price;
        }

        action removeLast() {
            if items.len() > 0 {
                let lastPrice = array_get(prices, items.len() - 1);
                items.pop();
                prices.pop();
                totalPrice = totalPrice - lastPrice;
            }
        }

        action clear() {
            items = [];
            prices = [];
            totalPrice = 0.0;
        }
    }


    signal log: String = "";

    fn addApple() {
        CartStore.addItem("Apple", 5.0);
        log = "Added: Apple ¥5.0";
    }

    fn addBook() {
        CartStore.addItem("OmniView Guide", 39.9);
        log = "Added: OmniView Guide ¥39.9";
    }

    fn addLaptop() {
        CartStore.addItem("Laptop", 5999.0);
        log = "Added: Laptop ¥5999.0";
    }

    fn remove() {
        CartStore.removeLast();
        log = "Removed last item";
    }

    fn clearCart() {
        CartStore.clear();
        log = "Cart cleared";
    }

    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>Inline Store Demo</h3>
            <p>Items: {CartStore.itemCount}</p>
            <p>Summary: {CartStore.summary}</p>
            <p>Total: {CartStore.totalPrice}</p>
            <div class: LearnDesign.Row>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={addApple}>
                    Add Apple
                </button>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={addBook}>
                    Add Book
                </button>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={addLaptop}>
                    Add Laptop
                </button>
                <button variant: LearnDesign.Button(color=danger, size=sm) @onPress={remove}>
                    Remove
                </button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={clearCart}>
                    Clear
                </button>
            </div>
            <p class: LearnDesign.Hint>{log}</p>
        </div>
    }
}
