// DataTable.omni - @onScroll, custom tags (Table/List/ListItem/Button),
// self-closing elements (img/br/hr), HTML comments,
// Map literals, closures |x| expr
// Demonstrates scroll tracking, custom tag mapping, void elements,
// comment preservation, map/dict usage, and inline closures

import omniview;
import { LearnDesign } from "../design";
import { array_sort, array_filter, array_length } from "std/array";

struct RowItem {
    id: i32,
    name: String,
    status: String,
    score: i32,
}

component DataTable {
    signal scrollCount: i32 = 0;
    signal rows: Array<RowItem> = [];
    signal sortAsc: bool = true;

    fn initRows() {
        rows = [
            RowItem { id: 1, name: "Alpha", status: "Active", score: 95 },
            RowItem { id: 2, name: "Bravo", status: "Active", score: 87 },
            RowItem { id: 3, name: "Charlie", status: "Inactive", score: 72 },
            RowItem { id: 4, name: "Delta", status: "Active", score: 91 },
            RowItem { id: 5, name: "Echo", status: "Active", score: 84 },
            RowItem { id: 6, name: "Foxtrot", status: "Inactive", score: 66 },
            RowItem { id: 7, name: "Golf", status: "Active", score: 78 },
            RowItem { id: 8, name: "Hotel", status: "Active", score: 93 },
            RowItem { id: 9, name: "India", status: "Inactive", score: 59 },
            RowItem { id: 10, name: "Juliet", status: "Active", score: 88 },
        ];
    }

    fn handleScroll() { scrollCount = scrollCount + 1; }
    fn toggleSort() { sortAsc = !sortAsc; rows = array_sort(rows, |a, b| a.name); }
    fn getSortIcon() -> String { if sortAsc { return "ASC"; } return "DESC"; }
    fn getActiveRows() -> Array<RowItem> { return array_filter(rows, |r| r.status == "Active"); }

    fn getStatusClass(status: String) -> String {
        if status == "Active" { return "badge active"; }
        return "badge inactive";
    }

    fn getScoreColor(score: i32) -> String {
        if score >= 90 { return "#16a34a"; }
        if score >= 75 { return "#6366f1"; }
        return "#dc2626";
    }

    // ── Map literal: grade config ────────────────────────────────
    // Creates a map literal with string keys mapping score thresholds to grades
    fn getGradeConfig() {
        return {
            "90": "A",
            "80": "B",
            "70": "C",
            "60": "D",
        };
    }

    // ── Map literal usage: grade lookup ─────────────────────────
    fn getGradeForScore(score: i32) -> String {
        let cfg = getGradeConfig();
        if score >= 90 { return cfg.get("90"); }
        if score >= 80 { return cfg.get("80"); }
        if score >= 70 { return cfg.get("70"); }
        if score >= 60 { return cfg.get("60"); }
        return "F";
    }

    // ── Closure: inline score transformation ────────────────────
    // Uses |x| x + bonus closure to compute adjusted total
    fn getBonusTotal() -> i32 {
        let bonus = |s| s + 5;
        let mut total = 0;
        let mut i = 0;
        while i < array_length(rows) {
            total = total + bonus(rows.get(i).score);
            i = i + 1;
        }
        return total;
    }

    @mount { initRows(); }

    view {
        <div class: LearnDesign.Card>
            <!-- Header -->
            <div class: header-row>
                <img src="/dot.png" alt="dot" />
                <h2 class: LearnDesign.CardTitle>DataTable Demo</h2>
                <hr />
            </div>

            <!-- Controls -->
            <div class: controls>
                <p class: info-text>Scroll count: {scrollCount}<br />Sort: {getSortIcon()}</p>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={toggleSort}>Toggle Sort</button>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={handleScroll}>Scroll +1</button>
            </div>

            <!-- Table -->
            <div class: table-wrapper @onScroll={handleScroll}>
                <Table class: data-table>
                    <thead>
                        <tr>
                            <th class: th>ID</th>
                            <th class: th>Name</th>
                            <th class: th>Status</th>
                            <th class: th>Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for row in rows {
                            <tr class: tr>
                                <td class: td>{row.id}</td>
                                <td class: td>{row.name}</td>
                                <td class: td>
                                    <span class: { badge: true, active: row.status == "Active", inactive: row.status == "Inactive" }>{row.status}</span>
                                </td>
                                <td class: td>
                                    <span class: score-text style: { color: getScoreColor(row.score) }>{row.score}</span>
                                </td>
                            </tr>
                        }
                        @empty {
                            <tr><td class: td-empty>No data</td></tr>
                        }
                    </tbody>
                </Table>
            </div>

            <!-- Summary -->
            <div class: summary-section>
                <h3 class: section-title>Summary</h3>
                <List class: summary-list>
                    <ListItem class: summary-item>
                        <img src="/dot.png" alt="dot" />
                        Total items: {array_length(rows)}
                    </ListItem>
                    <ListItem class: summary-item>
                        <img src="/dot.png" alt="dot" />
                        Active items: {array_length(getActiveRows())}
                    </ListItem>
                    <ListItem class: summary-item>
                        <img src="/dot.png" alt="dot" />
                        Scroll events: {scrollCount}
                    </ListItem>
                </List>
            </div>

            <!-- Map Closure Demo Phase 4 -->
            <div class: features-section>
                <h3 class: section-title>Map and Closure Demo</h3>
                <List class: features-list>
                    <ListItem class: features-item>
                        <img src="/dot.png" alt="dot" />
                        Grade for 95: {getGradeForScore(95)}
                    </ListItem>
                    <ListItem class: features-item>
                        <img src="/dot.png" alt="dot" />
                        Grade for 72: {getGradeForScore(72)}
                    </ListItem>
                    <ListItem class: features-item>
                        <img src="/dot.png" alt="dot" />
                        Grade for 59: {getGradeForScore(59)}
                    </ListItem>
                    <ListItem class: features-item>
                        <img src="/dot.png" alt="dot" />
                        Adj total (s+5): {getBonusTotal()}
                    </ListItem>
                </List>
            </div>

            <hr />
            <div class: footer-row>
                <img src="/dot.png" alt="dot" />
                <p class: footer-text>DataTable Phase 4 Demo</p>
            </div>
        </div>
    }
    style {
        // 数据表格特有的表格布局和行内样式
        .header-row { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
        .controls { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; }
        .info-text { font-size: 13px; color: #6b7280; margin: 0; }
        .table-wrapper { max-height: 400px; overflow-y: auto; border: 1px solid #d4d4d8; border-radius: 8px; }
        .data-table { width: 100%; border-collapse: collapse; }
        .th { padding: 12px; color: #6b7280; background: #f9fafb; border-bottom: 2px solid #d4d4d8; }
        .td { padding: 10px 12px; font-size: 14px; color: #374151; border-bottom: 1px solid #f3f4f6; }
        .tr { }
        .badge { font-size: 12px; padding: 2px 10px; border-radius: 10px; }
        .active { background: #d1fac5; color: #166534; }
        .inactive { background: #f3f4f6; color: #9ca3af; }
        .score-text { font-size: 14px; font-weight: bold; }
        .td-empty { padding: 20px; text-align: center; color: #9ca3af; }
        .summary-section { margin-top: 20px; }
        .section-title { font-size: 16px; color: #1f2937; margin: 0 0 8px 0; }
        .summary-list { list-style: none; padding: 0; margin: 0; }
        .summary-item { display: flex; align-items: center; gap: 8px; padding: 6px 0; font-size: 14px; color: #374151; }
        .features-section { margin-top: 20px; }
        .features-list { list-style: none; padding: 0; margin: 0; }
        .features-item { display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: 13px; color: #4b5563; }
        .footer-row { display: flex; align-items: center; gap: 8px; margin-top: 12px; }
        .footer-text { font-size: 12px; color: #9ca3af; margin: 0; }
    }
}
