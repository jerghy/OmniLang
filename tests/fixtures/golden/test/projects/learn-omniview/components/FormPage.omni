// FormPage.omni - @onChange, @onSubmit, boolean attrs, hyphenated attrs, @onFocus/@onBlur, @onScroll
// Demonstrates full form event handling, accessibility attributes, and data attributes

import omniview;
import { LearnDesign } from "../design";
import { string_length, string_contains, string_trim, string_starts_with } from "std/string";

component FormPage {
    signal name: String = "";
    signal email: String = "";
    signal message: String = "";
    signal nameError: String = "";
    signal emailError: String = "";
    signal submitted: bool = false;
    signal scrollPos: i32 = 0;
    signal focusField: String = "";

    fn handleNameChange() { nameError = ""; }
    fn handleEmailChange() { emailError = ""; }
    fn handleMessageChange() { scrollPos = scrollPos + 1; }

    fn handleNameFocus() { focusField = "name"; }
    fn handleNameBlur() { focusField = ""; if name == "" { nameError = "Name is required"; } else if string_length(name) < 2 { nameError = "Name must be at least 2 characters"; } else if string_starts_with(name, " ") { nameError = "Name must not start with a space"; } }
    fn handleEmailFocus() { focusField = "email"; }
    fn handleEmailBlur() { focusField = ""; if email == "" { emailError = "Email is required"; } else if !string_contains(email, "@") { emailError = "Email must contain @"; } }

    fn handleSubmit() {
        if name == "" { nameError = "Name is required"; }
        else if string_length(name) < 2 { nameError = "Name must be at least 2 characters"; }
        if email == "" { emailError = "Email is required"; }
        else if !string_contains(email, "@") { emailError = "Email must contain @"; }
        if nameError == "" && emailError == "" { submitted = true; }
    }

    fn handleScroll() { scrollPos = scrollPos + 1; }

    fn handleReset() {
        name = "";
        email = "";
        message = "";
        nameError = "";
        emailError = "";
        submitted = false;
        scrollPos = 0;
    }

    fn getTrimmedMessage() -> String {
        return string_trim(message);
    }

    fn getStatusText() -> String {
        if submitted { return "Form submitted successfully"; }
        if nameError != "" || emailError != "" { return "Please fix errors above"; }
        return "Fill in the form";
    }

    fn isFormValid() -> bool {
        return name != "" && email != "";
    }

    view {
        <div class: LearnDesign.Card>
            <h2 class: LearnDesign.CardTitle>FormPage Demo</h2>

            <!-- Form demonstrating @onSubmit, @onChange, boolean attrs, aria/data attrs -->
            <form class: form @onSubmit={handleSubmit}>
                <!-- Name field with @onFocus, @onBlur, @onChange, required, a11y block, data-testid -->
                <div class: field>
                    <label class: label for="name">Name</label>
                    <input
                        id="name"
                        class: input
                        placeholder="Your name"
                        bind:value={name}
                        required
                        a11y: { label: "Full name input" }
                        data-testid="name-field"
                        data-type="text"
                        @onFocus={handleNameFocus}
                        @onBlur={handleNameBlur}
                        @onChange={handleNameChange}
                    ></input>
                    @if nameError != "" {
                        <span class: error-text>{nameError}</span>
                    }
                </div>

                <!-- Email field with boolean attrs and hyphenated attrs -->
                <div class: field>
                    <label class: label for="email">Email</label>
                    <input
                        id="email"
                        class: input
                        placeholder="your@email.com"
                        bind:value={email}
                        required
                        a11y: { label: "Email address input" }
                        data-testid="email-field"
                        data-type="email"
                        @onFocus={handleEmailFocus}
                        @onBlur={handleEmailBlur}
                        @onChange={handleEmailChange}
                    ></input>
                    @if emailError != "" {
                        <span class: error-text>{emailError}</span>
                    }
                </div>

                <!-- Message field with @onChange, @onScroll, readonly (conditional) -->
                <div class: field>
                    <label class: label for="msg">Message</label>
                    <textarea
                        id="msg"
                        class: textarea
                        placeholder="Your message (optional)"
                        bind:value={message}
                        a11y: { label: "Message input" }
                        data-testid="msg-field"
                        @onChange={handleMessageChange}
                        @onScroll={handleScroll}
                    ></textarea>
                </div>

                <!-- Disabled field demonstration -->
                <div class: field>
                    <label class: label for="disabled-field">Disabled field</label>
                    <input
                        id="disabled-field"
                        class: input
                        placeholder="This field is disabled"
                        disabled
                        a11y: { label: "Disabled input" }
                        data-testid="disabled-field"
                    ></input>
                </div>

                <!-- Readonly field demonstration -->
                <div class: field>
                    <label class: label for="readonly-field">Readonly field</label>
                    <input
                        id="readonly-field"
                        class: input
                        value="Read-only value"
                        readonly
                        a11y: { label: "Read-only input" }
                        data-testid="readonly-field"
                    ></input>
                </div>

                <!-- Scrollable area with @onScroll -->
                <div class: scroll-box @onScroll={handleScroll}>
                    <p class: scroll-title>Scrollable area (scroll count: {scrollPos})</p>
                    <p class: scroll-line>Line 1: Scroll to trigger @onScroll</p>
                    <p class: scroll-line>Line 2: More content below</p>
                    <p class: scroll-line>Line 3: Keep scrolling</p>
                    <p class: scroll-line>Line 4: Almost there</p>
                    <p class: scroll-line>Line 5: Bottom reached</p>
                </div>

                <!-- Status display -->
                <div class: status-area>
                    <p class: { status: true, success: submitted, error: false, idle: false }>
                        {getStatusText()}
                    </p>
                </div>

                <!-- Trimmed message display -->
                @if message != "" {
                    <div class: trimmed-area>
                        <p class: trimmed-label>Trimmed message:</p>
                        <p class: trimmed-value>{getTrimmedMessage()}</p>
                    </div>
                }

                <!-- Form actions -->
                <div class: actions>
                    <button
                        variant: LearnDesign.Button(color=primary, size=lg)
                        type="submit"
                        disabled={false}
                        a11y: { label: "Submit form" }
                        data-testid="submit-btn"
                    >Submit</button>
                    <button
                        variant: LearnDesign.Button(color=ghost, size=lg)
                        type="button"
                        @onPress={handleReset}
                        a11y: { label: "Reset form" }
                        data-testid="reset-btn"
                    >Reset</button>
                </div>

                <!-- Conditional disabled button -->
                <div class: conditional-area>
                    <button
                        variant: LearnDesign.Button(color=ghost, size=md)
                        @onPress={handleSubmit}
                        disabled={false}
                        a11y: { label: "Conditional submit button" }
                        data-testid="conditional-btn"
                    >
                        {if isFormValid() { "Form is valid" } else { "Form incomplete" }}
                    </button>
                </div>
            </form>

            <!-- Focus indicator -->
            @if focusField != "" {
                <div class: focus-indicator>
                    <p class: focus-text>Focused field: {focusField}</p>
                </div>
            }
        </div>
    }
    style {
        // 表单特有的布局和验证样式
        .form { display: flex; flex-direction: column; gap: 16px; }
        .field { display: flex; flex-direction: column; gap: 4px; }
        .label { font-size: 14px; font-weight: bold; color: #374151; margin-bottom: 4px; }
        .input { padding: 12px; border: 2px solid #d4d4d8; border-radius: 8px; font-size: 15px; color: #1f2937; outline: none; }
        .input:focus { border-color: #6366f1; }
        .textarea { padding: 12px; border: 2px solid #d4d4d8; border-radius: 8px; font-size: 15px; min-height: 80px; color: #1f2937; outline: none; }
        .textarea:focus { border-color: #6366f1; }
        .error-text { font-size: 12px; color: #dc2626; }
        .scroll-box { height: 120px; overflow-y: scroll; padding: 12px; background: #f9fafb; border: 1px solid #d4d4d8; border-radius: 8px; }
        .scroll-title { font-size: 14px; font-weight: bold; color: #374151; margin: 0 0 8px 0; }
        .scroll-line { font-size: 13px; color: #6b7280; margin: 2px 0; }
        .status-area { padding: 12px; border-radius: 8px; }
        .status { font-size: 14px; margin: 0; padding: 8px 12px; border-radius: 6px; }
        .success { background: #d1fac5; color: #166534; }
        .error { background: #fddddd; color: #991b1b; }
        .idle { background: #f3f4f6; color: #6b7280; }
        .actions { display: flex; gap: 8px; }
        .trimmed-area { margin: 8px 0; padding: 8px 12px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; }
        .trimmed-label { font-size: 12px; color: #6b7280; margin: 0 0 2px 0; }
        .trimmed-value { font-size: 14px; color: #166534; margin: 0; font-family: monospace; }
        .conditional-area { padding: 8px 0; }
        .focus-indicator { margin-top: 12px; padding: 8px 16px; background: #dbf0ff; border-radius: 8px; }
        .focus-text { font-size: 13px; color: #1d40d0; margin: 0; }
    }
}
