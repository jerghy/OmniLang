// ╔══════════════════════════════════════════════════════════════╗
// ║  lib/type_system.omni —— 类型系统全覆盖演示                    ║
// ║  演示：i8, i16, i64, u8, u16, u32, u64, f32, isize, usize,  ║
// ║        Void 类型注解                                          ║
// ║  纯逻辑文件，不写 import omniview;                              ║
// ╚══════════════════════════════════════════════════════════════╝

// ── 1. 有符号整数变体 ──────────────────────────────────────────

pub fn demo_i8() -> i8 {
    return 127;
}

pub fn demo_i16() -> i16 {
    return 32767;
}

pub fn demo_i64() -> i64 {
    return 9223372036854775807;
}

// ── 2. 无符号整数变体 ──────────────────────────────────────────

pub fn demo_u8() -> u8 {
    return 255;
}

pub fn demo_u16() -> u16 {
    return 65535;
}

pub fn demo_u32() -> u32 {
    return 4294967295;
}

pub fn demo_u64() -> u64 {
    return 18446744073709551615;
}

// ── 3. 浮点变体 ────────────────────────────────────────────────

pub fn demo_f32() -> f32 {
    return 3.14;
}

// ── 4. 平台相关类型 ────────────────────────────────────────────

pub fn demo_isize() -> isize {
    return -42;
}

pub fn demo_usize() -> usize {
    return 100;
}

// ── 5. Void 类型 ──────────────────────────────────────────────

pub fn demo_void() -> Void {
    // Void 表示函数无有意义返回值
    print("void function called");
}

// ── 6. 综合类型展示 ────────────────────────────────────────────

pub fn type_system_summary() -> String {
    return "i8=" + demo_i8().to_string()
        + " i16=" + demo_i16().to_string()
        + " u8=" + demo_u8().to_string()
        + " u16=" + demo_u16().to_string()
        + " u32=" + demo_u32().to_string()
        + " f32=" + demo_f32().to_string()
        + " isize=" + demo_isize().to_string()
        + " usize=" + demo_usize().to_string();
}
