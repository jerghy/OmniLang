import omniview;
import { LearnDesign } from "../design";
import { math_abs, math_random, math_ceil, math_floor, math_sqrt } from "std/math";

component StatsDashboard {
    ref container: HtmlElement;
    const MAX_ITEMS = 10;
    const $iconUrl = "/assets/icon.png";
    const $apiBase = "https://api.example.com";

    signal counter: i32 = 0;
    signal removed: bool = false;
    signal randomValue: f64 = 0.0;

    fn addFive() { counter += 5; }
    fn subThree() { counter -= 3; }
    fn double() { counter *= 2; }
    fn halve() { counter /= 2; }
    fn modThree() {
        let mut x = counter;
        x %= 3;
        counter = x;
    }

    fn getModStatus() -> String {
        if counter % 2 == 0 { return "even"; }
        return "odd";
    }

    fn getFirst() -> i32 {
        let arr: Array<i32> = [10, 20, 30, 40, 50];
        return arr[0];
    }

    fn removeContainer() { removed = true; }

    fn rollDice() { randomValue = math_random(); }

    @unmount {
        println("StatsDashboard unmounting, counter: " + counter.to_string());
    }

    view {
        <div class: LearnDesign.Card ref: container>
            <h3 class: LearnDesign.CardTitle>StatsDashboard Demo</h3>

            <div class: const-area>
                <p class: small>MAX_ITEMS: {MAX_ITEMS}</p>
                <p class: small>prefixed consts declared</p>
            </div>

            <div class: counter-area>
                <p class: counter-text>Counter: {counter} ({getModStatus()})</p>
                <div class: btn-row>
                    <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={addFive}>+5</button>
                    <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={subThree}>-3</button>
                    <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={double}>x2</button>
                    <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={halve}>/2</button>
                    <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={modThree}>mod3</button>
                </div>
            </div>

            <div class: math-area>
                <p class: small>math_abs(counter) = {math_abs(counter)} | math_sqrt(counter) = {math_sqrt(counter)}</p>
            </div>

            <div class: dice-area>
                <p class: small>Random: {randomValue} | Ceil*100 = {math_ceil(randomValue * 100)} | Floor*100 = {math_floor(randomValue * 100)}</p>
                <button variant: LearnDesign.Button(color=ghost, size=sm) @onPress={rollDice}>Roll Dice</button>
            </div>

            <div class: array-area>
                <p class: small>First value: {getFirst()}</p>
            </div>

            @if !removed {
                <button variant: LearnDesign.Button(color=danger, size=sm) @onPress={removeContainer}>
                    Trigger unmount
                </button>
            }
        </div>
    }
    style {
        // 组件特有的演示区域颜色和内部布局
        .const-area { background: #f9fafb; padding: 8px 12px; border-radius: 6px; margin-bottom: 12px; }
        .small { font-size: 12px; color: #6b7280; margin: 2px 0; }
        .counter-area { margin-bottom: 12px; }
        .counter-text { font-size: 24px; font-weight: bold; color: #6366f1; margin-bottom: 8px; }
        .btn-row { display: flex; gap: 6px; }
        .math-area { background: #f0fdf4; padding: 8px 12px; border-radius: 6px; margin-bottom: 12px; }
        .dice-area { background: #fff7ed; padding: 8px 12px; border-radius: 6px; margin-bottom: 12px; }
        .array-area { margin-bottom: 12px; }
        // .dashboard / .title / .btn / .btn-danger 已由 LearnDesign.Card / CardTitle / Button 变体提供
    }
}
