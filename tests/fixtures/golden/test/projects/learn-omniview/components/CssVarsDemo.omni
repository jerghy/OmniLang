// ╔══════════════════════════════════════════════════════════════════╗
// ║  CssVarsDemo.omni — CSS 自定义属性（CSS 变量）全覆盖              ║
// ║                                                                  ║
// ║  演示 4 种 CSS 变量用法：                                         ║
// ║    1. Style 块中声明 --* 属性                                     ║
// ║    2. Style 块中使用 var() 引用                                   ║
// ║    3. 内联样式静态 CSS 变量                                       ║
// ║    4. 内联样式动态 CSS 变量（信号 → setProperty 桥接）             ║
// ╚══════════════════════════════════════════════════════════════════╝

import omniview;

component CssVarsDemo {
    // 动态 CSS 变量用的信号
    signal accentColor: String = "#6366f1";
    signal accentHue: i32 = 221;

    fn cycleAccent() {
        if accentColor == "#6366f1" {
            accentColor = "#ec4899";
        } else if accentColor == "#ec4899" {
            accentColor = "#14b8a6";
        } else {
            accentColor = "#6366f1";
        }
    }

    // Demo 4 驱动：hue 值在 HueBar 的四个阶梯间循环（221 → 260 → 300 → 340）
    fn cycleHue() {
        if accentHue == 221 {
            accentHue = 260;
        } else if accentHue == 260 {
            accentHue = 300;
        } else if accentHue == 300 {
            accentHue = 340;
        } else {
            accentHue = 221;
        }
    }

    view {
        <div class: Wrapper>
            <h3 class: SectionHeader>CSS Custom Properties (CSS Variables)</h3>
            <p class: subtitle>
                演示编译器对 <code>--*</code> 声明、<code>var()</code> 引用、内联静态/动态 CSS 变量的完整支持
            </p>

            <!-- ═══ Demo 1: Style 块声明 + var() 引用 ═══ -->
            <div class: demo-card>
                <h4 class: DemoLabel>① Style 块声明 --* + var() 引用</h4>
                <p class: DemoDesc>
                    Style 块内部声明 <code>--primary</code>、<code>--bg</code> 等自定义属性，
                    然后用 <code>var()</code> 引用。这是编译器中 <code>parse_css_property_name()</code>
                    解析 <code>--</code> 前缀的常规路径。
                </p>
                <div class: VarDemoArea>
                    <div class: var-card>var(--primary)</div>
                    <div class: var-card alt>var(--primary-alt)</div>
                    <div class: var-card surface>background: var(--surface)</div>
                    <div class: var-card border>border: var(--border-color)</div>
                </div>
            </div>

            <!-- ═══ Demo 2: 内联样式静态 CSS 变量 ═══ -->
            <div class: demo-card>
                <h4 class: DemoLabel>② 内联样式静态 CSS 变量</h4>
                <p class: DemoDesc>
                    在 <code>style: {"{"} --name: "value" {"}"}</code> 中直接写 <code>--</code> 属性。
                    编译器代码生成将 <code>--</code> 属性用 <code>el.style.setProperty("--name", value)</code>
                    输出，而非普通的 <code>el.style.prop = value</code>。
                </p>
                <div class: InlineStaticRow>
                    <div class: InlineStaticBox
                        style: {
                            --box-bg: "#e0e7ff",
                            --box-text: "#3730a3",
                            --box-radius: "8px"
                        }
                    >
                        <code>--box-bg: "#e0e7ff"</code>
                    </div>
                    <div class: InlineStaticBox
                        style: {
                            --box-bg: "#fce7f3",
                            --box-text: "#9d174d",
                            --box-radius: "16px"
                        }
                    >
                        <code>--box-radius: "16px"</code>
                    </div>
                    <div class: InlineStaticBox
                        style: {
                            --box-bg: "#d1fae5",
                            --box-text: "#065f46",
                            --box-radius: "50%"
                        }
                    >
                        <code>--box-radius: "50%"</code>
                    </div>
                </div>
            </div>

            <!-- ═══ Demo 3: 内联样式动态 CSS 变量（信号引用） ═══ -->
            <div class: demo-card>
                <h4 class: DemoLabel>③ 内联样式动态 CSS 变量（信号 → setProperty）</h4>
                <p class: DemoDesc>
                    传递<strong>信号引用</strong>给 <code>--*</code> 属性。编译器生成 effect
                    在信号变化时更新 CSS 变量。
                </p>

                <div class: DynamicArea
                    style: {
                        --accent: accentColor,
                        padding: "16px",
                        border: "2px solid " + accentColor
                    }
                >
                    <p class: DynamicText>
                        当前 accent: <strong>{accentColor}</strong>
                    </p>
                    <div class: DynamicSwatches>
                        <div class: SwatchPreview style: { background: accentColor }></div>
                        <div class: SwatchLabel>{accentColor}</div>
                    </div>
                    <button class: CycleBtn @onPress={cycleAccent}>
                        Cycle Accent Color
                    </button>
                    <p class: CodeHint>
                        生成的 JS: <code>setProperty("--accent", accentColor)</code>
                    </p>
                </div>
            </div>

            <!-- ═══ Demo 4: CSS 变量 + 动态 hue 实现主题色循环 ═══ -->
            <div class: demo-card>
                <h4 class: DemoLabel>④ CSS 变量级联 + 信号驱动</h4>
                <p class: DemoDesc>
                    外层设 <code>--accent-h</code>（由 accentHue 信号驱动），内层用
                    <code>var(--accent-h)</code> 计算衍生色。hue 值随信号变化实时更新。
                </p>
                <div class: CascadeArea
                    style: {
                        --accent-h: accentHue,
                        padding: "16px"
                    }
                >
                    <div class: CascadeBox>
                        <p class: CascadeTitle>
                            hue = <strong>{accentHue}°</strong>
                        </p>
                        <p class: CascadeDesc>
                            内层用 <code>var(--accent-h)</code> 通过 CSS <code>hsl()</code> 计算色值
                        </p>
                        <div class: HueBar>
                            <span class: HueStep style: { background: "hsl(221, 80%, 60%)" }>221°</span>
                            <span class: HueStep style: { background: "hsl(260, 80%, 60%)" }>260°</span>
                            <span class: HueStep style: { background: "hsl(300, 80%, 60%)" }>300°</span>
                            <span class: HueStep style: { background: "hsl(340, 80%, 60%)" }>340°</span>
                        </div>
                        <button class: CycleBtn @onPress={cycleHue}>
                            Cycle Hue（当前 {accentHue}°）
                        </button>
                    </div>
                </div>
            </div>

            <!-- 技术说明 -->
            <div class: TechNote>
                <h4 class: NoteTitle>要点</h4>
                <ul class: NoteList>
                    <li>Style 块与内联 <code>style:</code> 均可声明 <code>--name</code> 属性</li>
                    <li><code>--name: 信号</code> 信号引用 → 编译期生成响应式 setProperty 更新</li>
                    <li>静态 <code>--name: "value"</code> → 直接写入 CSS 变量</li>
                </ul>
            </div>
        </div>
    }

    style {
        // ═══ CSS 自定义属性声明 + var() 引用 ═══
        code {
            background: var(--surfaceMuted);
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 12px;
        }
        // Demo cards
        // Demo 1: var-demo-area
        .var-card {
            padding: 12px 18px;
            background: white;
            border: 1px solid var(--border-color);
            border-radius: var(--radiusSm);
            font-size: 13px;
            color: var(--textPrimary);
        }
        .var-card.alt {
            // 使用 var(--primary-alt) 覆盖边框颜色
            border-color: var(--primary-alt);
            color: var(--primary-alt);
        }
        .var-card.surface {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }
        .var-card.border {
            // 使用 var(--border-color)
            border: 2px solid var(--primary-alt);
            background: white;
        }
        // Demo 2: inline static
        // Demo 3: dynamic area
        .CodeHint code {
            background: #f1f5f9;
        }
        // Demo 4: cascade
        // Tech note
        .NoteList li {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 4px;
            line-height: 1.5;
        }
    
        .subtitle {
            font-size: 13px;
            color: var(--textMuted);
            margin: 0 0 20px 0;
        }
        .demo-card {
            // Demo 1 演示路径：组件级 --* 声明（覆盖 design.omni 全局同名变量，
            // 级联到 .var-card 子元素），随后用 var() 引用
            --primary: "#6366f1";
            --primary-alt: "#818cf8";
            --bg: "#f8fafc";
            background: var(--surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radiusMd);
            padding: 16px;
            margin-bottom: 16px;
        }
    }
}
