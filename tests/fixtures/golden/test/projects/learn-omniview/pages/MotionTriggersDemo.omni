import omniview;
import { LearnDesign } from "../design";

// ╔══════════════════════════════════════════════════════════════╗
// ║  MotionTriggersDemo.omni —— 触发器控制维度                      ║
// ║                                                              ║
// ║  演示 @in-view / @scroll / @focus / scrubbing 触发器           ║
// ║  （@drag-horizontal / @drag-vertical）及其参数：                ║
// ║    · @scroll  start: / end: / scrub:   滚动区间映射           ║
// ║    · @drag-horizontal constraints: / elastic: / threshold:    ║
// ║    · @drag-vertical  constraints / elastic / threshold     ║
// ╚══════════════════════════════════════════════════════════════╝

// ═══ 动效定义 ═══
@motion slideInView {
    from { opacity: 0, translateY: 30 }
    to   { opacity: 1, translateY: 0 }
    over: 400ms
    easing: power2-out
}

@motion scrollFade {
    from { opacity: 0.3, scale: 0.95 }
    to   { opacity: 1, scale: 1 }
    over: 500ms
    easing: ease-out
}

@motion dragSlide {
    from { translateX: 0 }
    to   { translateX: 100 }
    over: 300ms
    easing: power2-out
}

@motion dragSlideY {
    from { translateY: 0 }
    to   { translateY: 100 }
    over: 300ms
    easing: power2-out
}

component MotionTriggersDemo {
    view {
        <div class: LearnDesign.Container>
            <h3 class: LearnDesign.CardTitle>Motion Triggers Demo</h3>
            <p class: LearnDesign.Subtitle>@in-view · @scroll (start/end/scrub) · @focus · @drag (constraints/elastic)</p>

            <!-- @in-view 触发器 -->
            <div class: DemoCard>
                <h4 class: Label>@in-view 触发器</h4>
                <div @in-view={slideInView}>
                    <p>Slide in (entering viewport)</p>
                </div>
            </div>

            <!-- @scroll 触发器 + 控制维度：start/end/scrub -->
            <div class: DemoCard>
                <h4 class: Label>@scroll 触发器 + start/end/scrub</h4>
                <div @scroll start: 200 end: 800 scrub: true={scrollFade} class: ScrollArea>
                    <p>在 200–800px 滚动区间内，进度实时映射到动画（scrub）</p>
                    <p>区间外的滚动位置不驱动动画（start/end 限定）</p>
                </div>
            </div>

            <!-- @focus 触发器 -->
            <div class: DemoCard>
                <h4 class: Label>focus 触发器</h4>
                <input placeholder="Focus me" @focus={slideInView} class: FocusInput />
                <p>Focus the input to trigger slideInView</p>
            </div>

            <!-- @drag-horizontal + @drag-vertical 拖拽（constraints 限定范围、elastic 回弹） -->
            <div class: DemoCard>
                <h4 class: Label>@drag-horizontal / @drag-vertical 拖拽</h4>
                <div @drag-horizontal constraints: [-100, 100] elastic: 0.5 threshold: 8={dragSlide} class: DragBox>
                    <p>约束 ±100px · 弹性 0.5</p>
                </div>
                <div @drag-vertical constraints: [0, 150] elastic: 0.3 threshold: 4={dragSlideY} class: DragBoxVertical>
                    <p>约束 0–150px · 弹性 0.3</p>
                </div>
            </div>
        </div>
    }
    style {
    }
}
