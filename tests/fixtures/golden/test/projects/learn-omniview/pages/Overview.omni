// Overview.omni -- capability matrix landing page
// 批次 2 接线注记：NavDemo 入口卡片走 navigate("/nav")（路由意图），
// 其余 8 张卡片保留 CapabilityCard 合法组件事件模式（@onNavigate → switchTab tab UI 态）。
// routeOrTab 分派：tabName == "nav" → 路由跳转；其余 → 事件上抛。

import omniview;
import { LearnDesign } from "../design";
import { CapabilityCard } from "../components/CapabilityCard";
import { ThemeStore } from "../stores/ThemeStore";

component Overview {
    @store ThemeStore;

    event onNavigate: String;

    fn routeOrTab(tab: String) {
        if (tab == "nav") { navigate("/nav"); } else { onNavigate(tab); }
    }

    view {
        <section ><div class: LearnDesign.Banner>
                <h1 class: LearnDesign.BannerTitle>{'\u{1F680}'} OmniLang Capability Showcase</h1>
                <p class: LearnDesign.BannerSubtitle>
                    v2 语义级 DSL · 103 源文件 · 4 主题 · 10 语义域 · 9 标签页
                </p>
            </div>

            <div class: capability-grid>
                <CapabilityCard
                    icon="\u{1F3A8}" title="UI Components"
                    description="Forms, modals, tables, todo app, notifications, slots, a11y, @for rendering"
                    tabName="ui"
                    @onNavigate={onNavigate}
                />
                <CapabilityCard
                    icon="\u{1F3AC}" title="Motion & Animation"
                    description="Keyframes, easing, triggers, @scroll/@drag 控制维度, 60fps DOM"
                    tabName="motion"
                    @onNavigate={onNavigate}
                />
                <CapabilityCard
                    icon="\u{1F485}" title="Design & Theme"
                    description="4 themes · @themes directive · CSS cascade · design tokens · variants"
                    tabName="design"
                    @onNavigate={onNavigate}
                />
                <CapabilityCard
                    icon="⚡" title="State & Signals"
                    description="Signal reactivity, computed, @effect, stores (global/inline), bind:value"
                    tabName="state"
                    @onNavigate={onNavigate}
                />
                <CapabilityCard
                    icon="\u{1F524}" title="Language Features"
                    description="Nullish, optional chaining, ternary, block expressions, type system, style pseudos"
                    tabName="language"
                    @onNavigate={onNavigate}
                />
                <CapabilityCard
                    icon="\u{1F517}" title="Element Ref"
                    description="Direct DOM access, .focus(), .scrollTo(), .measure(), @drag 意图化拖拽 + style 信号绑定零中间层"
                    tabName="ref"
                    @onNavigate={onNavigate}
                />
                <CapabilityCard
                    icon="⚙️" title="Compiler Features"
                    description="HTTP fetch, data submit, error handling, async patterns, user settings"
                    tabName="compiler"
                    @onNavigate={onNavigate}
                />
                <CapabilityCard
                    icon="\u{1F4A0}" title="Design Tokens"
                    description="Dynamic design tokens — 编译时常量引用 + 运行时信号引用"
                    tabName="tokens"
                    @onNavigate={onNavigate}
                />
                <CapabilityCard
                    icon="\u{1F9ED}" title="Navigation & Routing"
                    description="@route / @layout / @query / guard / lazy / back() — navigate() 全要素 demo（NavDemo hub）"
                    tabName="nav"
                    @onNavigate={routeOrTab}
                />
            </div>

            <div class: StatsBar>
                <div class: StatItem>
                    <span class: StatValue>103</span>
                    <span class: StatLabel>Source Files</span>
                </div>
                <div class: StatItem>
                    <span class: StatValue>10</span>
                    <span class: StatLabel>语义域</span>
                </div>
                <div class: StatItem>
                    <span class: StatValue>4</span>
                    <span class: StatLabel>Themes</span>
                </div>
                <div class: StatItem>
                    <span class: StatValue>{ThemeStore.toggleCount}</span>
                    <span class: StatLabel>Theme Toggles</span>
                </div>
            </div>
        </section>
    }

    style {
        .capability-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 0 0 20px 0; }
    }
}
