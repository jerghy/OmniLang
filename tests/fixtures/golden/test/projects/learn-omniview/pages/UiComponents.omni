// UiComponents.omni — merged Interactive + Todo + Events page

import omniview;
import { LearnDesign } from "../design";
import { EventSpectrumDemo } from "../components/EventSpectrumDemo";
import { ValidationInput } from "../components/ValidationInput";
import { Timer } from "../components/Timer";
import { Modal } from "../components/Modal";
import { TabPanel } from "../components/TabPanel";
import { DataTable } from "../components/DataTable";
import { FormPage } from "../components/FormPage";
import { LoadDemo } from "../components/LoadDemo";
import { ResponsiveDemo } from "../components/ResponsiveDemo";
import { SlotDefaultDemo } from "../components/SlotDefaultDemo";
import { EventsDemo } from "../components/EventsDemo";
import { EventShorthand } from "../components/EventShorthand";
import { A11yDemo } from "../components/A11yDemo";
// Todo app
import { TodoList } from "../components/TodoList";
import { FilterBar } from "../components/FilterBar";
import { StatsDashboard } from "../components/StatsDashboard";
// 表单控件与 Dashboard 组合
import { FormControlsDemo } from "../components/FormControlsDemo";
import { Dashboard } from "./Dashboard";
import { FeatureList } from "../components/FeatureList";

component UiComponents {
    view {
        <section class: LearnDesign.DemoSection>
            <div class: LearnDesign.Row>
                <div class: LearnDesign.Col><ValidationInput /></div>
                <div class: LearnDesign.Col><Timer /></div>
            </div>
            <div class: LearnDesign.Row>
                <div class: LearnDesign.Col><Modal /></div>
                <div class: LearnDesign.Col><TabPanel /></div>
            </div>
            <div class: LearnDesign.DemoFull><DataTable /></div>

            <div class: LearnDesign.Row>
                <div class: LearnDesign.Col><SlotDefaultDemo /></div>
                <div class: LearnDesign.Col><EventsDemo /></div>
            </div>

            <div class: LearnDesign.DemoFull><FormPage /></div>
            <div class: LearnDesign.DemoFull><LoadDemo /></div>
            <!-- 批次 3 响应式：breakpoint 断点 + bp() 三使用面 + 用户级 @media 块 -->
            <div class: LearnDesign.DemoFull><ResponsiveDemo /></div>

            <!-- HTML 原生表单控件（FormControlsDemo：a / select / checkbox / number / range）-->
            <h3 class: LearnDesign.SectionTitle>HTML 原生控件</h3>
            <div class: LearnDesign.DemoFull><FormControlsDemo /></div>

            <!-- 命令式通知（showToast 内建语义函数：kind info/success/error，原 NotificationsPanel 手写形态即切换）-->
            <div class: LearnDesign.DemoFull>
                <h3 class: LearnDesign.SectionTitle>命令式通知（showToast）</h3>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={() => { showToast("普通消息"); }}>info 通知</button>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={() => { showToast("保存成功", { kind: "success" }); }}>success 通知</button>
                <button variant: LearnDesign.Button(color=primary, size=sm) @onPress={() => { showToast("网络不可用", { kind: "error" }); }}>error 通知</button>
            </div>
            <div class: LearnDesign.DemoFull><EventShorthand /></div>
            <div class: LearnDesign.DemoFull><EventSpectrumDemo /></div>

            <!-- 可访问性语义（a11y: label/role/hidden/live/alt）-->
            <h3 class: LearnDesign.SectionTitle>可访问性（a11y）</h3>
            <div class: LearnDesign.DemoFull><A11yDemo /></div>

            <!-- Dashboard 组合演示（Dashboard：StatsPanel + Counter + FeatureCard；FeatureList）-->
            <h3 class: LearnDesign.SectionTitle>Dashboard 组合演示</h3>
            <div class: LearnDesign.DemoFull><Dashboard /></div>
            <div class: LearnDesign.DemoFull><FeatureList /></div>

            <h3 class: LearnDesign.SectionTitle>Todo App Demo</h3>
            <!-- TodoList 内部组合了自己的 AddTodo（@onAdd → TodoStore.add）-->
            <div class: TodoSection>
                <div class: TodoSidebar>
                    <FilterBar />
                </div>
                <div class: TodoMain>
                    <TodoList />
                </div>
                <div class: TodoStats>
                    <StatsDashboard />
                </div>
            </div>
        </section>
    }

    style {
    }
}
