// NotificationStore.omni - multi-param action, return, async action

import omniview;

import { storage_set } from "std/storage";

store NotificationStore {
    signal notifications: Array<String> = [];
    signal maxCount: i32 = 5;

    // getter: derived count
    getter unreadCount: i32 = notifications.len();

    // action with return value (single param)
    action add(message: String): String {
        if message == "" {
            return "empty message ignored";
        }
        if notifications.len() >= maxCount {
            return "max notifications reached";
        }
        notifications.push(message);
        storage_set("notification-count", unreadCount.to_string());
        return "added";
    }

    // multi-param action with return value
    action addWithPriority(title: String, body: String, priority: i32): String {
        let full = title + ": " + body;
        if priority > 5 {
            // 高优先级——置顶（数组头部插入）
            notifications = [full, ...notifications];
            return "high priority added";
        }
        notifications.push(full);
        return "added";
    }

    // async action (with return)
    action removeLast(): String async {
        if notifications.len() == 0 {
            return "no notifications";
        }
        notifications.pop();
        return "removed";
    }

    action clear() {
        notifications = [];
    }

    action clearAll() {
        notifications = [];
        storage_set("notification-count", "0");
    }
}
