import omniview;

// Todo 条目类型
struct Todo {
    id: i32,
    text: String,
    done: bool,
}

store TodoStore {
  signal items: Todo[] = [];
  signal filterStatus: String = "all";
  signal lastAction: String = "none";
  // 自增 id——删除后 id 不复用，保证 @for key={item.id} 唯一
  signal nextId: i32 = 0;

  getter totalCount: i32 = items.len();

  action add(text: String) { items = [...items, Todo { id: nextId, text: text, done: false }]; nextId = nextId + 1; lastAction = "added"; }
  action remove(id: i32) { items = items.filter(|item| item.id != id); lastAction = "removed"; }
  action clear() { items = []; filterStatus = "all"; lastAction = "cleared"; }
  action setFilter(status: String) { filterStatus = status; lastAction = "filter: " + status; }
  action markFetching() { lastAction = "fetching..."; }  // 模拟占位：仅改状态串，不执行真实获取
}
