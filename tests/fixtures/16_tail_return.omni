fn add(a: i32, b: i32) -> i32 {
    a + b
}

fn greet(name: String) -> String {
    "Hello, " + name
}

fn do_nothing() {
    return;
}

fn main() {
    let sum: i32 = add(3, 4);
    println(sum.to_string());

    let msg: String = greet("World");
    println(msg);

    do_nothing();
    println("ok");
}
