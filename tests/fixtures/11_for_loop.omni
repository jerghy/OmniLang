fn main() {
    let arr: Array<i32> = [10, 20, 30];
    for item in arr {
        println(item.to_string());
    }

    let empty: Array<i32> = [];
    println(empty.len().to_string());

    let mut sum: i32 = 0;
    for n in arr {
        sum = sum + n;
    }
    println(sum.to_string());

    let arr2: Array<i32> = [1, 2, 3, 4, 5];
    for x in arr2 {
        if x > 3 {
            break;
        }
        println(x.to_string());
    }
}
