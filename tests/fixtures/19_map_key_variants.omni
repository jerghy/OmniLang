fn main() {
    let m1: Map<String, i32> = {"alpha": 1};
    let key: String = "beta";
    m1.insert(key, 2);
    m1.insert("gamma", 3);

    println(m1.get("alpha").to_string());
    println(m1.get(key).to_string());
    println(m1.len().to_string());

    let m2: Map<i32, String> = {1: "one", 2: "two"};
    println(m2.get(1));
    println(m2.contains(3).to_string());
}
