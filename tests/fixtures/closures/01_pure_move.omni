// Test 1: Pure computation closure — captures i32 (Copy, immutable)
// Expected Rust: direct `move` closure, no Cell needed
// Expected output: 30

fn make_adder(x: i32) -> fn(i32) -> i32 {
    return |y: i32| -> i32 {
        return x + y;
    };
}

fn main() {
    let add10: fn(i32) -> i32 = make_adder(10);
    let result: i32 = add10(20);
    println(result.to_string());
}
