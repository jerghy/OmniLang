// Class implementing multiple interfaces
interface Readable {
    fn read() -> String;
}

interface Writable {
    fn write(data: String) -> void;
}

interface Closable {
    fn close() -> void;
}

class File implements Readable, Writable, Closable {
    path: String = "";
    fn read() -> String {
        return "content";
    }
    fn write(data: String) -> void {
        println("Writing");
    }
    fn close() -> void {
        println("Closed");
    }
}

fn main() {
    println("ok");
}
