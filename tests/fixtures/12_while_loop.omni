fn main() {
    let mut i: i32 = 0;
    while i < 5 {
        if i == 2 {
            i = i + 1;
            continue;
        }
        if i == 4 {
            break;
        }
        println(i.to_string());
        i = i + 1;
    }

    let mut x: i32 = 0;
    let mut y: i32 = 10;
    while x < 3 {
        let mut inner: i32 = 0;
        while inner < 2 {
            y = y + 1;
            inner = inner + 1;
        }
        x = x + 1;
    }
    println(y.to_string());
}
