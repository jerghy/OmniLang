fn fib(n: i32) -> i32 {
    if n <= 1 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() {
    let result: i32 = fib(10);
    println(result.to_string());

    let mut arr: Array<i32> = [3, 1, 2];
    let mut i: i32 = 0;
    let n: i32 = arr.len();
    while i < n {
        let mut j: i32 = 0;
        while j < n - i - 1 {
            if arr[j] > arr[j + 1] {
                let tmp: i32 = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    for v in arr {
        println(v.to_string());
    }
}
