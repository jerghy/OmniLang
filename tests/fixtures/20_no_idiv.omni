fn main() {
    let x: i32 = 100;
    let y: i32 = 200;
    let sum: i32 = x + y;
    let diff: i32 = y - x;
    let prod: i32 = x * 10;

    println(sum.to_string());
    println(diff.to_string());
    println(prod.to_string());

    let s1: String = "hello";
    let s2: String = "world";
    let msg: String = s1 + s2;
    println(msg);
}
