import omniview;

component Counter {
    signal count: i32 = 0;

    fn increment() {
        count = count + 1;
    }

    view {
        <Container>
            <Heading level="1">Counter</Heading>
            <Text test-id="counter">Count: {count}</Text>
            <Button onPress={increment} test-id="btn-inc">+1</Button>
        </Container>
    }

    style {
        .container { layout: column; gap: 16px; padding: 32px; align: center; justify: center; max_width: 400px; }
        .heading { font_size: 28px; font_weight: bold; }
    }
}
