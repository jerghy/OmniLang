// Task Assignment Dashboard — Framework Test
// Covers: multi-panel layout, signals, fn actions, capacity checking, filtering
component TaskBoard {
  // ── Member task counts ──
  signal aliceTasks: i32 = 0;
  signal bobTasks: i32 = 0;
  signal charlieTasks: i32 = 1;

  // ── Task assignments ──
  signal task1Assignee: String = "";
  signal task2Assignee: String = "";

  // ── UI state ──
  signal filterPriority: String = "all";
  signal isSaving: bool = false;
  signal saveError: String = "";
  signal errorMessage: String = "";

  // ── Configuration ──
  signal maxCapacity: i32 = 3;

  // ── Actions: Task Assignment ──
  fn assignTask1ToAlice() {
    if (aliceTasks < maxCapacity) {
      task1Assignee = "Alice";
      aliceTasks = aliceTasks + 1;
      errorMessage = "";
    } else {
      errorMessage = "Alice is at capacity!";
    }
  }

  fn assignTask2ToBob() {
    if (bobTasks < maxCapacity) {
      task2Assignee = "Bob";
      bobTasks = bobTasks + 1;
      errorMessage = "";
    } else {
      errorMessage = "Bob is at capacity!";
    }
  }

  // ── Actions: Filtering ──
  fn filterAll() {
    filterPriority = "all";
  }

  fn filterHigh() {
    filterPriority = "high";
  }

  // ── Actions: Sync ──
  fn syncToBackend() {
    if (isSaving) {
      isSaving = false;
      saveError = "Sync failed: network error";
    } else {
      isSaving = true;
      saveError = "";
    }
  }

  // ── View ──
  view {
    <Card padding="24px" background="#1a1a2e" test-id="task-board-root">
      <Heading level="2" test-id="app-title">Task Assignment Dashboard</Heading>

      <Flex direction="row" gap="16px" flex="1" test-id="main-layout">
        {/* Left: Team Members */}
        <Flex direction="column" gap="12px" width="240px" padding="16px" background="#16213e" test-id="members-panel">
          <Heading level="3">Team Members</Heading>

          <Card padding="12px" background="#1e3a5f" test-id="member-alice">
            <Heading level="4">Alice Chen</Heading>
            <Text test-id="alice-tasks">Tasks: {aliceTasks} | Done: 0</Text>
          </Card>

          <Card padding="12px" background="#1e3a5f" test-id="member-bob">
            <Heading level="4">Bob Wang</Heading>
            <Text test-id="bob-tasks">Tasks: {bobTasks} | Done: 0</Text>
          </Card>

          <Card padding="12px" background="#1e3a5f" test-id="member-charlie">
            <Heading level="4">Charlie Li</Heading>
            <Text test-id="charlie-tasks">Tasks: {charlieTasks} | Done: 0</Text>
          </Card>
        </Flex>

        {/* Middle: Task Board */}
        <Flex direction="column" gap="12px" flex="1" padding="16px" background="#0f3460" test-id="task-panel">
          <Heading level="3" test-id="task-board-title">Task Board</Heading>

          <Card padding="12px" background="#1e3a5f" test-id="task-1">
            <Heading level="4">T1: Design API</Heading>
            <Text>Status: todo | Priority: high</Text>
            <Text test-id="task1-assignee">Assignee: {task1Assignee}</Text>
          </Card>

          <Card padding="12px" background="#1e3a5f" test-id="task-2">
            <Heading level="4">T2: Build Auth</Heading>
            <Text>Status: todo | Priority: medium</Text>
            <Text test-id="task2-assignee">Assignee: {task2Assignee}</Text>
          </Card>

          <Card padding="12px" background="#1e3a5f" test-id="task-3">
            <Heading level="4">T3: Write Tests</Heading>
            <Text>Status: todo | Priority: low</Text>
            <Text>Assignee: —</Text>
          </Card>

          <Card padding="12px" background="#1e3a5f" test-id="task-4">
            <Heading level="4">T4: Deploy CI</Heading>
            <Text>Status: todo | Priority: high</Text>
            <Text>Assignee: —</Text>
          </Card>

          <Flex direction="column" gap="8px" padding="8px 0" test-id="assign-buttons">
            <Button variant="primary" onPress={assignTask1ToAlice} test-id="btn-assign-t1-alice">Assign T1 to Alice</Button>
            <Button variant="primary" onPress={assignTask2ToBob} test-id="btn-assign-t2-bob">Assign T2 to Bob</Button>
          </Flex>

          <Flex direction="row" gap="8px" test-id="filter-buttons">
            <Button variant="primary" onPress={filterAll} test-id="btn-filter-all">All</Button>
            <Button variant="outline" onPress={filterHigh} test-id="btn-filter-high">High Priority</Button>
          </Flex>
        </Flex>

        {/* Right: Statistics */}
        <Flex direction="column" gap="12px" width="280px" padding="16px" background="#16213e" test-id="stats-panel">
          <Heading level="3">Statistics</Heading>
          <Text test-id="stat-total">Total tasks: 4</Text>
          <Text test-id="stat-filter">Filter: {filterPriority}</Text>
          <Text test-id="stat-error">{errorMessage}</Text>
          <Text test-id="stat-saving">Saving: {isSaving}</Text>
          <Text test-id="stat-save-error">{saveError}</Text>
          <Button variant="outline" onPress={syncToBackend} test-id="btn-sync">Sync to Backend</Button>
        </Flex>
      </Flex>
    </Card>
  }
}
