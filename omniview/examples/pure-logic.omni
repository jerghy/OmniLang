// Pure OmniLang test — functions, control flow, data structures

fn fibonacci(n: i32) -> i32 {
    if n <= 1 {
        return n;
    }
    let a: i32 = 0;
    let b: i32 = 1;
    let i: i32 = 2;
    while i <= n {
        let temp: i32 = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    return b;
}

fn factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

fn is_even(n: i32) -> bool {
    return n % 2 == 0;
}

fn greet(name: String) -> String {
    return "Hello, " + name + "!";
}

fn main() {
    let fib10: i32 = fibonacci(10);
    println(fib10);

    let fact5: i32 = factorial(5);
    println(fact5);

    let even: bool = is_even(42);
    println(even);

    let msg: String = greet("World");
    println(msg);

    let x: i32 = 10;
    let y: i32 = 20;
    if x < y {
        println("x is less than y");
    } else {
        println("x is not less than y");
    }
}
