import omniview;

// ── Style Showcase — tests all CSS properties ──────────

component StyleShowcase {
    signal theme: String = "light";
    signal selected_card: i32 = 1;

    view {
        <Container test-id="showcase">
            <Heading level="1" test-id="page-title">OmniView CSS Showcase</Heading>

            // Card 1: Typography
            <Card test-id="card-typo">
                <Heading level="2">Typography</Heading>
                <Text test-id="text-normal">Normal text (16px)</Text>
                <Text test-id="text-large">Large bold heading</Text>
                <Text test-id="text-muted">Muted secondary text</Text>
            </Card>

            // Card 2: Colors & Backgrounds
            <Card test-id="card-colors">
                <Heading level="2">Colors</Heading>
                <Container test-id="color-swatch-red" />
                <Container test-id="color-swatch-blue" />
                <Container test-id="color-swatch-green" />
            </Card>

            // Card 3: Borders & Radius
            <Card test-id="card-borders">
                <Heading level="2">Borders</Heading>
                <Container test-id="box-rounded">Rounded</Container>
                <Container test-id="box-bordered">Bordered</Container>
                <Container test-id="box-dashed">Dashed</Container>
                <Container test-id="box-pill">Pill shaped</Container>
            </Card>

            // Card 4: Shadows
            <Card test-id="card-shadows">
                <Heading level="2">Shadows</Heading>
                <Container test-id="box-shadow-sm">SM</Container>
                <Container test-id="box-shadow-md">MD</Container>
                <Container test-id="box-shadow-lg">LG</Container>
                <Container test-id="box-shadow-xl">XL</Container>
            </Card>

            // Card 5: Layout
            <Card test-id="card-layout">
                <Heading level="2">Layout</Heading>
                <Flex direction="row" gap="16px" test-id="flex-row">
                    <Container test-id="flex-child-1">A</Container>
                    <Container test-id="flex-child-2">B</Container>
                    <Container test-id="flex-child-3">C</Container>
                </Flex>
                <Flex direction="column" gap="8px" test-id="flex-col">
                    <Container test-id="flex-stack-1">Top</Container>
                    <Container test-id="flex-stack-2">Bottom</Container>
                </Flex>
            </Card>

            // Card 6: Spacing
            <Card test-id="card-spacing">
                <Heading level="2">Spacing</Heading>
                <Container test-id="box-padded">Padded content</Container>
                <Container test-id="box-margined">Margined content</Container>
            </Card>

            <Text test-id="footer-text">OmniView CSS Test — {theme} theme</Text>
        </Container>
    }

    style {
        .container {
            layout: column;
            gap: 24px;
            padding: 32px;
            max_width: 800px;
            background: #f8f9fa;
        }
        .heading {
            font_size: 28px;
            font_weight: bold;
            color: #1a1a2e;
        }
        .sub_heading {
            font_size: 20px;
            font_weight: semibold;
            color: #333333;
        }

        // Typography
        .card_typo { padding: 24px; border_radius: 12px; background: #ffffff; shadow: md; }
        .text_large { font_size: 24px; font_weight: bold; color: #16213e; }
        .text_muted { font_size: 14px; color: #999999; }

        // Colors
        .card_colors { padding: 24px; border_radius: 12px; background: #ffffff; shadow: sm; }
        .color_swatch_red { width: 60px; height: 60px; background: #e74c3c; border_radius: 8px; }
        .color_swatch_blue { width: 60px; height: 60px; background: #3498db; border_radius: 8px; }
        .color_swatch_green { width: 60px; height: 60px; background: #2ecc71; border_radius: 8px; }

        // Borders
        .card_borders { padding: 24px; border_radius: 12px; background: #ffffff; shadow: sm; }
        .box_rounded { padding: 16px; border_radius: 8px; background: #e8f4f8; }
        .box_bordered { padding: 16px; border_width: 2px; border_color: #3498db; border_style: solid; border_radius: 4px; }
        .box_dashed { padding: 16px; border_width: 2px; border_color: #e67e22; border_style: dashed; border_radius: 4px; }
        .box_pill { padding: 16px; border_radius: 999px; background: #3498db; color: #ffffff; }

        // Shadows
        .card_shadows { padding: 24px; border_radius: 12px; background: #ffffff; }
        .box_shadow_sm { padding: 16px; shadow: sm; border_radius: 4px; background: #ffffff; }
        .box_shadow_md { padding: 16px; shadow: md; border_radius: 4px; background: #ffffff; }
        .box_shadow_lg { padding: 16px; shadow: lg; border_radius: 4px; background: #ffffff; }
        .box_shadow_xl { padding: 16px; shadow: xl; border_radius: 4px; background: #ffffff; }

        // Layout
        .card_layout { padding: 24px; border_radius: 12px; background: #ffffff; shadow: sm; }
        .flex_child_1 { padding: 12px; background: #e74c3c; color: #ffffff; border_radius: 4px; text_align: center; }
        .flex_child_2 { padding: 12px; background: #3498db; color: #ffffff; border_radius: 4px; text_align: center; }
        .flex_child_3 { padding: 12px; background: #2ecc71; color: #ffffff; border_radius: 4px; text_align: center; }
        .flex_stack_1 { padding: 12px; background: #f39c12; color: #ffffff; border_radius: 4px; }
        .flex_stack_2 { padding: 12px; background: #9b59b6; color: #ffffff; border_radius: 4px; }

        // Spacing
        .card_spacing { padding: 24px; border_radius: 12px; background: #ffffff; shadow: sm; }
        .box_padded { padding: 24px; background: #d5f5e3; border_radius: 8px; }
        .box_margined { margin: 16px; padding: 16px; background: #d6eaf8; border_radius: 8px; }

        // Footer
        .footer_text { font_size: 12px; color: #aaaaaa; padding: 16px; }
    }
}
