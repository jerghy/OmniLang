store CartStore {
    signal item_count: i32 = 0;
    signal discount: i32 = 0;
    getter cart_total: i32 = discount;
    getter cart_count: i32 = item_count;
    action add_item() { item_count = item_count + 1; }
    action clear_cart() { item_count = 0; }
}

component ShopApp {
    @store CartStore;
    signal search: String = "";

    fn handle_add() { store.add_item(); }
    fn handle_clear() { store.clear_cart(); }

    view {
        <Container>
            <Flex direction="row" gap="16px" align="center">
                <Heading>Shop</Heading>
                <Spacer />
                <Input bind:value={search} placeholder="Search..." test-id="search-input" />
                <Text test-id="cart-count">Items: {store.cart_count}</Text>
            </Flex>
            <Grid test-id="product-grid">
                <Card test-id="product-1">
                    <Heading>Widget</Heading>
                    <Text>$19.99</Text>
                    <Button onPress={handle_add} test-id="btn-add-1">Add to Cart</Button>
                </Card>
                <Card test-id="product-2">
                    <Heading>Gadget</Heading>
                    <Text>$29.99</Text>
                    <Button onPress={handle_add} test-id="btn-add-2">Add to Cart</Button>
                </Card>
                <Card test-id="product-3">
                    <Heading>Doohickey</Heading>
                    <Text>$9.99</Text>
                    <Button onPress={handle_add} test-id="btn-add-3">Add to Cart</Button>
                </Card>
            </Grid>
            <Flex direction="row" gap="16px" test-id="cart-footer">
                <Text>Total: {store.cart_total}</Text>
                <Button onPress={handle_clear} test-id="btn-clear-cart">Clear Cart</Button>
            </Flex>
        </Container>
    }
    style {
        .product_card { padding: 16px; border_radius: 12px; shadow: md; layout: column; gap: 8px; }
    }
}

theme { colors { primary: "#1890ff"; accent: "#52c41a"; } }
