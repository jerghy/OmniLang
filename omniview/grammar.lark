// OmniView v0.3 — Frontend Component DSL Grammar
// Target: Lark Earley parser
//
// Architecture (2026-06-09 Council R9):
//   Dual-grammar model via omnilang.lexer unified entry.
//   Physical merge blocked by Lark constraints (%import, generic_params conflict).
//
//   expr rules (lines 129-160): KEPT PERMANENTLY — used inline in element props,
//     style entries, directive guards, etc. Cannot be pre-extracted.
//   stmt rules (lines 164-178): FALLBACK ONLY — all blocks go through preprocessor
//     → RAW_BLOCK → OmniLang delegation. These rules are only hit when preprocessor
//     misses a block context (should not happen in normal flow).
//   block rule (line 182): primary path is RAW_BLOCK; stmt* alternative is fallback.
//
//   See ADR-001 §8 for acceptance criteria.

start: program

program: (import_lib | import_stmt | import_type_stmt | import_namespace_stmt | export_from_stmt)* (component_def | store_def | theme_def)*

import_lib: "import" CNAME ";"
import_stmt: "import" "{" CNAME ("," CNAME)* "}" "from" STRING_LIT ";"
import_type_stmt: "import" "type" "{" CNAME ("," CNAME)* "}" "from" STRING_LIT ";"
import_namespace_stmt: "import" STRING_LIT "as" CNAME ";"

// ── Exports ──────────────────────────────────

export_from_stmt: "export" "{" CNAME ("," CNAME)* "}" "from" STRING_LIT ";"

// ── Component ────────────────────────────────────────

component_def: "component" CNAME ["<" generic_params ">"] "{" component_body "}"

generic_params: CNAME ("," CNAME)*

component_body: (prop_decl | signal_decl | computed_decl | event_decl
               | ref_decl | store_ref | lifecycle_hook | fn_def | action_def
               | view_block | style_block)*

prop_decl: "prop" CNAME ":" type ["=" expr] ";"
signal_decl: "signal" CNAME ":" type "=" expr ";"
computed_decl: "computed" CNAME ":" type "=" expr ";"
event_decl: "event" CNAME ":" type ["?"] ";"
ref_decl: "ref" CNAME ":" type ";"
store_ref: AT_STORE CNAME ";"

// ── Store ────────────────────────────────────────────

store_def: "store" CNAME "{" store_body "}"
store_body: (store_signal | store_getter | store_action)*
store_signal: "signal" CNAME ":" type "=" expr ";"
store_getter: "getter" CNAME ":" type "=" expr ";"
store_action: ["async"] "action" CNAME "(" [params] ")" ["->" return_type] block

// ── Theme ────────────────────────────────────────────

theme_def: "theme" "{" theme_body "}"
theme_body: theme_category*
theme_category: CNAME "{" (theme_value)* "}"
theme_value: CNAME ":" STRING_LIT ";"

// ── Lifecycle ────────────────────────────────────────

lifecycle_hook: AT_MOUNT block | AT_UNMOUNT block | AT_EFFECT "(" CNAME ")" block

// ── Functions ────────────────────────────────────────

fn_def: ["async"] "fn" CNAME "(" [params] ")" ["->" return_type] block
action_def: ["async"] "action" CNAME "(" [params] ")" ["->" return_type] block
params: param ("," param)*
param: CNAME [":" type]
return_type: type

// ── Types ────────────────────────────────────────────

?type: union_type
union_type: named_type ("|" named_type)*
named_type: TYPE_NAME ["<" type_args ">"] | CNAME ["<" type_args ">"] | optional_type
type_args: type ("," type)*
optional_type: TYPE_NAME "?" | CNAME "?"

TYPE_NAME: "i32" | "f64" | "bool" | "String" | "void" | "null"
         | "Array" | "Map" | "Option" | "Ref"

// ── View Block ───────────────────────────────────────

view_block: "view" "{" view_content* "}"

?view_content: element | if_directive | for_directive | slot_directive
             | native_block | fallback_block | error_boundary

element: "<" CNAME element_body ">" element_children "</" CNAME ">"
       | "<" CNAME element_body "/>"

element_children: (element | if_directive | for_directive | slot_directive
                  | native_block | fallback_block | error_boundary | text_content)*

element_body: element_prop*

?element_prop: ref_prop | bind_prop | event_prop | class_prop | class_map_prop | style_prop | test_id_prop | static_prop

static_prop: CNAME "=" (STRING_LIT | "{" expr "}")
bind_prop: "bind:" CNAME "=" "{" CNAME ("." CNAME)? "}"
event_prop: CNAME "=" "{" event_handler "}"
class_prop: "class" "=" "{" class_value "}"
class_map_prop: "class" "=" "{" "class_map" "(" "{" class_map_entries "}" ")" "}"
class_map_entries: (class_map_entry ("," class_map_entry)* [","])?
class_map_entry: CNAME ":" expr
style_prop: "style" "=" "{" "{" style_entries "}" "}"
style_entries: (style_entry ("," style_entry)* [","])?
style_entry: CNAME ":" expr
test_id_prop: "test-id" "=" STRING_LIT
ref_prop: "ref" "=" "{" CNAME "}"

class_value: "style" "." CNAME | STRING_LIT

// ── Event Handlers ───────────────────────────────────

event_handler: inline_fn_handler | fn_ref_handler | store_action_handler
inline_fn_handler: "fn" "(" [handler_params] ")" block
fn_ref_handler: CNAME
store_action_handler: CNAME "." CNAME
handler_params: handler_param ("," handler_param)*
handler_param: CNAME [":" type]

// ── Directives ───────────────────────────────────────

if_directive: AT_IF guard_expr view_block_body (AT_ELSE "if" guard_expr view_block_body)* [AT_ELSE view_block_body]
for_directive: AT_FOR CNAME "in" expr view_block_body [AT_EMPTY view_block_body]
slot_directive: AT_SLOT ["name" "=" STRING_LIT]
native_block: AT_NATIVE "(" CNAME ")" "{" [NATIVE_RAW] "}"
fallback_block: AT_FALLBACK view_block_body

error_boundary: AT_ERROR "(" CNAME ")" view_block_body

// View block body — used by directives in view context
view_block_body: "{" view_content* "}"

// ── Text Content ─────────────────────────────────────

?text_content: TEXT_PLAIN | interpolation
TEXT_PLAIN: /(?u)[^{}<>@\n\r]+/
interpolation: "{" expr "}"

// ── Expressions ──────────────────────────────────────

?expr: ternary_expr
?ternary_expr: logic_expr ["?" expr ":" expr]
?logic_expr: comp_expr ((AND | OR) comp_expr)*
?comp_expr: add_expr (COMP_OP add_expr)*
?add_expr: mul_expr (ADD_OP mul_expr)*
?mul_expr: unary_expr (MUL_OP unary_expr)*
?unary_expr: UNARY_OP unary_expr | postfix_expr
?postfix_expr: atom_expr (DOT CNAME ("(" [call_args] ")")?)* | func_call_expr

func_call_expr: CNAME "(" [call_args] ")"
?atom_expr: literal | var_ref | "(" expr ")" | template_string | array_lit | map_lit | if_expr

var_ref: CNAME
call_args: expr ("," expr)*

// ── Literals ─────────────────────────────────────────

?literal: bool_lit | string_lit | number_lit
bool_lit: TRUE | FALSE
TRUE: "true"
FALSE: "false"
string_lit: STRING_LIT
number_lit: NUMBER

array_lit: "[" [array_element ("," array_element)* [","] ] "]"
?array_element: SPREAD expr | expr
map_lit: "{" [map_entry ("," map_entry)* [","] ] "}"
map_entry: expr ":" expr
template_string: TEMPLATE_STRING

if_expr: "if" guard_expr block "else" block
guard_expr: expr

// ── Statements ───────────────────────────────────────

stmt: var_decl | assign | if_stmt | while_stmt | for_stmt
    | break_stmt | continue_stmt | return_stmt | print_stmt
    | event_emit_stmt | expr_stmt

var_decl: "let" ["mut"] CNAME [":" type] "=" expr ";"
assign: CNAME ("." CNAME)? ASSIGN_OP expr ";"
if_stmt: "if" expr block ["else" (if_stmt | block)]
while_stmt: "while" expr block
for_stmt: "for" CNAME "in" expr block
break_stmt: "break" ";"
continue_stmt: "continue" ";"
return_stmt: "return" [expr] ";"
print_stmt: "println" "(" expr ")" ";"
event_emit_stmt: "event" CNAME "(" [expr ("," expr)*] ")" ";"
expr_stmt: expr ";"

// ── Block ────────────────────────────────────────────

block: "{" stmt* "}"
     | "{" RAW_BLOCK "}"

RAW_BLOCK: /__OMNI_BLOCK_\d+__/

// ── Style Block ──────────────────────────────────────

style_block: "style" "{" style_rule* "}"
style_rule: "." CNAME "{" style_property (";" style_property)* [";"] "}"
style_property: CSS_PROP_NAME ":" style_value
CSS_PROP_NAME: /[a-zA-Z_][a-zA-Z0-9_-]*/

?style_value: CSS_DIMENSION | HEX_COLOR | style_value_list | STRING_LIT | NUMBER | CNAME
// Multi-value CSS shorthands: 8px 24px, 1px solid #ccc, 1rem auto, 0 4px 6px rgba(...)
// Each value part can be: dimension, keyword (CNAME), number, or hex color
// Use STRING_LIT for complex values with function calls: "0 4px 6px rgba(0,0,0,0.1)"
style_value_part: CSS_DIMENSION | CNAME | NUMBER | HEX_COLOR
style_value_list: style_value_part style_value_part+
CSS_DIMENSION: /\d+(\.\d+)?(px|rem|em|vh|vw|%|ch|ex|vmin|vmax)/
HEX_COLOR: /#[0-9a-fA-F]{3,8}/

// ── Operators ────────────────────────────────────────

ASSIGN_OP: "=" | "+=" | "-=" | "*=" | "/=" | "%="
COMP_OP: "==" | "!=" | "<" | ">" | "<=" | ">="
ADD_OP: "+" | "-"
MUL_OP: "*" | "/" | "%"
UNARY_OP: "-" | "!"
AND: "&&"
OR: "||"
SPREAD: "..."
DOT: "."

// ── Terminals ────────────────────────────────────────

NUMBER: /0[xX][0-9a-fA-F]+/ | /0[oO][0-7]+/ | /0[bB][01]+/
      | /\d+\.\d+([eE][+-]?\d+)?/ | /\d+[eE][+-]?\d+/ | /\d+/
STRING_LIT: /"(?:[^"\\]|\\.)*"/
TEMPLATE_STRING: /`(?:[^`\\]|\\.)*`/
NATIVE_RAW: /[^}]+/

CNAME: /[a-zA-Z_][a-zA-Z0-9_]*/

// ── @Directive Keywords ──────────────────────────────

AT_STORE: "@store"
AT_IF: "@if"
AT_ELSE: "@else"
AT_FOR: "@for"
AT_EMPTY: "@empty"
AT_SLOT: "@slot"
AT_NATIVE: "@native"
AT_FALLBACK: "@fallback"
AT_ERROR: "@error"
AT_MOUNT: "@mount"
AT_UNMOUNT: "@unmount"
AT_EFFECT: "@effect"

// ── Comments (declared before TEXT_PLAIN for priority) ─

COMMENT_SINGLE: /\/\/[^\n]*/
COMMENT_BLOCK: /\/\*[\s\S]*?\*\//

// ── Whitespace ──────────────────────────────────────

%import common.WS
%ignore WS
%ignore COMMENT_SINGLE
%ignore COMMENT_BLOCK
