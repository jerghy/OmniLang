{
  "name": "omnilang-vscode",
  "displayName": "OmniLang",
  "description": "OmniLang language support — syntax highlighting, diagnostics, and code actions",
  "version": "0.2.0",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:omnilang"],
  "main": "./extension.js",
  "contributes": {
    "languages": [{ "id": "omnilang", "extensions": [".omni"], "configuration": "./language-configuration.json" }],
    "grammars": [{ "language": "omnilang", "scopeName": "source.omni", "path": "./syntaxes/omnilang.tmLanguage.json" }]
  },
  "scripts": { "package": "vsce package" }
}
