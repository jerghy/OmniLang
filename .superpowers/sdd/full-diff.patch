+        {icons[data.skeletonType]} {data.label}
+      </div>
+      {data.condition && (
+        <div
+          style={{
+            fontSize: 10,
+            color: "#92400E",
+            marginTop: 2,
+            maxWidth: 140,
+            overflow: "hidden",
+            textOverflow: "ellipsis",
+          }}
+        >
+          {data.condition}
+        </div>
+      )}
+      <Handle
+        type="target"
+        position={Position.Top}
+        id="flow-in"
+        style={{ background: "#F59E0B" }}
+      />
+      <Handle
+        type="source"
+        position={Position.Bottom}
+        id="flow-true"
+        style={{ background: "#10B981", left: hasTwoBranches ? "30%" : "50%" }}
+        title="true"
+      />
+      {hasTwoBranches && (
+        <Handle
+          type="source"
+          position={Position.Bottom}
+          id="flow-false"
+          style={{ background: "#EF4444", left: "70%" }}
+          title="false"
+        />
+      )}
+      <Handle
+        type="target"
+        position={Position.Left}
+        id="data-in"
+        style={{ background: "#FBBF24" }}
+      />
+    </div>
+  );
+}
