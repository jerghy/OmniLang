-  | { type: "execution-trace"; nodeId: string; edgeId?: string; timestamp: number }
-  | { type: "runtime-ready" | "runtime-error"; message?: string }
-  | { type: "paused" | "resumed"; signalId?: string; value?: unknown; timestamp: number };
