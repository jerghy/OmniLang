-const VIEW_HEIGHT = 200; // covers input (198), tight for button (306) but ok
-
-// ── Layout spacing ──
-const RANK_SEP = 300;   // horizontal spacing between ranks (data-flow steps)
-const NODE_SEP = 140;   // vertical spacing between nodes in the same rank
