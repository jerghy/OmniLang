+            borderTop: `5px solid ${layerStyle.border}`,
+            flexShrink: 0,
+          }}
+        />
+      )}
+      <span
+        style={{
+          overflow: "hidden",
+          textOverflow: "ellipsis",
+          whiteSpace: "nowrap",
+          flex: 1,
+        }}
+      >
+        {d.label}
+      </span>
+      {d.childCount > 0 && (
+        <span
+          style={{
+            background: layerStyle.border,
+            color: "#fff",
+            fontSize: 10,
+            fontWeight: 700,
+            borderRadius: "50%",
