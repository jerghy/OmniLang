+const LAYER_COLORS: Record<string, { border: string; bg: string }> = {
+  interface: { border: "#3b82f6", bg: "#eff6ff" },
+  composition: { border: "#10b981", bg: "#ecfdf5" },
+  "store-deps": { border: "#ef4444", bg: "#fef2f2" },
